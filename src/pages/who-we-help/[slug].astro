---
import { ArrowRight, Check, ChevronRight, ExternalLink } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { audiences, getAudience, type AudiencePage } from "@/lib/audiences";
import { CONSULTATION_URL } from "@/lib/services";

export function getStaticPaths() {
  return audiences.map((audience) => ({
    params: { slug: audience.slug },
    props: { audience },
  }));
}

interface Props {
  audience: AudiencePage;
}

const { audience } = Astro.props;
const currentAudience = audience ?? getAudience(Astro.params.slug ?? "");

if (!currentAudience) {
  return Astro.redirect("/404");
}

const path = `/who-we-help/${currentAudience.slug}`;
const siteUrl = Astro.site ?? new URL("https://www.turnkeyautomarketing.com");
const pageUrl = new URL(path, siteUrl).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: currentAudience.seoTitle.split(" | ")[0],
  description: currentAudience.seoDescription,
  url: pageUrl,
  provider: {
    "@type": "Organization",
    "@id": new URL("/#organization", siteUrl).toString(),
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
  areaServed: "United States",
  audience: {
    "@type": "BusinessAudience",
    audienceType: currentAudience.name,
  },
  serviceType: `Marketing for ${currentAudience.name}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl.toString() },
    { "@type": "ListItem", position: 2, name: currentAudience.name, item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: currentAudience.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  title={currentAudience.seoTitle}
  description={currentAudience.seoDescription}
  path={path}
  ogTitle={currentAudience.seoTitle}
  ogImage={currentAudience.image.src}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <section class="relative overflow-hidden bg-white py-10 md:py-16 lg:py-20">
    <div class="container-page">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-charcoal/60">
        <a href="/" class="inline-flex min-h-11 items-center font-medium transition hover:text-charcoal">Home</a>
        <ChevronRight className="h-4 w-4 text-charcoal/30" aria-hidden="true" />
        <span class="font-medium text-charcoal">{currentAudience.name}</span>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow text-[var(--key-blue)]">{currentAudience.eyebrow}</p>
          <h1 class="page-title mt-6 max-w-[15ch] text-balance text-charcoal">
            <span class="block">{currentAudience.heroTitle}</span>
            <span class="block text-[var(--key-blue)]">{currentAudience.heroAccent}</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-charcoal/68 md:text-xl">
            {currentAudience.heroCopy}
          </p>
          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a
              href={CONSULTATION_URL}
              class="btn-primary"
              data-track-event="consultation_cta_click"
              data-track-slug={currentAudience.slug}
              data-track-placement="audience_hero"
            >
              Book a Strategy Call
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
            <a href="#answer" class="inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--navy)]">
              See what matters
              <ArrowRight className="motion-arrow h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>

        <figure class="lg:col-span-5">
          <div class="overflow-hidden rounded-[32px] bg-[var(--navy)] p-3 shadow-[0_34px_90px_-58px_rgba(20,22,28,0.55)]">
            <img
              src={currentAudience.image.src}
              alt={currentAudience.image.alt}
              width={currentAudience.image.width}
              height={currentAudience.image.height}
              loading="eager"
              decoding="async"
              class="aspect-[4/3] h-full w-full rounded-[24px] object-cover"
              style={`object-position: ${currentAudience.image.position};`}
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section id="answer" class="bg-[var(--navy)] py-14 text-white md:py-20">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow text-[var(--green)]">The short answer</p>
        <h2 class="display-3 mt-5 max-w-[12ch] text-balance text-white">What should this marketing actually do?</h2>
      </div>
      <p class="max-w-3xl text-xl leading-relaxed text-white/82 lg:col-span-7 lg:col-start-6 lg:pt-2 md:text-2xl">
        {currentAudience.answer}
      </p>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-24">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow text-[var(--key-blue)]">The customer decision</p>
        <h2 class="display-2 mt-5 text-balance text-charcoal">Build trust before the phone call.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {currentAudience.priorities.map((priority) => (
          <article class="motion-card rounded-[28px] border border-black/[0.07] bg-white p-7 md:p-8">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[var(--navy)] text-white">
              <Check className="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="mt-6 font-display text-2xl font-semibold leading-tight text-charcoal">{priority.title}</h3>
            <p class="mt-4 leading-relaxed text-charcoal/68">{priority.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow text-[var(--key-blue)]">A coordinated approach</p>
        <h2 class="display-2 mt-5 max-w-[12ch] text-balance text-charcoal">One plan. Clear local priorities.</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-charcoal/65">
          The strategy stays focused on the shop's real capacity, customer fit, and repair work. The channels support that decision instead of setting it.
        </p>
      </div>
      <div class="space-y-4 lg:col-span-7">
        {currentAudience.approach.map((item) => (
          <article class="rounded-[24px] border border-[var(--hairline)] bg-white p-6 shadow-[0_20px_55px_-48px_rgba(20,22,28,0.5)] md:p-8">
            <h3 class="font-display text-2xl font-semibold leading-tight text-charcoal">{item.title}</h3>
            <p class="mt-3 max-w-2xl leading-relaxed text-charcoal/68">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--charcoal)] py-14 text-white md:py-24">
    <div class="container-page">
      <div class="grid gap-10 rounded-[32px] bg-[var(--navy)] p-7 md:p-12 lg:grid-cols-12 lg:items-center lg:gap-16 lg:p-14">
        <div class="lg:col-span-4">
          <p class="eyebrow text-[var(--green)]">{currentAudience.proof.eyebrow}</p>
          <p class="mt-5 font-display text-7xl font-semibold tracking-[-0.055em] text-white md:text-8xl">{currentAudience.proof.metric}</p>
        </div>
        <div class="lg:col-span-8">
          <h2 class="display-3 text-balance text-white">{currentAudience.proof.title}</h2>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/72">{currentAudience.proof.description}</p>
          <a href={currentAudience.proof.href} class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--green)]">
            {currentAudience.proof.linkLabel}
            <ArrowRight className="motion-arrow h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-24">
    <div class="container-page">
      <div class="max-w-3xl">
        <p class="eyebrow text-[var(--key-blue)]">Relevant services</p>
        <h2 class="display-2 mt-5 text-balance text-charcoal">Choose the level of help the shop needs.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {currentAudience.services.map((service) => (
          <a
            href={service.href}
            class="group flex min-h-[260px] flex-col rounded-[28px] border border-black/[0.07] bg-white p-7 transition hover:-translate-y-1 hover:border-[var(--key-blue)]/35 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.45)]"
            data-track-event="service_cta_click"
            data-track-slug={service.href.replace("/services/", "")}
            data-track-placement="audience_services"
          >
            <h3 class="font-display text-2xl font-semibold leading-tight text-charcoal">{service.title}</h3>
            <p class="mt-4 leading-relaxed text-charcoal/68">{service.description}</p>
            <span class="mt-auto inline-flex min-h-11 items-end gap-2 pt-7 font-semibold text-[var(--navy)]">
              Explore service
              <ArrowRight className="motion-arrow h-4 w-4" aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow text-[var(--key-blue)]">Source notes</p>
        <h2 class="display-3 mt-5 text-balance text-charcoal">Useful primary guidance.</h2>
        <p class="mt-5 leading-relaxed text-charcoal/65">
          These external sources support the local-profile, service, and review practices referenced on this page.
        </p>
      </div>
      <div class="grid gap-4 lg:col-span-8">
        {currentAudience.sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener noreferrer" class="group rounded-[24px] border border-[var(--hairline)] bg-white p-6 transition hover:border-[var(--key-blue)]/35 hover:shadow-[0_20px_55px_-48px_rgba(20,22,28,0.5)]">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--key-blue)]">{source.publisher}</p>
            <h3 class="mt-3 flex items-start gap-3 font-display text-xl font-semibold leading-tight text-charcoal">
              <span>{source.title}</span>
              <ExternalLink className="mt-1 h-4 w-4 shrink-0 text-charcoal/40 transition group-hover:text-[var(--key-blue)]" aria-hidden="true" />
            </h3>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-charcoal/65">{source.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-24">
    <div class="container-page">
      <div class="mx-auto mb-8 max-w-4xl text-center md:mb-14">
        <h2 class="display-2 text-balance text-charcoal">Frequently asked questions</h2>
      </div>
      <div class="faq-list mx-auto max-w-3xl space-y-3">
        {currentAudience.faqs.map((faq, index) => (
          <details class="faq-item overflow-hidden rounded-2xl border hairline bg-white" open={index === 0}>
            <summary class="faq-summary group flex w-full cursor-pointer items-center justify-between px-5 py-4 text-left transition-colors hover:bg-[var(--key-blue)] md:px-6 md:py-5">
              <span class="faq-question pr-5 font-display text-base font-semibold text-charcoal transition-colors group-hover:text-white md:pr-8 md:text-lg">
                {faq.question}
              </span>
              <span class="faq-icon inline-flex h-8 w-8 flex-none items-center justify-center rounded-full bg-[var(--off-white)] text-charcoal transition-colors group-hover:bg-white/15 group-hover:text-white" aria-hidden="true">
                <span class="faq-plus">+</span>
                <span class="faq-minus">−</span>
              </span>
            </summary>
            <div class="faq-answer px-5 pb-5 leading-relaxed text-charcoal/70 transition-colors md:px-6 md:pb-6">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-24">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-[32px] bg-[var(--navy)] p-8 text-white md:p-12 lg:p-14">
        <span class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-[var(--key-blue)] blur-3xl opacity-30" aria-hidden="true"></span>
        <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="eyebrow text-[var(--green)]">Talk through the fit</p>
            <h2 class="display-2 mt-5 max-w-[14ch] text-balance text-white">Build the plan around the work you want more of.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/72">Bring your market, capacity, current vendors, and biggest question. We will help you identify the next practical move.</p>
          </div>
          <a
            href={CONSULTATION_URL}
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-[var(--green)] px-6 py-3.5 font-semibold text-charcoal transition hover:-translate-y-0.5 hover:brightness-105"
            data-track-event="consultation_cta_click"
            data-track-slug={currentAudience.slug}
            data-track-placement="audience_footer"
          >
            Book a Strategy Call
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-item > summary {
    list-style: none;
  }

  .faq-item > summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] > .faq-summary,
  .faq-item[open] > .faq-answer {
    background: var(--key-blue);
  }

  .faq-item[open] .faq-question,
  .faq-item[open] > .faq-answer {
    color: white;
  }

  .faq-item[open] .faq-icon {
    background: rgb(255 255 255 / 0.15);
    color: white;
  }

  .faq-minus {
    display: none;
  }

  .faq-item[open] .faq-plus {
    display: none;
  }

  .faq-item[open] .faq-minus {
    display: inline;
  }
</style>
