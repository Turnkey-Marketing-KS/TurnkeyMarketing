---
import V6Layout from "@/components/v6/V6Layout.astro";
import V6Faq from "@/components/v6/V6Faq.astro";
import SolidPhoneIcon from "@/components/site/SolidPhoneIcon.astro";
import { googleReviewSummary } from "@/lib/google-reviews";
import { arrow, arrowUp, iconSrc, phoneHref, phoneLabel, serviceIcons, split } from "@/lib/v6";
import { audiences, getAudience, type AudiencePage } from "@/lib/audiences";
import { CONSULTATION_URL } from "@/lib/services";

export function getStaticPaths() {
  return audiences.map((audience) => ({
    params: { slug: audience.slug },
    props: { audience },
  }));
}

interface Props {
  audience: AudiencePage;
}

const { audience } = Astro.props;
const currentAudience = audience ?? getAudience(Astro.params.slug ?? "");

if (!currentAudience) {
  return Astro.redirect("/404");
}

const path = `/who-we-help/${currentAudience.slug}`;
const siteUrl = Astro.site ?? new URL("https://www.turnkeyautomarketing.com");
const pageUrl = new URL(path, siteUrl).toString();

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: currentAudience.seoTitle.split(" | ")[0],
  description: currentAudience.seoDescription,
  url: pageUrl,
  provider: {
    "@type": "Organization",
    "@id": new URL("/#organization", siteUrl).toString(),
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
  areaServed: "United States",
  audience: {
    "@type": "BusinessAudience",
    audienceType: currentAudience.name,
  },
  serviceType: `Marketing for ${currentAudience.name}`,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl.toString() },
    { "@type": "ListItem", position: 2, name: currentAudience.name, item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: currentAudience.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

// Noun icons for the three "customer decision" priorities, per audience.
const priorityIcons: Record<string, string[]> = {
  "european-auto-repair-shops": ["car-count", "target", "vip"],
  "multi-location-auto-repair-shops": ["weekly-planner", "location", "report"],
};
const icons = priorityIcons[currentAudience.slug] ?? ["target", "location", "report"];
const serviceIcon = (href: string) => serviceIcons[href.replace("/services/", "")] ?? "target";
---

<V6Layout
  title={currentAudience.seoTitle}
  description={currentAudience.seoDescription}
  path={path}
  ogTitle={currentAudience.seoTitle}
  ogImage={currentAudience.image.src}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
  class="tk-aud"
>
  <!-- Hero. Desktop: title and actions beside a portrait photo. Phones: title, actions, then a 4:3 photo. -->
  <section class="tk-aud__hero">
    <div class="v6-wrap tk-aud__hero-grid">
      <div class="tk-aud__hero-copy">
        <nav class="v6-crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/" class="tk-aud__crumb">Home</a></li>
            <li><span aria-current="page">{currentAudience.name}</span></li>
          </ol>
        </nav>
        <h1 class="tk-aud__title" data-words set:html={split([{ t: currentAudience.heroTitle }, { t: currentAudience.heroAccent, accent: true }])} />
        <p class="tk-aud__lead" data-fade style="--d:2">{currentAudience.heroCopy}</p>
        <div class="tk-aud__actions" data-fade style="--d:3">
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--navy v6-btn--lg"
            data-track-event="consultation_cta_click"
            data-track-slug={currentAudience.slug}
            data-track-placement="audience_hero"
          >
            <span>Book a Strategy Call</span><i set:html={arrow} />
          </a>
          <a href="#answer" class="v6-link">See what matters <i set:html={arrow} /></a>
        </div>
      </div>
      <figure class="tk-aud__media" data-fade style="--d:2">
        <img
          src={currentAudience.image.src}
          alt={currentAudience.image.alt}
          width={currentAudience.image.width}
          height={currentAudience.image.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style={`object-position: ${currentAudience.image.position};`}
        />
      </figure>
    </div>
  </section>

  <!-- The short answer -->
  <section id="answer" class="v6-sec v6-sec--navy tk-aud__answer">
    <div class="v6-wrap tk-aud__answer-grid">
      <h2 class="tk-aud__answer-title" data-words set:html={split([{ t: "What should this marketing" }, { t: "actually do?", accent: true }])} />
      <p class="tk-aud__answer-text" data-rise>{currentAudience.answer}</p>
    </div>
  </section>

  <!-- The customer decision: tiles on desktop, a swipe rail on phones -->
  <section class="v6-sec v6-sec--tint">
    <div class="v6-wrap">
      <h2 class="v6-h2 tk-aud__h2" data-words set:html={split([{ t: "Build trust before" }, { t: "the phone call.", accent: true }])} />
      <div class="v6-swipe tk-aud__tiles" style="--cols:3">
        {currentAudience.priorities.map((priority, index) => (
          <article class="v6-tile tk-aud__tile" data-rise style={`transition-delay:${index * 0.08}s`}>
            <span class="v6-tile__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(icons[index] ?? "target")})`}></span></span>
            <h3 class="v6-tile__title">{priority.title}</h3>
            <p class="v6-tile__text">{priority.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- A coordinated approach: sticky title, numbered rows -->
  <section class="v6-sec">
    <div class="v6-wrap tk-aud__split">
      <div class="tk-aud__side">
        <h2 class="v6-h2 tk-aud__side-title" data-words set:html={split([{ t: "One plan." }, { t: "Clear local priorities.", accent: true }])} />
        <p class="v6-lead" data-rise>
          The strategy stays focused on the shop's real capacity, customer fit, and repair work. The channels support that decision instead of setting it.
        </p>
      </div>
      <ol class="tk-aud__steps">
        {currentAudience.approach.map((item, index) => (
          <li class="tk-aud__step" data-rise>
            <div>
              <h3 class="tk-aud__step-title">{item.title}</h3>
              <p class="tk-aud__step-text">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Proof: the one featured card on the page -->
  <section class="v6-sec tk-aud__proof-sec">
    <div class="v6-wrap">
      <div class="v6-glow" data-rise>
        <div class="v6-glow__inner tk-aud__proof">
          <div class="tk-aud__proof-stat">
            <p class="tk-aud__metric">{currentAudience.proof.metric}</p>
          </div>
          <div class="tk-aud__proof-body">
            <h2 class="tk-aud__proof-title">{currentAudience.proof.title}</h2>
            <p class="tk-aud__proof-text">{currentAudience.proof.description}</p>
            <a href={currentAudience.proof.href} class="v6-link">{currentAudience.proof.linkLabel} <i set:html={arrow} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Relevant services -->
  <section class="v6-sec v6-sec--tint">
    <div class="v6-wrap">
      <h2 class="v6-h2 tk-aud__h2" data-words set:html={split([{ t: "Choose the level of help" }, { t: "the shop needs.", accent: true }])} />
      <div class="v6-swipe tk-aud__tiles" style="--cols:3">
        {currentAudience.services.map((service, index) => (
          <a
            href={service.href}
            class:list={["v6-tile tk-aud__svc", index === 0 && "v6-tile--navy"]}
            data-track-event="service_cta_click"
            data-track-slug={service.href.replace("/services/", "")}
            data-track-placement="audience_services"
            data-rise
            style={`transition-delay:${index * 0.08}s`}
          >
            <span class="v6-tile__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(serviceIcon(service.href))})`}></span></span>
            <h3 class="v6-tile__title">{service.title}</h3>
            <p class="v6-tile__text">{service.description}</p>
            <span class:list={["v6-link tk-aud__svc-go", index === 0 && "v6-link--light"]}>Explore service <i set:html={arrow} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Source notes: hairline rows -->
  <section class="v6-sec">
    <div class="v6-wrap tk-aud__split">
      <div class="tk-aud__side">
        <h2 class="tk-aud__src-h2" data-words set:html={split([{ t: "Useful primary" }, { t: "guidance.", accent: true }])} />
        <p class="v6-lead" data-rise>
          These external sources support the local-profile, service, and review practices referenced on this page.
        </p>
      </div>
      <ul class="tk-aud__sources">
        {currentAudience.sources.map((source) => (
          <li data-rise>
            <a href={source.href} target="_blank" rel="noopener noreferrer" class="tk-aud__src">
              <p class="tk-aud__src-pub">{source.publisher}</p>
              <h3 class="tk-aud__src-title">
                <span>{source.title}</span>
                <i class="tk-aud__src-go" set:html={arrowUp} />
              </h3>
              <p class="tk-aud__src-text">{source.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <V6Faq items={currentAudience.faqs.map((faq) => ({ q: faq.question, a: faq.answer }))} />

  <!-- Closing call to action (page copy kept; audience tracking kept) -->
  <section class="v6-cta">
    <div class="v6-wrap">
      <div class="v6-cta__panel" data-rise>
        <a href={googleReviewSummary.url} class="v6-cta__rating">
          <span class="v6-stars" aria-hidden="true">★★★★★</span>
          {googleReviewSummary.rating} on Google · {googleReviewSummary.count} reviews
        </a>
        <h2 class="v6-cta__title" data-words set:html={split([{ t: "Build the plan around" }, { t: "the work you want more of.", accent: true }])} />
        <p class="v6-cta__text">Bring your market, capacity, current vendors, and biggest question. We will help you identify the next practical move.</p>
        <div class="v6-cta__actions">
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--navy v6-btn--lg"
            data-track-event="consultation_cta_click"
            data-track-slug={currentAudience.slug}
            data-track-placement="audience_footer"
          >
            <span>Book a Strategy Call</span><i set:html={arrow} />
          </a>
          <a href={phoneHref} class="v6-btn v6-btn--ghost v6-btn--lg" data-track-event="phone_click" data-track-placement="audience_footer"><SolidPhoneIcon class="h-6 w-6" /><span>{phoneLabel}</span></a>
        </div>
      </div>
    </div>
  </section>
</V6Layout>

<style>
  /* Hero */
  .tk-aud__hero { padding-block: clamp(2.5rem, 5.5vw, 5rem) clamp(4rem, 8vw, 7rem); }
  .tk-aud__hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(2.5rem, 5vw, 5.5rem); align-items: end; }
  .tk-aud__hero-copy { display: grid; justify-items: start; }
  .tk-aud__crumb { display: inline-flex; align-items: center; min-height: 2.75rem; min-width: 2.75rem; }
  .tk-aud__actions .v6-link, .tk-aud__proof-body .v6-link { min-height: 2.75rem; }
  .tk-aud__hero .v6-crumbs { margin-top: -0.75rem; }
  .tk-aud__kicker { margin-top: 1.75rem; }
  .tk-aud__title { margin-top: 1rem; max-width: 15ch; font-size: clamp(3rem, 5.4vw, 5.6rem); line-height: 0.98; letter-spacing: -0.058em; font-weight: 600; text-wrap: balance; }
  .tk-aud__lead { margin-top: 1.75rem; max-width: 36rem; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.6; color: var(--muted); }
  .tk-aud__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 2.25rem; }
  .tk-aud__media { position: relative; margin: 0; overflow: hidden; border-radius: 36px; aspect-ratio: 4 / 5; max-height: 38rem; background: var(--off-white); box-shadow: 0 40px 90px -60px rgba(35, 46, 102, 0.7); }
  .tk-aud__media img { width: 100%; height: 100%; object-fit: cover; }
  .tk-aud__media::after { content: ""; position: absolute; inset: 0; background: radial-gradient(90% 70% at 0% 0%, rgba(63, 140, 203, 0.22), transparent 62%); pointer-events: none; }

  /* Short answer */
  .tk-aud__answer-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .tk-aud__answer-title { font-size: clamp(2rem, 3.4vw, 3.4rem); line-height: 1.04; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; max-width: 12ch; }
  .tk-aud__answer-text { font-size: clamp(1.25rem, 2vw, 1.85rem); line-height: 1.42; letter-spacing: -0.025em; font-weight: 500; color: rgba(255, 255, 255, 0.86); text-wrap: pretty; }

  /* Section heads and tiles */
  .tk-aud__h2 { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .tk-aud__tile .v6-tile__title, .tk-aud__svc .v6-tile__title { margin-top: 1.25rem; }
  .tk-aud__tile { min-height: 20rem; }
  .tk-aud__svc { min-height: 22rem; }
  .tk-aud__svc-go { margin-top: auto; padding-top: 1rem; align-self: flex-start; }
  .tk-aud__svc:hover .tk-aud__svc-go i { transform: translateX(3px); }
  .tk-aud__svc.v6-tile--navy { background: linear-gradient(150deg, var(--key-blue), var(--navy) 70%); }

  /* Split with sticky side title */
  .tk-aud__split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 7vw, 7rem); align-items: start; }
  .tk-aud__side { position: sticky; top: calc(var(--header-h) + 2.5rem); display: grid; gap: 1.5rem; }
  .tk-aud__side-title { max-width: 11ch; }
  .tk-aud__steps { border-top: 1px solid var(--hairline); }
  .tk-aud__step { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding-block: clamp(1.75rem, 3vw, 2.5rem); border-bottom: 1px solid var(--hairline); }
  .tk-aud__step-num { font-size: 1rem; font-weight: 700; color: var(--key-blue); font-variant-numeric: tabular-nums; padding-top: 0.45rem; }
  .tk-aud__step-title { font-size: clamp(1.45rem, 2.3vw, 2.1rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.1; text-wrap: balance; }
  .tk-aud__step-text { margin-top: 0.85rem; max-width: 34rem; font-size: 1.05rem; line-height: 1.65; color: var(--muted); }

  /* Proof */
  .tk-aud__proof { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: clamp(2.25rem, 5vw, 4.5rem); }
  .tk-aud__proof-stat { display: grid; gap: 0.75rem; padding-right: clamp(1rem, 3vw, 3rem); border-right: 1px solid var(--hairline); }
  .tk-aud__metric { font-size: clamp(5.5rem, 12vw, 11rem); font-weight: 600; letter-spacing: -0.07em; line-height: 0.9; white-space: nowrap; background: linear-gradient(120deg, var(--navy) 10%, var(--key-blue) 60%, var(--green)); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: 0.08em; }
  .tk-aud__proof-body { display: grid; justify-items: start; gap: 1.25rem; }
  .tk-aud__proof-title { font-size: clamp(1.9rem, 3.2vw, 3.1rem); line-height: 1.04; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; }
  .tk-aud__proof-text { max-width: 36rem; font-size: 1.05rem; line-height: 1.65; color: var(--muted); }

  /* Sources */
  .tk-aud__src-h2 { font-size: clamp(2rem, 3.4vw, 3.4rem); line-height: 1.04; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; }
  .tk-aud__sources { border-top: 1px solid var(--hairline); }
  .tk-aud__sources li { border-bottom: 1px solid var(--hairline); }
  .tk-aud__src { display: grid; gap: 0.55rem; padding-block: 1.75rem; transition: padding 0.5s var(--ease); }
  .tk-aud__src:hover { padding-left: 0.75rem; }
  .tk-aud__src-pub { font-size: 0.85rem; font-weight: 600; color: var(--key-blue); }
  .tk-aud__src-title { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; font-size: clamp(1.2rem, 1.7vw, 1.5rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.2; transition: color 0.3s; }
  .tk-aud__src:hover .tk-aud__src-title { color: var(--navy); }
  .tk-aud__src-go { flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; margin-top: -0.3rem; border-radius: 999px; background: var(--off-white); color: var(--navy); transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease); }
  .tk-aud__src:hover .tk-aud__src-go { background: var(--navy); color: #fff; transform: rotate(0deg) scale(1.05); }
  .tk-aud__src-text { max-width: 38rem; line-height: 1.6; color: var(--muted); }

  @media (max-width: 1100px) {
    .tk-aud__hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: center; }
    .tk-aud__answer-grid, .tk-aud__split { grid-template-columns: 1fr; }
    .tk-aud__side { position: static; }
    .tk-aud__side-title, .tk-aud__answer-title { max-width: 18ch; }
    .tk-aud__proof { grid-template-columns: 1fr; }
    .tk-aud__proof-stat { padding-right: 0; padding-bottom: 1.75rem; border-right: 0; border-bottom: 1px solid var(--hairline); }
  }

  /* Phones: CTA right under the title, full-width buttons, compact photo, rails for card groups */
  @media (max-width: 900px) {
    .tk-aud__hero { padding-block: 1.25rem 3.5rem; }
    .tk-aud__hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .tk-aud__hero .v6-crumbs { margin-top: 0; }
    .tk-aud__kicker { margin-top: 0.75rem; }
    .tk-aud__title { margin-top: 0.6rem; font-size: clamp(2.35rem, 10.5vw, 3.4rem); }
    .tk-aud__lead { margin-top: 1.1rem; font-size: 1.02rem; }
    .tk-aud__actions { display: grid; width: 100%; gap: 0.25rem; margin-top: 1.6rem; }
    .tk-aud__actions .v6-btn, .tk-aud__actions .v6-link { justify-content: center; }
    .tk-aud__media { margin-inline: calc(var(--gutter) * -0.5); aspect-ratio: 4 / 3; max-height: none; border-radius: 28px; }
    .tk-aud__answer-grid { gap: 1.5rem; }
    .tk-aud__answer-text { font-size: 1.2rem; line-height: 1.5; }
    .tk-aud__tile, .tk-aud__svc { min-height: 0; }
    .tk-aud__tile .v6-tile__title, .tk-aud__svc .v6-tile__title { margin-top: 0.5rem; }
    .tk-aud__svc-go { min-height: 2.75rem; }
    .tk-aud__split { gap: 2rem; }
    .tk-aud__side { gap: 1rem; }
    .tk-aud__step { grid-template-columns: minmax(0, 1fr); gap: 0.9rem; padding-block: 1.5rem; }
    .tk-aud__step-num { padding-top: 0.25rem; font-size: 0.9rem; }
    .tk-aud__step-title { font-size: 1.35rem; }
    .tk-aud__step-text { margin-top: 0.55rem; font-size: 1rem; }
    .tk-aud__proof { gap: 1.5rem; padding: 1.75rem 1.5rem 2rem; }
    .tk-aud__proof-stat { padding-bottom: 1.25rem; }
    .tk-aud__metric { font-size: clamp(4.5rem, 24vw, 6.5rem); }
    .tk-aud__proof-title { font-size: 1.75rem; }
    .tk-aud__proof-text { font-size: 1rem; }
    .tk-aud__src { padding-block: 1.35rem; }
    .tk-aud__src:hover { padding-left: 0; }
    .tk-aud__src-title { font-size: 1.15rem; gap: 1rem; }
    .tk-aud__src-go { width: 2.25rem; height: 2.25rem; }
    .tk-aud__src-text { font-size: 0.95rem; }
  }
</style>
