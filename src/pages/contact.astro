---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarketingIcon from "@/components/site/MarketingIcon.astro";
import { siteMedia } from "@/lib/site-media";

const bookingUrl = "https://api.leadconnectorhq.com/widget/booking/wDWczTxA5kEbkEWoqzLC";
---

<BaseLayout
  title="Contact — Turnkey Marketing"
  description="Contact Turnkey Marketing or book a strategy call to talk through your auto repair shop marketing."
  path="/contact"
  ogTitle="Contact Turnkey Marketing"
  ogImage={siteMedia.team.visionExpoConversation.src}
>
  <section id="book" class="scroll-mt-24 border-b hairline bg-[var(--off-white)] py-4 md:py-10">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-display text-2xl font-semibold leading-tight tracking-tight text-charcoal md:text-4xl text-balance">
          Book a Strategy Call
        </h1>
        <p class="mx-auto mt-2 max-w-2xl text-sm leading-relaxed text-charcoal/75 md:text-base">
          30 minutes with the Turnkey team to discuss your shop’s marketing.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 text-sm">
          <a href="tel:+19134270674" class="inline-flex min-h-11 items-center font-medium text-[var(--navy)] underline underline-offset-4" data-track-event="phone_click" data-track-placement="booking_intro">Call (913) 427-0674</a>
          <a href="mailto:hello@turnkeyautomarketing.com" class="inline-flex min-h-11 items-center font-medium text-[var(--navy)] underline underline-offset-4" data-track-event="email_click" data-track-placement="booking_intro">Email the team</a>
        </div>
      </div>

      <div class="booking-sheet mx-auto mt-2 max-w-7xl md:mt-5">
        <iframe
          data-src={bookingUrl}
          data-tk-booking-provider="ghl_calendar"
          title="Book a strategy call with Turnkey Marketing"
          class="booking-widget"
          allow="payment"
          scrolling="yes"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>

        <div class="booking-fallback">
          <p>Having trouble with the calendar?</p>
          <a
            class="btn-primary inline-flex min-h-11 items-center justify-center px-5 py-3 text-sm"
            href={bookingUrl}
            data-tk-booking-provider="ghl_calendar"
            data-track-placement="calendar_fallback"
          >
            Open the Booking Calendar
          </a>
        </div>

        <noscript>
          <p class="p-6 text-center">
            <a
              class="font-semibold text-[var(--key-blue)] underline"
              href={bookingUrl}
            >
              Open the Booking Calendar
            </a>
          </p>
        </noscript>
      </div>

      <div class="mx-auto mt-5 max-w-2xl text-center text-sm leading-relaxed text-charcoal/75">
        <h2 class="font-semibold text-charcoal">What to expect</h2>
        <p class="mt-2">We’ll discuss your shop’s goals, current marketing, and where Turnkey could help.</p>
        <p class="mt-2">Helpful to have in mind: what you’re running today and the questions you want to discuss.</p>
      </div>

      <p class="mx-auto mt-5 max-w-3xl text-center text-sm leading-relaxed text-muted-foreground">
        SMS marketing consent is optional and separate from booking. If you
        choose to opt in, you agree to receive recurring marketing text
        messages about special offers, marketing services, and business updates
        from Turnkey Marketing, operated by CL Business Coaching LLC, at the
        mobile number provided. Message frequency varies. Message and data rates
        may apply. Reply HELP for help or STOP to opt out. Consent is not a
        condition of purchase. Review our
        <a class="font-medium text-[var(--navy)] underline underline-offset-4" href="/privacy-policy">Privacy Policy</a>
        and
        <a class="font-medium text-[var(--navy)] underline underline-offset-4" href="/terms-of-service">Terms of Service</a>.
      </p>
    </div>

  </section>

  <section class="container-page py-14 md:py-20">
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-5 md:grid-cols-3">
      <a
        href="tel:+19134270674"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        data-track-event="phone_click"
        data-track-placement="contact"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <MarketingIcon name="phone-calls" class="h-9 w-9" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Call the team
        </h2>
        <p class="mt-3 text-lg font-medium text-charcoal">(913) 427-0674</p>
      </a>

      <a
        href="mailto:hello@turnkeyautomarketing.com"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        data-track-event="email_click"
        data-track-placement="contact"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <MarketingIcon name="email-marketing" class="h-9 w-9" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Email us
        </h2>
        <p class="mt-3 break-words text-lg font-medium text-charcoal">
          hello@turnkeyautomarketing.com
        </p>
      </a>

      <a
        href="https://www.google.com/maps/search/?api=1&query=9401+Indian+Creek+Pkwy+%231300%2C+Overland+Park%2C+KS+66210"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <MarketingIcon name="location-targeting" class="h-9 w-9" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Office
        </h2>
        <address class="mt-3 text-base font-medium not-italic leading-relaxed text-charcoal">
          9401 Indian Creek Pkwy #1300<br />
          Overland Park, KS 66210
        </address>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    decorateGhlCalendarUrlWithAttribution,
    initializeAttributionTracking,
    trackMainWebsiteGhlCalendarViewed,
  } from "@/lib/booking-tracking.mjs";

  const trackingWindow = window as typeof window & {
    tkAttribution?: Record<string, unknown>;
  };
  const initialAttribution = initializeAttributionTracking(window);

  const applyAttribution = (attribution: Record<string, unknown>) => {
    document
      .querySelectorAll<HTMLElement>('[data-tk-booking-provider="ghl_calendar"]')
      .forEach((element) => {
        const attribute =
          element.tagName === "A" ? "href" : element.hasAttribute("data-src") ? "data-src" : "src";
        const source = element.getAttribute(attribute);
        if (!source) return;
        element.setAttribute(
          attribute,
          decorateGhlCalendarUrlWithAttribution(source, attribution),
        );
      });
  };

  applyAttribution(initialAttribution);

  window.setTimeout(() => {
    applyAttribution(trackingWindow.tkAttribution || initialAttribution);
    const frame = document.querySelector<HTMLIFrameElement>(
      'iframe[data-tk-booking-provider="ghl_calendar"]',
    );
    const source = frame?.getAttribute("data-src");
    if (frame && source) frame.src = source;
    trackMainWebsiteGhlCalendarViewed(window);
  }, 300);
</script>

<style>
  .booking-sheet {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 28px;
    background: white;
    padding: 0.75rem;
    box-shadow: 0 28px 70px -48px rgba(20, 22, 28, 0.35);
  }

  .booking-widget {
    display: block;
    width: 100%;
    height: clamp(760px, calc(100vh - 120px), 900px);
    border: 0;
    border-radius: 18px;
    background: white;
  }

  .booking-fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 18px;
    background: white;
    padding: 0.85rem 1rem;
  }

  .booking-fallback p {
    color: var(--charcoal);
    font-size: 0.875rem;
  }

  @media (max-width: 639px) {
    .booking-sheet {
      margin-inline: -0.5rem;
      border-radius: 22px;
      padding: 0.5rem;
    }

    .booking-widget {
      height: 760px;
      border-radius: 16px;
    }

    .booking-fallback a {
      width: 100%;
    }
  }
</style>
