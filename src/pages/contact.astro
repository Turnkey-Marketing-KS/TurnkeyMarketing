---
import { Mail, MapPin, Phone } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { APPOINTMENTCORE_BOOKING_URL } from "@/lib/services";
import { siteMedia } from "@/lib/site-media";
---

<BaseLayout
  title="Contact — Turnkey Marketing"
  description="Contact Turnkey Marketing or book a strategy call to talk through your auto repair shop marketing."
  path="/contact"
  ogTitle="Contact Turnkey Marketing"
  ogImage={siteMedia.team.visionExpoConversation.src}
>
  <section id="book" class="scroll-mt-24 border-b hairline bg-[var(--off-white)] py-14 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow" style="color: var(--key-blue);">Book a strategy call</p>
        <h2 class="display-2 mt-5 text-balance">
          Choose a time that works for you.
        </h2>
      </div>

      <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-[28px] bg-white shadow-[0_28px_70px_-48px_rgba(20,22,28,0.35)] ring-1 ring-black/5">
        <iframe
          src={APPOINTMENTCORE_BOOKING_URL}
          title="Book a strategy call with Turnkey Marketing"
          width="100%"
          height="800"
          class="block min-h-[800px] w-full border-0"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

      <p class="mx-auto mt-5 max-w-3xl text-center text-sm leading-relaxed text-muted-foreground">
        SMS marketing consent is optional and separate from booking. If you
        choose to opt in, you agree to receive recurring marketing text
        messages about special offers, marketing services, and business updates
        from Turnkey Marketing, operated by CL Business Coaching LLC, at the
        mobile number provided. Message frequency varies. Message and data rates
        may apply. Reply HELP for help or STOP to opt out. Consent is not a
        condition of purchase. Review our
        <a class="font-medium text-[var(--navy)] underline underline-offset-4" href="/privacy-policy">Privacy Policy</a>
        and
        <a class="font-medium text-[var(--navy)] underline underline-offset-4" href="/terms-of-service">Terms of Service</a>.
      </p>
    </div>

    <script
      is:inline
      src="https://go.appointmentcore.com/frontend/js/app/booking-link-embed-helper.js?v=1786632678"
    ></script>
  </section>

  <section class="container-page py-14 md:py-20">
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-5 md:grid-cols-3">
      <a
        href="tel:9137774144"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        data-track-event="phone_click"
        data-track-placement="contact"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <Phone className="h-5 w-5" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Call the team
        </h2>
        <p class="mt-3 text-lg font-medium text-charcoal">(913) 777-4144</p>
      </a>

      <a
        href="mailto:hello@turnkeyautomarketing.com"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        data-track-event="email_click"
        data-track-placement="contact"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <Mail className="h-5 w-5" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Email us
        </h2>
        <p class="mt-3 break-words text-lg font-medium text-charcoal">
          hello@turnkeyautomarketing.com
        </p>
      </a>

      <a
        href="https://www.google.com/maps/search/?api=1&query=9401+Indian+Creek+Pkwy+%231300%2C+Overland+Park%2C+KS+66210"
        class="min-w-0 rounded-[28px] bg-[var(--off-white)] p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.3)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
          <MapPin className="h-5 w-5" />
        </span>
        <h2 class="mt-8 font-display text-2xl font-semibold text-charcoal">
          Office
        </h2>
        <address class="mt-3 text-base font-medium not-italic leading-relaxed text-charcoal">
          9401 Indian Creek Pkwy #1300<br />
          Overland Park, KS 66210
        </address>
      </a>
    </div>
  </section>
</BaseLayout>
