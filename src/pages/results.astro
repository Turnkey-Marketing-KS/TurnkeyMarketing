---
import V6Layout from "@/components/v6/V6Layout.astro";
import V6Cta from "@/components/v6/V6Cta.astro";
import { CONSULTATION_URL } from "@/lib/services";
import { videoTestimonials } from "@/lib/proof";
import {
  bandStats,
  demandQuote,
  featuredResult,
  killianStory,
  moreResults,
} from "@/lib/results-content";
import { arrow, iconSrc, split } from "@/lib/v6";

// Routes marketing-director and outsourced-department intent to the service pages that
// own it, so this proof page supports those pages instead of ranking in place of them.
const resultPathways = [
  {
    eyebrow: "Outsourced marketing department",
    title: "VIP Marketing Manager",
    body: "A full outside marketing department for your auto repair shop — an account manager, designer, copywriter, and social coordinator planning the work, running it every week, and reporting what it did for car count.",
    cta: "See how VIP works",
    href: "/services/vip-marketing-manager",
    icon: "vip",
  },
  {
    eyebrow: "Outside marketing direction",
    title: "Marketing Consulting",
    body: "Monthly strategy sessions with an experienced auto repair marketing consultant who reviews what is running and helps you decide what to keep, fix, stop, and start next.",
    cta: "See how consulting works",
    href: "/services/marketing-consulting",
    icon: "target",
  },
];

const resultsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Auto Repair Marketing Results",
  description:
    "Client-specific revenue, car-count, retention, and location-growth examples from independent auto repair shops working with Turnkey Marketing.",
  url: "https://www.turnkeyautomarketing.com/results",
  about: {
    "@type": "Thing",
    name: "Auto repair marketing results",
  },
};

// Hero headline: three colored lines, each word revealed in sequence. Text is unchanged.
const heroLines = ["Auto repair marketing", "that drives calls, cars,", "and revenue."];
let wordIndex = 0;
const heroHtml = heroLines
  .map((line, n) => {
    const words = line
      .split(" ")
      .map((word) => `<span class="v6-w" style="--i:${wordIndex++}"><span>${word}</span></span>`)
      .join(" ");
    return `<span class="tk-res__line tk-res__line--${n + 1}">${words}</span>`;
  })
  .join(" ");

const esc = (value: string) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");

// Odometer: the real value is readable text; the rolling digits are drawn by CSS only.
const odometer = (value: string) => {
  const cells = [...value]
    .map((ch, i) =>
      /\d/.test(ch)
        ? `<span class="tk-odo__col" style="--n:${10 + Number(ch)};--i:${i}"><span class="tk-odo__strip"></span></span>`
        : `<span class="tk-odo__sym" data-ch="${esc(ch === " " ? " " : ch)}"></span>`,
    )
    .join("");
  return `<span class="v6-sr">${esc(value)}</span><span class="tk-odo__vis" aria-hidden="true">${cells}</span>`;
};

// Per-character stat, colored navy to key blue. `asText` keeps the characters as real text.
const mix = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
const statChars = (value: string, asText: boolean) => {
  const chars = [...value];
  return chars
    .map((ch, i) => {
      const t = chars.length > 1 ? i / (chars.length - 1) : 0;
      const [r, g, b] = mix([35, 46, 102], [63, 140, 203], t);
      const glyph = ch === " " ? " " : ch;
      return asText
        ? `<span class="tk-char" style="--c:${i};color:rgb(${r},${g},${b})">${esc(glyph)}</span>`
        : `<span class="tk-char" data-ch="${esc(glyph)}" style="--c:${i};color:rgb(${r},${g},${b})"></span>`;
    })
    .join("");
};

// Visual-only details for the story cards (logos and bar ratios from the figures in each label).
const storyExtras: Record<string, { logo: string; dark?: boolean; ratio: number; labels?: [string, string] }> = {
  "torque-european": { logo: "/images/results/shop-logos/torque-european.png", ratio: 48 },
  "asap-auto-repair": { logo: "/images/results/shop-logos/asap-auto-repair.png", dark: true, ratio: 62 },
  "pro-automotive": { logo: "/images/results/shop-logos/pro-automotive-services.png", ratio: 27, labels: ["Spent", "Earned"] },
};

const featBefore = featuredResult.chart.bars[0];
const featAfter = featuredResult.chart.bars[1];
---

<V6Layout
  title="Auto Repair Marketing Results — Turnkey Marketing"
  description="See how independent auto repair shops grow revenue, car count, customer retention, and locations with Turnkey Marketing campaigns."
  path="/results"
  ogTitle="Auto Repair Marketing Results — Turnkey Marketing"
  schema={resultsSchema}
  class="tk-results"
>
  <!-- HERO -->
  <section class="v6-ph tk-res__hero">
    <div class="v6-wrap">
      <div class="v6-ph__grid">
        <div>
          <h1 class="v6-ph__title tk-res__title" data-words set:html={heroHtml} />
        </div>
        <div class="v6-ph__aside" data-fade style="--d:2">
          <p class="v6-ph__lead">
            Client-specific examples from independent repair shops using coordinated strategy,
            campaigns, and reporting with Turnkey Marketing.
          </p>
          <div class="v6-ph__actions">
            <a href={CONSULTATION_URL} class="v6-btn v6-btn--navy v6-btn--lg"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
            <a href={`#${featuredResult.id}`} class="v6-link">Show me the proof <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEOS -->
  <section class="v6-sec v6-sec--navy tk-vid" data-rail-scope>
    <div class="v6-wrap">
      <div class="tk-vid__head">
        <div>
          <h2 class="v6-h2" data-words set:html={split([{ t: "Hear it from" }, { t: "shop owners.", accent: true }])} />
        </div>
        <div class="tk-vid__aside">
          <p class="v6-lead">
            These testimonial videos are optimized for the page so visitors can
            hear directly from shop owners without leaving the site.
          </p>
          <div class="v6-arrows v6-only-desktop">
            <button type="button" data-rail-prev aria-label="Previous videos"><i set:html={arrow} /></button>
            <button type="button" data-rail-next aria-label="Next videos"><i set:html={arrow} /></button>
          </div>
        </div>
      </div>
    </div>
    <div class="v6-rail tk-vid__rail" data-rail>
      {videoTestimonials.map((video) => (
        <article class="tk-reel">
          <div class="tk-reel__frame">
            <video
              class="tk-reel__video"
              controls
              preload="metadata"
              poster={video.posterSrc}
              title={`${video.name} testimonial video`}
              aria-label={video.posterAlt}
              playsinline
            >
              <source src={video.videoSrc} type="video/mp4" />
              <a href={video.videoSrc}>Download {video.name} testimonial video</a>
            </video>
          </div>
          <h3 class="tk-reel__name">{video.name}</h3>
          <p class="tk-reel__shop">{video.shop}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- FEATURED: LEGENDARY -->
  <section id={featuredResult.id} class="tk-res__feat result-target">
    <div class="v6-wrap tk-feat">
      <div class="tk-feat__text" data-rise>
        <span class="tk-feat__logo">
          <img src={featuredResult.logoSrc} alt={`${featuredResult.name} logo`} loading="lazy" decoding="async" />
        </span>
        <h2 class="tk-feat__title" data-words set:html={split([{ t: featuredResult.headline }])} />
        <p class="tk-feat__body">{featuredResult.body}</p>
        <p class="v6-fine tk-feat__note">{featuredResult.footnote}</p>
      </div>

      <figure class="tk-feat__chart" data-odo-group data-rise>
        <div role="img" aria-label={featuredResult.chart.ariaLabel}>
          <div class="tk-feat__plot">
            <div class="tk-feat__col tk-feat__col--before">
              <p class="tk-feat__value">{featBefore.value}</p>
              <div class="tk-feat__bar" style={`--h:${featBefore.height}%`}></div>
            </div>
            <div class="tk-feat__col tk-feat__col--after">
              {featAfter.tag && <span class="tk-feat__tag">{featAfter.tag}</span>}
              <p class="tk-feat__value tk-odo" set:html={odometer(featAfter.value)} />
              <div class="tk-feat__bar" style={`--h:${featAfter.height}%`}></div>
            </div>
          </div>
          <div class="tk-feat__axis">
            {featuredResult.chart.bars.map((bar) => <p>{bar.label}</p>)}
          </div>
        </div>
        <figcaption class="tk-feat__caption">{featuredResult.chart.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- STORY: NOT A ONE-OFF -->
  <section class="v6-sec v6-sec--tint tk-res__story">
    <div class="v6-wrap">
      <h2 class="v6-h2" data-words set:html={split([{ t: "And it’s not a" }, { t: "one-off.", accent: true }])} />
      <div class="tk-story" data-story>
        <div class="tk-story__pin" aria-hidden="true">
          <div class="tk-story__stats">
            {bandStats.map((stat, index) => (
              <div class:list={["tk-story__stat", index === 0 && "is-active"]} data-story-stat>
                <span class="tk-story__num" set:html={statChars(stat.value, false)} />
                <span class="tk-story__label" data-ch={stat.name}></span>
              </div>
            ))}
          </div>
          <div class="tk-story__progress"><span data-story-progress></span></div>
        </div>
        <ol class="tk-story__list">
          {bandStats.map((stat, index) => {
            const extra = storyExtras[stat.id];
            return (
              <li class:list={["tk-story__card", index === 0 && "is-active"]} data-story-card>
                <article
                  id={stat.id}
                  tabindex="-1"
                  aria-label={`${stat.name} client result`}
                  class="result-target tk-story__inner"
                >
                  <div class="tk-story__head">
                    {extra && (
                      <span class:list={["tk-story__logo", extra.dark && "tk-story__logo--dark"]}>
                        <img src={extra.logo} alt={`${stat.name} logo`} loading="lazy" decoding="async" />
                      </span>
                    )}
                    <strong class="tk-story__who">{stat.name}</strong>
                  </div>
                  <p class="tk-story__val" set:html={statChars(stat.value, true)} />
                  {extra && (
                    <div class="tk-story__bars" aria-hidden="true">
                      <span class="tk-story__bar" data-l={extra.labels?.[0] ?? "Before"}><span class="tk-story__fill tk-story__fill--before" style={`--w:${extra.ratio}%`}></span></span>
                      <span class="tk-story__bar" data-l={extra.labels?.[1] ?? "After"}><span class="tk-story__fill tk-story__fill--after" style="--w:100%"></span></span>
                    </div>
                  )}
                  <p class="tk-story__line">{stat.label}</p>
                  {stat.serviceLinks && (
                    <p class="tk-work">
                      <span class="tk-work__label">Documented work:</span>
                      {stat.serviceLinks.map((link) => (
                        <a
                          href={link.href}
                          class="tk-work__link"
                          data-track-event="service_cta_click"
                          data-track-slug={link.href.replace("/services/", "")}
                          data-track-placement="results_documented_work"
                        >
                          {link.label}
                        </a>
                      ))}
                    </p>
                  )}
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <!-- KILLIAN -->
  <section id={killianStory.id} class="v6-sec tk-kil">
    <div class="v6-wrap tk-kil__grid">
      <div class="tk-kil__text">
        <h2 class="v6-h2 tk-kil__title" data-words set:html={split([{ t: "One shop" }, { t: "became four.", accent: true }])} />
        <p class="tk-kil__body" data-rise>{killianStory.body}</p>
        <div class="tk-kil__foot" data-rise>
          <img src={killianStory.logoSrc} alt={`${killianStory.name} logo`} loading="lazy" decoding="async" class="tk-kil__logo" />
          <p class="v6-fine">{killianStory.footnote}</p>
        </div>
      </div>

      <ol class="tk-kil__map" data-kil>
        {killianStory.locations.map((location, index) => {
          const [milestone, result] = location.detail.split(" · ");
          return (
            <li class="tk-kil__loc" style={`--i:${index}`}>
              <span class="tk-kil__pin"><span class="v6-icon" style={`--icon:url(${iconSrc("location")})`}></span></span>
              <div class="tk-kil__where">
                <p class="tk-kil__name">{location.name}</p>
                <p class="tk-kil__ms">{milestone}</p>
              </div>
              {result && <p class="tk-kil__result">{result}</p>}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- MORE BEFORE & AFTERS -->
  <section class="v6-sec tk-more">
    <div class="v6-wrap">
      <h2 class="v6-h2" data-words set:html={split([{ t: "More before &" }, { t: "afters.", accent: true }])} />
      <div class="tk-board">
        {moreResults.map((result) => (
          <article id={result.id} tabindex="-1" class="result-target tk-board__row" data-odo-group data-rise>
            <span class="tk-board__logo">
              <img src={result.logoSrc} alt={`${result.name} logo`} loading="lazy" decoding="async" />
            </span>
            <p class="tk-board__delta tk-odo" set:html={odometer(result.delta)} />
            <div class="tk-board__body">
              <p class="tk-board__line">{result.line}</p>
              <p class="tk-board__meta">{result.meta}</p>
              {result.serviceLinks && (
                <p class="tk-work">
                  <span class="tk-work__label">Documented work:</span>
                  {result.serviceLinks.map((link) => (
                    <a
                      href={link.href}
                      class="tk-work__link"
                      data-track-event="service_cta_click"
                      data-track-slug={link.href.replace("/services/", "")}
                      data-track-placement="results_documented_work"
                    >
                      {link.label}
                    </a>
                  ))}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="v6-sec v6-sec--tint tk-quote">
    <div class="v6-wrap">
      <figure class="tk-quote__fig" data-rise>
        <img src={demandQuote.logoSrc} alt={demandQuote.logoAlt} loading="lazy" decoding="async" class="tk-quote__logo" />
        <div>
          <blockquote class="tk-quote__text">“{demandQuote.quote}”</blockquote>
          <figcaption class="tk-quote__by">{demandQuote.attribution}</figcaption>
        </div>
      </figure>
    </div>
  </section>

  <!-- PATHWAYS -->
  <section class="v6-sec tk-path">
    <div class="v6-wrap">
      <div class="v6-head">
        <div>
          <h2 class="v6-h2 tk-path__title" data-words set:html={split([{ t: "Every shop on this page has" }, { t: "someone owning the marketing.", accent: true }])} />
        </div>
        <p class="v6-lead" data-rise>
          The results above came from a plan that someone ran every week and reported on every
          month. Shops reach that two ways — by handing the whole function to an outside team, or
          by keeping execution in-house with experienced direction on top of it.
        </p>
      </div>

      <div class="v6-tiles tk-path__tiles" style="--cols:2">
        {resultPathways.map((path, index) => (
          <a href={path.href} class:list={["v6-tile tk-path__tile", index === 0 ? "v6-tile--navy" : "v6-tile--blue"]} data-rise style={`transition-delay:${index * 0.1}s`}>
            <span class="v6-tile__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(path.icon)})`}></span></span>
            <h3 class="tk-path__name">{path.title}</h3>
            <p class="v6-tile__text">{path.body}</p>
            <span class:list={["v6-link v6-tile__go", index === 0 && "v6-link--light"]}>{path.cta} <i set:html={arrow} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <V6Cta
    title="What could happen to your shop if you let"
    accent="the experts handle your marketing?"
    text=""
    placement="results_final_cta"
  />

  <section class="tk-res__disclaimer">
    <div class="v6-wrap">
      <p>
        These are client-specific examples, not promises or typical-results claims. Results vary
        by shop, market, investment, capacity, offer, tracking, and execution.
      </p>
    </div>
  </section>
</V6Layout>

<script>
  const root = document.querySelector<HTMLElement>(".tk-results");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Odometers and bar charts start when they come into view
    const countIo = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        setTimeout(() => entry.target.classList.add("is-counted"), reduce ? 0 : 200);
        countIo.unobserve(entry.target);
      }),
      { rootMargin: "0px 0px -15% 0px" },
    );
    root.querySelectorAll("[data-odo-group], [data-kil]").forEach((el) => countIo.observe(el));

    // Story: the card nearest the middle of the screen drives the big number
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-story-card]"));
    const stats = Array.from(root.querySelectorAll<HTMLElement>("[data-story-stat]"));
    const progress = root.querySelector<HTMLElement>("[data-story-progress]");
    const seenIo = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-seen");
        seenIo.unobserve(entry.target);
      }),
      { rootMargin: "0px 0px -25% 0px" },
    );
    cards.forEach((card) => seenIo.observe(card));

    let active = -1;
    let queued = false;
    const updateStory = () => {
      queued = false;
      if (!cards.length) return;
      const mid = window.innerHeight / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      if (best !== active) {
        active = best;
        cards.forEach((card, i) => card.classList.toggle("is-active", i === best));
        stats.forEach((stat, i) => {
          stat.classList.toggle("is-active", i === best);
          stat.classList.toggle("is-past", i < best);
        });
      }
      if (progress) {
        const first = cards[0].getBoundingClientRect();
        const last = cards[cards.length - 1].getBoundingClientRect();
        const span = last.top + last.height / 2 - (first.top + first.height / 2);
        const p = span > 0 ? (mid - (first.top + first.height / 2)) / span : 0;
        progress.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
      }
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(updateStory);
    };
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
    updateStory();
  }
</script>

<style is:global>
  /* Hero */
  .tk-res__hero { padding-bottom: clamp(3rem, 6vw, 5.5rem); }
  .tk-res__title { max-width: none; font-size: clamp(3rem, 7vw, 7.5rem); }
  .tk-res__line { display: block; }
  .tk-res__line--1 { color: var(--navy); }
  .tk-res__line--2 { color: var(--key-blue); }
  .tk-res__line--3 { color: var(--green); }
  .tk-res__hero .v6-ph__grid { grid-template-columns: 1fr; gap: clamp(2rem, 4vw, 3rem); }
  .tk-res__hero .v6-ph__aside { grid-template-columns: minmax(0, 34rem) auto; justify-content: space-between; align-items: end; gap: 1.5rem 3rem; padding-bottom: 0; }
  .tk-res__hero .v6-link { min-height: 2.75rem; }

  /* Odometer: digits are drawn by CSS, the value itself is real text */
  .tk-odo { --cell: 1.08em; }
  .tk-odo__vis { display: inline-flex; align-items: flex-start; height: var(--cell); line-height: var(--cell); font-variant-numeric: tabular-nums; }
  .tk-odo__col { display: inline-block; height: var(--cell); overflow: hidden; }
  .tk-odo__strip { display: block; transform: translateY(0); transition: transform 2.2s cubic-bezier(0.2, 0.9, 0.1, 1); transition-delay: calc(var(--i) * 0.07s); }
  .tk-odo__strip::before { content: "0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9\A 0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9"; display: block; white-space: pre; line-height: var(--cell); text-align: center; }
  .tk-odo__sym::before { content: attr(data-ch); display: inline-block; height: var(--cell); line-height: var(--cell); white-space: pre; }
  .is-counted .tk-odo__strip { transform: translateY(calc(var(--n) * var(--cell) * -1)); }

  /* Featured result */
  .tk-res__feat { padding-block: var(--space); scroll-margin-top: 4rem; }
  .tk-feat { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .tk-feat__text { display: grid; justify-items: start; gap: 1.25rem; }
  .tk-feat__logo { display: flex; align-items: center; height: 4.5rem; margin-top: 0.5rem; }
  .tk-feat__logo img { max-height: 100%; width: auto; object-fit: contain; }
  .tk-feat__title { font-size: clamp(2.6rem, 5vw, 5rem); line-height: 1; letter-spacing: -0.055em; font-weight: 600; text-wrap: balance; }
  .tk-feat__body { font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.65; color: var(--muted); max-width: 34rem; }
  .tk-feat__note { margin-top: 0.25rem; }
  .tk-feat__chart { padding: clamp(1.75rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem); border-radius: 40px; background: var(--off-white); }
  .tk-feat__plot { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.25rem, 4vw, 3rem); align-items: end; height: clamp(22rem, 34vw, 30rem); border-bottom: 2px solid rgba(20, 22, 28, 0.12); }
  .tk-feat__col { display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; height: 100%; }
  .tk-feat__value { margin-bottom: 1rem; font-size: clamp(1.4rem, 2.2vw, 2rem); font-weight: 600; letter-spacing: -0.04em; color: #7c8392; }
  .tk-feat__col--after .tk-feat__value { font-size: clamp(2.4rem, 4.6vw, 4.6rem); letter-spacing: -0.06em; color: var(--navy); line-height: 1; }
  .tk-feat__tag { margin-bottom: 0.9rem; padding: 0.4rem 0.9rem; border-radius: 999px; background: var(--green); color: var(--charcoal); font-weight: 700; font-size: 0.95rem; }
  .tk-feat__bar { width: 100%; height: var(--h); border-radius: 22px 22px 0 0; transform: scaleY(0); transform-origin: bottom; transition: transform 1.3s var(--ease) 0.15s; }
  .tk-feat__col--before .tk-feat__bar { background: #c9d6e5; }
  .tk-feat__col--after .tk-feat__bar { background: linear-gradient(180deg, var(--key-blue), var(--navy)); transition-delay: 0.4s; }
