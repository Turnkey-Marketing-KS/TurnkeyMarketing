---
import V6Layout from "@/components/v6/V6Layout.astro";
import { siteMedia } from "@/lib/site-media";
import { resourcePosts } from "@/lib/resource-posts";
import { arrow, iconSrc, split } from "@/lib/v6";

const [featuredPost, ...secondaryPosts] = resourcePosts;
const resourceFilters = ["All", ...Array.from(new Set(resourcePosts.map((post) => post.tag)))];
const filterSlug = (filter: string) => filter.toLowerCase().replaceAll(" ", "-");
---

<V6Layout
  title="Auto Repair Marketing Resources — Turnkey Marketing"
  description="Auto repair marketing articles, guides, and tools for shop owners who want clearer spend, better follow-up, and less guesswork."
  path="/resources"
  ogTitle="Auto Repair Marketing Resources — Turnkey Marketing"
  ogImage={siteMedia.graphics.leadGenerator.src}
  class="tk-res"
>
  <section class="tk-res__hero">
    <div class="v6-wrap">
      <header class="tk-res__head">
        <h1 class="tk-res__title" data-words set:html={split([{ t: "Auto repair marketing" }, { t: "resources for busy", accent: true }, { t: "shop owners." }])} />
        <p class="tk-res__lead" data-fade style="--d:2">
          Practical articles for shop owners who want clearer marketing
          decisions, stronger vendor accountability, and less guesswork
          around what to run next.
        </p>
      </header>

      <aside class="tk-res__tools" aria-label="Practical marketing tools" data-fade style="--d:3">
        <a href="/ai-visibility-scan" class="tk-res__tool tk-res__tool--navy">
          <span class="tk-res__tool-icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("internet")})`}></span></span>
          <div class="tk-res__tool-text">
            <h2 class="tk-res__tool-h2">Check your shop's AI visibility</h2>
            <p class="tk-res__tool-copy">See how clearly AI answer engines can understand and verify the shop information already online.</p>
            <span class="v6-link tk-res__tool-go">Run the scan <i set:html={arrow} /></span>
          </div>
        </a>
        <a href="/photos" class="tk-res__tool tk-res__tool--blue">
          <span class="tk-res__tool-icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("weekly-planner")})`}></span></span>
          <div class="tk-res__tool-text">
            <h2 class="tk-res__tool-h2">Use the auto repair photo shot list</h2>
            <p class="tk-res__tool-copy">Give a photographer a practical list of the people, bays, details, and customer moments worth capturing.</p>
            <span class="v6-link tk-res__tool-go">Open the shot list <i set:html={arrow} /></span>
          </div>
        </a>
      </aside>
    </div>
  </section>

  <section class="tk-res__lib" aria-labelledby="resource-library-heading">
    <div class="v6-wrap">
      <div class="tk-res__lib-head">
        <h2 id="resource-library-heading" class="tk-res__lib-h2">
          Explore the resources
        </h2>
        <p class="tk-res__count" aria-live="polite" data-resource-count>
          {resourcePosts.length} resources
        </p>
      </div>

      <div class="tk-res__filters">
        <p class="v6-sr">Browse by topic</p>
        <div
          class="resource-filter-bar tk-res__bar"
          data-resource-filter-bar
          data-allow-overflow
          role="tablist"
          aria-label="Filter resources"
        >
          <span
            class="tk-res__indicator"
            data-resource-filter-indicator
            aria-hidden="true"
          ></span>
          {resourceFilters.map((filter, index) => (
            <button
              type="button"
              data-resource-filter={filter}
              data-resource-filter-slug={filterSlug(filter)}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              class="tk-res__chip"
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      {featuredPost && (
        <div
          class="tk-res__featured-wrap"
          data-resource-card
          data-resource-tag={featuredPost.tag}
        >
          <a
            href={featuredPost.href}
            class="tk-res__featured"
          >
            <div class="tk-res__featured-media">
              <img
                src={featuredPost.image.src}
                alt={featuredPost.image.alt}
                width={featuredPost.imageWidth ?? 1400}
                height={featuredPost.imageHeight ?? 790}
                loading="eager"
                decoding="async"
                style={`object-position: ${featuredPost.image.position};`}
              />
            </div>
            <article class="tk-res__featured-body">
              <div class="tk-res__meta">
                <span class="tk-res__tag">
                  {featuredPost.tag}
                </span>
                <span aria-hidden="true">·</span>
                <time datetime={featuredPost.updatedDate ?? featuredPost.originalDate}>{featuredPost.date}</time>
              </div>
              <h2 class="tk-res__featured-h2">
                {featuredPost.title}
              </h2>
              <p class="tk-res__featured-dek">
                {featuredPost.dek}
              </p>
              <span class="v6-btn v6-btn--navy tk-res__featured-go">
                <span>Read article</span>
                <i set:html={arrow} />
              </span>
            </article>
          </a>
        </div>
      )}

      <div class="tk-res__grid">
        {secondaryPosts.map((item) => (
          <a
            href={item.href}
            id={filterSlug(item.tag)}
            data-resource-card
            data-resource-tag={item.tag}
            class="tk-res__card"
          >
            <div class="tk-res__card-media">
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.imageWidth ?? 1000}
                height={item.imageHeight ?? 625}
                loading="lazy"
                decoding="async"
                style={`object-position: ${item.image.position};`}
              />
            </div>
            <div class="tk-res__meta tk-res__card-meta">
              <span class="tk-res__tag">
                {item.tag}
              </span>
              <span aria-hidden="true">·</span>
              <time datetime={item.updatedDate ?? item.originalDate}>{item.date}</time>
            </div>
            <h3 class="tk-res__card-h3">
              {item.title}
            </h3>
            <p class="tk-res__card-text">
              {item.description}
            </p>
            <span class="v6-link tk-res__card-go">
              Read article
              <i set:html={arrow} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tk-res__cta">
    <div class="v6-wrap">
      <div class="tk-res__cta-panel" data-rise>
        <div>
        <h2 class="tk-res__cta-title">
          Need help turning a resource into a real next step?
        </h2>
        <p class="tk-res__cta-text">
          Start with a clear marketing decision, then choose the focused service or coordinated
          support that fits your shop.
        </p>
        </div>
        <div class="tk-res__cta-actions">
          <a
            href="/services/marketing-consulting"
            class="v6-btn v6-btn--green v6-btn--lg"
            data-track-event="service_cta_click"
            data-track-slug="marketing-consulting"
            data-track-placement="resources_commercial_path"
          >
            <span>Get marketing guidance</span> <i set:html={arrow} />
          </a>
          <a href="/services" class="v6-btn v6-btn--ghost v6-btn--lg">
            <span>Explore services</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const initResourceFilters = () => {
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const bar = document.querySelector("[data-resource-filter-bar]");
      const indicator = document.querySelector("[data-resource-filter-indicator]");
      const buttons = Array.from(document.querySelectorAll("[data-resource-filter]"));
      const cards = Array.from(document.querySelectorAll("[data-resource-card]"));
      const count = document.querySelector("[data-resource-count]");

      if (!(bar instanceof HTMLElement) || !(indicator instanceof HTMLElement) || buttons.length === 0) {
        return;
      }

      const moveIndicator = (button) => {
        if (!(button instanceof HTMLElement)) return;
        indicator.style.width = `${button.offsetWidth}px`;
        indicator.style.height = `${button.offsetHeight}px`;
        indicator.style.transform = `translate(${button.offsetLeft}px, ${button.offsetTop}px)`;
      };

      const setActiveFilter = (filter, updateHash = true) => {
        const activeButton = buttons.find((button) => button.getAttribute("data-resource-filter") === filter);
        if (!(activeButton instanceof HTMLElement)) return;

        buttons.forEach((button) => {
          const isActive = button === activeButton;
          button.setAttribute("aria-selected", isActive ? "true" : "false");
          button.toggleAttribute("data-active", isActive);
          if (button instanceof HTMLElement) {
            button.style.color = isActive ? "#fff" : "";
          }
        });

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;

          const shouldShow = filter === "All" || card.getAttribute("data-resource-tag") === filter;
          if (shouldShow) {
            card.hidden = false;
            card.style.opacity = "0";
            window.requestAnimationFrame(() => {
              card.style.opacity = "1";
            });
          } else {
            card.style.opacity = "0";
            window.setTimeout(() => {
              if (card.style.opacity === "0") {
                card.hidden = true;
              }
            }, 180);
          }
        });

        if (count instanceof HTMLElement) {
          const visibleCount = cards.filter(
            (card) => filter === "All" || card.getAttribute("data-resource-tag") === filter,
          ).length;
          count.textContent = `${visibleCount} ${visibleCount === 1 ? "resource" : "resources"}`;
        }

        window.requestAnimationFrame(() => {
          moveIndicator(activeButton);
        });

        if (updateHash) {
          const slug = activeButton.getAttribute("data-resource-filter-slug");
          const nextUrl = filter === "All" ? "/resources" : `/resources#${slug}`;
          window.history.replaceState(null, "", nextUrl);
        }
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          setActiveFilter(button.getAttribute("data-resource-filter") ?? "All");
          if (button instanceof HTMLElement) {
            button.scrollIntoView({
              behavior: reducedMotion ? "auto" : "smooth",
              block: "nearest",
              inline: "center",
            });
          }
        });
      });

      const initialSlug = window.location.hash.replace("#", "");
      const initialButton = buttons.find(
        (button) => button.getAttribute("data-resource-filter-slug") === initialSlug,
      );
      setActiveFilter(initialButton?.getAttribute("data-resource-filter") ?? "All", false);
      window.addEventListener("resize", () => {
        const activeButton = buttons.find((button) => button.getAttribute("aria-selected") === "true");
        moveIndicator(activeButton);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initResourceFilters, { once: true });
    } else {
      initResourceFilters();
    }
  </script>

  <style>
    .tk-res { --res-ink: #2b303b; --res-soft: #3d4350; --res-meta: #5b6070; --res-rule: #dcd9d1; }
    .tk-res__hero { padding-top: clamp(2.5rem, 6vw, 5.5rem); }
    .tk-res__head { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: clamp(2rem, 5vw, 5rem); align-items: end; }
    .tk-res__title { font-size: clamp(3rem, 6.2vw, 6.25rem); line-height: 0.98; letter-spacing: -0.058em; font-weight: 600; text-wrap: balance; max-width: 15ch; color: var(--charcoal); }
    .tk-res__lead { padding-bottom: 0.6rem; font-size: clamp(1.08rem, 1.3vw, 1.22rem); line-height: 1.6; color: var(--res-soft); max-width: 30rem; }

    .tk-res__tools { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-top: clamp(3rem, 6vw, 4.5rem); }
    .tk-res__tool { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: start; padding: clamp(1.5rem, 2.6vw, 2.25rem); border-radius: 28px; background: var(--off-white); color: var(--charcoal); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
    .tk-res__tool--blue { background: var(--key-blue-soft); }
    .tk-res__tool--navy { background: var(--navy); color: #fff; }
    .tk-res__tool:hover { transform: translateY(-3px); box-shadow: 0 30px 60px -44px rgba(35, 46, 102, 0.6); }
    .tk-res__tool-icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: #fff; color: var(--navy); }
    .tk-res__tool--navy .tk-res__tool-icon { background: var(--green); color: var(--navy); }
    .tk-res__tool-icon .v6-icon { width: 1.5rem; height: 1.5rem; }
    .tk-res__tool-h2 { font-size: clamp(1.3rem, 1.8vw, 1.6rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; }
    .tk-res__tool-copy { margin-top: 0.55rem; max-width: 30rem; line-height: 1.55; color: var(--res-ink); }
    .tk-res__tool--navy .tk-res__tool-copy { color: #dde3f1; }
    .tk-res__tool-go { margin-top: 0.6rem; min-height: 2.75rem; background-size: 100% 2px; }
    .tk-res__tool--navy .tk-res__tool-go { color: #fff; }

    .tk-res__lib { padding-block: clamp(5rem, 9vw, 8rem) clamp(2rem, 4vw, 3rem); }
    .tk-res__lib-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--charcoal); }
    .tk-res__lib-h2 { font-size: clamp(2.2rem, 4.2vw, 4rem); line-height: 1; letter-spacing: -0.05em; font-weight: 600; color: var(--charcoal); }
    .tk-res__count { flex: none; font-size: 0.95rem; font-weight: 500; color: var(--res-soft); font-variant-numeric: tabular-nums; }

    .tk-res__filters { margin-top: 1.5rem; }
    .tk-res__bar { position: relative; isolation: isolate; display: inline-flex; flex-wrap: wrap; gap: 0.35rem; padding: 0.35rem; border-radius: 999px; background: var(--off-white); max-width: 100%; }
    .tk-res__indicator { position: absolute; left: 0; top: 0; z-index: -1; border-radius: 999px; background: var(--navy); pointer-events: none; transition: transform 0.4s var(--ease), width 0.4s var(--ease), height 0.4s var(--ease); }
    .tk-res__chip { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0 1.15rem; border-radius: 999px; white-space: nowrap; font-size: 0.93rem; font-weight: 600; color: var(--res-ink); transition: color 0s; }
    .tk-res__chip:hover { color: var(--navy); }
    .resource-filter-bar [data-resource-filter][data-active] { color: #fff; }

    [data-resource-card] { transition: opacity 180ms ease, transform 260ms var(--ease); }
    .tk-res__featured-wrap { margin-top: clamp(2rem, 4vw, 3rem); }
    .tk-res__featured { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
    .tk-res__featured-media { position: relative; overflow: hidden; aspect-ratio: 16 / 10; border-radius: 32px; background: var(--off-white); }
    .tk-res__featured-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
    .tk-res__featured:hover .tk-res__featured-media img { transform: scale(1.04); }
    .tk-res__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 500; color: var(--res-meta); }
    .tk-res__tag { font-weight: 600; color: var(--navy); }
    .tk-res__featured-h2 { margin-top: 1rem; font-size: clamp(2rem, 3.4vw, 3.3rem); line-height: 1.04; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; color: var(--charcoal); }
    .tk-res__featured-dek { margin-top: 1.25rem; font-size: 1.12rem; line-height: 1.6; color: var(--res-soft); max-width: 30rem; }
    .tk-res__featured-go { margin-top: 1.75rem; }

    .tk-res__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2.75rem, 4vw, 3.75rem) clamp(1.25rem, 2.2vw, 2rem); margin-top: clamp(4rem, 7vw, 6rem); padding-top: clamp(2.5rem, 4vw, 3.5rem); border-top: 1px solid var(--res-rule); }
    .tk-res__card { display: grid; align-content: start; gap: 0.7rem; color: var(--charcoal); }
    .tk-res__card-media { aspect-ratio: 3 / 2; overflow: hidden; border-radius: 22px; background: var(--off-white); }
    .tk-res__card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
    .tk-res__card:hover .tk-res__card-media img { transform: scale(1.05); }
    .tk-res__card-meta { margin-top: 0.6rem; }
    .tk-res__card-h3 { font-size: clamp(1.3rem, 1.7vw, 1.55rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; text-wrap: balance; transition: color 0.3s; }
    .tk-res__card:hover .tk-res__card-h3 { color: var(--navy); }
    .tk-res__card-text { font-size: 1rem; line-height: 1.6; color: var(--res-soft); }
    .tk-res__card-go { justify-self: start; min-height: 2.75rem; background-size: 100% 2px; background-image: linear-gradient(var(--key-blue), var(--key-blue)); }
    .tk-res__card:hover .tk-res__card-go { background-image: linear-gradient(var(--navy), var(--navy)); }

    .tk-res__cta { padding-block: clamp(4rem, 8vw, 7rem); }
    .tk-res__cta-panel { display: grid; grid-template-columns: minmax(0, 1.25fr) auto; align-items: end; gap: clamp(2rem, 5vw, 5rem); padding: clamp(2.75rem, 5.5vw, 5rem); border-radius: 36px; background: var(--navy); color: #fff; }
    .tk-res__cta-title { max-width: 16ch; font-size: clamp(2.2rem, 4.2vw, 4rem); line-height: 1.02; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; color: #fff; }
    .tk-res__cta-text { margin-top: 1.4rem; max-width: 34rem; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.6; color: #dde3f1; }
    .tk-res__cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .tk-res__cta-actions .v6-btn { justify-content: center; }
    .tk-res__cta-actions .v6-btn--ghost { box-shadow: none; }

    @media (min-width: 1101px) {
      .tk-res__card:last-child:nth-child(3n+1) { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); grid-template-rows: 1fr auto auto auto auto 1fr; column-gap: clamp(2rem, 4vw, 4rem); row-gap: 0.7rem; }
      .tk-res__card:last-child:nth-child(3n+1) > * { grid-column: 2; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-meta { grid-row: 2; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-h3 { grid-row: 3; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-text { grid-row: 4; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-go { grid-row: 5; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-media { grid-column: 1; grid-row: 1 / -1; aspect-ratio: 16 / 9; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-meta { margin-top: 1rem; }
      .tk-res__card:last-child:nth-child(3n+1) .tk-res__card-h3 { font-size: clamp(1.8rem, 2.6vw, 2.6rem); line-height: 1.05; letter-spacing: -0.05em; }
    }
    @media (min-width: 901px) and (max-width: 1100px) {
      .tk-res__card:last-child:nth-child(odd) { grid-column: 1 / -1; }
      .tk-res__card:last-child:nth-child(odd) .tk-res__card-media { aspect-ratio: 16 / 9; }
    }
    @media (max-width: 1100px) {
      .tk-res__head { grid-template-columns: 1fr; align-items: start; gap: 1.5rem; }
      .tk-res__grid { grid-template-columns: 1fr 1fr; }
      .tk-res__featured { grid-template-columns: 1fr; gap: 1.5rem; }
      .tk-res__cta-panel { grid-template-columns: 1fr; align-items: start; }
      .tk-res__cta-actions { flex-direction: row; flex-wrap: wrap; }
    }
    @media (max-width: 900px) {
      .tk-res__hero { padding-top: 1.75rem; }
      .tk-res__title { font-size: clamp(2.5rem, 11vw, 3.5rem); }
      .tk-res__lead { padding-bottom: 0; font-size: 1.08rem; }
      .tk-res__tools { grid-template-columns: 1fr; margin-top: 2rem; gap: 0.6rem; }
      .tk-res__tool { gap: 1rem; border-radius: 22px; padding: 1.3rem 1.25rem; }
      .tk-res__tool-icon { width: 2.75rem; height: 2.75rem; }
      .tk-res__tool-icon .v6-icon { width: 1.25rem; height: 1.25rem; }
      .tk-res__tool-h2 { font-size: 1.2rem; }
      .tk-res__tool-copy { font-size: 0.98rem; }
      .tk-res__lib { padding-top: 3.75rem; }
      .tk-res__lib-head { padding-bottom: 1rem; }
      .tk-res__lib-h2 { font-size: clamp(2rem, 9vw, 2.6rem); }
      .tk-res__filters { margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); overflow-x: auto; scrollbar-width: none; }
      .tk-res__filters::-webkit-scrollbar { display: none; }
      .tk-res__bar { flex-wrap: nowrap; max-width: none; margin-right: var(--gutter); }
      .tk-res__featured-media { aspect-ratio: 4 / 3; border-radius: 22px; margin-inline: calc(var(--gutter) * -0.5); }
      .tk-res__featured-h2 { font-size: clamp(1.85rem, 8vw, 2.4rem); margin-top: 0.75rem; }
      .tk-res__featured-dek { font-size: 1.04rem; margin-top: 0.9rem; }
      .tk-res__featured-go { width: 100%; justify-content: center; margin-top: 1.25rem; }
      .tk-res__grid { grid-template-columns: 1fr; gap: 0; margin-top: 2.75rem; padding-top: 0; border-top: 2px solid var(--charcoal); }
      .tk-res__card { grid-template-columns: 6.5rem minmax(0, 1fr); grid-template-areas: "media meta" "media title" "text text" "go go"; column-gap: 1rem; row-gap: 0.4rem; padding-block: 1.5rem; border-bottom: 1px solid var(--res-rule); }
      .tk-res__card-media { grid-area: media; aspect-ratio: 1; border-radius: 16px; align-self: start; }
      .tk-res__card-meta { grid-area: meta; margin-top: 0; font-size: 0.84rem; }
      .tk-res__card-h3 { grid-area: title; font-size: 1.2rem; }
      .tk-res__card-text { grid-area: text; margin-top: 0.5rem; font-size: 0.98rem; }
      .tk-res__card-go { grid-area: go; }
      .tk-res__cta { padding-block: 3rem 3.5rem; }
      .tk-res__cta-panel { gap: 1.75rem; padding: 2.25rem 1.5rem 1.5rem; border-radius: 26px; margin-inline: calc(var(--gutter) * -0.5); }
