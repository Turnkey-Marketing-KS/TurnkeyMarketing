  }
  @media (prefers-reduced-motion: reduce) {
    .v6 *, .v6 *::before, .v6 *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
    .v6-marquee__track { animation: none; }
  }

  /* Homepage additions (content carried over from the previous homepage) */
  .tk-home__h1 { margin: 0; font: inherit; letter-spacing: inherit; line-height: inherit; }
  .tk-home__lead { margin-top: 1.5rem; max-width: 34rem; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.6; color: var(--muted); }
  .tk-home__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid var(--hairline); }
  .tk-home__stat-num { font-size: clamp(2.2rem, 3.4vw, 3.4rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; color: var(--navy); font-variant-numeric: tabular-nums; }
  .tk-home__stat-num.is-accent { color: var(--key-blue); }
  .tk-home__stat-label { margin: 0.7rem 0 0; font-size: 0.9rem; line-height: 1.45; color: var(--muted); }
  .tk-home__stat-link { display: flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--navy); text-decoration: underline; text-decoration-color: var(--green); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  .tk-home__hired { padding-block: var(--space); background: var(--navy); color: #fff; }
  .tk-home__hired-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .tk-home__hired-title { font-size: clamp(2.3rem, 4.2vw, 4.25rem); line-height: 1.02; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; }
  .tk-home__hired-title > span { display: block; }
  .tk-home__hired-accent { color: #79b8ea; }
  .tk-home__hired-copy { margin-block: 1.5rem 2.25rem; max-width: 32rem; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.6; color: #cdd3e6; }
  .tk-home__hired-media { aspect-ratio: 4 / 3; border-radius: 32px; overflow: hidden; background: #1b2452; }
  .tk-home__hired-media img { width: 100%; height: 100%; object-fit: cover; }

  .tk-home__intro { display: grid; gap: 1rem; max-width: 50rem; margin: 1.75rem auto 0; text-align: center; font-size: 1.05rem; line-height: 1.7; color: var(--muted); }
  .tk-home__intro a { font-weight: 600; color: var(--navy); text-decoration: underline; text-decoration-color: var(--green); text-decoration-thickness: 2px; text-underline-offset: 4px; transition: color 0.3s; }
  .tk-home__intro a:hover { color: var(--key-blue); }

  .v6-dt__name, .v6-dt__title, .v6-suite__name, .v6-svc__name { margin: 0; }
  .tk-home__dt-label { margin-bottom: 1.25rem; font-size: 0.85rem; font-weight: 600; color: #d6def0; }
  .tk-home__dt-copy { margin-top: 0.45rem; max-width: 17rem; font-size: 0.9rem; line-height: 1.5; color: #d6def0; }

  .tk-home__voices-note { display: flex; flex-wrap: wrap; align-items: center; gap: 0.1rem 1.1rem; margin-top: 1.25rem; font-size: 0.95rem; line-height: 1.5; color: var(--muted); }
  .tk-home__rating { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 600; color: var(--charcoal); text-decoration: underline; text-underline-offset: 4px; }
  .tk-home__rating .v6-stars { color: #f4b400; }
  .v6-reel--quote figcaption span { font-size: 0.8rem; }

  .v6-time__grid { grid-template-areas: "head card" "cta card"; row-gap: 2rem; }
  .tk-home__time-head { grid-area: head; align-self: end; }
  .v6-time__card { grid-area: card; }
  .tk-home__time-cta { grid-area: cta; align-self: start; }
  .v6-time__title { margin: 0; }
