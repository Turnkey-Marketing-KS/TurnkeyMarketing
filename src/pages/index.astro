// Odometer markup: digits roll through a full turn to their target.
const odometer = (value: string) =>
  value
    .split("")
    .map((ch, index) => {
      if (!/\d/.test(ch)) return `<span class="v6-odo__sym">${ch}</span>`;
      const strip = Array.from({ length: 20 }, (_, n) => `<span>${n % 10}</span>`).join("");
      return `<span class="v6-odo__col" style="--n:${10 + Number(ch)};--i:${index}"><span class="v6-odo__strip">${strip}</span></span>`;
    })
    .join("");

// Results scroll story. Same verified figures as the Results page.
