    .v6-step__node { width: 3rem; height: 3rem; }
    .v6-step__node .v6-icon { width: 1.3rem; height: 1.3rem; }
    .v6-suite { border-width: 4px; border-radius: 32px; padding: 0.4rem; }
    .v6-suite__list ul { grid-template-columns: 1fr; }
    .v6-dt__flow { grid-template-columns: 1fr; }
    .v6-dt__flow::before { left: 1.75rem; right: auto; top: 1.75rem; bottom: 1.75rem; width: 2px; height: auto; background: linear-gradient(180deg, rgba(255, 255, 255, 0.4), var(--green)); }
    .v6-dt__flow li { grid-template-columns: auto 1fr; align-items: center; column-gap: 1rem; }
    .v6-dt__row { margin-top: 0; }
    .v6-aud__row { grid-template-columns: minmax(0, 1fr) auto; }
    .v6-aud__line { grid-column: 1; grid-row: 2; }
    .v6-aud__go { grid-row: 1; grid-column: 2; }
    .v6-posts { display: flex; gap: 0.75rem; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .v6-posts::-webkit-scrollbar { display: none; }
    .v6-posts > li { flex: none; width: min(78vw, 19rem); scroll-snap-align: start; }
    .v6-post__media { border-radius: 22px; }
    .v6-post__title { font-size: 1.15rem; }
    /* Phones: tighter rhythm */
    .v6-hero__intro { padding-top: 6.25rem; }
    .v6-hero__lead { margin-top: 1.1rem; font-size: 1rem; }
    .v6-hero__actions { margin-top: 1.5rem; gap: 0.5rem 1.5rem; }
    .v6-hero__stage { margin-top: 2rem; }
    .v6-logos { padding-block: 3rem 1rem; gap: 1rem; }
    .v6-steps { gap: 2.75rem; padding-block: 0.5rem 1rem; }
    .v6-connect__grid { gap: 2.5rem; }
    .v6-step__copy { font-size: 1rem; }
    .v6-suite { margin-top: 2.25rem; }
    .v6-suite__lead { min-height: 0; }
    .v6-suite__content { padding: 1.75rem 1.5rem; }
    .v6-suite__list { padding: 1.25rem 0.5rem 0.75rem; }
    .v6-svc { padding: 0.9rem 0.75rem; gap: 0.85rem; }
    .v6-svc__icon, .v6-svc__icon .v6-icon { width: 2rem; height: 2rem; }
    .v6-svc__text { padding-right: 0; }
    .v6-dt { padding: 1.75rem 1.5rem; border-radius: 32px; }
    .v6-voices .v6-arrows { display: none; }
    .v6-rail { margin-top: 2rem; }
    .v6-time__card { border-radius: 30px; }
    .v6-aud__list { margin-top: 2rem; }
    .v6-posts { margin-top: 2rem; }
    .v6-link { min-height: 2.75rem; }
    .v6-header__logo { display: inline-flex; align-items: center; min-height: 2.75rem; }
