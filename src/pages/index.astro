    .tk-home__intro { margin-top: 1.25rem; text-align: left; font-size: 1rem; line-height: 1.65; }
    .v6-dt__flow li { align-items: start; }
    .tk-home__dt-body { padding-top: 0.2rem; }
    .v6-dt__flow { gap: 1.5rem; }
    .tk-home__dt-copy { max-width: none; }
