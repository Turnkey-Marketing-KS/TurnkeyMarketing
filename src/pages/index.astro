    .tk-home__stat { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; align-items: center; padding-block: 1rem; border-bottom: 1px solid var(--hairline); }
    .tk-home__stat-num { font-size: 2.4rem; }
    .tk-home__stat-label { margin-top: 0; }
    .tk-home__stat-link { min-height: 2.75rem; }
    .tk-home__hired-copy { font-size: 1rem; margin-block: 1.1rem 1.75rem; }
