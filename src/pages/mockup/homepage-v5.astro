  .v5-header__nav { display: flex; gap: 2.4rem; font-size: 0.95rem; font-weight: 500; }
  .v5-header__nav a { position: relative; padding-block: 0.4rem; opacity: 0.85; transition: opacity 0.3s; }
  .v5-header__nav a:hover { opacity: 1; }
  .v5-header__nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px; background: var(--grad); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease); }
  .v5-header__nav a:hover::after { transform: none; }
  .v5-header__end { display: flex; justify-content: flex-end; gap: 0.75rem; }
  .v5-burger { display: none; position: relative; width: 2.6rem; height: 2.6rem; border-radius: 999px; background: var(--green); }
  .v5-burger i { position: absolute; left: 50%; top: 50%; width: 15px; height: 1.5px; margin: -0.75px 0 0 -7.5px; background: var(--ink); transition: transform 0.45s var(--ease); }
  .v5-burger i:first-of-type { transform: translateY(-3px); }
  .v5-burger i:last-of-type { transform: translateY(3px); }
  .v5-burger[aria-expanded="true"] i:first-of-type { transform: rotate(45deg); }
  .v5-burger[aria-expanded="true"] i:last-of-type { transform: rotate(-45deg); }
  .v5-menu { position: fixed; inset: 0; z-index: 45; background: var(--ink); padding-top: 6.5rem; }
  .v5-menu__nav { display: grid; gap: 0.3rem; }
  .v5-menu__nav a:not(.v5-btn) { font-size: 2.4rem; font-weight: 600; letter-spacing: -0.045em; }
  .v5-menu__nav .v5-btn { margin-top: 1.75rem; justify-self: start; }

  /* Hero */
  .v5-hero { position: relative; height: 240vh; }
  .v5-hero__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .v5-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px); background-size: 88px 88px; mask-image: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 70%); }
  .v5-hero__intro { position: absolute; inset: 0 0 auto; margin-inline: auto; z-index: 3; padding-top: clamp(7.5rem, 16vh, 10rem); text-align: center; display: grid; justify-items: center; will-change: transform, opacity; }
  .v5-hero__title { font-size: clamp(3rem, 6.8vw, 7.5rem); line-height: 0.98; letter-spacing: -0.058em; font-weight: 600; }
  .v5-mask { display: block; overflow: hidden; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .v5-mask__in { display: block; transform: translateY(110%); transition: transform 1.2s var(--ease); transition-delay: calc(0.1s + var(--d, 0) * 0.1s); }
  .v5.is-loaded .v5-mask__in { transform: none; }
  .v5-hero__rotator { color: var(--green); padding-block: 0.1em 0.14em; margin-top: -0.06em; }
  .v5-rotator { display: grid; justify-items: center; }
  .v5-rotator__item { grid-area: 1 / 1; transform: translateY(130%); transition: transform 0.95s var(--ease); white-space: nowrap; }
  .v5-rotator__item.is-active { transform: none; }
  .v5-rotator__item.is-leaving { transform: translateY(-130%); }
  .v5-hero__lead { margin-top: 1.6rem; max-width: 34rem; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.55; color: var(--on-dark-muted); }
  .v5-hero__actions { display: flex; align-items: center; gap: 1.75rem; margin-top: 2.1rem; flex-wrap: wrap; justify-content: center; }
  [data-fade] { opacity: 0; transform: translateY(14px); transition: opacity 0.9s var(--ease), transform 1.1s var(--ease); transition-delay: calc(0.15s + var(--d, 0) * 0.1s); }
  .v5.is-loaded [data-fade] { opacity: 1; transform: none; }
  .v5-hero__stage { position: absolute; inset: 0; z-index: 1; overflow: hidden; clip-path: inset(68% 14% 0% 14% round 28px 28px 0 0); will-change: clip-path; }
  .v5-hero__stage img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; will-change: transform; }
  .v5-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 19, 49, 0) 45%, rgba(13, 19, 49, 0.75)); opacity: 0; }
  .v5-hero__caption { position: absolute; left: 0; right: 0; bottom: 9vh; font-size: clamp(2rem, 4.4vw, 4.4rem); font-weight: 600; letter-spacing: -0.048em; line-height: 1.02; opacity: 0; transform: translateY(24px); }
  .v5-hero__caption span { display: block; }
  .v5-hero__chip { position: absolute; z-index: 4; right: calc(14% - 1.5rem); top: calc(68% - 1.4rem); display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1.1rem; border-radius: 999px; background: #fff; color: var(--on-light-muted); font-size: 0.85rem; box-shadow: 0 20px 44px -22px rgba(0, 0, 0, 0.6); will-change: transform, opacity; }
  .v5-hero__chip strong { color: var(--ink); }

  /* Logos */
  .v5-logos { padding-block: clamp(4rem, 7vw, 6rem) clamp(2rem, 4vw, 3rem); }
  .v5-logos__label { text-align: center; font-size: 0.95rem; color: var(--on-dark-muted); padding-inline: var(--gutter); }
  .v5-marquee { margin-top: 2rem; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .v5-marquee__track { display: flex; align-items: center; gap: 0.9rem; width: max-content; animation: v5-marquee 80s linear infinite; }
  .v5-marquee img { height: 4.5rem; width: 9.5rem; object-fit: contain; padding: 0.75rem 1.1rem; border-radius: 18px; background: #fff; filter: grayscale(1); opacity: 0.88; transition: filter 0.4s, opacity 0.4s, transform 0.5s var(--ease); }
  .v5-marquee img:hover { filter: none; opacity: 1; transform: translateY(-3px); }
  .v5-marquee:hover .v5-marquee__track { animation-play-state: paused; }
  @keyframes v5-marquee { to { transform: translateX(-50%); } }

  /* Connect */
  .v5-connect { padding-block: var(--space) calc(var(--space) + 3rem); }
  .v5-connect__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .v5-connect__title { position: sticky; top: 8rem; }
  .v5-steps { position: relative; display: grid; gap: clamp(4rem, 9vw, 8rem); padding-block: 1rem 2rem; }
  .v5-steps__rail { position: absolute; left: 2rem; top: 2rem; bottom: 3rem; width: 2px; background: var(--line-dark); overflow: hidden; }
  .v5-steps__rail span { position: absolute; inset: 0; background: var(--grad-v); transform: scaleY(0); transform-origin: top; }
  .v5-step { position: relative; display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.75rem; align-items: start; opacity: 0.32; transition: opacity 0.6s var(--ease); }
  .v5-step.is-active { opacity: 1; }
  .v5-step__node { position: relative; z-index: 1; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 999px; background: var(--ink-2); color: #fff; box-shadow: 0 0 0 1px var(--line-dark); transition: background-color 0.5s, color 0.5s, box-shadow 0.5s; }
  .v5-step__node .v5-icon { width: 1.7rem; height: 1.7rem; }
  .v5-step.is-active .v5-step__node { background: var(--green); color: var(--ink); box-shadow: 0 0 0 8px rgba(147, 200, 69, 0.14); }
  .v5-step__title { font-size: clamp(1.6rem, 2.4vw, 2.3rem); letter-spacing: -0.045em; font-weight: 600; line-height: 1.05; margin-top: 0.7rem; }
  .v5-step__copy { margin-top: 0.8rem; max-width: 28rem; font-size: 1.05rem; line-height: 1.6; color: var(--on-dark-muted); }

  /* Services hub */
  .v5-services { padding-block: var(--space); }
  .v5-services .v5-h2 { max-width: 20ch; }
  .v5-hub { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; margin-top: clamp(3.5rem, 7vw, 6rem); }
  .v5-hub__lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .v5-hub__lines path { fill: none; stroke: rgba(35, 46, 102, 0.16); stroke-width: 1.5; transition: stroke 0.4s; }
  .v5-hub__lines path.is-hot { stroke: url(#v5-hub-grad); stroke-width: 2.5; }
  .v5-hub__lines path.is-flow { stroke-dasharray: 6 10; animation: v5-dash 1.2s linear infinite; }
  @keyframes v5-dash { to { stroke-dashoffset: -32; } }
  .v5-hub__col { position: relative; z-index: 1; display: grid; gap: 1.25rem; }
  .v5-node { display: flex; align-items: center; gap: 1rem; padding: 0.85rem 1.25rem 0.85rem 0.85rem; border-radius: 999px; background: #fff; box-shadow: 0 10px 30px -22px rgba(20, 22, 28, 0.45); transition: transform 0.5s var(--ease), background-color 0.4s, color 0.4s; }
  .v5-hub__col--right .v5-node { flex-direction: row; }
  .v5-node__icon { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 999px; background: var(--key-blue-soft); color: var(--navy); transition: background-color 0.4s, color 0.4s; }
  .v5-node__icon .v5-icon { width: 1.45rem; height: 1.45rem; }
  .v5-node__name { font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; }
  .v5-node:hover, .v5-node.is-hot { background: var(--navy); color: #fff; transform: scale(1.03); }
  .v5-node:hover .v5-node__icon, .v5-node.is-hot .v5-node__icon { background: var(--green); color: var(--ink); }
  .v5-hub__core { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; gap: 1rem; padding: clamp(2rem, 4vw, 3.25rem) clamp(1.5rem, 3vw, 2.5rem); border-radius: 40px; background: var(--navy); color: #fff; box-shadow: 0 40px 80px -40px rgba(35, 46, 102, 0.8); }
  .v5-hub__badge { display: grid; place-items: center; width: 4.25rem; height: 4.25rem; border-radius: 999px; background: var(--green); color: var(--ink); }
  .v5-hub__badge .v5-icon { width: 2rem; height: 2rem; }
  .v5-hub__name { font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; transition: opacity 0.25s; }
  .v5-hub__tagline { max-width: 22rem; line-height: 1.55; color: rgba(255, 255, 255, 0.72); min-height: 3.1em; transition: opacity 0.25s; }
  .v5-hub__core.is-swapping .v5-hub__name, .v5-hub__core.is-swapping .v5-hub__tagline { opacity: 0; }
  .v5-hub__note { margin-top: 0.5rem; font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); }
  .v5-dt { position: relative; display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 1.25rem; margin-top: clamp(3rem, 6vw, 5rem); padding: 1.35rem 1.35rem 1.35rem 1.75rem; border-radius: 999px; background: #fff; transition: background-color 0.5s var(--ease), color 0.5s; }
  .v5-dt:hover { background: var(--navy); color: #fff; }
  .v5-dt__new { padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--green); color: var(--ink); font-size: 0.75rem; font-weight: 700; }
  .v5-dt__name { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.03em; }
  .v5-dt__line { color: var(--on-light-muted); transition: color 0.5s; }
  .v5-dt:hover .v5-dt__line { color: rgba(255, 255, 255, 0.7); }
  .v5-dt__go { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: var(--navy); color: #fff; transition: transform 0.5s var(--ease), background-color 0.4s, color 0.4s; }
  .v5-dt:hover .v5-dt__go { background: var(--green); color: var(--ink); transform: rotate(45deg); }

  /* Results */
  .v5-results { padding-block: var(--space); }
  .v5-explorer { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 2fr); gap: clamp(1rem, 3vw, 3rem); margin-top: clamp(3rem, 6vw, 5rem); }
  .v5-explorer__tabs { display: grid; align-content: start; border-top: 1px solid var(--line-dark); }
  .v5-tab { position: relative; display: grid; gap: 0.2rem; padding: 1.25rem 0 1.4rem; text-align: left; color: var(--on-dark-muted); border-bottom: 1px solid var(--line-dark); transition: color 0.4s, padding 0.5s var(--ease); }
  .v5-tab:hover { color: #fff; }
  .v5-tab.is-active { color: #fff; padding-left: 1rem; }
