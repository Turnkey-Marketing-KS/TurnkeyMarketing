---
// Redesign mockup, version 5. Not linked, not in the sitemap, and noindex.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONSULTATION_URL, services } from "@/lib/services";
import { ownerTestimonials, videoTestimonials } from "@/lib/proof";
import { googleReviewSummary } from "@/lib/google-reviews";
import { resourcePosts } from "@/lib/resource-posts";
import { audiences } from "@/lib/audiences";

const phrases = [
  "that increases car count.",
  "that gets the phone ringing.",
  "that brings customers back.",
  "that proves what is working.",
  "that gets it off your plate.",
];

const navLinks = [
  { label: "Services", href: "/services" },
  { label: "Results", href: "/results" },
  { label: "Resources", href: "/resources" },
  { label: "About", href: "/about" },
];

// Two logos have solid backgrounds and cannot be shown as white marks.
const logoFiles = [
  "01-d-and-e-auto-repair", "02-super-service-of-aliso-viejo", "03-cdt-automotive",
  "04-fast-lane-automotive", "05-budd-and-company-automotive-mlk", "06-keeton-euro-repair",
  "07-ingolstadt-west", "08-chris-matthews-automotive", "09-japanese-car-care-east",
  "10-cherry-lane-auto-repair", "11-carfix-mast-dr", "12-pristal-s-automotive-inc",
  "13-boradori-automotive-marysville", "14-al-huss-auto-and-truck", "15-autoworks-of-tampa",
  "16-pit-shop-auto-repair-libertyville", "17-eurotech-car-care", "18-kay-jay-s-auto-repair",
  "19-koffman-autoworks", "20-pro-automotive-191-west-main-dudley", "21-keeton-auto-repair",
  "22-horizon-auto-center", "23-garage-guys-automotive-richmond",
  "24-choisser-automotive-services-of-davidsonville", "25-craftsman-auto-care",
  "26-apex-auto-and-rv-repair", "29-killian-auto-pros-greenville", "30-certified-auto-repair",
].map((file) => `/images/trust-logos/vip/${file}.webp`);

const iconSrc = (name: string) => `/images/icons/noun/${name}.svg`;

const steps = [
  { icon: "target", title: "Shop-specific strategy", copy: "We start with proven auto-repair formulas, then adjust the plan around your market, capacity, goals, and customer mix." },
  { icon: "weekly-planner", title: "Weekly execution", copy: "We don't just consult. We run the direct mail, ads, GBP, reviews, and CRM every week." },
  { icon: "report", title: "Honest reporting", copy: "See campaign spending, tracked calls, and reported revenue where the data connects them." },
];

const serviceIcons: Record<string, string> = {
  "marketing-consulting": "target",
  "direct-mail": "direct-mail",
  "social-media-marketing": "social-media-marketing",
  "retention-marketing": "retention",
  "digital-marketing": "internet",
  "boost-days": "boost",
};
const vip = services.find((service) => service.slug === "vip-marketing-manager")!;
const directTrack = services.find((service) => service.slug === "directtrack-marketing")!;
const included = services.filter((service) => serviceIcons[service.slug]);
const leftNodes = included.slice(0, 3);
const rightNodes = included.slice(3);

type Story = {
  shop: string;
  logo: string;
  logoDark?: boolean;
  tabStat: string;
  stat: string;
  statLabel: string;
  context: string;
  story: string;
  visual:
    | { kind: "bars"; before: { label: string; value: string; h: number }; after: { label: string; value: string; h: number } }
    | { kind: "locations"; items: string[] }
    | { kind: "multiplier" };
  quote?: { text: string; by: string };
};

const stories: Story[] = [
  {
    shop: "Legendary Automotive & Diesel Repair",
    logo: "/images/results/shop-logos/legendary-automotive-diesel-repair.png",
    tabStat: "+169% revenue",
    stat: "+169%",
    statLabel: "reported revenue",
    context: "Aug 2024 vs. June 2026",
    story: "Total cars served nearly tripled.",
    visual: { kind: "bars", before: { label: "Aug 2024", value: "$260,534", h: 37 }, after: { label: "June 2026", value: "$701,725", h: 100 } },
  },
  {
    shop: "Killian Auto Pros",
    logo: "/images/results/shop-logos/killian-auto-pros.png",
    tabStat: "1 shop became 4",
    stat: "1 → 4",
    statLabel: "locations",
    context: "Upstate South Carolina",
    story: "The growth funded a second, a third, and a fourth shop.",
    visual: { kind: "locations", items: ["Mauldin", "Greenville", "Fountain Inn", "Spartanburg"] },
    quote: { text: "We got to $300,000/month within one year at a brand new shop.", by: "Steve Killian" },
  },
  {
    shop: "Torque European",
    logo: "/images/results/shop-logos/torque-european.png",
    tabStat: "2× monthly revenue",
    stat: "2×",
    statLabel: "monthly revenue",
    context: "Since August 2025",
    story: "From about $110K a month to a consistent $220K to $230K.",
    visual: { kind: "bars", before: { label: "Before", value: "≈ $110K", h: 48 }, after: { label: "Now", value: "$220K+", h: 100 } },
  },
  {
    shop: "ASAP Auto Repair",
    logo: "/images/results/shop-logos/asap-auto-repair.png",
    logoDark: true,
    tabStat: "+60% monthly revenue",
    stat: "+60%",
    statLabel: "monthly revenue",
    context: "Oct 2024 vs. June 2026",
    story: "Car count grew from 240 to 340 a month.",
    visual: { kind: "bars", before: { label: "Oct 2024", value: "$125K", h: 62 }, after: { label: "June 2026", value: "$200K", h: 100 } },
    quote: { text: "They have absolutely perfected marketing for auto repair.", by: "Terrie Walters" },
  },
  {
    shop: "Pro Automotive",
    logo: "/images/results/shop-logos/pro-automotive-services.png",
    tabStat: "3.74× return on ads",
    stat: "3.74×",
    statLabel: "tracked revenue per ad dollar",
    context: "First full month",
    story: "Every $1 of advertising matched to $3.74 in tracked revenue.",
    visual: { kind: "multiplier" },
  },
];

const alone = {
  title: "The weight of success is all on you.",
  points: ["Every empty bay becomes your problem", "Every ad and design needs your attention", "Every vendor needs to be chased"],
};
const together = {
  title: "One team owns the whole strategy.",
  points: ["Shop-specific strategy", "Weekly execution", "Honest reporting"],
};

const rail = [
  { type: "video" as const, ...videoTestimonials[0] },
  { type: "quote" as const, ...ownerTestimonials[0] },
  { type: "video" as const, ...videoTestimonials[1] },
  { type: "video" as const, ...videoTestimonials[2] },
  { type: "quote" as const, ...ownerTestimonials[1] },
  { type: "video" as const, ...videoTestimonials[3] },
  { type: "video" as const, ...videoTestimonials[4] },
  { type: "video" as const, ...videoTestimonials[5] },
];

const audienceRows = audiences.map((audience) => ({
  href: `/who-we-help/${audience.slug}`,
  name: audience.name.charAt(0).toUpperCase() + audience.name.slice(1),
  line: audience.heroCopy.split(". ")[0] + ".",
}));

const insights = resourcePosts.slice(0, 3);
const faqs = [
  { q: "What does an auto repair marketing company actually do?", a: "An auto repair marketing company should connect the shop’s business goals to a practical plan, coordinate the people and vendors responsible for executing it, and measure whether the work creates the right calls, appointments, customers, and repair orders. Turnkey can provide focused services or function as the shop’s outsourced marketing department." },
  { q: "What is the best marketing strategy for an auto repair shop?", a: "The best strategy is a coordinated plan that matches your market, capacity, customer mix, and budget. For most shops, that means Google visibility, reviews, paid search, retention, direct mail, and reporting working together instead of as separate vendor tasks." },
  { q: "How do I get more customers for my auto repair shop?", a: "Start by deciding which customers and jobs you actually want more of. Then connect search, Google Business Profile, reviews, offers, follow-up, and call handling so demand turns into booked appointments." },
  { q: "How can my auto repair shop show up higher on Google Maps?", a: "Google Maps visibility usually improves when your profile, reviews, photos, location signals, website, and local relevance are stronger. No agency can guarantee rankings, but complete shop information, steady review activity, accurate listings, and useful local content give Google clearer trust signals." },
  { q: "How do I know if my auto repair marketing is actually working?", a: "Marketing is working when it creates the right calls, booked appointments, returning customers, and customer mix at a cost the shop can defend. The report should explain what to keep, what to fix, what to stop spending on, and what to run next." },
  { q: "How long does auto repair marketing take to work?", a: "Some cleanup and campaign fixes can show early signals quickly, but dependable growth usually takes months. A practical first 90-120 days should clarify budget, fix tracking, clean up vendors, launch priority campaigns, and set the next moves." },
];

const arrow = `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrowUp = `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const play = `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>`;
---

<BaseLayout
  title="Homepage Redesign Mockup v5 | Turnkey Marketing"
  description="Design mockup, version 5, for the Turnkey Marketing homepage redesign."
  path="/mockup/homepage-v5"
  noindex
  minimalChrome
>
  <div class="v5" data-v5>
    <header class="v5-header" data-header>
      <div class="v5-wrap v5-header__inner">
        <a href="/" class="v5-logo" aria-label="Turnkey Marketing home">
          <img class="v5-logo__onDark" src="/images/logos/Turnkey%20Marketing%20Logo%20-%20full%20color-dark%20background-01.png" alt="Turnkey Marketing" width="170" height="45" />
          <img class="v5-logo__onLight" src="/turnkey-marketing-logo-2026.webp" alt="" width="170" height="45" />
        </a>
        <nav class="v5-header__nav" aria-label="Primary">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <div class="v5-header__end">
          <a href={CONSULTATION_URL} class="v5-btn v5-btn--green v5-btn--sm"><span>Book a Strategy Call</span></a>
          <button type="button" class="v5-burger" data-menu-btn aria-expanded="false" aria-controls="v5-menu"><span class="v5-sr">Menu</span><i></i><i></i></button>
        </div>
      </div>
    </header>

    <div class="v5-menu" id="v5-menu" data-menu hidden>
      <nav class="v5-wrap v5-menu__nav" aria-label="Mobile">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="/contact">Contact</a>
        <a href={CONSULTATION_URL} class="v5-btn v5-btn--green"><span>Book a Strategy Call</span></a>
      </nav>
    </div>

    <main>
      <!-- HERO (dark) -->
      <section class="v5-hero v5-dark" data-hero data-theme-zone="dark">
        <div class="v5-hero__sticky">
          <div class="v5-hero__grid" aria-hidden="true"></div>
          <div class="v5-wrap v5-hero__intro" data-hero-intro>
            <h1 class="v5-hero__title">
              <span class="v5-sr">Auto repair marketing that increases car count.</span>
              <span aria-hidden="true">
                <span class="v5-mask"><span class="v5-mask__in" data-intro style="--d:0">Auto repair marketing</span></span>
                <span class="v5-mask v5-hero__rotator">
                  <span class="v5-mask__in v5-rotator" data-intro style="--d:1">
                    {phrases.map((phrase, index) => <span class:list={["v5-rotator__item", index === 0 && "is-active"]}>{phrase}</span>)}
                  </span>
                </span>
              </span>
            </h1>
            <p class="v5-hero__lead" data-fade style="--d:3">
              We plan your marketing, coordinate your vendors, and manage campaigns for your independent repair shop.
            </p>
            <div class="v5-hero__actions" data-fade style="--d:4">
              <a href={CONSULTATION_URL} class="v5-btn v5-btn--green v5-btn--lg"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
              <a href="/results" class="v5-link">See Shop Results <i set:html={arrow} /></a>
            </div>
          </div>

          <div class="v5-hero__stage" data-hero-stage>
            <img src="/site-media/pearson-auto-repair-shop.webp" alt="Pearson Auto Repair technician working in a service bay" width="1400" height="933" fetchpriority="high" data-hero-img />
            <div class="v5-hero__shade" data-hero-shade></div>
            <p class="v5-hero__caption" data-hero-caption><span class="v5-wrap">Serving 300+ independent shops since 2013.</span></p>
          </div>

          <div class="v5-hero__chip" data-hero-chip data-fade style="--d:6">
            <span class="v5-stars" aria-hidden="true">★★★★★</span>
            <span><strong>{googleReviewSummary.rating} on Google</strong> · {googleReviewSummary.count} reviews</span>
          </div>
        </div>
      </section>

      <!-- LOGOS (dark) -->
      <section class="v5-logos v5-dark" aria-label="Trusted by 300+ shops and industry-leading partners">
        <p class="v5-logos__label">Trusted by 300+ shops and industry-leading partners</p>
        <div class="v5-marquee">
          <div class="v5-marquee__track">
            {[...logoFiles, ...logoFiles].map((src, index) => (
              <img src={src} alt="" width="150" height="60" loading="lazy" decoding="async" aria-hidden={index >= logoFiles.length ? "true" : undefined} />
            ))}
          </div>
        </div>
      </section>

      <!-- CONNECT (dark) -->
      <section class="v5-connect v5-dark" data-connect>
        <div class="v5-wrap v5-connect__grid">
          <h2 class="v5-h2 v5-connect__title" data-rise>Auto repair marketing that connects strategy to <em>execution.</em></h2>
          <ol class="v5-steps" data-steps>
            <span class="v5-steps__rail" aria-hidden="true"><span data-steps-fill></span></span>
            {steps.map((step) => (
              <li class="v5-step" data-step>
                <span class="v5-step__node"><span class="v5-icon" style={`--icon:url(${iconSrc(step.icon)})`}></span></span>
                <div>
                  <h3 class="v5-step__title">{step.title}</h3>
                  <p class="v5-step__copy">{step.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- SERVICES (light sheet) -->
      <section class="v5-services v5-sheet" data-theme-zone="light">
        <div class="v5-wrap">
          <h2 class="v5-h2 v5-center" data-rise>Start with one service. Or get the whole <em>marketing department.</em></h2>

          <div class="v5-hub" data-hub data-rise>
            <svg class="v5-hub__lines" data-hub-lines aria-hidden="true"></svg>
            <ul class="v5-hub__col">
              {leftNodes.map((service) => (
                <li><a href={`/services/${service.slug}`} class="v5-node" data-node data-name={service.name} data-tagline={service.tagline} data-href={`/services/${service.slug}`}>
                  <span class="v5-node__icon"><span class="v5-icon" style={`--icon:url(${iconSrc(serviceIcons[service.slug])})`}></span></span>
                  <span class="v5-node__name">{service.name}</span>
                </a></li>
              ))}
            </ul>
            <div class="v5-hub__core" data-hub-core>
              <span class="v5-hub__badge"><span class="v5-icon" style={`--icon:url(${iconSrc("vip")})`}></span></span>
              <p class="v5-hub__name" data-hub-name>{vip.name}</p>
              <p class="v5-hub__tagline" data-hub-tagline>{vip.tagline}</p>
              <a href={`/services/${vip.slug}`} class="v5-btn v5-btn--green" data-hub-link><span data-hub-cta>See how VIP works</span><i set:html={arrow} /></a>
              <p class="v5-hub__note">All included with our VIP plan. Also available on their own.</p>
            </div>
            <ul class="v5-hub__col v5-hub__col--right">
              {rightNodes.map((service) => (
                <li><a href={`/services/${service.slug}`} class="v5-node" data-node data-name={service.name} data-tagline={service.tagline} data-href={`/services/${service.slug}`}>
                  <span class="v5-node__icon"><span class="v5-icon" style={`--icon:url(${iconSrc(serviceIcons[service.slug])})`}></span></span>
                  <span class="v5-node__name">{service.name}</span>
                </a></li>
              ))}
            </ul>
          </div>

          <a href={`/services/${directTrack.slug}`} class="v5-dt" data-rise>
            <span class="v5-dt__new">New</span>
            <span class="v5-dt__name">{directTrack.name}</span>
            <span class="v5-dt__line">{directTrack.tagline}</span>
            <span class="v5-dt__go" set:html={arrowUp} />
          </a>
        </div>
      </section>

      <!-- RESULTS (dark) -->
      <section class="v5-results v5-dark" data-theme-zone="dark">
        <div class="v5-wrap">
          <div class="v5-row-head">
            <h2 class="v5-h2" data-rise>Over $1 billion in revenue for <em>independent shops.</em></h2>
            <a href="/results" class="v5-link" data-rise>See every result <i set:html={arrow} /></a>
          </div>

          <div class="v5-explorer" data-explorer>
            <div class="v5-explorer__tabs" role="tablist" aria-label="Client results">
              {stories.map((story, index) => (
                <button type="button" role="tab" class:list={["v5-tab", index === 0 && "is-active"]} aria-selected={index === 0 ? "true" : "false"} data-tab={index}>
                  <span class="v5-tab__shop">{story.shop}</span>
                  <span class="v5-tab__stat">{story.tabStat}</span>
                  <span class="v5-tab__bar" aria-hidden="true"><span></span></span>
                </button>
              ))}
            </div>
            <div class="v5-explorer__stage">
              {stories.map((story, index) => (
                <article class:list={["v5-story", `v5-story--${story.visual.kind}`, index === 0 && "is-active"]} role="tabpanel" data-story={index}>
                  <div class="v5-story__numbers">
                    <span class:list={["v5-story__logo", story.logoDark && "v5-story__logo--dark"]}><img src={story.logo} alt={`${story.shop} logo`} loading="lazy" /></span>
                    <p class="v5-story__stat">{story.stat}</p>
                    <p class="v5-story__label">{story.statLabel} <span>· {story.context}</span></p>
                    <p class="v5-story__text">{story.story}</p>
                    {story.quote && <blockquote class="v5-story__quote">“{story.quote.text}”<cite>{story.quote.by}</cite></blockquote>}
                  </div>
                  <div class="v5-story__visual" aria-hidden="true">
                    {story.visual.kind === "bars" && (
                      <div class="v5-bars">
                        {[story.visual.before, story.visual.after].map((bar, i) => (
                          <div class:list={["v5-bar", i === 1 && "v5-bar--after"]} style={`--h:${bar.h}%`}>
                            <span class="v5-bar__value">{bar.value}</span>
                            <span class="v5-bar__fill"></span>
                            <span class="v5-bar__label">{bar.label}</span>
                          </div>
                        ))}
                      </div>
                    )}
                    {story.visual.kind === "locations" && (
                      <ol class="v5-locs">
                        {story.visual.items.map((name, i) => (
                          <li style={`--i:${i}`}>
                            <span class="v5-locs__pin"><span class="v5-icon" style={`--icon:url(${iconSrc("location")})`}></span></span>
                            <span class="v5-locs__name">{name}</span>
                          </li>
                        ))}
                      </ol>
                    )}
                    {story.visual.kind === "multiplier" && (
                      <div class="v5-multi">
                        <div class="v5-multi__col"><span class="v5-multi__coin">$1</span><span class="v5-multi__cap">Advertising</span></div>
                        <span class="v5-multi__arrow" set:html={arrow} />
                        <div class="v5-multi__col">
                          <span class="v5-multi__stack"><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i><i class="v5-multi__part" style="--i:3"></i></span>
                          <span class="v5-multi__cap">$3.74 revenue</span>
                        </div>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
          <p class="v5-fine">Client-specific examples. Results vary by shop, market, investment, and execution.</p>
        </div>
      </section>

      <!-- TIME (light sheet) -->
      <section class="v5-time v5-sheet" data-time data-theme-zone="light">
        <div class="v5-wrap v5-time__grid">
          <div>
            <h2 class="v5-h2" data-rise>What is your <em>time worth?</em></h2>
            <div class="v5-switch" role="tablist" aria-label="Compare" data-rise>
              <button type="button" role="tab" aria-selected="true" data-mode="alone">On your own</button>
              <button type="button" role="tab" aria-selected="false" data-mode="together">With Turnkey</button>
              <span class="v5-switch__thumb" aria-hidden="true"></span>
            </div>
          </div>
          <div class="v5-time__card" data-time-card data-rise>
            {[alone, together].map((state, index) => (
              <div class:list={["v5-time__state", index === 0 && "is-active"]} data-state={index === 0 ? "alone" : "together"}>
                <p class="v5-time__title">{state.title}</p>
                <ul class="v5-time__points">
                  {state.points.map((point) => <li><span class:list={["v5-mark", index === 0 ? "v5-mark--x" : "v5-mark--check"]} aria-hidden="true"></span>{point}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- VOICES (dark) -->
      <section class="v5-voices v5-dark" data-theme-zone="dark">
        <div class="v5-wrap v5-row-head">
          <h2 class="v5-h2" data-rise>Hear it from <em>shop owners.</em></h2>
          <div class="v5-voices__arrows" data-rise>
            <button type="button" data-rail-prev aria-label="Previous"><i set:html={arrow} /></button>
            <button type="button" data-rail-next aria-label="Next"><i set:html={arrow} /></button>
          </div>
        </div>
        <ul class="v5-rail" data-rail>
          {rail.map((item) => item.type === "video" ? (
            <li class="v5-reel">
              <button type="button" class="v5-reel__frame" data-video={item.videoSrc} aria-label={`Play ${item.name}'s testimonial`}>
                <img src={item.posterSrc} alt="" loading="lazy" decoding="async" />
                <video muted playsinline loop preload="none" data-preview={item.videoSrc}></video>
                <span class="v5-reel__play" set:html={play} />
                <span class="v5-reel__who"><strong>{item.name}</strong>{item.shop}</span>
              </button>
            </li>
          ) : (
            <li class="v5-reel v5-reel--quote">
              <figure>
                <blockquote>“{item.quote}”</blockquote>
                <figcaption><strong>{item.name}</strong>{item.shop}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>

      <!-- AUDIENCES + INSIGHTS + FAQ (light sheet) -->
      <section class="v5-lower v5-sheet" data-theme-zone="light">
        <div class="v5-wrap">
          <h2 class="v5-h2" data-rise>Bring in more of the work <em>your shop wants.</em></h2>
          <ul class="v5-aud">
            {audienceRows.map((row) => (
              <li data-rise>
                <a href={row.href} class="v5-aud__row">
                  <span class="v5-aud__name">{row.name}</span>
                  <span class="v5-aud__line">{row.line}</span>
                  <span class="v5-aud__go" set:html={arrowUp} />
                </a>
              </li>
            ))}
          </ul>

          <div class="v5-row-head v5-gap">
            <h2 class="v5-h2" data-rise>Latest insights</h2>
            <a href="/resources" class="v5-link v5-link--dark" data-rise>Explore all <i set:html={arrow} /></a>
          </div>
          <ul class="v5-posts">
            {insights.map((post) => (
              <li data-rise>
                <a href={post.href} class="v5-post">
                  <span class="v5-post__media"><img src={post.image.src} alt="" loading="lazy" decoding="async" /></span>
                  <span class="v5-post__tag">{post.tag}</span>
                  <span class="v5-post__title">{post.title}</span>
                </a>
              </li>
            ))}
          </ul>

          <div class="v5-faq v5-gap">
            <h2 class="v5-h2" data-rise>Frequently asked <em>questions</em></h2>
            <ul class="v5-acc">
              {faqs.map((item, index) => (
                <li class:list={["v5-acc__item", index === 0 && "is-open"]} data-acc-item>
                  <button type="button" class="v5-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head>
                    <span>{item.q}</span><span class="v5-acc__icon" aria-hidden="true"></span>
                  </button>
                  <div class="v5-acc__panel"><div><p>{item.a}</p></div></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- CTA (green sheet) -->
      <section class="v5-cta v5-sheet v5-sheet--green" data-theme-zone="light">
        <div class="v5-wrap v5-cta__grid">
          <div>
            <h2 class="v5-cta__title" data-rise>Stop carrying the marketing burden.</h2>
            <p class="v5-cta__text" data-rise>30 minutes with our team. No pitch deck. Just a real conversation.</p>
            <div class="v5-cta__actions" data-rise>
              <a href={CONSULTATION_URL} class="v5-btn v5-btn--ink v5-btn--lg"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
              <a href="tel:+19134270674" class="v5-cta__phone">(913) 427-0674</a>
            </div>
          </div>
          <figure class="v5-cta__media" data-rise>
            <img src="/site-media/team-turnkey-2025.webp" alt="The Turnkey Marketing team under the message We'll take it from here" width="1400" height="933" loading="lazy" decoding="async" />
          </figure>
        </div>
      </section>
    </main>

    <footer class="v5-footer v5-dark" data-theme-zone="dark">
      <div class="v5-wrap">
        <p class="v5-footer__tag"><span>More calls.</span> <span>More cars.</span> <em>More revenue.</em></p>
        <div class="v5-footer__cols">
          <img src="/images/logos/Turnkey%20Marketing%20Logo%20-%20full%20color-dark%20background-01.png" alt="Turnkey Marketing" width="150" height="40" loading="lazy" />
          <nav aria-label="Footer">{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}<a href="/contact">Contact</a></nav>
          <nav aria-label="Services">{services.slice(0, 5).map((service) => <a href={`/services/${service.slug}`}>{service.name}</a>)}</nav>
          <div>
            <a href="tel:+19134270674">(913) 427-0674</a>
            <a href="mailto:hello@turnkeyautomarketing.com">hello@turnkeyautomarketing.com</a>
            <span>Overland Park, KS</span>
          </div>
        </div>
        <div class="v5-footer__base">
          <p>© {new Date().getFullYear()} Turnkey Marketing</p>
          <p><a href="/privacy-policy">Privacy</a> · <a href="/terms-of-service">Terms</a></p>
        </div>
      </div>
    </footer>

    <dialog class="v5-lightbox" data-lightbox>
      <button type="button" class="v5-lightbox__close" data-lightbox-close>Close</button>
      <video controls playsinline preload="none" data-lightbox-video></video>
    </dialog>
  </div>
</BaseLayout>

<style is:global>
  .v5 {
    --ink: #0d1331;
    --ink-2: #151d45;
    --paper: #f4f2ed;
    --gutter: clamp(1.25rem, 3.2vw, 3rem);
    --max: 1400px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --space: clamp(5rem, 9.5vw, 9.5rem);
    --grad: linear-gradient(90deg, var(--key-blue), var(--green));
    --grad-v: linear-gradient(180deg, var(--key-blue), var(--green));
    --on-dark-muted: rgba(255, 255, 255, 0.62);
    --on-light-muted: #5b6070;
    --line-dark: rgba(255, 255, 255, 0.12);
    background: var(--ink);
    color: #fff;
  }
  .v5-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .v5-wrap { width: 100%; max-width: calc(var(--max) + var(--gutter) * 2); margin-inline: auto; padding-inline: var(--gutter); }
  .v5-dark { background: var(--ink); color: #fff; }
  .v5-sheet { margin-top: -3rem; border-radius: 48px 48px 0 0; background: var(--paper); color: var(--charcoal); }
  .v5-sheet + .v5-dark { margin-top: -3rem; padding-top: calc(var(--space) + 3rem) !important; border-radius: 48px 48px 0 0; }
  .v5-sheet--green { background: var(--green); }
  .v5 main > section { position: relative; }
  .v5 main > section:nth-child(1) { z-index: 1; }
  .v5 main > section:nth-child(2) { z-index: 2; }
  .v5 main > section:nth-child(3) { z-index: 3; }
  .v5 main > section:nth-child(4) { z-index: 4; }
  .v5 main > section:nth-child(5) { z-index: 5; }
  .v5 main > section:nth-child(6) { z-index: 6; }
  .v5 main > section:nth-child(7) { z-index: 7; }
  .v5 main > section:nth-child(8) { z-index: 8; }
  .v5 main > section:nth-child(9) { z-index: 9; }
  .v5 main > section:nth-child(10) { z-index: 10; }
  .v5 main > section:nth-child(11) { z-index: 11; }
  .v5-center { text-align: center; margin-inline: auto; }
  .v5-gap { margin-top: var(--space); }
  .v5-h2 { font-size: clamp(2.3rem, 4.8vw, 4.75rem); line-height: 1.02; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; max-width: 18ch; }
  .v5-h2 em { font-style: normal; color: var(--green); }
  .v5-sheet .v5-h2 em { color: var(--key-blue); }
  .v5-row-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; }
  .v5-stars { color: #f5a623; letter-spacing: 0.06em; }
  .v5-fine { margin-top: 2rem; font-size: 0.8rem; color: var(--on-dark-muted); opacity: 0.8; }
  .v5-icon { display: inline-block; width: 100%; height: 100%; background: currentColor; -webkit-mask: var(--icon) center / contain no-repeat; mask: var(--icon) center / contain no-repeat; }

  /* Buttons */
  .v5-btn { position: relative; display: inline-flex; align-items: center; gap: 0.75rem; min-height: 3rem; padding: 0 1.5rem; border-radius: 999px; font-weight: 600; font-size: 0.95rem; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), background-color 0.4s; }
  .v5-btn:hover { transform: translateY(-2px); }
  .v5-btn i { display: inline-grid; transition: transform 0.5s var(--ease); }
  .v5-btn:hover i { transform: translateX(3px); }
  .v5-btn--sm { min-height: 2.6rem; padding: 0 1.2rem; font-size: 0.875rem; }
