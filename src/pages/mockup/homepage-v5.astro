    requestAnimationFrame(() => setTimeout(() => root.classList.add("is-loaded"), 60));

    // Rotating headline
    const rotatorItems = Array.from(root.querySelectorAll<HTMLElement>(".v5-rotator__item"));
    if (rotatorItems.length > 1 && !reduceMotion) {
      let index = 0;
      setInterval(() => {
        const current = rotatorItems[index];
        index = (index + 1) % rotatorItems.length;
        current.classList.replace("is-active", "is-leaving");
        rotatorItems[index].classList.remove("is-leaving");
        rotatorItems[index].classList.add("is-active");
        setTimeout(() => current.classList.remove("is-leaving"), 1000);
      }, 2800);
    }

    // Menu
    const menu = root.querySelector<HTMLElement>("[data-menu]");
    const menuBtn = root.querySelector<HTMLButtonElement>("[data-menu-btn]");
    menuBtn?.addEventListener("click", () => {
      if (!menu) return;
      const open = menu.hidden;
      menu.hidden = !open;
      menuBtn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    });

    // Reveals
    const io = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        io.unobserve(entry.target);
      }),
      { rootMargin: "0px 0px -10% 0px" },
    );
    root.querySelectorAll("[data-rise]").forEach((el) => io.observe(el));

    // Scroll: hero, header theme, steps
    const header = root.querySelector<HTMLElement>("[data-header]");
    const hero = root.querySelector<HTMLElement>("[data-hero]");
    const intro = root.querySelector<HTMLElement>("[data-hero-intro]");
    const stage = root.querySelector<HTMLElement>("[data-hero-stage]");
    const heroImg = root.querySelector<HTMLImageElement>("[data-hero-img]");
    const shade = root.querySelector<HTMLElement>("[data-hero-shade]");
    const caption = root.querySelector<HTMLElement>("[data-hero-caption]");
    const chip = root.querySelector<HTMLElement>("[data-hero-chip]");
    const stepsEl = root.querySelector<HTMLElement>("[data-steps]");
    const stepsFill = root.querySelector<HTMLElement>("[data-steps-fill]");
    const stepItems = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const zones = Array.from(root.querySelectorAll<HTMLElement>("[data-theme-zone]"));

    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const vw = window.innerWidth;
      const y = window.scrollY;

      let zone = "dark";
      for (const el of zones) {
        const r = el.getBoundingClientRect();
        if (r.top <= 40 && r.bottom > 40) zone = el.dataset.themeZone ?? "dark";
      }
      header?.classList.toggle("is-light", zone === "light");
      header?.classList.toggle("is-scrolled", y > 10 && zone !== "light");

      let hidden = false;
      if (hero && stage && heroImg && intro && desktop.matches && !reduceMotion) {
        const rect = hero.getBoundingClientRect();
        const p = clamp(-rect.top / (rect.height - vh));
        const e = 1 - Math.pow(1 - p, 3);
        const start = { top: 68, side: 14 };
        const r = lerp(28, 0, e);
        stage.style.clipPath = `inset(${lerp(start.top, 0, e)}% ${lerp(start.side, 0, e)}% 0% ${lerp(start.side, 0, e)}% round ${r}px ${r}px 0 0)`;
        const ratio = (heroImg.naturalWidth || 1400) / (heroImg.naturalHeight || 933);
        const coverW = Math.max(vw, vh * ratio);
        const coverH = coverW / ratio;
        const faceX = (vw - coverW) / 2 + coverW * 0.57;
        const faceY = (vh - coverH) * 0.3 + coverH * 0.26;
        const winY = vh * (start.top + (100 - start.top) / 2) / 100;
        heroImg.style.transform = `translate3d(${(vw / 2 - faceX) * (1 - e)}px, ${(winY - faceY) * (1 - e)}px, 0) scale(${lerp(1.12, 1, e)})`;
        intro.style.transform = `translate3d(0, ${-e * 30}vh, 0)`;
        intro.style.opacity = String(clamp(1 - p * 4));
        if (chip) {
          chip.style.transform = `translate3d(${e * 120}px, ${-e * 60}px, 0)`;
          chip.style.opacity = String(clamp(1 - p * 5));
        }
        if (shade) shade.style.opacity = String(clamp((p - 0.5) / 0.35));
        if (caption) {
          const c = clamp((p - 0.62) / 0.3);
          caption.style.opacity = String(c);
          caption.style.transform = `translateY(${(1 - c) * 24}px)`;
        }
        hidden = p > 0.3 && p < 1;
      }
      header?.classList.toggle("is-hidden", hidden);

      if (stepsEl && stepsFill) {
        const rect = stepsEl.getBoundingClientRect();
        stepsFill.style.transform = `scaleY(${reduceMotion ? 1 : clamp((vh * 0.6 - rect.top) / rect.height)})`;
        stepItems.forEach((item) => item.classList.toggle("is-active", reduceMotion || item.getBoundingClientRect().top < vh * 0.62));
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => { onScroll(); drawHub(); });
    heroImg?.addEventListener("load", onScroll);

    // Services hub lines and hover swap
    const hub = root.querySelector<HTMLElement>("[data-hub]");
    const svg = root.querySelector<SVGSVGElement>("[data-hub-lines]");
    const core = root.querySelector<HTMLElement>("[data-hub-core]");
    const nodes = Array.from(root.querySelectorAll<HTMLElement>("[data-node]"));
    const hubName = root.querySelector<HTMLElement>("[data-hub-name]");
    const hubTagline = root.querySelector<HTMLElement>("[data-hub-tagline]");
    const hubLink = root.querySelector<HTMLAnchorElement>("[data-hub-link]");
    const hubCta = root.querySelector<HTMLElement>("[data-hub-cta]");
    const defaults = { name: hubName?.textContent ?? "", tagline: hubTagline?.textContent ?? "", href: hubLink?.getAttribute("href") ?? "", cta: hubCta?.textContent ?? "" };
    const paths: SVGPathElement[] = [];
    function drawHub() {
      if (!hub || !svg || !core || !desktop.matches) return;
      const box = hub.getBoundingClientRect();
      const c = core.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      svg.innerHTML = `<defs><linearGradient id="v5-hub-grad" x1="0" x2="1"><stop offset="0" stop-color="#3F8CCB"/><stop offset="1" stop-color="#93C845"/></linearGradient></defs>`;
      paths.length = 0;
      nodes.forEach((node) => {
        const n = node.getBoundingClientRect();
        const left = n.left < c.left;
        const x1 = (left ? n.right : n.left) - box.left;
        const y1 = n.top + n.height / 2 - box.top;
        const x2 = (left ? c.left + 1 : c.right - 1) - box.left;
        const y2 = c.top + c.height / 2 - box.top;
        const mid = (x1 + x2) / 2;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", `M${x1},${y1} C${mid},${y1} ${mid},${y2} ${x2},${y2}`);
        svg.appendChild(path);
        paths.push(path);
      });
    }
    const swap = (name: string, tagline: string, href: string, cta: string) => {
      if (!core || !hubName || !hubTagline || !hubLink || !hubCta) return;
      core.classList.add("is-swapping");
      setTimeout(() => {
        hubName.textContent = name;
        hubTagline.textContent = tagline;
        hubLink.setAttribute("href", href);
        hubCta.textContent = cta;
        core.classList.remove("is-swapping");
      }, 180);
    };
    nodes.forEach((node, i) => {
      node.addEventListener("mouseenter", () => {
        nodes.forEach((other) => other.classList.toggle("is-hot", other === node));
        paths.forEach((path, j) => { path.classList.toggle("is-hot", j === i); path.classList.toggle("is-flow", j === i && !reduceMotion); });
        swap(node.dataset.name ?? "", node.dataset.tagline ?? "", node.dataset.href ?? "", `Explore ${node.dataset.name}`);
      });
    });
    hub?.addEventListener("mouseleave", () => {
      nodes.forEach((node) => node.classList.remove("is-hot"));
      paths.forEach((path) => path.classList.remove("is-hot", "is-flow"));
      swap(defaults.name, defaults.tagline, defaults.href, defaults.cta);
    });
    drawHub();
    window.addEventListener("load", drawHub);

    // Results explorer
    const explorer = root.querySelector<HTMLElement>("[data-explorer]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const storyEls = Array.from(root.querySelectorAll<HTMLElement>("[data-story]"));
    const duration = 7000;
    let current = 0;
    let timer = 0;
    const show = (index: number, auto: boolean) => {
      current = index;
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === index);
        tab.classList.remove("is-running");
        tab.setAttribute("aria-selected", String(i === index));
      });
      storyEls.forEach((story, i) => story.classList.toggle("is-active", i === index));
      clearTimeout(timer);
      if (auto && !reduceMotion) {
        void tabs[index].offsetWidth;
        tabs[index].style.setProperty("--dur", `${duration}ms`);
        tabs[index].classList.add("is-running");
        timer = window.setTimeout(() => show((current + 1) % tabs.length, true), duration);
      }
    };
    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i, false)));
    if (explorer) {
      storyEls.forEach((story) => story.classList.remove("is-active"));
      const exIO = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        exIO.disconnect();
        show(0, true);
      }, { threshold: 0.35 });
      exIO.observe(explorer);
    }

    // Time switch
    const timeSection = root.querySelector<HTMLElement>("[data-time]");
    const timeCard = root.querySelector<HTMLElement>("[data-time-card]");
    const switchEl = timeSection?.querySelector<HTMLElement>(".v5-switch");
    timeSection?.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.mode;
        timeSection.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => b.setAttribute("aria-selected", String(b === button)));
        timeSection.querySelectorAll<HTMLElement>("[data-state]").forEach((state) => state.classList.toggle("is-active", state.dataset.state === mode));
        switchEl?.classList.toggle("is-together", mode === "together");
        timeCard?.classList.toggle("is-together", mode === "together");
      });
    });

    // Rail
    const rail = root.querySelector<HTMLElement>("[data-rail]");
    const railStep = () => (rail?.querySelector<HTMLElement>(".v5-reel")?.offsetWidth ?? 280) + 16;
    root.querySelector("[data-rail-prev]")?.addEventListener("click", () => rail?.scrollBy({ left: -railStep() * 2, behavior: "smooth" }));
    root.querySelector("[data-rail-next]")?.addEventListener("click", () => rail?.scrollBy({ left: railStep() * 2, behavior: "smooth" }));
    if (finePointer && !reduceMotion) {
      root.querySelectorAll<HTMLElement>(".v5-reel__frame").forEach((frame) => {
        const video = frame.querySelector<HTMLVideoElement>("video");
        if (!video) return;
        let hoverTimer = 0;
        frame.addEventListener("mouseenter", () => {
          hoverTimer = window.setTimeout(() => {
            if (!video.src) video.src = video.dataset.preview ?? "";
            video.play().then(() => frame.classList.add("is-previewing")).catch(() => {});
          }, 250);
        });
        frame.addEventListener("mouseleave", () => {
          clearTimeout(hoverTimer);
          frame.classList.remove("is-previewing");
          video.pause();
        });
      });
    }

    // FAQ
    root.querySelectorAll<HTMLElement>("[data-acc-item]").forEach((item) => {
      item.querySelector("[data-acc-head]")?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        item.classList.toggle("is-open", open);
        item.querySelector("[data-acc-head]")?.setAttribute("aria-expanded", String(open));
      });
    });

    // Lightbox
    const lightbox = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const lightboxVideo = root.querySelector<HTMLVideoElement>("[data-lightbox-video]");
    root.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!lightbox || !lightboxVideo) return;
        button.querySelector("video")?.pause();
        lightboxVideo.src = button.dataset.video ?? "";
        lightbox.showModal();
        lightboxVideo.play().catch(() => {});
      });
    });
    const close = () => {
      lightboxVideo?.pause();
      lightboxVideo?.removeAttribute("src");
      lightboxVideo?.load();
      if (lightbox?.open) lightbox.close();
    };
    root.querySelector("[data-lightbox-close]")?.addEventListener("click", close);
    lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) close(); });
    lightbox?.addEventListener("close", () => lightboxVideo?.pause());
  }
</script>
