  /* Header */
  .v5-header { position: fixed; inset: 0 0 auto; z-index: 50; padding-top: env(safe-area-inset-top, 0px); color: #fff; transition: background-color 0.5s, color 0.5s, transform 0.6s var(--ease), box-shadow 0.5s; }
  .v5-header.is-scrolled { background: rgba(13, 19, 49, 0.92); backdrop-filter: blur(12px); }
  .v5-header.is-light { background: rgba(244, 242, 237, 0.94); color: var(--charcoal); box-shadow: 0 1px 0 rgba(20, 22, 28, 0.08); }
  .v5-header.is-hidden { transform: translateY(-105%); }
  .v5-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 4.75rem; }
  .v5-logo img { height: 2.25rem; width: auto; }
  .v5-logo__onLight { display: none; }
