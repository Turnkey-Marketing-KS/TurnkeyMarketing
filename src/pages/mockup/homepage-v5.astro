  .v5-btn--ink { background: var(--ink); color: #fff; }
  .v5-link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat; padding-block: 0.3rem; transition: background-size 0.5s var(--ease); }
