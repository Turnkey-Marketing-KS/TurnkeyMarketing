</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-v2]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const desktop = window.matchMedia("(min-width: 901px)");

  if (root) {
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));

    // Intro
    const reveal = () => root.classList.add("is-loaded");
    requestAnimationFrame(() => setTimeout(reveal, 80));

    // Header and menu
    const header = root.querySelector<HTMLElement>("[data-header]");
    const menu = root.querySelector<HTMLElement>("[data-menu]");
    const menuBtn = root.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const menuLabel = root.querySelector<HTMLElement>("[data-menu-label]");
    let menuOpen = false;
    menuBtn?.addEventListener("click", () => {
      if (!menu) return;
      menuOpen = !menuOpen;
      menuBtn.setAttribute("aria-expanded", String(menuOpen));
      if (menuLabel) menuLabel.textContent = menuOpen ? "Close" : "Menu";
      header?.classList.toggle("is-menu", menuOpen);
      document.body.style.overflow = menuOpen ? "hidden" : "";
      if (menuOpen) {
        menu.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add("is-open")));
      } else {
        menu.classList.remove("is-open");
        setTimeout(() => { if (!menuOpen) menu.hidden = true; }, 900);
      }
    });

    // Reveals
    const io = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        io.unobserve(entry.target);
      }),
      { rootMargin: "0px 0px -10% 0px" },
    );
    root.querySelectorAll("[data-rise], [data-lines]").forEach((el) => io.observe(el));

    // Theme follows the section in the middle of the screen; header follows the section under it
    const sections = Array.from(root.querySelectorAll<HTMLElement>("[data-section-theme]"));
    const themeAt = (y: number) => {
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= y && rect.bottom > y) return section.dataset.sectionTheme ?? "dark";
      }
      return null;
    };

    // Hero
    const hero = root.querySelector<HTMLElement>("[data-hero]");
    const heroTitle = root.querySelector<HTMLElement>("[data-hero-title]");
    const heroWindow = root.querySelector<HTMLElement>("[data-hero-window]");
    const heroImg = root.querySelector<HTMLElement>("[data-hero-img]");
    const heroOverlay = root.querySelector<HTMLElement>("[data-hero-overlay]");
    const heroFoot = root.querySelector<HTMLElement>("[data-hero-foot]");

    // Parallax
    const parallax = Array.from(root.querySelectorAll<HTMLElement>("[data-parallax]"));

    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const y = window.scrollY;

      const theme = themeAt(vh * 0.5);
      if (theme && root.dataset.theme !== theme) root.dataset.theme = theme;
      const headerTheme = themeAt(40);
      header?.classList.toggle("is-light", headerTheme === "light" || headerTheme === "green");
      header?.classList.toggle("is-hidden", !menuOpen && y > vh * 2.6 && y > lastY + 2);
      if (y < lastY - 2) header?.classList.remove("is-hidden");
      const heroBottom = hero ? hero.getBoundingClientRect().bottom : 0;
      header?.classList.toggle("is-solid", heroBottom < 80);
      lastY = y;

      if (hero && heroWindow && heroImg && heroTitle && desktop.matches && !reduceMotion) {
        const rect = hero.getBoundingClientRect();
        const p = clamp(-rect.top / (rect.height - vh));
        const e = 1 - Math.pow(1 - p, 3);
        const vw = window.innerWidth;
        const padPct = (parseFloat(getComputedStyle(root).getPropertyValue("--pad-px")) || vw * 0.034) / vw * 100;
        const start = { top: 16, right: padPct, bottom: 42, left: 60 };
        const top = lerp(start.top, 0, e);
        const right = lerp(start.right, 0, e);
        const bottom = lerp(start.bottom, 0, e);
        const left = lerp(start.left, 0, e);
        const radius = lerp(16, 0, e);
        heroWindow.style.clipPath = `inset(${top}% ${right}% ${bottom}% ${left}% round ${radius}px)`;
        // Start with the technician's face centered in the small window, then settle to the full frame
        const img = heroImg as HTMLImageElement;
        const ratio = (img.naturalWidth || 1400) / (img.naturalHeight || 933);
        const coverW = Math.max(vw, vh * ratio);
        const coverH = coverW / ratio;
        const offsetY = (vh - coverH) * 0.3;
        const faceX = (vw - coverW) / 2 + coverW * 0.57;
        const faceY = offsetY + coverH * 0.24;
        const winX = vw * (start.left + (100 - start.left - start.right) / 2) / 100;
        const winY = vh * (start.top + (100 - start.top - start.bottom) / 2) / 100;
        const tx = (winX - faceX) * (1 - e);
        const ty = (winY - faceY) * (1 - e);
        heroImg.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${lerp(1.18, 1, e)})`;
        heroTitle.style.transform = `translate3d(0, ${-e * 18}vh, 0)`;
        heroTitle.style.opacity = String(clamp(1 - p * 2.2));
        if (heroFoot) heroFoot.style.opacity = String(clamp(1 - p * 4));
        if (heroOverlay) heroOverlay.style.opacity = String(clamp((p - 0.62) / 0.3));
      }

      if (!reduceMotion) {
        parallax.forEach((el) => {
          const wrap = el.parentElement;
          if (!wrap) return;
          const rect = wrap.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > vh) return;
          const progress = (rect.top + rect.height / 2 - vh / 2) / vh;
          el.style.transform = `translate3d(0, ${progress * -8}%, 0)`;
        });
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    // Accordion: hover opens on desktop, click everywhere
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-acc-item]"));
    const openItem = (item: HTMLElement) => {
      items.forEach((other) => {
        const open = other === item;
        other.classList.toggle("is-open", open);
        other.querySelector("[data-acc-head]")?.setAttribute("aria-expanded", String(open));
      });
    };
    items.forEach((item) => {
      const head = item.querySelector<HTMLElement>("[data-acc-head]");
      head?.addEventListener("click", () => openItem(item));
      if (finePointer) {
        let timer = 0;
        head?.addEventListener("mouseenter", () => { timer = window.setTimeout(() => openItem(item), 140); });
        head?.addEventListener("mouseleave", () => clearTimeout(timer));
      }
    });

    // Cursor
    const cursor = root.querySelector<HTMLElement>("[data-cursor]");
    const cursorLabel = root.querySelector<HTMLElement>("[data-cursor-label]");
    if (cursor && finePointer && !reduceMotion) {
      let x = -100, y = -100, cx = -100, cy = -100;
      window.addEventListener("pointermove", (event) => {
        x = event.clientX;
        y = event.clientY;
        cursor.classList.add("is-ready");
      });
      const loop = () => {
        cx += (x - cx) * 0.2;
        cy += (y - cy) * 0.2;
        cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
      root.querySelectorAll<HTMLElement>("[data-cursor-text]").forEach((el) => {
        el.addEventListener("mouseenter", () => {
          if (cursorLabel) cursorLabel.textContent = el.dataset.cursorText ?? "";
          cursor.classList.add("is-label");
        });
        el.addEventListener("mouseleave", () => cursor.classList.remove("is-label"));
      });
    }

    // Magnetic orb
    if (finePointer && !reduceMotion) {
      root.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
        el.addEventListener("mousemove", (event) => {
          const rect = el.getBoundingClientRect();
          const dx = event.clientX - (rect.left + rect.width / 2);
          const dy = event.clientY - (rect.top + rect.height / 2);
          el.style.transform = `translate(${dx * 0.25}px, ${dy * 0.25}px)`;
        });
        el.addEventListener("mouseleave", () => { el.style.transform = ""; });
      });
    }

    // Video lightbox
    const lightbox = root.querySelector<HTMLDialogElement>("[data-lightbox]");
    const lightboxVideo = root.querySelector<HTMLVideoElement>("[data-lightbox-video]");
    root.querySelectorAll<HTMLButtonElement>("[data-video]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!lightbox || !lightboxVideo) return;
        lightboxVideo.src = button.dataset.video ?? "";
        lightbox.showModal();
        lightboxVideo.play().catch(() => {});
      });
    });
    const closeLightbox = () => {
      lightboxVideo?.pause();
      lightboxVideo?.removeAttribute("src");
      lightboxVideo?.load();
      if (lightbox?.open) lightbox.close();
    };
    root.querySelector("[data-lightbox-close]")?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) closeLightbox(); });
    lightbox?.addEventListener("close", () => lightboxVideo?.pause());
  }
</script>
