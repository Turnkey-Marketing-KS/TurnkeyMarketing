    .v2-hero { height: auto; }
    .v2-hero__sticky { position: relative; height: auto; overflow: visible; padding-top: 9rem; }
    .v2-hero__title { position: relative; top: 0; left: 0; right: 0; padding-inline: var(--pad); }
    .v2-hero__window { position: relative; inset: auto; margin-top: 3rem; aspect-ratio: 16 / 9; clip-path: none !important; }
    .v2-hero__window img { transform: none !important; }
