---
// Redesign mockup, version 2. Not linked, not in the sitemap, and noindex.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONSULTATION_URL, services } from "@/lib/services";
import { videoTestimonials } from "@/lib/proof";
import { googleReviewSummary } from "@/lib/google-reviews";

const ledger = [
  {
    value: "+169%",
    shop: "Legendary Automotive & Diesel Repair",
    detail: "Reported revenue, August 2024 to June 2026. Total cars served nearly tripled.",
  },
  {
    value: "1→4",
    shop: "Killian Auto Pros",
    detail: "One location in Mauldin, South Carolina became four.",
  },
  {
    value: "2×",
    shop: "Torque European",
    detail: "Monthly revenue, from about $110K to a steady $220K+ since August 2025.",
  },
  {
    value: "+60%",
    shop: "ASAP Auto Repair",
    detail: "Monthly revenue, $125K to $200K. Record months in three of the last four.",
  },
  {
    value: "3.74×",
    shop: "Pro Automotive",
    detail: "Tracked revenue for every advertising dollar in the first full month.",
  },
];

const serviceImages: Record<string, string> = {
  "vip-marketing-manager": "/images/services/vip-marketing-manager-hero.jpg",
  "directtrack-marketing": "/images/services/directtrack-marketing-hero-v2.webp",
  "marketing-consulting": "/images/services/marketing-consulting-hero-v2.webp",
  "direct-mail": "/images/services/direct-mail-mailbox.webp",
  "social-media-marketing": "/images/services/social-media-marketing-hero-v2.webp",
  "retention-marketing": "/images/services/retention-marketing-hero-v2.webp",
  "digital-marketing": "/images/services/digital-marketing-hero-v2.webp",
  "boost-days": "/images/services/boost-days-hero-v2.webp",
};

const serviceRows = services.map((service) => ({
  ...service,
  image: serviceImages[service.slug],
  label: service.slug === "vip-marketing-manager" ? "The whole department" : service.name,
}));

const featuredVideo = videoTestimonials[0];
const moreVideos = videoTestimonials.slice(1, 6);
const marqueeWords = ["More calls", "More cars", "More revenue"];
---

<BaseLayout
  title="Homepage Redesign Mockup v2 | Turnkey Marketing"
  description="Design mockup, version 2, for the Turnkey Marketing homepage redesign."
  path="/mockup/homepage-v2"
  noindex
  minimalChrome
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
  />

  <div class="v2" data-v2 data-theme="dark">
    <div class="v2-cursor" data-cursor aria-hidden="true"><span data-cursor-label></span></div>

    <header class="v2-header" data-header>
      <a href="/" class="v2-logo" aria-label="Turnkey Marketing home">
        <img class="v2-logo__light" src="/images/logos/Turnkey%20Marketing%20Logo%20-%20full%20color-dark%20background-01.png" alt="Turnkey Marketing" width="170" height="45" />
        <img class="v2-logo__dark" src="/turnkey-marketing-logo-2026.webp" alt="" width="170" height="45" />
      </a>
      <div class="v2-header__right">
        <a href={CONSULTATION_URL} class="v2-header__cta v2-underline">Book a strategy call</a>
        <button type="button" class="v2-menu-btn" data-menu-btn aria-expanded="false" aria-controls="v2-menu">
          <span class="v2-menu-btn__label" data-menu-label>Menu</span>
          <span class="v2-menu-btn__dots" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </header>

    <div class="v2-menu" id="v2-menu" data-menu hidden>
      <div class="v2-menu__inner">
        <nav class="v2-menu__primary" aria-label="Primary">
          <a href="/services"><span>Services</span></a>
          <a href="/results"><span>Results</span></a>
          <a href="/resources"><span>Resources</span></a>
          <a href="/about"><span>About</span></a>
          <a href="/contact"><span>Contact</span></a>
        </nav>
        <div class="v2-menu__side">
          <p class="v2-menu__heading">Services</p>
          {services.map((service) => <a href={`/services/${service.slug}`}>{service.name}</a>)}
          <p class="v2-menu__heading v2-menu__heading--gap">Talk to us</p>
          <a href="tel:+19134270674">(913) 427-0674</a>
          <a href="mailto:hello@turnkeyautomarketing.com">hello@turnkeyautomarketing.com</a>
        </div>
      </div>
    </div>

    <main>
      <!-- 1. Hero: the image window opens to full screen as you scroll -->
      <section class="v2-hero" data-hero data-section-theme="dark">
        <div class="v2-hero__sticky">
          <h1 class="v2-hero__title" data-hero-title>
            <span class="v2-mask"><span class="v2-mask__in" data-intro style="--d:0">Auto repair</span></span>
            <span class="v2-mask"><span class="v2-mask__in" data-intro style="--d:1">marketing that</span></span>
            <span class="v2-mask"><span class="v2-mask__in v2-serif" data-intro style="--d:2">increases car count.</span></span>
          </h1>

          <div class="v2-hero__window" data-hero-window>
            <img
              src="/site-media/pearson-auto-repair-shop.webp"
              alt="Pearson Auto Repair technician working in a service bay"
              width="1400"
              height="933"
              fetchpriority="high"
              data-hero-img
            />
            <div class="v2-hero__overlay" data-hero-overlay>
              <p>300+ independent shops.<br /><span class="v2-serif">One accountable team.</span></p>
            </div>
          </div>

          <div class="v2-hero__foot" data-intro style="--d:4" data-hero-foot>
            <p class="v2-hero__scroll"><span class="v2-hero__scroll-line" aria-hidden="true"></span>Scroll</p>
            <p class="v2-hero__line">
              {googleReviewSummary.rating} on Google &nbsp;·&nbsp; Since 2013
            </p>
          </div>
        </div>
      </section>

      <!-- 2. Statement with inline photos -->
      <section class="v2-statement" data-section-theme="light">
        <div class="v2-grid">
          <p class="v2-statement__text" data-lines>
            We
            <span class="v2-pill"><img src="/images/team/20230303-turnkeyvisionexpo0043.jpg" alt="" loading="lazy" /></span>
            plan your marketing, run it
            <span class="v2-pill"><img src="/site-media/mikes-auto-works.webp" alt="" loading="lazy" /></span>
            every week, and show you exactly what it did for
            <span class="v2-serif v2-blue">car count.</span>
            <span class="v2-pill"><img src="/site-media/thunderbird-team.webp" alt="" loading="lazy" /></span>
          </p>
          <div class="v2-statement__aside" data-rise>
            <p>
              You didn't open a shop to spend your nights doing marketing. We become the marketing
              department you never had to hire, from the plan to the postcard to the report.
            </p>
            <a href={CONSULTATION_URL} class="v2-arrow-link" data-cursor-text="Book">
              <span class="v2-underline">Book a strategy call</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            </a>
          </div>
        </div>
      </section>

      <!-- 3. Proof ledger -->
      <section class="v2-proof" data-section-theme="light">
        <div class="v2-grid">
          <h2 class="v2-proof__title" data-rise>
            Over $1 billion in revenue
            <span class="v2-serif">for independent shops.</span>
          </h2>
        </div>
        <ol class="v2-ledger">
          {ledger.map((row) => (
            <li class="v2-ledger__row" data-rise>
              <span class="v2-ledger__value">{row.value}</span>
              <span class="v2-ledger__meta">
                <span class="v2-ledger__shop">{row.shop}</span>
                <span class="v2-ledger__detail">{row.detail}</span>
              </span>
            </li>
          ))}
        </ol>
        <div class="v2-grid v2-proof__foot">
          <a href="/results" class="v2-arrow-link" data-cursor-text="View">
            <span class="v2-underline">Every result, in detail</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
          <p class="v2-fine">Client-specific examples. Results vary by shop, market, investment, and execution.</p>
        </div>
      </section>

      <!-- 4. Services accordion -->
      <section class="v2-services" data-section-theme="dark">
        <div class="v2-grid">
          <h2 class="v2-services__title" data-rise>
            Take one thing off your plate.
            <span class="v2-serif v2-green">Or all of it.</span>
          </h2>
        </div>
        <ul class="v2-acc" data-acc>
          {serviceRows.map((service, index) => (
            <li class:list={["v2-acc__item", index === 0 && "is-open"]} data-acc-item>
              <button type="button" class="v2-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head>
                <span class="v2-acc__name">{service.name}</span>
                <span class="v2-acc__icon" aria-hidden="true"></span>
              </button>
              <div class="v2-acc__panel">
                <div class="v2-acc__panel-inner">
                  <div class="v2-acc__body">
                    <p class="v2-acc__tagline">{service.tagline}</p>
                    <a href={`/services/${service.slug}`} class="v2-arrow-link" data-cursor-text="Open">
                      <span class="v2-underline">Explore {service.name}</span>
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                    </a>
                  </div>
                  <div class="v2-acc__media">
                    <img src={service.image} alt="" loading="lazy" decoding="async" />
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- 5. Testimonial -->
      <section class="v2-voice" data-section-theme="dark">
        <div class="v2-grid">
          <blockquote class="v2-voice__quote" data-rise>
            <p>“We got to <span class="v2-green">$300,000</span> a month within one year at a brand new shop.”</p>
          </blockquote>
          <div class="v2-voice__who" data-rise>
            <button type="button" class="v2-voice__play" data-video={featuredVideo.videoSrc} data-cursor-text="Play" aria-label={`Play ${featuredVideo.name}'s story`}>
              <img src={featuredVideo.posterSrc} alt="" loading="lazy" />
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
            </button>
            <p><strong>{featuredVideo.name}</strong><br />{featuredVideo.shop}</p>
          </div>
        </div>
        <div class="v2-voice__more">
          <p class="v2-voice__more-label">More owners, in their own words</p>
          <ul>
            {moreVideos.map((video) => (
              <li>
                <button type="button" data-video={video.videoSrc} data-cursor-text="Play" aria-label={`Play ${video.name}'s testimonial`}>
                  <img src={video.posterSrc} alt="" loading="lazy" decoding="async" />
                </button>
                <span>{video.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 6. Founder -->
      <section class="v2-founder" data-section-theme="light">
        <figure class="v2-founder__media" data-parallax-wrap>
          <img src="/site-media/founder-carrie-lynn.webp" alt="Carrie-Lynn Rodenberg, founder of Turnkey Marketing" width="687" height="900" loading="lazy" decoding="async" data-parallax />
        </figure>
        <div class="v2-founder__copy">
          <h2 class="v2-founder__title" data-rise>
            Founded in 2013 by
            <span class="v2-serif">Carrie-Lynn Rodenberg.</span>
          </h2>
          <p class="v2-founder__text" data-rise>
            Turnkey started in Kansas City as a family-owned small business, so we know the weight of
            payroll and late-night decisions. That is why the work has never been about selling one more
            tactic. We learn the shop, build the plan, and stay accountable to the outcome.
          </p>
          <p class="v2-founder__creds" data-rise>
            EmblemHealth <i>·</i> VISION Hi-Tech Training & Expo <i>·</i> ShopFix Academy <i>·</i> Remarkable Results Radio
          </p>
          <a href="/about" class="v2-arrow-link" data-rise data-cursor-text="Meet">
            <span class="v2-underline">Meet the team</span>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        </div>
      </section>

      <!-- 7. CTA -->
      <section class="v2-cta" data-section-theme="green">
        <div class="v2-marquee" aria-hidden="true">
          <div class="v2-marquee__track">
            {[0, 1].map(() => (
              <span class="v2-marquee__group">
                {marqueeWords.map((word, index) => (
                  <span class:list={["v2-marquee__word", index === 2 && "v2-serif"]}>{word}<i></i></span>
                ))}
              </span>
            ))}
          </div>
        </div>
        <h2 class="v2-sr">More calls. More cars. More revenue.</h2>
        <a href={CONSULTATION_URL} class="v2-orb" data-magnetic data-cursor-text="Go">
          <svg class="v2-orb__ring" viewBox="0 0 200 200" aria-hidden="true">
            <defs><path id="v2-ring" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0" /></defs>
            <text><textPath href="#v2-ring">Book a strategy call • Book a strategy call • </textPath></text>
          </svg>
          <span class="v2-orb__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="34" height="34"><path d="M6 18L18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </span>
          <span class="v2-sr">Book a strategy call</span>
        </a>
        <p class="v2-cta__phone">Or call <a href="tel:+19134270674" class="v2-underline">(913) 427-0674</a></p>
      </section>
    </main>

    <footer class="v2-footer" data-section-theme="dark">
      <a href="mailto:hello@turnkeyautomarketing.com" class="v2-footer__mail" data-cursor-text="Write">
        hello@turnkey<wbr />automarketing.com
      </a>
      <div class="v2-footer__cols">
        <nav aria-label="Footer">
          <a href="/services">Services</a>
          <a href="/results">Results</a>
          <a href="/resources">Resources</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
        <p>9401 Indian Creek Pkwy #1300<br />Overland Park, KS 66210</p>
        <p>
          <a href="https://www.facebook.com/turnkeymarketingks">Facebook</a><br />
          <a href="https://www.instagram.com/turnkey_marketing/">Instagram</a><br />
          <a href="https://www.linkedin.com/company/turnkey-marketing-for-auto-repair-shops">LinkedIn</a>
        </p>
        <p class="v2-footer__legal">© {new Date().getFullYear()} Turnkey Marketing<br /><a href="/privacy-policy">Privacy</a> · <a href="/terms-of-service">Terms</a></p>
      </div>
    </footer>

    <dialog class="v2-lightbox" data-lightbox>
      <button type="button" class="v2-lightbox__close" data-lightbox-close aria-label="Close video">Close</button>
      <video controls playsinline preload="none" data-lightbox-video></video>
    </dialog>
  </div>
</BaseLayout>

<style is:global>
  .v2 {
    --ink: #0b0f26;
    --paper: #f3f1ea;
    --blue: #5aa2dd;
    --green: #93c845;
    --navy: #232e66;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --pad: clamp(1.25rem, 3.2vw, 3.25rem);
    --display: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    --serif: "Instrument Serif", ui-serif, Georgia, serif;
    --bg: var(--ink);
    --fg: var(--paper);
    --muted: rgba(243, 241, 234, 0.58);
    --line: rgba(243, 241, 234, 0.16);
    background: var(--bg);
    color: var(--fg);
    transition: background-color 0.9s var(--ease), color 0.9s var(--ease);
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
  }
  .v2[data-theme="light"] { --bg: var(--paper); --fg: var(--ink); --muted: rgba(11, 15, 38, 0.56); --line: rgba(11, 15, 38, 0.14); --blue: #2f78b8; }
  .v2[data-theme="green"] { --bg: var(--green); --fg: var(--ink); --muted: rgba(11, 15, 38, 0.6); --line: rgba(11, 15, 38, 0.2); }
  .v2 h1, .v2 h2, .v2 h3 { font-family: var(--display); letter-spacing: -0.04em; font-weight: 400; }
  .v2-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .v2-serif { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; }
  .v2-blue { color: var(--blue); }
  .v2-green { color: var(--green); }
  .v2-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25rem; padding-inline: var(--pad); }

  .v2-underline { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; transition: background-size 0.6s var(--ease); padding-bottom: 0.1em; }
  .v2-underline:hover, a:hover > .v2-underline { background-size: 0 1px; background-position: 100% 100%; }
  .v2-arrow-link { display: inline-flex; align-items: center; gap: 0.9rem; font-size: 1.05rem; font-weight: 500; }
  .v2-arrow-link svg { transition: transform 0.6s var(--ease); }
  .v2-arrow-link:hover svg { transform: translateX(0.4rem); }
  .v2-fine { font-size: 0.8rem; color: var(--muted); }

  /* Cursor */
  .v2-cursor { position: fixed; left: 0; top: 0; z-index: 90; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 999px; background: #fff; mix-blend-mode: difference; pointer-events: none; display: grid; place-items: center; transition: width 0.5s var(--ease), height 0.5s var(--ease), margin 0.5s var(--ease), opacity 0.3s; opacity: 0; }
  .v2-cursor.is-ready { opacity: 1; }
  .v2-cursor span { font-size: 0.8rem; font-weight: 600; color: #000; opacity: 0; transition: opacity 0.3s; letter-spacing: 0.02em; }
  .v2-cursor.is-label { width: 84px; height: 84px; margin: -42px 0 0 -42px; }
  .v2-cursor.is-label span { opacity: 1; }
  @media (pointer: coarse) { .v2-cursor { display: none; } }

  /* Header */
  .v2-header { position: fixed; inset: 0 0 auto; z-index: 60; display: flex; align-items: center; justify-content: space-between; padding: calc(1.25rem + env(safe-area-inset-top, 0px)) var(--pad) 1.25rem; pointer-events: none; }
  .v2-header > * { pointer-events: auto; }
  .v2-logo img { height: 2.1rem; width: auto; }
  .v2-logo__dark { display: none; }
  .v2-header.is-light .v2-logo__light { display: none; }
  .v2-header.is-light .v2-logo__dark { display: block; }
  .v2-header.is-light:not(.is-menu) { color: var(--ink); }
  .v2-header { color: var(--paper); transition: color 0.5s; }
  .v2-header.is-menu .v2-logo__light { display: block; }
  .v2-header.is-menu .v2-logo__dark { display: none; }
  .v2-header__right { display: flex; align-items: center; gap: 2rem; font-size: 0.95rem; font-weight: 500; }
  .v2-menu-btn { display: inline-flex; align-items: center; gap: 0.75rem; font: inherit; color: inherit; }
  .v2-menu-btn__dots { display: grid; grid-template-columns: repeat(2, 5px); gap: 4px; }
  .v2-menu-btn__dots i { width: 5px; height: 5px; border-radius: 999px; background: currentColor; transition: transform 0.5s var(--ease); }
  .v2-menu-btn:hover .v2-menu-btn__dots i:first-child { transform: translateX(9px); }
  .v2-menu-btn:hover .v2-menu-btn__dots i:last-child { transform: translateX(-9px); }
  .v2-header.is-hidden { transform: translateY(-120%); }
  .v2-header.is-solid:not(.is-menu) { background: var(--bg); }
  .v2-header { transition: transform 0.7s var(--ease), color 0.5s, background-color 0.9s var(--ease); }

  .v2-menu { position: fixed; inset: 0; z-index: 55; background: var(--navy); color: var(--paper); clip-path: inset(0 0 100% 0); transition: clip-path 0.9s var(--ease); }
  .v2-menu.is-open { clip-path: inset(0 0 0 0); }
  .v2-menu__inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 2rem; height: 100%; padding: 8rem var(--pad) 3rem; }
  .v2-menu__primary { display: flex; flex-direction: column; justify-content: flex-end; }
  .v2-menu__primary a { font-family: var(--display); font-size: clamp(3rem, 8.5vw, 8rem); line-height: 0.95; letter-spacing: -0.05em; overflow: hidden; }
  .v2-menu__primary a span { display: inline-block; transform: translateY(105%); transition: transform 0.9s var(--ease); }
  .v2-menu.is-open .v2-menu__primary a span { transform: none; }
  .v2-menu__primary a:nth-child(2) span { transition-delay: 0.05s; }
  .v2-menu__primary a:nth-child(3) span { transition-delay: 0.1s; }
  .v2-menu__primary a:nth-child(4) span { transition-delay: 0.15s; }
  .v2-menu__primary a:nth-child(5) span { transition-delay: 0.2s; }
  .v2-menu__primary a:hover { color: var(--green); }
  .v2-menu__side { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.45rem; color: rgba(243, 241, 234, 0.72); }
  .v2-menu__side a:hover { color: #fff; }
  .v2-menu__heading { color: rgba(243, 241, 234, 0.45); font-size: 0.85rem; margin-bottom: 0.4rem; }
  .v2-menu__heading--gap { margin-top: 1.5rem; }

  /* Intro masks */
  .v2-mask { display: block; overflow: hidden; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .v2-mask__in { display: block; text-wrap: balance; transform: translateY(110%); transition: transform 1.3s var(--ease); transition-delay: calc(0.2s + var(--d, 0) * 0.1s); }
  .v2.is-loaded .v2-mask__in { transform: none; }
  [data-intro]:not(.v2-mask__in) { opacity: 0; transition: opacity 1s var(--ease); transition-delay: calc(0.3s + var(--d, 0) * 0.1s); }
  .v2.is-loaded [data-intro]:not(.v2-mask__in) { opacity: 1; }

  /* Hero */
  .v2-hero { position: relative; height: 240vh; }
  .v2-hero__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
