---
// Keeps BaseLayout directly (not V6Layout) so the Google Ads attribution funnel stays exactly as before.
// The v6 header, footer, and page styles are added here instead. No phone dock on this confirmation page.
import "@/styles/v6.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/site/Footer.astro";
import V6Header from "@/components/v6/V6Header.astro";
import { siteMedia } from "@/lib/site-media";
import { arrow, iconSrc, split } from "@/lib/v6";

const photo = siteMedia.team.visionExpoConversation;
---

<BaseLayout
  title="Your Consultation Is Booked — Turnkey Marketing"
  description="Your consultation with Turnkey Marketing is confirmed. Check your inbox for the appointment details."
  path="/google-ads-call-booked"
  ogTitle="Your Consultation Is Booked"
  ogImage={siteMedia.team.visionExpoConversation.src}
  noindex={true}
  attributionFunnel="google_ads"
  minimalChrome
>
  <V6Header slot="chrome-top" />
  <div class="v6 v6-page tk-booked-page" data-v6>
  <section class="tk-booked">
    <div class="v6-wrap tk-booked__grid">
      <div class="tk-booked__main">
        <p class="tk-booked__status" data-fade>
          <span class="tk-booked__check" aria-hidden="true"></span>
          Consultation confirmed
        </p>
        <h1 class="tk-booked__title" data-words set:html={split([{ t: "You’re" }, { t: "booked.", accent: true }])} />
        <p class="tk-booked__lead" data-fade style="--d:1">
          Your 30-minute consultation is on the calendar. Check your inbox for
          the confirmation and meeting details.
        </p>

        <div class="tk-booked__next" data-fade style="--d:2">
          <span class="tk-booked__icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("email")})`}></span></span>
          <div>
            <h2 class="tk-booked__h2">What happens next</h2>
            <p>
              We’ll review what you shared before the call so the conversation
              can focus on your shop, your current marketing, and the clearest
              next move.
            </p>
          </div>
        </div>

        <div class="tk-booked__actions" data-fade style="--d:3">
          <a href="/" class="v6-btn v6-btn--navy v6-btn--lg"><span>Visit Turnkey Marketing</span><i set:html={arrow} /></a>
          <a href="tel:+19134270674" class="v6-btn v6-btn--ghost v6-btn--lg">
            <span class="tk-booked__phone" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("phone")})`}></span></span>
            <span>(913) 427-0674</span>
          </a>
        </div>
      </div>

      <figure class="tk-booked__media" data-fade style="--d:2">
        <img src={photo.src} alt={photo.alt} width="1000" height="667" style={`object-position:${photo.position}`} />
      </figure>
    </div>
  </section>
  </div>
  <Footer slot="chrome-bottom" />
</BaseLayout>

<script>
  // v6 page behavior for this BaseLayout page: load fade, headline reveal, mobile menu, header shadow.
  const root = document.querySelector<HTMLElement>("[data-v6]");
  if (root) {
    requestAnimationFrame(() => setTimeout(() => root.classList.add("is-loaded"), 60));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-in");
        io.unobserve(entry.target);
      }),
      { rootMargin: "0px 0px -10% 0px" },
    );
    root.querySelectorAll("[data-rise], [data-words]").forEach((el) => io.observe(el));

    const menu = document.querySelector<HTMLElement>("[data-menu]");
    const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
    const setMenu = (open: boolean) => {
      if (!menu || !menuBtn) return;
      menu.hidden = !open;
      menuBtn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    };
    menuBtn?.addEventListener("click", () => setMenu(Boolean(menu?.hidden)));
    menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && menu && !menu.hidden) setMenu(false); });
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => { if (event.matches) setMenu(false); });

    const header = document.querySelector<HTMLElement>("[data-header]");
    const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 10);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<!-- Booked-consultation measurement for the GHL calendar on the Google Ads landing page. -->
<script is:inline>
  (function () {
    var storageKey = "turnkey_google_ads_call_booked_sent";
    var shouldTrack = true;

    try {
      if (window.sessionStorage.getItem(storageKey)) shouldTrack = false;
      else window.sessionStorage.setItem(storageKey, "1");
    } catch (_) {}

    if (!shouldTrack || typeof window.gtag !== "function") return;

    window.gtag("event", "google_ads_call_booked", {
      appointment_type: "30_minute_consultation",
      lead_source: "google_ads_landing_page",
      booking_provider: "ghl_calendar",
      funnel: "google_ads_landing_page",
      lead_event: "appointment_booked",
    });

    window.gtag("event", "conversion", {
      send_to: "AW-18358810922/8Oy4CJqVtuMcEKrylLJE",
      value: 1.0,
      currency: "USD",
    });

  })();
</script>

<style>
  .tk-booked { padding-block: clamp(3rem, 7vw, 6rem) clamp(4.5rem, 9vw, 8rem); }
  /* Desktop: confirmation on the left, a real team photo on the right. Phones: one column, photo last. */
  .tk-booked__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(3rem, 6vw, 6rem); align-items: center; }
  .tk-booked__main { display: grid; justify-items: start; }
  .tk-booked__status { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.5rem; padding: 0 1.1rem 0 0.4rem; border-radius: 999px; background: var(--off-white); color: var(--navy); font-size: 0.92rem; font-weight: 600; }
  .tk-booked__check { position: relative; width: 1.9rem; height: 1.9rem; border-radius: 999px; background: var(--green); }
  .tk-booked__check::after { content: ""; position: absolute; left: 37%; top: 24%; width: 26%; height: 44%; border: solid var(--charcoal); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .tk-booked__title { margin-top: clamp(1.5rem, 3vw, 2.25rem); font-size: clamp(3.25rem, 7vw, 7rem); line-height: 0.96; letter-spacing: -0.06em; font-weight: 600; }
  .tk-booked__lead { margin-top: 1.5rem; max-width: 34rem; font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.6; color: var(--muted); }
  .tk-booked__next { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); gap: 1.1rem; align-items: start; max-width: 34rem; margin-top: 2.25rem; padding: 1.5rem; border-radius: 26px; background: var(--key-blue-soft); }
  .tk-booked__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: #fff; color: var(--navy); }
  .tk-booked__icon .v6-icon { width: 1.4rem; height: 1.4rem; }
  .tk-booked__h2 { padding-top: 0.2rem; font-size: 1.2rem; font-weight: 600; letter-spacing: -0.025em; color: var(--charcoal); }
  .tk-booked__next p { margin-top: 0.4rem; line-height: 1.6; color: #3a3f4b; }
  .tk-booked__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .tk-booked__phone { display: inline-grid; width: 1.15rem; height: 1.15rem; }
  .tk-booked__media { overflow: hidden; aspect-ratio: 4 / 5; max-height: 44rem; border-radius: 40px; background: var(--off-white); }
  .tk-booked__media img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .tk-booked { padding-block: 2rem 3.5rem; }
    .tk-booked__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .tk-booked__title { margin-top: 1.25rem; font-size: clamp(3rem, 15vw, 4rem); }
    .tk-booked__lead { margin-top: 1rem; font-size: 1.08rem; }
    .tk-booked__next { grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.9rem; margin-top: 1.75rem; padding: 1.25rem; border-radius: 22px; }
    .tk-booked__icon { width: 2.75rem; height: 2.75rem; }
    .tk-booked__icon .v6-icon { width: 1.2rem; height: 1.2rem; }
    .tk-booked__actions { flex-direction: column; align-self: stretch; width: 100%; margin-top: 1.75rem; gap: 0.6rem; }
    .tk-booked__actions .v6-btn { justify-content: center; }
    .tk-booked__media { aspect-ratio: 4 / 3; border-radius: 28px; }
  }
</style>
