---
import { ArrowRight, CalendarCheck, Mail, Phone } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteMedia } from "@/lib/site-media";
---

<BaseLayout
  title="Your Consultation Is Booked — Turnkey Marketing"
  description="Your consultation with Turnkey Marketing is confirmed. Check your inbox for the appointment details."
  path="/google-ads-call-booked"
  ogTitle="Your Consultation Is Booked"
  ogImage={siteMedia.team.visionExpoConversation.src}
  noindex={true}
>
  <section class="container-page flex min-h-[calc(100vh-168px)] items-center py-14 md:py-24">
    <div
      class="mx-auto w-full max-w-3xl overflow-hidden rounded-[32px] border bg-white text-center shadow-[0_32px_90px_-58px_rgba(20,22,28,0.5)]"
      style="border-color: var(--hairline);"
    >
      <div
        class="px-6 py-12 sm:px-10 md:px-16 md:py-16"
        style="background:
          radial-gradient(circle at 50% 0%, rgba(63, 140, 203, 0.16), transparent 42%),
          linear-gradient(180deg, #f7f9fc 0%, #ffffff 72%);"
      >
        <span
          class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl text-white shadow-[0_18px_36px_-20px_rgba(35,46,102,0.75)]"
          style="background: var(--navy);"
          aria-hidden="true"
        >
          <CalendarCheck className="h-8 w-8" strokeWidth={1.8} />
        </span>

        <p class="eyebrow mt-7" style="color: var(--key-blue);">Consultation confirmed</p>
        <h1 class="page-title mt-4 text-balance text-charcoal">You’re booked.</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground md:text-xl">
          Your 30-minute consultation is on the calendar. Check your inbox for
          the confirmation and meeting details.
        </p>

        <div
          class="mx-auto mt-8 max-w-xl rounded-2xl border px-5 py-5 text-left"
          style="border-color: var(--hairline); background: var(--off-white);"
        >
          <div class="flex gap-4">
            <span
              class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
              style="background: var(--key-blue-soft); color: var(--navy);"
              aria-hidden="true"
            >
              <Mail className="h-5 w-5" />
            </span>
            <div>
              <h2 class="font-display text-lg font-semibold text-charcoal">What happens next</h2>
              <p class="mt-1 text-sm leading-relaxed text-charcoal/65">
                We’ll review what you shared before the call so the conversation
                can focus on your shop, your current marketing, and the clearest
                next move.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5"
            style="background: var(--navy);"
          >
            Visit Turnkey Marketing <ArrowRight className="h-4 w-4" />
          </a>
          <a
            href="tel:+19134270674"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border px-6 py-3 font-semibold text-charcoal transition hover:-translate-y-0.5"
            style="border-color: var(--hairline); background: white;"
          >
            <Phone className="h-4 w-4" /> (913) 427-0674
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var storageKey = "turnkey_google_ads_call_booked_sent";
    var shouldTrack = true;

    try {
      if (window.sessionStorage.getItem(storageKey)) shouldTrack = false;
      else window.sessionStorage.setItem(storageKey, "1");
    } catch (_) {}

    if (!shouldTrack || typeof window.gtag !== "function") return;

    window.gtag("event", "google_ads_call_booked", {
      appointment_type: "30_minute_consultation",
      lead_source: "google_ads_landing_page",
    });

    window.gtag("event", "ads_conversion_Book_appointment_1", {});
  })();
</script>
