---
import V6Layout from "@/components/v6/V6Layout.astro";
import V6Cta from "@/components/v6/V6Cta.astro";
import { CONSULTATION_URL } from "@/lib/services";
import { siteMedia } from "@/lib/site-media";
import { arrow, iconSrc, split } from "@/lib/v6";

const arrowDown = `<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 3v9M4 8.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const expertise = [
  {
    icon: "target",
    title: "Strategy & account leadership",
    copy: "A clear plan, a steady point of contact, and confident next moves for your shop.",
  },
  {
    icon: "social-media-marketing",
    title: "Brand, content & creative",
    copy: "Work that sounds like you, looks like you, and earns trust in your community.",
  },
  {
    icon: "direct-mail",
    title: "Digital, media & direct mail",
    copy: "The right channels working together instead of competing for your attention and budget.",
  },
  {
    icon: "report",
    title: "Reporting & optimization",
    copy: "Plain-English insight into what is working, what is not, and where we go next.",
  },
];

const values = [
  {
    number: "01",
    title: "Care like it is our own shop.",
    copy: "Your business supports a team, a family, and a community. We never forget what is riding on the work.",
  },
  {
    number: "02",
    title: "Tell the truth about the numbers.",
    copy: "We review campaign costs, tracked responses, and shop results, then explain what to keep or change.",
  },
  {
    number: "03",
    title: "Bring expertise, stay curious.",
    copy: "We know this industry deeply, and we keep learning from every shop owner, campaign, and market we serve.",
  },
];

const glance = [
  { term: "Since 2013", detail: "Family-owned and founder-led" },
  { term: "300+ shops", detail: "Supported across the country" },
  { term: "$1 Billion+", detail: "Revenue driven to repair shops" },
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Turnkey Marketing",
  description:
    "Meet the founder-led team of auto repair marketing experts behind Turnkey Marketing.",
  mainEntity: {
    "@type": "Organization",
    name: "Turnkey Marketing",
    foundingDate: "2013",
    founder: {
      "@type": "Person",
      name: "Carrie-Lynn Rodenberg",
      jobTitle: "Founder",
      knowsAbout: [
        "Auto repair marketing",
        "Direct response marketing",
        "Marketing strategy",
        "Small business growth",
      ],
    },
  },
};
---

<V6Layout
  title="About Turnkey | Auto Repair Marketing Agency"
  description="Meet the founder-led auto repair marketing agency helping independent shops grow through expert strategy, creative, execution, and genuine care."
  path="/about"
  ogTitle="Meet the Auto Repair Marketing Experts at Turnkey"
  ogImage={siteMedia.about.team.src}
  schema={aboutSchema}
  class="tk-about"
>
  <!-- Hero: editorial title with the lead and actions beside it, the team photo, then the numbers -->
  <section class="v6-ph tk-about__hero">
    <div class="v6-wrap">
      <div class="v6-ph__grid">
        <div>
          <p class="v6-kicker" data-fade>About Turnkey Marketing</p>
          <h1 class="v6-ph__title tk-about__title" data-words set:html={split([{ t: "Auto repair marketing experts" }, { t: "who care deeply.", accent: true }])} />
        </div>
        <div class="v6-ph__aside" data-fade style="--d:2">
          <p class="v6-ph__lead">
            Turnkey is an auto repair marketing agency built for independent shop owners. We help
            them grow stronger businesses, reclaim their time, and build the life they worked so
            hard to create.
          </p>
          <div class="v6-ph__actions">
            <a
              href={CONSULTATION_URL}
              class="v6-btn v6-btn--navy v6-btn--lg"
              data-track-event="consultation_cta_click"
              data-track-placement="about_hero"
            >
              <span>Book a Strategy Call</span><i set:html={arrow} />
            </a>
            <a href="#our-team" class="v6-link">Meet the team <i set:html={arrowDown} /></a>
          </div>
        </div>
      </div>

      <figure class="v6-ph__media tk-about__hero-media" data-allow-overflow data-ph-media data-fade style="--d:3">
        <img
          src={siteMedia.about.team.src}
          alt="The Turnkey Marketing team, specialists in marketing for independent auto repair shops"
          width="1400"
          height="933"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>

      <aside class="tk-about__glance" aria-label="Turnkey Marketing at a glance">
        <dl>
          {glance.map((item, index) => (
            <div class="tk-about__glance-item" data-rise style={`transition-delay:${index * 0.08}s`}>
              <dt>{item.term}</dt>
              <dd>{item.detail}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- Story: sticky title on desktop, reading column and the ten-year photo beside it -->
  <section class="v6-sec tk-about__story">
    <div class="v6-wrap tk-about__story-grid">
      <div class="tk-about__story-head">
        <p class="v6-kicker">Why we are here</p>
        <h2 class="v6-h2 tk-about__story-title" data-words set:html={split([{ t: "We fell in love with the people" }, { t: "behind the bays.", accent: true }])} />
      </div>
      <div class="tk-about__story-body" data-rise>
        <p class="tk-about__lede">
          Turnkey began in Kansas City in 2013 as a family-owned small business. We understand
          the weight of payroll, the late-night decisions, and the responsibility that comes
          with building something other people depend on.
        </p>
        <p class="tk-about__para">
          That is why our work has never been about selling one more tactic. We learn the shop,
          build the plan, coordinate the work, and stay accountable to the outcome. Our purpose
          is simple: use what we are good at to help independent auto repair businesses — and
          the people behind them — thrive.
        </p>
        <div class="tk-about__links">
          <a href="/services" class="v6-link">Explore our marketing services <i set:html={arrow} /></a>
          <a href="/results" class="v6-link">See client results and stories <i set:html={arrow} /></a>
        </div>
      </div>
      <figure class="tk-about__story-media" data-rise>
        <img
          src="/images/team/2023-02-28-turnkey-10-years-8977-3x2-1.jpeg"
          alt="The Turnkey Marketing team celebrating ten years in business"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Founder: the page's featured moment. Portrait in the gradient frame, stage photo tucked beside it -->
  <section id="carrie-lynn" class="v6-sec v6-sec--tint tk-about__founder">
    <div class="v6-wrap tk-about__founder-grid">
      <div class="tk-about__portrait" data-rise>
        <div class="v6-glow tk-about__portrait-glow">
          <div class="tk-about__portrait-frame" data-allow-overflow data-founder-parallax>
            <img
              src={siteMedia.about.founder.src}
              alt="Carrie-Lynn Rodenberg, founder and auto repair marketing expert at Turnkey Marketing"
              width="687"
              height="900"
              loading="lazy"
              decoding="async"
              style={`object-position: ${siteMedia.about.founder.position};`}
            />
            <div class="tk-about__portrait-name">
              <p class="tk-about__name">Carrie-Lynn Rodenberg</p>
              <p class="tk-about__role">Founder, Turnkey Marketing</p>
            </div>
          </div>
        </div>
      </div>

      <div class="tk-about__founder-text">
        <h2 class="v6-h2 tk-about__founder-title" data-words set:html={split([{ t: "An industry-leading voice in" }, { t: "auto repair marketing.", accent: true }])} />
        <div class="tk-about__founder-copy" data-rise>
          <p class="tk-about__lede">
            Before founding Turnkey, Carrie-Lynn led direct-response marketing for EmblemHealth,
            a $10 billion company. Later, as Director of Marketing for an orthodontic
            company, her team placed second for Infusionsoft’s Ultimate Marketer of the
            Year award. Since then, Carrie-Lynn and the Turnkey team have helped drive
            $1 Billion+ in revenue for independent repair shops.
          </p>
          <p class="tk-about__para">
            Her perspective is trusted on stages and platforms including ShopFix Academy,
            VISION Hi-Tech Training & Expo, and Remarkable Results Radio. As a speaker,
            strategist, and founder, Carrie-Lynn continues to raise the standard for what
            shop owners should expect from their marketing partners.
          </p>
        </div>
      </div>

      <figure class="tk-about__stage" data-rise>
        <img
          src={siteMedia.team.industrySession.src}
          alt={siteMedia.team.industrySession.alt}
          width="1000"
          height="667"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Team: group photo beside the four disciplines on desktop; disciplines become a swipe rail on phones -->
  <section id="our-team" class="v6-sec tk-about__team">
    <div class="v6-wrap">
      <div class="v6-head tk-about__team-head">
        <h2 class="v6-h2" data-words set:html={split([{ t: "Different specialties." }, { t: "One plan for your shop.", accent: true }])} />
        <p class="v6-lead" data-rise>
          You get strategists, account leaders, designers, writers, media experts,
          analysts, and operators working as one connected marketing department.
        </p>
      </div>

      <div class="tk-about__team-grid">
        <figure class="tk-about__team-photo" data-rise>
          <img
            src={siteMedia.about.team.src}
            alt="Turnkey Marketing's team of auto repair marketing strategists, creatives, account leaders, and specialists"
            width="1400"
            height="933"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="v6-swipe tk-about__disciplines" style="--cols:1">
          {expertise.map((item) => (
            <article class="tk-about__discipline" data-rise>
              <span class="tk-about__discipline-icon"><span class="v6-icon" style={`--icon:url(${iconSrc(item.icon)})`}></span></span>
              <div>
                <h3 class="tk-about__discipline-title">{item.title}</h3>
                <p class="tk-about__discipline-copy">{item.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Values: navy, sticky title with a photo of the team with shop owners, numbered rows -->
  <section class="v6-sec v6-sec--navy tk-about__values">
    <div class="v6-wrap tk-about__values-grid">
      <div class="tk-about__values-head">
        <h2 class="v6-h2 tk-about__values-title" data-words set:html={split([{ t: "Expertise matters." }, { t: "How we use it matters more.", accent: true }])} />
        <figure class="tk-about__values-media" data-rise>
          <img
            src="/images/team/20230303-turnkeyvisionexpo0048.jpg"
            alt="Turnkey Marketing team members talking with auto repair shop owners at VISION Hi-Tech Training & Expo"
            width="1000"
            height="667"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="v6-rows tk-about__values-rows">
        {values.map((value) => (
          <article class="tk-about__value" data-rise>
            <h3 class="tk-about__value-title">{value.title}</h3>
            <p class="tk-about__value-copy">{value.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <V6Cta
    title="Let’s build something good for your business —"
    accent="and your life."
    text="Tell us where you want your shop to go. We’ll listen, share what we see, and help you find the clearest next step."
    placement="about_footer"
  />
</V6Layout>

<script>
  const portraitFrame = document.querySelector<HTMLElement>("[data-founder-parallax]");
  const portraitImage = portraitFrame?.querySelector<HTMLElement>("img");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (portraitFrame && portraitImage && !reduceMotion.matches) {
    let animationFrame: number | undefined;

    const updatePortrait = () => {
      animationFrame = undefined;
      const bounds = portraitFrame.getBoundingClientRect();
      const viewportCenter = window.innerHeight / 2;
      const portraitCenter = bounds.top + bounds.height / 2;
      const travel = viewportCenter + bounds.height / 2;
      const progress = Math.max(-1, Math.min(1, (viewportCenter - portraitCenter) / travel));

      portraitImage.style.setProperty("--portrait-parallax", `${progress * 40}px`);
    };

    const requestPortraitUpdate = () => {
      if (animationFrame === undefined) {
        animationFrame = window.requestAnimationFrame(updatePortrait);
      }
    };

    updatePortrait();
    window.addEventListener("scroll", requestPortraitUpdate, { passive: true });
    window.addEventListener("resize", requestPortraitUpdate);
  }
</script>

<style>
  /* Hero */
  .tk-about__title { max-width: 13ch; }
  .tk-about__hero .v6-kicker { margin-top: 0.25rem; }
  .tk-about__hero-media { height: clamp(20rem, 40vw, 34rem); }
  .v6-ph__media.tk-about__hero-media img { object-position: 50% 100%; transform-origin: 50% 90%; }

  .tk-about__glance dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 3rem); padding-top: clamp(2rem, 4vw, 3rem); }
  .tk-about__glance-item { display: grid; gap: 0.5rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--hairline); }
  .tk-about__glance dt { font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 600; letter-spacing: -0.055em; line-height: 1; color: var(--navy); }
  .tk-about__glance dd { font-size: 0.95rem; line-height: 1.45; color: var(--muted); }
  .tk-about__glance-item:nth-child(3) dt { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* Story */
  .tk-about__story-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: "head body" "head media"; column-gap: clamp(3rem, 7vw, 7rem); row-gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  .tk-about__story-head { grid-area: head; position: sticky; top: 8rem; display: grid; gap: 1.25rem; }
  .tk-about__story-title { max-width: 11ch; }
  .tk-about__story-body { grid-area: body; display: grid; gap: 1.5rem; padding-top: clamp(0rem, 3vw, 2.5rem); }
  .tk-about__story-media { grid-area: media; overflow: hidden; border-radius: 36px; aspect-ratio: 16 / 10; background: var(--off-white); }
  .tk-about__story-media img, .tk-about__stage img, .tk-about__values-media img, .tk-about__team-photo img { width: 100%; height: 100%; object-fit: cover; }
  .tk-about__story-media img { object-position: 50% 40%; }
  .tk-about__lede { font-size: clamp(1.2rem, 1.7vw, 1.5rem); line-height: 1.5; letter-spacing: -0.02em; font-weight: 500; color: var(--charcoal); text-wrap: pretty; }
  .tk-about__para { font-size: 1.1rem; line-height: 1.7; color: var(--muted); max-width: 40rem; text-wrap: pretty; }
  .tk-about__links { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; padding-top: 0.25rem; }

  /* Founder */
  .tk-about__founder-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-areas: "portrait text" "portrait stage"; column-gap: clamp(3rem, 7vw, 7rem); row-gap: 2.5rem; align-items: start; }
  .tk-about__portrait { grid-area: portrait; }
  .tk-about__portrait-glow { border-radius: 40px; }
  .tk-about__portrait-frame { position: relative; overflow: hidden; aspect-ratio: 4 / 5; border-radius: 35px; background: var(--navy); }
  .tk-about__portrait-frame img { width: 100%; height: 100%; object-fit: cover; transform: translate3d(0, var(--portrait-parallax, 0px), 0) scale(1.2); will-change: transform; }
  .tk-about__portrait-frame::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20, 22, 28, 0) 58%, rgba(20, 26, 60, 0.78)); pointer-events: none; }
  .tk-about__portrait-name { position: absolute; z-index: 1; left: clamp(1.25rem, 2.5vw, 2rem); right: 1.25rem; bottom: clamp(1.25rem, 2.5vw, 1.75rem); color: #fff; }
  .tk-about__name { font-size: clamp(1.3rem, 1.9vw, 1.65rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.1; }
  .tk-about__role { margin-top: 0.3rem; font-size: 0.92rem; color: rgba(255, 255, 255, 0.78); }
  .tk-about__founder-text { grid-area: text; display: grid; gap: 1.75rem; padding-top: clamp(0rem, 2vw, 1.5rem); }
  .tk-about__founder-title { max-width: 14ch; }
  .tk-about__founder-copy { display: grid; gap: 1.25rem; }
  .tk-about__stage { grid-area: stage; overflow: hidden; width: min(100%, 30rem); border-radius: 28px; aspect-ratio: 3 / 2; background: #fff; }
  .tk-about__stage img { object-position: 60% 35%; }

  /* Team */
  .tk-about__team-head .v6-h2 { max-width: 13ch; }
  .tk-about__team-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .tk-about__team-photo { overflow: hidden; border-radius: 36px; aspect-ratio: 3 / 2; background: #fff; box-shadow: 0 0 0 1px var(--hairline), 0 40px 90px -60px rgba(35, 46, 102, 0.55); }
  .tk-about__disciplines.v6-swipe { gap: 0; border-top: 1px solid var(--hairline); }
  .tk-about__discipline { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.25rem; align-items: start; padding-block: clamp(1.25rem, 2vw, 1.6rem); border-bottom: 1px solid var(--hairline); }
  .tk-about__discipline-icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: var(--key-blue-soft); color: var(--navy); }
  .tk-about__discipline:nth-child(2) .tk-about__discipline-icon { background: #e9f3dc; }
  .tk-about__discipline:nth-child(4) .tk-about__discipline-icon { background: var(--navy); color: var(--green); }
  .tk-about__discipline-icon .v6-icon { width: 1.4rem; height: 1.4rem; }
  .tk-about__discipline-title { font-size: clamp(1.15rem, 1.5vw, 1.35rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .tk-about__discipline-copy { margin-top: 0.4rem; line-height: 1.6; color: var(--muted); }

  /* Values */
  .tk-about__values-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(3rem, 7vw, 7rem); row-gap: 2.5rem; align-items: start; }
  .tk-about__values-head { position: sticky; top: 8rem; display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .tk-about__values-title { max-width: 12ch; }
  .tk-about__values-media { overflow: hidden; border-radius: 28px; aspect-ratio: 4 / 3; background: var(--navy); }
  .tk-about__values-media img { object-position: 55% 40%; }
  .tk-about__value { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 1.5rem; row-gap: 0.9rem; padding-block: clamp(2rem, 3.5vw, 3rem); border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .tk-about__value-num { grid-row: span 2; font-size: clamp(2.4rem, 3.6vw, 3.4rem); font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; color: var(--green); font-variant-numeric: tabular-nums; }
  .tk-about__value-title { font-size: clamp(1.6rem, 2.6vw, 2.4rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; text-wrap: balance; }
  .tk-about__value-copy { max-width: 32rem; font-size: 1.05rem; line-height: 1.65; color: rgba(255, 255, 255, 0.72); }

  :global(.tk-about .v6-cta__title) { max-width: 16ch; }

  /* Phones: tighter hero, close crop on faces, stacked numbers, swipe rail for disciplines */
  @media (max-width: 900px) {
    .tk-about__title { max-width: 12ch; }
    .tk-about__hero-media { height: auto; }
    .v6-ph__media.tk-about__hero-media img { transform: scale(1.5); transform-origin: 50% 100%; object-position: 50% 100%; }

    .tk-about__glance dl { grid-template-columns: 1fr; gap: 0; padding-top: 1.75rem; }
    .tk-about__glance-item { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; gap: 1rem; padding-block: 1.1rem; border-top: 0; border-bottom: 1px solid var(--hairline); }
    .tk-about__glance-item:first-child { border-top: 1px solid var(--hairline); }
    .tk-about__glance dt { font-size: clamp(1.6rem, 7.6vw, 2.1rem); }
    .tk-about__glance dd { font-size: 0.9rem; }

    .tk-about__story-grid, .tk-about__founder-grid, .tk-about__values-grid { grid-template-columns: 1fr; }
    .tk-about__story-grid { grid-template-areas: "head" "body" "media"; row-gap: 1.75rem; }
    .tk-about__story-head { position: static; gap: 1rem; }
    .tk-about__story-body { padding-top: 0; gap: 1.1rem; }
    .tk-about__lede { font-size: 1.15rem; }
    .tk-about__para { font-size: 1.02rem; }
    .tk-about__links { flex-direction: column; gap: 0; }
    .tk-about__story-media { margin-inline: calc(var(--gutter) * -0.5); border-radius: 26px; aspect-ratio: 4 / 3; }

    .tk-about__founder-grid { grid-template-areas: "portrait" "text" "stage"; row-gap: 2rem; }
    .tk-about__portrait-glow { padding: 4px; border-radius: 32px; }
    .tk-about__portrait-frame { border-radius: 28px; }
    .tk-about__founder-text { padding-top: 0; gap: 1.25rem; }
    .tk-about__stage { width: auto; margin-inline: calc(var(--gutter) * -0.5); border-radius: 26px; aspect-ratio: 4 / 3; }

    .tk-about__team-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .tk-about__team-photo { margin-inline: calc(var(--gutter) * -0.5); border-radius: 26px; }
    .tk-about__disciplines.v6-swipe { gap: 0.75rem; border-top: 0; }
    .tk-about__discipline { grid-template-columns: 1fr; gap: 2.5rem; align-content: space-between; min-height: 15rem; padding: 1.5rem; border-bottom: 0; border-radius: 24px; background: var(--off-white); }
    .tk-about__discipline:nth-child(4) { background: var(--navy); color: #fff; }
    .tk-about__discipline:nth-child(4) .tk-about__discipline-icon { background: var(--green); color: var(--navy); }
    .tk-about__discipline:nth-child(4) .tk-about__discipline-copy { color: rgba(255, 255, 255, 0.74); }
    .tk-about__discipline-icon { background: #fff; }
    .tk-about__discipline:nth-child(2) .tk-about__discipline-icon { background: #fff; }
    .tk-about__discipline-title { font-size: 1.3rem; }

    .tk-about__values-grid { row-gap: 1.5rem; }
    .tk-about__values-head { position: static; gap: 1.75rem; }
    .tk-about__values-media { margin-inline: calc(var(--gutter) * -0.5); border-radius: 26px; }
    .tk-about__value { grid-template-columns: 1fr; row-gap: 0.6rem; padding-block: 1.6rem; }
    .tk-about__value-num { grid-row: auto; font-size: 1rem; letter-spacing: 0; line-height: 1.2; font-weight: 700; }
    .tk-about__value-title { font-size: 1.6rem; }
