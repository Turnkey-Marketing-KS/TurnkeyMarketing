---
import V6Layout from "@/components/v6/V6Layout.astro";
import { APPOINTMENTCORE_BOOKING_URL, CONSULTATION_URL } from "@/lib/services";
import { arrow, iconSrc, split } from "@/lib/v6";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "AI Visibility Scan for Auto Repair Shops",
  description: "See how clearly AI-powered searches understand your auto repair shop.",
  url: "https://www.turnkeyautomarketing.com/ai-visibility-scan",
};
const icon = (name: string) => `--icon:url(${iconSrc(name)})`;
---

<V6Layout
  title="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  description="See how clearly AI-powered searches understand and recommend your auto repair shop."
  path="/ai-visibility-scan"
  ogTitle="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  schema={reportSchema}
  dock={false}
  class="tk-scan"
>
  <section class="tk-scan__hero">
    <span class="tk-scan__wash" aria-hidden="true" data-allow-overflow></span>
    <div class="v6-wrap tk-scan__grid">
      <div class="tk-scan__intro">
        <p class="v6-kicker" data-fade>Free AI visibility scan</p>
        <h1 class="tk-scan__title" data-words set:html={split([{ t: "Does AI" }, { t: "Recommend Your Shop?", accent: true }])} />
        <p class="tk-scan__lead" data-fade style="--d:1">See where your shop appears in AI search—and which nearby shops may be winning the call.</p>
      </div>

      <div class="tk-scan__meta" data-fade style="--d:2">
        <span class="tk-scan__chip"><span class="tk-scan__chip-icon"><span class="v6-icon" style={icon("car-count")}></span></span> Built for auto repair</span>
        <span class="tk-scan__chip"><span class="tk-scan__chip-icon"><span class="v6-icon" style={icon("boost")}></span></span> About 60 seconds</span>
      </div>

      <div class="tk-scan__formwrap" data-fade style="--d:2">
        <div class="v6-glow tk-scan__glow">
          <form id="scan-form" class="v6-glow__inner tk-scan__form">
            <div class="tk-scan__field">
              <label class="tk-scan__label" for="shop-name">Shop name</label>
              <input id="shop-name" name="shopName" required autocomplete="organization" class="tk-scan__input" placeholder="e.g. Smith Auto Care" />
            </div>
            <div class="tk-scan__field">
              <label class="tk-scan__label" for="shop-location">City and state</label>
              <input id="shop-location" name="location" required autocomplete="address-level2" class="tk-scan__input" placeholder="e.g. Scottsdale, AZ" />
            </div>
            <div class="tk-scan__field">
              <label class="tk-scan__label" for="shop-specialty">Work you want more of <span class="tk-scan__optional">Optional</span></label>
              <input id="shop-specialty" name="specialty" class="tk-scan__input" placeholder="e.g. European repair, brakes, diagnostics" />
            </div>
            <button id="scan-submit" type="submit" class="v6-btn v6-btn--navy v6-btn--lg tk-scan__submit"><span data-scan-submit-label>Run My Free Scan</span> <i set:html={arrow} /></button>
            <p id="scan-error" class="tk-scan__error hidden"></p>
          </form>
        </div>
      </div>

      <div class="tk-scan__signals" data-fade style="--d:3">
        <p class="tk-scan__signals-title">Built from a live, AI-powered search of public signals</p>
        <div class="tk-scan__signals-list">
          <span class="tk-scan__signal"><span class="tk-scan__signal-icon"><span class="v6-icon" style={icon("location")}></span></span> Shop identity</span>
          <span class="tk-scan__signal"><span class="tk-scan__signal-icon"><span class="v6-icon" style={icon("weekly-planner")}></span></span> Service clarity</span>
          <span class="tk-scan__signal"><span class="tk-scan__signal-icon"><span class="v6-icon" style={icon("retention")}></span></span> Nearby context</span>
        </div>
      </div>
    </div>
  </section>

  <section id="scan-progress" class="tk-scan__progress hidden">
    <div class="v6-wrap">
      <div class="scan-progress-panel">
        <div class="tk-scan__progress-head">
          <span id="scan-stage-hero-icon" class="scan-stage-hero-icon" role="status" aria-label="Scan in progress">
            <span class="scan-stage-pulse scan-stage-pulse-left" aria-hidden="true"></span>
            <span class="scan-stage-pulse scan-stage-pulse-right" aria-hidden="true"></span>
            <span class="scan-icon scan-icon-location" aria-hidden="true"></span>
          </span>
          <p class="v6-kicker tk-scan__progress-kicker">Scan in progress</p>
          <h2 id="scan-stage-title" class="tk-scan__progress-title">Finding your shop</h2>
          <p id="scan-stage-detail" class="tk-scan__progress-detail">Checking what a driver can find about your business online.</p>
        </div>

        <div class="tk-scan__track-wrap">
          <div class="scan-progress-track" role="progressbar" aria-label="AI visibility scan progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="7">
            <span id="scan-progress-bar" class="scan-progress-bar" style="--scan-progress:7%"></span>
          </div>
        </div>

        <div class="scan-stage-grid" aria-live="polite">
          <div data-scan-stage="0" class="scan-stage-item scan-stage-active">
            <span class="scan-stage-marker"><span class="scan-icon scan-icon-location" aria-hidden="true"></span><span class="sr-only">Step 1</span></span>
            <span class="scan-stage-label">Finding your shop and location</span>
          </div>
          <div data-scan-stage="1" class="scan-stage-item">
            <span class="scan-stage-marker"><span class="scan-icon scan-icon-search" aria-hidden="true"></span><span class="sr-only">Step 2</span></span>
            <span class="scan-stage-label">Checking your services and specialties</span>
          </div>
          <div data-scan-stage="2" class="scan-stage-item">
            <span class="scan-stage-marker"><span class="scan-icon scan-icon-pages" aria-hidden="true"></span><span class="sr-only">Step 3</span></span>
            <span class="scan-stage-label">Comparing nearby shops</span>
          </div>
          <div data-scan-stage="3" class="scan-stage-item">
            <span class="scan-stage-marker"><span class="scan-icon scan-icon-ai" aria-hidden="true"></span><span class="sr-only">Step 4</span></span>
            <span class="scan-stage-label">Preparing your report</span>
          </div>
        </div>
        <p class="scan-progress-note"><span class="scan-icon scan-icon-clock" aria-hidden="true"></span>This usually takes less than a minute. You can keep this tab open.</p>
      </div>
    </div>
  </section>

  <section id="report-gate" class="tk-scan__gate hidden">
    <div class="v6-wrap">
      <div class="report-gate-shell">
        <div class="tk-scan__gate-head">
          <p class="tk-scan__ready"><span class="v6-mark v6-mark--check" aria-hidden="true"></span> Report ready</p>
          <p class="v6-kicker tk-scan__gate-kicker">Your report is built</p>
          <h2 class="tk-scan__gate-title" data-words set:html={split([{ t: "Your shop report is ready." }])} />
          <p class="tk-scan__gate-text">See whether AI mentioned <strong data-gate-shop>your shop</strong>, how it compared with nearby shops, and what to fix first.</p>
        </div>

        <div class="tk-scan__gate-list">
          <div class="tk-scan__gate-item"><span class="v6-mark v6-mark--check" aria-hidden="true"></span><span>See whether your shop showed up</span></div>
          <div class="tk-scan__gate-item"><span class="v6-mark v6-mark--check" aria-hidden="true"></span><span>Compare your shop with nearby options</span></div>
          <div class="tk-scan__gate-item"><span class="v6-mark v6-mark--check" aria-hidden="true"></span><span>Know what to fix first</span></div>
        </div>

        <div class="report-gate-unlock">
          <p class="v6-kicker">Unlock your report</p>
          <h3 class="tk-scan__unlock-title">See what drivers may learn about your shop.</h3>
          <p class="tk-scan__unlock-text">Enter your business email to see whether your shop appeared, what AI found, and what to improve first.</p>

          <form id="report-gate-form" class="tk-scan__unlock-form">
            <label class="tk-scan__label" for="report-email">Business email</label>
            <input id="report-email" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" class="tk-scan__input" placeholder="you@yourshop.com" />
            <button id="report-gate-submit" type="submit" class="v6-btn v6-btn--green v6-btn--lg tk-scan__submit"><span data-gate-submit-label>Reveal My Report</span> <i set:html={arrow} /></button>
            <p id="report-gate-error" class="tk-scan__error hidden"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section id="scan-results" class="report-dashboard tk-scan__results hidden">
    <div class="v6-wrap">
      <header class="report-heading">
        <p class="v6-kicker">Your AI visibility snapshot</p>
        <h2 class="tk-scan__results-title" data-words set:html={split([{ t: "AI Visibility Report" }])} />
        <div class="tk-scan__facts">
          <span class="tk-scan__fact tk-scan__fact--shop"><span data-result-shop>Your shop</span></span>
          <span class="tk-scan__dot" aria-hidden="true">•</span>
          <span class="tk-scan__fact"><span class="tk-scan__fact-icon"><span class="v6-icon" style={icon("location")}></span></span><span data-result-location>Local market</span></span>
          <span class="tk-scan__dot" aria-hidden="true">•</span>
          <span class="tk-scan__fact tk-scan__fact--done"><span class="v6-mark v6-mark--check" aria-hidden="true"></span>Scan complete</span>
          <span class="tk-scan__dot" aria-hidden="true">•</span>
          <span data-analysis-label class="tk-scan__analysis">Analysis: General auto repair</span>
        </div>
      </header>

      <article class="scan-results-report">
        <div class="tk-scan__top">
          <section class="report-card scan-score-panel">
            <p class="tk-scan__score-label">Overall AI visibility score</p>
            <div data-score-ring class="score-ring" style="--score:0">
              <div class="score-ring-inner"><span data-result-score class="tk-scan__score">—</span><span class="tk-scan__score-of">/100</span></div>
            </div>
            <p data-result-status class="report-status">Scan complete</p>
            <p class="tk-scan__score-note">A snapshot of public information and three recommendation checks—not a permanent ranking.</p>
          </section>

          <section class="scan-verdict-panel">
            <div class="tk-scan__verdict-inner">
              <div class="tk-scan__verdict-head"><span class="tk-scan__verdict-icon"><span class="v6-icon" style={icon("internet")}></span></span><h3>Overall verdict</h3></div>
              <p data-result-verdict class="tk-scan__verdict">Your result will appear here.</p>
              <div class="tk-scan__match"><span class="tk-scan__match-label">Business match: <span data-match-confidence>—</span></span><span class="tk-scan__match-dot">•</span><span data-confidence-note></span></div>
            </div>
          </section>
        </div>

        <section class="tk-scan__block" aria-labelledby="understood-heading">
          <div class="report-section-label"><span class="tk-scan__label-icon"><span class="v6-icon" style={icon("internet")}></span></span><h3 id="understood-heading">How AI understands your business</h3></div>
          <div data-result-understood class="tk-scan__understood"></div>
        </section>

        <div class="tk-scan__pair">
          <section class="report-card report-strip tk-scan__strip--gap">
            <span class="report-strip-icon tk-scan__alert" aria-hidden="true"></span>
            <div><h3 class="tk-scan__card-title">Biggest visibility gap</h3><p data-result-gap class="tk-scan__card-text"></p></div>
          </section>
          <section class="report-card report-strip">
            <span class="report-strip-icon tk-scan__strip-icon--blue"><span class="v6-icon" style={icon("report")}></span></span>
            <div class="tk-scan__grow">
              <h3 class="tk-scan__card-title">Recommendation performance</h3>
              <p class="tk-scan__card-text">Appeared in <strong><span data-checks-appeared>—</span> of <span data-checks-total>3</span></strong> recommendation checks.</p>
              <div class="tk-scan__meter" role="progressbar" aria-label="Recommendation checks that mentioned this shop" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0"><span data-recommendation-progress class="tk-scan__meter-bar" style="width:0%"></span></div>
            </div>
          </section>
        </div>

        <div class="tk-scan__split">
          <section class="tk-scan__block" aria-labelledby="competitive-position-heading">
            <div class="report-section-label"><span class="tk-scan__label-icon"><span class="v6-icon" style={icon("retention")}></span></span><h3 id="competitive-position-heading">Competitive insight</h3></div>
            <div class="report-card tk-scan__insight">
              <p class="tk-scan__mini">Business confidence</p>
              <div class="tk-scan__confidence"><span data-confidence-pill class="tk-scan__pill">High</span><span data-confidence-summary class="tk-scan__confidence-text">AI is confident it found the right business.</span></div>
              <div class="tk-scan__rule"></div>
              <p class="tk-scan__mini">What nearby shops did better</p>
              <p data-result-competitor class="tk-scan__card-text"></p>
            </div>
          </section>

          <section class="tk-scan__block" aria-labelledby="action-plan-heading">
            <div class="report-section-label"><span class="tk-scan__label-icon"><span class="v6-icon" style={icon("target")}></span></span><h3 id="action-plan-heading">Action plan</h3></div>
            <div class="tk-scan__actions">
              <div class="report-action-card tk-scan__action--good">
                <span class="report-action-icon"><span class="v6-mark v6-mark--check" aria-hidden="true"></span></span>
                <div><h4 class="tk-scan__card-title">What is working</h4><p data-result-working class="tk-scan__card-text">AI found clear public information about your shop.</p></div>
              </div>
              <div class="report-action-card tk-scan__action--fix">
                <span class="report-action-icon"><span class="v6-icon" style={icon("weekly-planner")}></span></span>
                <div class="tk-scan__grow">
                  <h4 class="tk-scan__card-title">What to fix first</h4>
                  <p data-result-cta class="tk-scan__card-text"></p>
                  <div class="tk-scan__cta-row">
                    <a href={CONSULTATION_URL} class="v6-btn v6-btn--navy" data-track-event="consultation_cta_click" data-track-placement="ai_visibility_results_bottom"><span>Book a Strategy Call</span> <i set:html={arrow} /></a>
                    <a href="/resources/ai-search-for-auto-repair-shops#action-plan" class="v6-link">Use the 30-day plan</a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>

        <div class="tk-scan__how">
          <p><strong>How the score works:</strong> public facts contribute <span data-foundation-score>—</span>/40 and recommendation checks contribute <span data-recommendation-score>—</span>/60.</p>
          <a href="/resources/ai-search-for-auto-repair-shops" class="v6-link v6-link--light">Learn about AI search <i set:html={arrow} /></a>
        </div>
      </article>
    </div>
  </section>

  <section id="schedule" class="tk-scan__schedule hidden"><div class="v6-wrap"><div class="tk-scan__schedule-head"><p class="v6-kicker">Want help fixing it?</p><h2 class="tk-scan__schedule-title" data-words set:html={split([{ t: "Let’s turn this report into a" }, { t: "practical plan.", accent: true }])} /><p class="tk-scan__schedule-text">We’ll show you what to update first, what can wait, and how to make your shop easier for the right drivers to find.</p></div><div class="tk-scan__sheet"><iframe src={APPOINTMENTCORE_BOOKING_URL} title="Schedule an AI visibility review with Turnkey Marketing" width="100%" height="800" class="tk-scan__frame" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div><script is:inline src="https://go.appointmentcore.com/frontend/js/app/booking-link-embed-helper.js?v=1786635857"></script></section>

  <script is:inline>
    const form = document.querySelector("#scan-form");
    const submit = document.querySelector("#scan-submit");
    const submitLabel = document.querySelector("[data-scan-submit-label]");
    const error = document.querySelector("#scan-error");
    const progress = document.querySelector("#scan-progress");
    const gate = document.querySelector("#report-gate");
    const gateForm = document.querySelector("#report-gate-form");
    const gateSubmit = document.querySelector("#report-gate-submit");
    const gateSubmitLabel = document.querySelector("[data-gate-submit-label]");
    const gateError = document.querySelector("#report-gate-error");
    const results = document.querySelector("#scan-results");
    const schedule = document.querySelector("#schedule");
    const stageTitle = document.querySelector("#scan-stage-title");
    const stageDetail = document.querySelector("#scan-stage-detail");
    const stageHeroIcon = document.querySelector("#scan-stage-hero-icon .scan-icon");
    const progressBar = document.querySelector("#scan-progress-bar");
    const progressTrack = document.querySelector("[role='progressbar']");
    const stageMessages = [
      ["Finding your shop", "Checking what a driver can find about your business online."],
      ["Checking your services", "Looking for clear information about your location, repairs, and specialties."],
      ["Comparing nearby shops", "Seeing which local shops are easiest for AI to understand and suggest."],
      ["Building your report", "Summing up what is working and what to fix first."],
    ];
    const stageIcons = ["location", "search", "pages", "ai"];
    const stageThresholds = [0, 28, 48, 68];
    let progressTimer;
    let stageIndex = 0;
    let pendingReportToken = "";
    let pendingScanContext = { location: "", specialty: "" };
    const setText = (selector, value) => document.querySelector(selector)?.replaceChildren(document.createTextNode(value ?? ""));
    const cleanResultText = (value) => String(value || "")
      .replace(/\[([^\]]+)\]\(https?:\/\/[^)]+\)/gi, "$1")
      .replace(/https?:\/\/\S+/gi, "")
      .replace(/\s*\([^)]*\b(?:\.com|\.net|\.org|\.co|\.io)\b[^)]*\)/gi, "")
      .replace(/【[^】]+】/g, "")
      .replace(/\s+/g, " ")
      .replace(/\s+([,.;:!?])/g, "$1")
      .trim();
    const shortText = (value, max = 260) => {
      const text = cleanResultText(value);
      return text.length > max ? `${text.slice(0, max - 1).trim()}…` : text;
    };
    const showList = (items) => {
      const list = document.querySelector("[data-result-understood]");
      if (!list) return;
      const labels = ["Business identity", "Service information", "Public proof"];
      list.replaceChildren(...(items || []).slice(0, 3).map((item, index) => {
        const card = document.createElement("article");
        card.className = "report-card understood-card";
        const check = document.createElement("span");
        check.className = "inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[var(--navy)] text-sm font-bold text-white";
        check.textContent = "✓";
        check.setAttribute("aria-hidden", "true");
        const content = document.createElement("div");
        const label = document.createElement("h4");
        label.className = "font-display text-base font-semibold text-[var(--navy-deep)]";
        label.textContent = labels[index] || "Confirmed detail";
        const copy = document.createElement("p");
        copy.className = "mt-2 text-sm leading-relaxed text-charcoal/62";
        copy.textContent = shortText(item, 140);
        content.append(label, copy);
        card.append(check, content);
        return card;
      }));
      setText("[data-result-working]", shortText(items?.[0], 150) || "AI found clear public information about your shop.");
    };
    const scoreStatus = (score) => score < 40 ? "Not showing up yet" : score < 60 ? "Some important gaps" : score < 80 ? "Good starting point" : "Easy to understand";
    const showRecommendationChecks = (items, appearedValue) => {
      const checks = Array.isArray(items) ? items.slice(0, 3) : [];
      const appeared = Math.max(0, Math.min(checks.length, Number(appearedValue) || 0));
      setText("[data-checks-appeared]", String(appeared));
      setText("[data-checks-total]", String(checks.length));
      const summaries = ["Not mentioned in these checks", "Mentioned once", "Mentioned in most checks", "Mentioned in every check"];
      setText("[data-check-summary]", summaries[appeared] || summaries[0]);
      const progress = checks.length ? Math.round((appeared / checks.length) * 100) : 0;
      const progressBar = document.querySelector("[data-recommendation-progress]");
      progressBar?.setAttribute("style", `width:${progress}%`);
      progressBar?.parentElement?.setAttribute("aria-valuenow", String(appeared));
      const list = document.querySelector("[data-recommendation-checks]");
      if (!list) return;
      list.replaceChildren(...checks.map((check) => {
        const row = document.createElement("article");
        row.className = "recommendation-check";
        const marker = document.createElement("span");
        marker.className = `recommendation-check-marker ${check.appeared ? "recommendation-check-found" : "recommendation-check-missing"}`;
        marker.textContent = check.appeared ? "✓" : "—";
        marker.setAttribute("aria-label", check.appeared ? "Shop mentioned" : "Shop not mentioned");
        const content = document.createElement("div");
        const heading = document.createElement("h5");
        heading.className = "recommendation-check-query";
        heading.textContent = shortText(check.query, 100);
        const finding = document.createElement("p");
        finding.className = "recommendation-check-finding";
        finding.textContent = shortText(check.finding, 150);
        const context = document.createElement("p");
        context.className = "recommendation-check-context";
        const alternatives = Math.max(0, Number(check.alternativesShown) || 0);
        context.textContent = `${alternatives} other shop${alternatives === 1 ? "" : "s"} considered`;
        content.append(heading, finding, context);
        row.append(marker, content);
        return row;
      }));
    };
    const renderReport = (payload) => {
      const hasScore = payload.score !== null && Number.isFinite(Number(payload.score));
      const score = hasScore ? Math.max(0, Math.min(100, Number(payload.score))) : 0;
      setText("[data-result-shop]", shortText(payload.shopName, 90));
      setText("[data-result-location]", shortText(payload.location || pendingScanContext.location, 70) || "Local market");
      const specialty = shortText(payload.specialty || pendingScanContext.specialty, 80) || "General auto repair";
      setText("[data-analysis-label]", `Analysis: ${specialty}`);
      setText("[data-result-score]", hasScore ? String(score) : "—");
      setText("[data-foundation-score]", hasScore ? String(Number(payload.foundationScore) || 0) : "—");
      setText("[data-recommendation-score]", hasScore ? String(Number(payload.recommendationScore) || 0) : "—");
      setText("[data-result-status]", hasScore ? scoreStatus(score) : "Shop match needs review");
      const scoreTone = !hasScore ? "caution" : score < 40 ? "danger" : score < 60 ? "caution" : "positive";
      document.querySelector("[data-result-status]")?.setAttribute("data-score-tone", scoreTone);
      const confidence = ["high", "medium", "low"].includes(payload.matchConfidence) ? payload.matchConfidence : "low";
      setText("[data-match-confidence]", `${confidence.charAt(0).toUpperCase()}${confidence.slice(1)}`);
      setText("[data-confidence-pill]", `${confidence.charAt(0).toUpperCase()}${confidence.slice(1)}`);
      document.querySelector("[data-confidence-pill]")?.setAttribute("data-confidence", confidence);
      const confidenceSummaries = {
        high: "AI is confident it found the right business.",
        medium: "Most details align, but the match is not complete.",
        low: "The business match needs a closer review.",
      };
      setText("[data-confidence-summary]", confidenceSummaries[confidence]);
      setText("[data-confidence-note]", shortText(payload.confidenceNote, 150));
      setText("[data-result-verdict]", shortText(payload.verdict, 125));
      setText("[data-result-gap]", shortText(payload.gap, 190));
      setText("[data-result-competitor]", shortText(payload.competitor, 170));
      setText("[data-result-cta]", shortText(payload.cta, 170));
      const scoreColor = !hasScore || score < 40 ? "#c9544a" : score < 60 ? "#d5a136" : "var(--green)";
      document.querySelector("[data-score-ring]")?.setAttribute("style", `--score:${score};--score-color:${scoreColor}`);
      showList(payload.understood);
      showRecommendationChecks(payload.recommendationChecks, payload.checksAppeared);
    };
    if (window.location.hostname === "127.0.0.1" && new URLSearchParams(window.location.search).get("preview") === "report") {
      renderReport({
        shopName: "Snyder Automotive Inc",
        location: "Blue Springs, MO",
        specialty: "Brake repair",
        score: 60,
        foundationScore: 40,
        recommendationScore: 20,
        matchConfidence: "high",
        confidenceNote: "The business name, Blue Springs location, and official website align.",
        verdict: "Your shop appeared once, but nearby repair shops were easier to verify and recommend.",
        gap: "Brake repair is not described clearly enough across the website and public listings.",
        understood: [
          "The shop name and Blue Springs location are easy to confirm.",
          "The official website lists general automotive service and repair.",
          "Public reviews show an established history with local drivers.",
        ],
        recommendationChecks: [
          { query: "Auto repair shop in Blue Springs", appeared: false, alternativesShown: 5, finding: "Other local shops had clearer repair categories and review coverage." },
          { query: "Brake repair in Blue Springs", appeared: true, alternativesShown: 4, finding: "Your shop appeared alongside four nearby brake-service options." },
          { query: "Where to get brake repair near Blue Springs", appeared: false, alternativesShown: 5, finding: "Specialists gave drivers more specific brake-service proof." },
        ],
        checksAppeared: 1,
        competitor: "Nearby shops described brake work more clearly and had stronger service-specific review language.",
        cta: "Add a focused brake-repair page and reinforce that service in listings and review requests.",
      });
      results?.classList.remove("hidden");
    }
    const updateStage = () => {
      const [title, detail] = stageMessages[stageIndex];
      if (stageTitle) stageTitle.textContent = title;
      if (stageDetail) stageDetail.textContent = detail;
      if (stageHeroIcon) stageHeroIcon.className = `scan-icon scan-icon-${stageIcons[stageIndex]}`;
      document.querySelectorAll("[data-scan-stage]").forEach((item, index) => {
        item.classList.toggle("scan-stage-active", index === stageIndex);
        item.classList.toggle("scan-stage-complete", index < stageIndex);
      });
    };
    const setScanProgress = (value) => {
      const percent = Math.max(0, Math.min(100, value));
      if (progressBar) progressBar.style.setProperty("--scan-progress", `${percent}%`);
      progressTrack?.setAttribute("aria-valuenow", String(Math.round(percent)));
      const nextStage = stageThresholds.reduce((current, threshold, index) => percent >= threshold ? index : current, 0);
      if (nextStage !== stageIndex) {
        stageIndex = nextStage;
        updateStage();
      }
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      pendingReportToken = "";
      pendingScanContext = {
        location: String(data.location || ""),
        specialty: String(data.specialty || "") || "General auto repair",
      };
      error.classList.add("hidden");
      gateError?.classList.add("hidden");
      gate?.classList.add("hidden");
      results.classList.add("hidden");
      schedule.classList.add("hidden");
      submit.disabled = true;
      if (submitLabel) submitLabel.textContent = "Running scan…";
      progress.classList.remove("hidden");
      progress.scrollIntoView({ behavior: "smooth", block: "center" });
      window.clearInterval(progressTimer);
      stageIndex = 0;
      updateStage();
      setScanProgress(7);
      const progressStartedAt = window.performance.now();
      progressTimer = window.setInterval(() => {
        const elapsed = window.performance.now() - progressStartedAt;
        const nextProgress = Math.min(95, 7 + 90 * (1 - Math.exp(-elapsed / 30000)));
        setScanProgress(nextProgress);
      }, 500);

      try {
        const response = await fetch("/api/visibility-scan", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const payload = await response.json();
        if (!response.ok || !payload.reportToken) {
          throw new Error(payload.error || "We could not complete the scan.");
        }

        window.clearInterval(progressTimer);
        setScanProgress(100);
        await new Promise((resolve) => window.setTimeout(resolve, 900));
        pendingReportToken = payload.reportToken;
        setText("[data-gate-shop]", shortText(payload.shopName, 90));
        progress.classList.add("hidden");
        gate?.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run Another Scan";
        gate?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => document.querySelector("#report-email")?.focus({ preventScroll: true }), 650);
      } catch (scanError) {
        window.clearInterval(progressTimer);
        progress.classList.add("hidden");
        error.textContent = scanError.message || "Something went wrong. Please try again.";
        error.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run My Free Scan";
      }
    });

    gateForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      gateError?.classList.add("hidden");
      gateSubmit.disabled = true;
      if (gateSubmitLabel) gateSubmitLabel.textContent = "Unlocking report…";

      try {
        const email = new FormData(gateForm).get("email");
        const response = await fetch("/api/visibility-scan-unlock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, reportToken: pendingReportToken }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || "We couldn't unlock your report yet.");

        renderReport(payload);
        gate?.classList.add("hidden");
        results.classList.remove("hidden");
        schedule.classList.remove("hidden");
        pendingReportToken = "";
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Report Unlocked";
        results.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (unlockError) {
        gateError.textContent = unlockError.message || "We couldn't unlock your report yet. Please try again.";
        gateError.classList.remove("hidden");
        gateSubmit.disabled = false;
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Reveal My Report";
      }
    });
  </script>

