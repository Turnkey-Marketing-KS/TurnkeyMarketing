---
import { ArrowRight, CircleCheckBig, ListChecks, LockKeyhole, Search, ShieldCheck, Trophy, TriangleAlert } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { APPOINTMENTCORE_BOOKING_URL, CONSULTATION_URL } from "@/lib/services";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "AI Visibility Scan for Auto Repair Shops",
  description: "See how clearly AI-powered searches understand your auto repair shop.",
  url: "https://www.turnkeyautomarketing.com/ai-visibility-scan",
};
---

<BaseLayout
  title="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  description="See how clearly AI-powered searches understand and recommend your auto repair shop."
  path="/ai-visibility-scan"
  ogTitle="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  schema={reportSchema}
>
  <main class="min-h-screen bg-[var(--off-white)]">
    <section class="ai-scan-hero relative overflow-hidden bg-[linear-gradient(135deg,#fff_0%,#f6faff_62%,#edf4fc_100%)] py-14 md:py-20 lg:py-24">
      <span class="pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-[var(--key-blue-soft)]/60 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-48 left-1/3 h-80 w-80 rounded-full bg-[var(--green)]/10 blur-3xl" aria-hidden="true"></span>
      <div class="container-page relative">
        <div class="ai-scan-hero-grid relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[.96fr_1.04fr] lg:items-center lg:gap-14 xl:gap-20">
          <div class="ai-scan-hero-copy relative z-10 text-center md:text-left">
            <p class="eyebrow text-[var(--key-blue)]">Free AI visibility scan</p>
            <h1 class="display-1 mt-6 max-w-[11ch] text-charcoal md:max-w-[12ch]">Does AI <span class="text-[var(--key-blue)]">Recommend Your Shop?</span></h1>
            <p class="mx-auto mt-7 max-w-[42ch] text-lg leading-relaxed text-charcoal/65 md:mx-0 md:text-xl">See where your shop appears in AI search—and which nearby shops may be winning the call.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-3 text-sm text-charcoal/55 md:justify-start">
              <span class="inline-flex items-center gap-2"><ShieldCheck className="h-4 w-4 text-[var(--key-blue)]" /> Built for auto repair</span>
              <span class="inline-flex items-center gap-2"><span class="scan-icon scan-icon-clock h-4 w-4 text-[var(--key-blue)]" aria-hidden="true"></span> About 60 seconds</span>
            </div>
          </div>

          <div class="relative z-10 mx-auto w-full max-w-[470px] lg:mr-4">
            <form id="scan-form" class="relative overflow-hidden rounded-[30px] border border-[rgba(35,46,102,.12)] bg-white shadow-[0_34px_90px_-42px_rgba(20,30,78,.62)]">
              <div class="p-6 md:p-8 lg:p-9">
                <label class="block text-sm font-medium text-charcoal" for="shop-name">Shop name</label>
                <input id="shop-name" name="shopName" required autocomplete="organization" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. Smith Auto Care" />
                <label class="mt-5 block text-sm font-medium text-charcoal" for="shop-location">City and state</label>
                <input id="shop-location" name="location" required autocomplete="address-level2" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. Scottsdale, AZ" />
                <label class="mt-5 block text-sm font-medium text-charcoal" for="shop-specialty">Work you want more of <span class="font-normal text-charcoal/40">Optional</span></label>
                <input id="shop-specialty" name="specialty" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. European repair, brakes, diagnostics" />
                <button id="scan-submit" type="submit" class="btn-primary mt-7 h-13 w-full !bg-[linear-gradient(100deg,var(--key-blue),var(--navy))] !px-5 shadow-[0_18px_38px_-22px_rgba(35,46,102,.75)] hover:!bg-[var(--navy-deep)] disabled:cursor-wait disabled:opacity-70"><span data-scan-submit-label>Run My Free Scan</span> <ArrowRight class="h-4 w-4" /></button>
                <p id="scan-error" class="mt-4 hidden rounded-2xl bg-red-50 p-3 text-sm leading-relaxed text-red-700"></p>
              </div>
            </form>
          </div>
        </div>

        <div class="ai-scan-platform relative z-10 mx-auto mt-12 flex max-w-6xl flex-col gap-4 rounded-[22px] border border-[rgba(35,46,102,.1)] bg-white/90 px-5 py-4 shadow-[0_18px_55px_-42px_rgba(35,46,102,.45)] backdrop-blur sm:flex-row sm:items-center sm:justify-between md:px-7">
          <p class="text-sm font-semibold text-[var(--navy)]">Built from a live, AI-powered search of public signals</p>
          <div class="ai-scan-platform-list flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-charcoal/58">
            <span class="ai-scan-platform-item inline-flex items-center gap-2"><Search className="h-4 w-4 text-[var(--key-blue)]" /> Shop identity</span>
            <span class="ai-scan-platform-item inline-flex items-center gap-2"><ListChecks className="h-4 w-4 text-[var(--key-blue)]" /> Service clarity</span>
            <span class="ai-scan-platform-item inline-flex items-center gap-2"><Trophy className="h-4 w-4 text-[var(--key-blue)]" /> Nearby context</span>
          </div>
        </div>
      </div>
    </section>

    <section id="scan-progress" class="relative hidden overflow-hidden bg-[#f3f7fd] py-14 md:py-20">
      <span class="pointer-events-none absolute -left-28 top-0 h-80 w-80 rounded-full bg-[var(--key-blue)]/8 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-[var(--green)]/8 blur-3xl" aria-hidden="true"></span>
      <div class="container-page relative">
        <div class="scan-progress-panel mx-auto max-w-5xl rounded-[32px] border border-[rgba(35,46,102,.1)] bg-white px-5 py-9 shadow-[0_34px_85px_-52px_rgba(35,46,102,.45)] sm:px-8 md:rounded-[38px] md:px-12 md:py-12 lg:px-16">
          <div class="text-center">
            <span id="scan-stage-hero-icon" class="scan-stage-hero-icon" role="status" aria-label="Scan in progress">
              <span class="scan-stage-pulse scan-stage-pulse-left" aria-hidden="true"></span>
              <span class="scan-stage-pulse scan-stage-pulse-right" aria-hidden="true"></span>
              <span class="scan-icon scan-icon-location" aria-hidden="true"></span>
            </span>
            <p class="eyebrow mt-6 text-[var(--key-blue)]">Scan in progress</p>
            <h2 id="scan-stage-title" class="mx-auto mt-3 max-w-[19ch] font-display text-[clamp(2.15rem,4.2vw,3.65rem)] font-semibold leading-[1.02] tracking-[-.045em] text-[var(--navy-deep)]">Finding your shop</h2>
            <p id="scan-stage-detail" class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-charcoal/62 md:text-lg">Checking what a driver can find about your business online.</p>
          </div>

          <div class="mx-auto mt-8 max-w-2xl">
            <div class="scan-progress-track" role="progressbar" aria-label="AI visibility scan progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="25">
              <span id="scan-progress-bar" class="scan-progress-bar" style="--scan-progress:25%"></span>
            </div>
          </div>

          <div class="scan-stage-grid mt-9" aria-live="polite">
            <div data-scan-stage="0" class="scan-stage-item scan-stage-active">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-location" aria-hidden="true"></span><span class="sr-only">Step 1</span></span>
              <span class="scan-stage-label">Finding your shop and location</span>
            </div>
            <div data-scan-stage="1" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-search" aria-hidden="true"></span><span class="sr-only">Step 2</span></span>
              <span class="scan-stage-label">Checking your services and specialties</span>
            </div>
            <div data-scan-stage="2" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-pages" aria-hidden="true"></span><span class="sr-only">Step 3</span></span>
              <span class="scan-stage-label">Comparing nearby shops</span>
            </div>
            <div data-scan-stage="3" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-ai" aria-hidden="true"></span><span class="sr-only">Step 4</span></span>
              <span class="scan-stage-label">Preparing your report</span>
            </div>
          </div>
          <p class="scan-progress-note mt-8 text-center text-sm text-charcoal/52"><span class="scan-icon scan-icon-ai" aria-hidden="true"></span>This usually takes less than a minute. You can keep this tab open.</p>
        </div>
      </div>
    </section>

    <section id="report-gate" class="hidden bg-[linear-gradient(180deg,var(--off-white)_0%,#fff_100%)] py-14 md:py-24">
      <div class="container-page">
        <div class="mx-auto max-w-6xl">
          <div class="mb-7 flex justify-center">
            <div class="inline-flex items-center gap-2 rounded-full bg-[#eaf3dc] px-4 py-2 text-sm font-semibold text-[#557f20] ring-1 ring-[#6d9b2f]/15">
              <CircleCheckBig class="h-4 w-4" /> Report ready
            </div>
          </div>

          <div class="report-gate-shell overflow-hidden rounded-[36px] bg-[linear-gradient(140deg,var(--navy)_0%,var(--navy-deep)_100%)] shadow-[0_38px_100px_-58px_rgba(20,22,28,.7)]">
            <div class="grid lg:grid-cols-[1.08fr_.92fr]">
              <div class="report-gate-summary relative overflow-hidden p-7 text-white md:p-11 lg:p-14">
                <span class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[var(--key-blue)]/25 blur-3xl" aria-hidden="true"></span>
                <span class="pointer-events-none absolute -bottom-32 right-0 h-72 w-72 rounded-full bg-[var(--green)]/10 blur-3xl" aria-hidden="true"></span>
                <div class="relative">
                  <p class="eyebrow text-[#9ed8f0]">Your report is built</p>
                  <h2 class="mt-5 max-w-[13ch] font-display text-[clamp(2.5rem,5vw,4.7rem)] font-semibold leading-[.98] tracking-[-.055em]">Your shop report is ready.</h2>
                  <p class="mt-6 max-w-[42rem] text-lg leading-relaxed text-white/68">See whether AI mentioned <strong data-gate-shop class="font-semibold text-white">your shop</strong>, how it compared with nearby shops, and what to fix first.</p>

                  <div class="mt-9 max-w-xl border-y border-white/12">
                    <div class="flex items-center gap-3 border-b border-white/12 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">See whether your shop showed up</span></div>
                    <div class="flex items-center gap-3 border-b border-white/12 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">Compare your shop with nearby options</span></div>
                    <div class="flex items-center gap-3 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">Know what to fix first</span></div>
                  </div>
                </div>
              </div>

              <div class="report-gate-unlock m-2 rounded-[30px] bg-white p-6 md:m-3 md:p-9 lg:flex lg:flex-col lg:justify-center lg:p-11">
                <div class="flex items-center justify-between gap-5">
                  <p class="eyebrow text-[var(--key-blue)]">Unlock your report</p>
                  <LockKeyhole class="h-7 w-7 text-[var(--navy)]" />
                </div>
                <h3 class="mt-5 font-display text-[clamp(2rem,3.6vw,3rem)] font-semibold leading-[1.02] tracking-[-.04em] text-charcoal">See what drivers may learn about your shop.</h3>
                <p class="mt-5 leading-relaxed text-charcoal/62">Enter your business email to see whether your shop appeared, what AI found, and what to improve first.</p>

                <form id="report-gate-form" class="mt-7">
                  <label class="block text-sm font-semibold text-charcoal" for="report-email">Business email</label>
                  <input id="report-email" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" class="mt-2 h-13 w-full rounded-2xl border border-[rgba(35,46,102,.24)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.4)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="you@yourshop.com" />
                  <button id="report-gate-submit" type="submit" class="btn-primary mt-4 h-13 w-full !bg-[var(--green)] !px-5 !text-charcoal shadow-[0_16px_36px_-20px_rgba(95,143,34,.75)] hover:!bg-[var(--key-blue)] hover:!text-white disabled:cursor-wait disabled:opacity-70"><span data-gate-submit-label>Reveal My Report</span> <ArrowRight class="h-4 w-4" /></button>
                  <p id="report-gate-error" class="mt-4 hidden rounded-2xl bg-red-50 p-3 text-sm leading-relaxed text-red-700"></p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="scan-results" class="hidden scroll-mt-28 bg-white py-12 md:py-24">
      <div class="container-page">
        <div class="mx-auto max-w-6xl">
          <div class="report-heading mb-9 border-b border-[var(--hairline)] pb-8 md:mb-12 md:pb-10">
            <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
              <div>
                <p class="eyebrow text-[var(--key-blue)]">What AI found about your shop</p>
                <h2 class="mt-4 max-w-[18ch] font-display text-[clamp(2.45rem,5.2vw,4.8rem)] font-semibold leading-[.96] tracking-[-.055em] text-charcoal"><span data-result-shop>Your shop</span></h2>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-charcoal/65">Here is what showed up, how your shop compared with nearby options, and the first thing we would improve.</p>
              </div>
              <div class="inline-flex w-fit items-center gap-3 rounded-full bg-[var(--navy)] py-2 pl-2 pr-4 text-white shadow-[0_16px_34px_-24px_rgba(35,46,102,.75)]">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-[var(--navy)]"><CircleCheckBig class="h-5 w-5" /></span>
                <span class="text-sm font-semibold">Scan complete</span>
              </div>
            </div>
          </div>

          <article class="scan-results-report space-y-6 md:space-y-8">
            <div class="grid gap-6 lg:grid-cols-[340px_1fr] md:gap-8">
              <section class="scan-score-panel relative overflow-hidden rounded-[32px] bg-[linear-gradient(155deg,var(--navy)_0%,var(--navy-deep)_100%)] p-8 text-white shadow-[0_32px_72px_-50px_rgba(35,46,102,.9)] md:p-10">
                <span class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-[var(--key-blue)]/25 blur-3xl"></span>
                <div class="relative">
                  <p class="eyebrow text-[#9ed8f0]">How clear your shop looks online</p>
                  <div data-score-ring class="score-ring mx-auto mt-8 lg:mx-0" style="--score:0">
                    <div class="score-ring-inner"><span data-result-score class="font-display text-6xl font-semibold tracking-[-.07em]">—</span><span class="mt-1 text-xs text-white/45">out of 100</span></div>
                  </div>
                  <div class="mt-8 border-t border-white/15 pt-5">
                    <p class="eyebrow text-white/45">In plain English</p>
                    <p data-result-status class="mt-2 font-display text-2xl font-semibold">Scan complete</p>
                  </div>
                  <p class="mt-5 text-xs leading-relaxed text-white/48">This score is based on what the scan could find online today.</p>
                </div>
              </section>

              <section class="scan-verdict-panel relative overflow-hidden rounded-[32px] border border-[rgba(35,46,102,.14)] bg-white p-8 shadow-[0_30px_70px_-56px_rgba(35,46,102,.6)] md:p-12 lg:p-14">
                <span class="absolute inset-y-0 left-0 w-1.5 bg-[var(--key-blue)]" aria-hidden="true"></span>
                <div class="relative">
                  <p class="eyebrow text-[var(--key-blue)]">The short answer</p>
                  <h3 data-result-verdict class="mt-5 max-w-[26ch] font-display text-[clamp(2rem,3.4vw,3.15rem)] font-semibold leading-[1.03] tracking-[-.045em] text-charcoal">Your result will appear here.</h3>
                  <p class="mt-6 max-w-[58ch] leading-relaxed text-charcoal/62">This is one scan, not a permanent ranking. It shows whether AI found enough clear information and proof to suggest your shop to a driver.</p>
                  <a href="/resources/ai-search-for-auto-repair-shops" class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--navy)] underline decoration-[rgba(64,145,209,.45)] decoration-2 underline-offset-4 transition hover:decoration-[var(--key-blue)]">Learn how AI chooses which shops to mention <ArrowRight class="h-4 w-4" /></a>
                </div>
              </section>
            </div>

            <div class="grid gap-6 lg:grid-cols-[1.08fr_.92fr] md:gap-8">
              <section class="relative overflow-hidden rounded-[30px] border border-[rgba(35,46,102,.13)] bg-white p-6 shadow-[0_26px_64px_-52px_rgba(35,46,102,.58)] md:p-8">
                <span class="absolute inset-y-0 left-0 w-1.5 bg-[var(--key-blue)]" aria-hidden="true"></span>
                <div class="flex items-center gap-3"><span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--navy)] text-white"><CircleCheckBig class="h-5 w-5" /></span><div><p class="eyebrow text-[var(--key-blue)]">What is working</p><h4 class="mt-1 font-display text-2xl font-semibold text-charcoal">What AI could clearly find</h4></div></div>
                <ul data-result-understood class="mt-7 divide-y divide-[var(--hairline)]"></ul>
              </section>

              <section class="relative overflow-hidden rounded-[30px] bg-[linear-gradient(145deg,var(--navy)_0%,var(--navy-deep)_100%)] p-6 text-white shadow-[0_30px_68px_-48px_rgba(35,46,102,.9)] md:p-8">
                <div class="relative flex items-center gap-3"><span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-[var(--navy)]"><TriangleAlert class="h-5 w-5" /></span><div><p class="eyebrow text-[#9ed8f0]">What to fix first</p><h4 class="mt-1 font-display text-2xl font-semibold text-white">What may be costing you calls</h4></div></div>
                <p data-result-gap class="relative mt-7 text-lg font-medium leading-relaxed text-white/82"></p>
                <p class="relative mt-6 border-t border-white/15 pt-5 text-sm leading-relaxed text-white/58">Fix this one issue first. A clear improvement here is worth more than chasing every new AI tool.</p>
              </section>
            </div>

            <section class="rounded-[32px] border border-[rgba(35,46,102,.13)] bg-white p-6 shadow-[0_28px_70px_-56px_rgba(35,46,102,.55)] md:p-10" aria-labelledby="competitive-position-heading">
              <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
                <div class="flex items-center gap-4"><span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--navy)] text-white"><Trophy class="h-6 w-6" /></span><div><p class="eyebrow text-[var(--key-blue)]">How you compared</p><h4 id="competitive-position-heading" class="mt-1 font-display text-2xl font-semibold text-charcoal">Did AI mention your shop?</h4></div></div>
                <span class="w-fit rounded-full bg-[var(--navy)] px-4 py-2 text-[10px] font-semibold uppercase tracking-[.14em] text-white">Today’s scan</span>
              </div>

              <div class="mt-8 grid gap-7 md:grid-cols-[220px_1fr] md:items-center md:gap-10">
                <div class="rounded-[26px] bg-[var(--navy)] p-6 text-white shadow-[0_24px_56px_-42px_rgba(35,46,102,.8)]">
                  <p class="eyebrow text-[#9ed8f0]">Your result</p>
                  <p data-rank-found class="mt-4 font-display text-6xl font-semibold leading-none tracking-[-.06em]">#<span data-rank-position>—</span></p>
                  <p data-rank-missing class="mt-4 hidden font-display text-4xl font-semibold leading-[.95] tracking-[-.045em]">Not mentioned</p>
                  <p class="mt-2 text-sm text-white/58">of <span data-rank-total>—</span> shops checked</p>
                  <div data-rank-ahead-copy class="mt-5 border-t border-white/15 pt-4 text-sm font-semibold text-white"><span data-shops-ahead>—</span> recommended before you</div>
                  <div data-rank-missing-copy class="mt-5 hidden border-t border-white/15 pt-4 text-sm font-semibold text-white">AI suggested other nearby shops instead</div>
                </div>

                <div>
                  <div data-rank-track class="rank-track" aria-label="Competitive recommendation order"></div>
                  <p data-result-competitor class="mt-6 max-w-2xl text-base leading-relaxed text-charcoal/65"></p>
                </div>
              </div>
            </section>
          </article>

          <div class="scan-results-cta relative mt-8 overflow-hidden rounded-[32px] bg-[linear-gradient(135deg,var(--key-blue),var(--navy)_58%,var(--navy-deep))] p-7 text-white shadow-[0_30px_72px_-48px_rgba(35,46,102,.85)] md:p-10">
            <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-end md:gap-10">
              <div class="max-w-2xl"><p class="eyebrow text-[#b7e3f4]">What to do next</p><h3 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-[-.035em] md:text-4xl">Help more drivers find and choose your shop.</h3><p data-result-cta class="mt-4 leading-relaxed text-white/72"></p></div>
              <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
                <a href={CONSULTATION_URL} class="btn-primary w-full shrink-0 justify-center !bg-[var(--green)] !text-charcoal hover:!bg-white sm:w-auto" data-track-event="consultation_cta_click" data-track-placement="ai_visibility_results_bottom">Review this with Turnkey <ArrowRight class="h-4 w-4" /></a>
                <a href="/resources/ai-search-for-auto-repair-shops#action-plan" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full border border-white bg-transparent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white hover:text-[var(--navy)] sm:w-auto">Use the 30-day plan</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="schedule" class="hidden scroll-mt-24 bg-white py-14 md:py-20"><div class="container-page"><div class="mx-auto max-w-5xl text-center"><p class="eyebrow text-[var(--key-blue)]">Want help fixing it?</p><h2 class="display-2 mt-4 text-charcoal">Let’s turn this report into a practical plan.</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-charcoal/65">We’ll show you what to update first, what can wait, and how to make your shop easier for the right drivers to find.</p><div class="mt-9 overflow-hidden rounded-[30px] bg-[var(--off-white)] text-left shadow-[0_28px_70px_-48px_rgba(20,22,28,.35)] ring-1 ring-black/5"><iframe src={APPOINTMENTCORE_BOOKING_URL} title="Schedule an AI visibility review with Turnkey Marketing" width="100%" height="800" class="block min-h-[800px] w-full border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></div><script is:inline src="https://go.appointmentcore.com/frontend/js/app/booking-link-embed-helper.js?v=1786635857"></script></section>
  </main>

  <script is:inline>
    const form = document.querySelector("#scan-form");
    const submit = document.querySelector("#scan-submit");
    const submitLabel = document.querySelector("[data-scan-submit-label]");
    const error = document.querySelector("#scan-error");
    const progress = document.querySelector("#scan-progress");
    const gate = document.querySelector("#report-gate");
    const gateForm = document.querySelector("#report-gate-form");
    const gateSubmit = document.querySelector("#report-gate-submit");
    const gateSubmitLabel = document.querySelector("[data-gate-submit-label]");
    const gateError = document.querySelector("#report-gate-error");
    const results = document.querySelector("#scan-results");
    const schedule = document.querySelector("#schedule");
    const stageTitle = document.querySelector("#scan-stage-title");
    const stageDetail = document.querySelector("#scan-stage-detail");
    const stageHeroIcon = document.querySelector("#scan-stage-hero-icon .scan-icon");
    const progressBar = document.querySelector("#scan-progress-bar");
    const progressTrack = document.querySelector("[role='progressbar']");
    const stageMessages = [
      ["Finding your shop", "Checking what a driver can find about your business online."],
      ["Checking your services", "Looking for clear information about your location, repairs, and specialties."],
      ["Comparing nearby shops", "Seeing which local shops are easiest for AI to understand and suggest."],
      ["Building your report", "Summing up what is working and what to fix first."],
    ];
    const stageIcons = ["location", "search", "pages", "ai"];
    const stageProgress = [25, 50, 75, 96];
    let stageTimer;
    let stageIndex = 0;
    let pendingReportToken = "";
    const setText = (selector, value) => document.querySelector(selector)?.replaceChildren(document.createTextNode(value ?? ""));
    const cleanResultText = (value) => String(value || "")
      .replace(/\[([^\]]+)\]\(https?:\/\/[^)]+\)/gi, "$1")
      .replace(/https?:\/\/\S+/gi, "")
      .replace(/\s*\([^)]*\b(?:\.com|\.net|\.org|\.co|\.io)\b[^)]*\)/gi, "")
      .replace(/【[^】]+】/g, "")
      .replace(/\s+/g, " ")
      .replace(/\s+([,.;:!?])/g, "$1")
      .trim();
    const shortText = (value, max = 260) => {
      const text = cleanResultText(value);
      return text.length > max ? `${text.slice(0, max - 1).trim()}…` : text;
    };
    const showList = (items) => {
      const list = document.querySelector("[data-result-understood]");
      if (!list) return;
      list.replaceChildren(...(items || []).slice(0, 3).map((item) => {
        const li = document.createElement("li");
        li.className = "grid grid-cols-[38px_1fr] gap-3 py-5 first:pt-0 last:pb-0";
        const check = document.createElement("span");
        check.className = "inline-flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--navy)] text-sm font-bold text-white";
        check.textContent = "✓";
        check.setAttribute("aria-hidden", "true");
        const copy = document.createElement("p");
        copy.className = "text-[15px] leading-relaxed text-charcoal/68";
        copy.textContent = shortText(item, 125);
        li.append(check, copy);
        return li;
      }));
    };
    const scoreStatus = (score) => score < 40 ? "Not showing up yet" : score < 60 ? "Some important gaps" : score < 80 ? "Good starting point" : "Easy to understand";
    const showRank = (appearedValue, aheadValue, comparedValue) => {
      const shopAppeared = appearedValue === true;
      const shopsAhead = Math.max(0, Number(aheadValue) || 0);
      const total = Math.max(shopsAhead + 1, Number(comparedValue) || 0);
      const position = shopsAhead + 1;
      document.querySelector("[data-rank-found]")?.classList.toggle("hidden", !shopAppeared);
      document.querySelector("[data-rank-missing]")?.classList.toggle("hidden", shopAppeared);
      document.querySelector("[data-rank-ahead-copy]")?.classList.toggle("hidden", !shopAppeared);
      document.querySelector("[data-rank-missing-copy]")?.classList.toggle("hidden", shopAppeared);
      setText("[data-rank-position]", String(position));
      setText("[data-rank-total]", String(total));
      setText("[data-shops-ahead]", String(shopsAhead));
      const track = document.querySelector("[data-rank-track]");
      if (!track) return;
      const nodes = [];
      if (!shopAppeared) {
        const current = document.createElement("div");
        current.className = "rank-node rank-node-current rank-node-missing";
        current.innerHTML = "<span>—</span><small>Your shop</small>";
        nodes.push(current);
        const alternatives = Math.max(0, total - 1);
        if (alternatives > 0) {
          const after = document.createElement("div");
          after.className = "rank-node-after";
          after.textContent = `${alternatives} alternative${alternatives === 1 ? "" : "s"} appeared`;
          nodes.push(after);
        }
        track.replaceChildren(...nodes);
        track.setAttribute("aria-label", `Your shop was not included in the reviewed recommendations; ${total} shops were checked.`);
        return;
      }
      const visibleAhead = Math.min(shopsAhead, 5);
      for (let index = 1; index <= visibleAhead; index += 1) {
        const node = document.createElement("div");
        node.className = "rank-node rank-node-ahead";
        node.innerHTML = `<span>#${index}</span><small>Shop</small>`;
        nodes.push(node);
      }
      if (shopsAhead > visibleAhead) {
        const more = document.createElement("div");
        more.className = "rank-node-more";
        more.textContent = `+${shopsAhead - visibleAhead}`;
        nodes.push(more);
      }
      const current = document.createElement("div");
      current.className = "rank-node rank-node-current";
      current.innerHTML = `<span>#${position}</span><small>Your shop</small>`;
      nodes.push(current);
      const shopsAfter = Math.max(0, total - position);
      if (shopsAfter > 0) {
        const after = document.createElement("div");
        after.className = "rank-node-after";
        after.textContent = `+${shopsAfter} after`;
        nodes.push(after);
      }
      track.replaceChildren(...nodes);
      track.setAttribute("aria-label", `Your shop appeared number ${position} of ${total}; ${shopsAhead} shops were recommended before it.`);
    };
    const renderReport = (payload) => {
      const score = Math.max(0, Math.min(100, Number(payload.score) || 0));
      setText("[data-result-shop]", shortText(payload.shopName, 90));
      setText("[data-result-score]", String(score));
      setText("[data-result-status]", scoreStatus(score));
      setText("[data-result-verdict]", shortText(payload.verdict, 125));
      setText("[data-result-gap]", shortText(payload.gap, 190));
      setText("[data-result-competitor]", shortText(payload.competitor, 170));
      setText("[data-result-cta]", shortText(payload.cta, 170));
      document.querySelector("[data-score-ring]")?.setAttribute("style", `--score:${score}`);
      showList(payload.understood);
      showRank(payload.shopAppeared, payload.shopsAhead, payload.shopsCompared);
    };
    const updateStage = () => {
      const [title, detail] = stageMessages[stageIndex];
      const percent = stageProgress[stageIndex];
      if (stageTitle) stageTitle.textContent = title;
      if (stageDetail) stageDetail.textContent = detail;
      if (stageHeroIcon) stageHeroIcon.className = `scan-icon scan-icon-${stageIcons[stageIndex]}`;
      if (progressBar) progressBar.style.setProperty("--scan-progress", `${percent}%`);
      progressTrack?.setAttribute("aria-valuenow", String(percent));
      document.querySelectorAll("[data-scan-stage]").forEach((item, index) => {
        item.classList.toggle("scan-stage-active", index === stageIndex);
        item.classList.toggle("scan-stage-complete", index < stageIndex);
      });
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      pendingReportToken = "";
      error.classList.add("hidden");
      gateError?.classList.add("hidden");
      gate?.classList.add("hidden");
      results.classList.add("hidden");
      schedule.classList.add("hidden");
      submit.disabled = true;
      if (submitLabel) submitLabel.textContent = "Running scan…";
      progress.classList.remove("hidden");
      progress.scrollIntoView({ behavior: "smooth", block: "center" });
      stageIndex = 0;
      updateStage();
      stageTimer = window.setInterval(() => {
        stageIndex = Math.min(stageIndex + 1, stageMessages.length - 1);
        updateStage();
      }, 2200);

      try {
        const response = await fetch("/api/visibility-scan", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const payload = await response.json();
        if (!response.ok || !payload.reportToken) {
          throw new Error(payload.error || "We could not complete the scan.");
        }

        window.clearInterval(stageTimer);
        pendingReportToken = payload.reportToken;
        setText("[data-gate-shop]", shortText(payload.shopName, 90));
        progress.classList.add("hidden");
        gate?.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run Another Scan";
        gate?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => document.querySelector("#report-email")?.focus({ preventScroll: true }), 650);
      } catch (scanError) {
        window.clearInterval(stageTimer);
        progress.classList.add("hidden");
        error.textContent = scanError.message || "Something went wrong. Please try again.";
        error.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run My Free Scan";
      }
    });

    gateForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      gateError?.classList.add("hidden");
      gateSubmit.disabled = true;
      if (gateSubmitLabel) gateSubmitLabel.textContent = "Unlocking report…";

      try {
        const email = new FormData(gateForm).get("email");
        const response = await fetch("/api/visibility-scan-unlock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, reportToken: pendingReportToken }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || "We couldn't unlock your report yet.");

        renderReport(payload);
        gate?.classList.add("hidden");
        results.classList.remove("hidden");
        schedule.classList.remove("hidden");
        pendingReportToken = "";
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Report Unlocked";
        results.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (unlockError) {
        gateError.textContent = unlockError.message || "We couldn't unlock your report yet. Please try again.";
        gateError.classList.remove("hidden");
        gateSubmit.disabled = false;
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Reveal My Report";
      }
    });
  </script>

