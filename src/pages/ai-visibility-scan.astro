---
import { ArrowRight, CircleCheckBig, Gauge, LockKeyhole, Search, ShieldCheck, Trophy, TriangleAlert } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { APPOINTMENTCORE_BOOKING_URL, CONSULTATION_URL } from "@/lib/services";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "AI Visibility Scan for Auto Repair Shops",
  description: "See how clearly AI-powered searches understand your auto repair shop.",
  url: "https://www.turnkeyautomarketing.com/ai-visibility-scan",
};
---

<BaseLayout
  title="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  description="See how clearly AI-powered searches understand and recommend your auto repair shop."
  path="/ai-visibility-scan"
  ogTitle="AI Visibility Scan for Auto Repair Shops | Turnkey Marketing"
  schema={reportSchema}
>
  <main class="min-h-screen bg-[var(--off-white)]">
    <section class="relative overflow-hidden bg-[linear-gradient(135deg,#fff_0%,#f6faff_62%,#edf4fc_100%)] py-14 md:py-20 lg:py-24">
      <span class="pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-[var(--key-blue-soft)]/60 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-48 left-1/3 h-80 w-80 rounded-full bg-[var(--green)]/10 blur-3xl" aria-hidden="true"></span>
      <div class="container-page relative">
        <div class="relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[.96fr_1.04fr] lg:items-center lg:gap-14 xl:gap-20">
          <div class="relative z-10 text-center md:text-left">
            <p class="eyebrow inline-flex rounded-full bg-[var(--key-blue-soft)] px-4 py-2 text-[var(--key-blue)]">Free AI visibility scan</p>
            <h1 class="display-1 mt-6 max-w-[11ch] text-charcoal md:max-w-[12ch]">Does AI <span class="text-[var(--key-blue)]">Recommend Your Shop?</span></h1>
            <p class="mx-auto mt-7 max-w-[42ch] text-lg leading-relaxed text-charcoal/65 md:mx-0 md:text-xl">See where your shop appears in AI search—and which nearby shops may be winning the call.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-3 text-sm text-charcoal/55 md:justify-start">
              <span class="inline-flex items-center gap-2"><ShieldCheck class="h-4 w-4 text-[var(--green)]" /> Built for auto repair</span>
              <span class="inline-flex items-center gap-2"><span class="scan-icon scan-icon-clock h-4 w-4 text-[var(--key-blue)]" aria-hidden="true"></span> About 60 seconds</span>
            </div>
          </div>

          <div class="relative z-10 mx-auto w-full max-w-[470px] lg:mr-4">
            <form id="scan-form" class="relative overflow-hidden rounded-[30px] border border-[rgba(35,46,102,.12)] bg-white shadow-[0_34px_90px_-42px_rgba(20,30,78,.62)]">
              <div class="p-6 md:p-8 lg:p-9">
                <div><p class="eyebrow text-[var(--key-blue)]">Start your scan</p><h2 class="mt-2 font-display text-2xl font-semibold tracking-tight text-charcoal">Run your free scan</h2><p class="mt-1 text-sm text-charcoal/48">Takes about 60 seconds.</p></div>
                <label class="mt-8 block text-sm font-medium text-charcoal" for="shop-name">Shop name</label>
                <input id="shop-name" name="shopName" required autocomplete="organization" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. Smith Auto Care" />
                <label class="mt-5 block text-sm font-medium text-charcoal" for="shop-location">City and state</label>
                <input id="shop-location" name="location" required autocomplete="address-level2" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. Scottsdale, AZ" />
                <label class="mt-5 block text-sm font-medium text-charcoal" for="shop-specialty">What work do you want more of? <span class="font-normal text-charcoal/40">Optional</span></label>
                <input id="shop-specialty" name="specialty" class="mt-2 h-12 w-full rounded-2xl border border-[rgba(35,46,102,.2)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.35)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="e.g. European repair, brakes, diagnostics" />
                <button id="scan-submit" type="submit" class="btn-primary mt-7 h-13 w-full !bg-[linear-gradient(100deg,var(--key-blue),var(--navy))] !px-5 shadow-[0_18px_38px_-22px_rgba(35,46,102,.75)] hover:!bg-[var(--navy-deep)] disabled:cursor-wait disabled:opacity-70"><span data-scan-submit-label>Run My Free Scan</span> <ArrowRight class="h-4 w-4" /></button>
                <p id="scan-error" class="mt-4 hidden rounded-2xl bg-red-50 p-3 text-sm leading-relaxed text-red-700"></p>
              </div>
            </form>
          </div>
        </div>

        <div class="relative z-10 mx-auto mt-12 flex max-w-6xl flex-col gap-4 rounded-[22px] border border-[rgba(35,46,102,.1)] bg-white/90 px-5 py-4 shadow-[0_18px_55px_-42px_rgba(35,46,102,.45)] backdrop-blur sm:flex-row sm:items-center sm:justify-between md:px-7">
          <p class="text-sm font-semibold text-[var(--navy)]">We check your shop across</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-charcoal/58">
            <span class="inline-flex items-center gap-2"><img src="/images/logos/google-search.webp" alt="" width="200" height="200" class="h-8 w-8 object-contain" loading="lazy" decoding="async" aria-hidden="true" /> Google Search</span>
            <span class="inline-flex items-center gap-2"><img src="/images/logos/google-ai-overviews.png" alt="" width="800" height="449" class="h-8 w-8 object-cover object-center" loading="lazy" decoding="async" aria-hidden="true" /> AI Overviews</span>
            <span class="inline-flex items-center gap-2"><img src="/images/logos/chatgpt-logo.png" alt="" width="3840" height="2160" class="h-8 w-8 object-cover object-center" loading="lazy" decoding="async" aria-hidden="true" /> ChatGPT</span>
          </div>
        </div>
      </div>
    </section>

    <section id="scan-progress" class="relative hidden overflow-hidden bg-[#f3f7fd] py-14 md:py-20">
      <span class="pointer-events-none absolute -left-28 top-0 h-80 w-80 rounded-full bg-[var(--key-blue)]/8 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-[var(--green)]/8 blur-3xl" aria-hidden="true"></span>
      <div class="container-page relative">
        <div class="scan-progress-panel mx-auto max-w-5xl rounded-[32px] border border-[rgba(35,46,102,.1)] bg-white px-5 py-9 shadow-[0_34px_85px_-52px_rgba(35,46,102,.45)] sm:px-8 md:rounded-[38px] md:px-12 md:py-12 lg:px-16">
          <div class="text-center">
            <span id="scan-stage-hero-icon" class="scan-stage-hero-icon" role="status" aria-label="Scan in progress">
              <span class="scan-stage-pulse scan-stage-pulse-left" aria-hidden="true"></span>
              <span class="scan-stage-pulse scan-stage-pulse-right" aria-hidden="true"></span>
              <span class="scan-icon scan-icon-location" aria-hidden="true"></span>
            </span>
            <p class="eyebrow mt-6 text-[var(--key-blue)]">Scan in progress</p>
            <h2 id="scan-stage-title" class="mx-auto mt-3 max-w-[19ch] font-display text-[clamp(2.15rem,4.2vw,3.65rem)] font-semibold leading-[1.02] tracking-[-.045em] text-[var(--navy-deep)]">Finding your shop</h2>
            <p id="scan-stage-detail" class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-charcoal/62 md:text-lg">Checking the public information AI can find about your business.</p>
          </div>

          <div class="mx-auto mt-8 max-w-2xl">
            <div class="scan-progress-track" role="progressbar" aria-label="AI visibility scan progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="25">
              <span id="scan-progress-bar" class="scan-progress-bar" style="--scan-progress:25%"></span>
            </div>
          </div>

          <div class="scan-stage-grid mt-9" aria-live="polite">
            <div data-scan-stage="0" class="scan-stage-item scan-stage-active">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-location" aria-hidden="true"></span><span class="sr-only">Step 1</span></span>
              <span class="scan-stage-label">Finding your shop and location</span>
            </div>
            <div data-scan-stage="1" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-search" aria-hidden="true"></span><span class="sr-only">Step 2</span></span>
              <span class="scan-stage-label">Checking service and specialty signals</span>
            </div>
            <div data-scan-stage="2" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-pages" aria-hidden="true"></span><span class="sr-only">Step 3</span></span>
              <span class="scan-stage-label">Comparing nearby recommendations</span>
            </div>
            <div data-scan-stage="3" class="scan-stage-item">
              <span class="scan-stage-marker"><span class="scan-icon scan-icon-ai" aria-hidden="true"></span><span class="sr-only">Step 4</span></span>
              <span class="scan-stage-label">Preparing your visibility snapshot</span>
            </div>
          </div>
          <p class="scan-progress-note mt-8 text-center text-sm text-charcoal/52"><span class="scan-icon scan-icon-ai" aria-hidden="true"></span>This usually takes less than a minute. You can keep this tab open.</p>
        </div>
      </div>
    </section>

    <section id="report-gate" class="hidden bg-[linear-gradient(180deg,var(--off-white)_0%,#fff_100%)] py-14 md:py-24">
      <div class="container-page">
        <div class="mx-auto max-w-6xl">
          <div class="mb-7 flex justify-center">
            <div class="inline-flex items-center gap-2 rounded-full bg-[#eaf3dc] px-4 py-2 text-sm font-semibold text-[#557f20] ring-1 ring-[#6d9b2f]/15">
              <CircleCheckBig class="h-4 w-4" /> Analysis complete
            </div>
          </div>

          <div class="overflow-hidden rounded-[36px] bg-[linear-gradient(140deg,var(--navy)_0%,var(--navy-deep)_100%)] shadow-[0_38px_100px_-58px_rgba(20,22,28,.7)]">
            <div class="grid lg:grid-cols-[1.08fr_.92fr]">
              <div class="relative overflow-hidden p-7 text-white md:p-11 lg:p-14">
                <span class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[var(--key-blue)]/25 blur-3xl" aria-hidden="true"></span>
                <span class="pointer-events-none absolute -bottom-32 right-0 h-72 w-72 rounded-full bg-[var(--green)]/10 blur-3xl" aria-hidden="true"></span>
                <div class="relative">
                  <p class="eyebrow text-[#9ed8f0]">Your report is built</p>
                  <h2 class="mt-5 max-w-[13ch] font-display text-[clamp(2.5rem,5vw,4.7rem)] font-semibold leading-[.98] tracking-[-.055em]">Your AI Visibility Report Is Ready.</h2>
                  <p class="mt-6 max-w-[42rem] text-lg leading-relaxed text-white/68">We found how AI sees <strong data-gate-shop class="font-semibold text-white">your shop</strong>, where it appeared against nearby shops, and the clearest opportunity to improve.</p>

                  <div class="mt-9 max-w-xl border-y border-white/12">
                    <div class="flex items-center gap-3 border-b border-white/12 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">AI visibility score calculated</span></div>
                    <div class="flex items-center gap-3 border-b border-white/12 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">Recommendation position mapped</span></div>
                    <div class="flex items-center gap-3 py-4"><CircleCheckBig class="h-5 w-5 shrink-0 text-[var(--green)]" /><span class="font-medium text-white/88">Biggest visibility gap identified</span></div>
                  </div>
                </div>
              </div>

              <div class="m-2 rounded-[30px] bg-white p-6 md:m-3 md:p-9 lg:flex lg:flex-col lg:justify-center lg:p-11">
                <div class="flex items-center justify-between gap-5">
                  <p class="eyebrow text-[var(--key-blue)]">Unlock your report</p>
                  <LockKeyhole class="h-7 w-7 text-[var(--navy)]" />
                </div>
                <h3 class="mt-5 font-display text-[clamp(2rem,3.6vw,3rem)] font-semibold leading-[1.02] tracking-[-.04em] text-charcoal">See what AI may be telling local drivers.</h3>
                <p class="mt-5 leading-relaxed text-charcoal/62">Your score and competitive position are ready. Enter your business email to reveal the full report instantly.</p>

                <form id="report-gate-form" class="mt-7">
                  <label class="block text-sm font-semibold text-charcoal" for="report-email">Business email</label>
                  <input id="report-email" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" class="mt-2 h-13 w-full rounded-2xl border border-[rgba(35,46,102,.24)] bg-white px-4 text-charcoal outline-none ring-2 ring-transparent transition placeholder:text-charcoal/35 hover:border-[rgba(35,46,102,.4)] focus:border-[var(--key-blue)] focus:ring-[var(--key-blue)]/15" placeholder="you@yourshop.com" />
                  <button id="report-gate-submit" type="submit" class="btn-primary mt-4 h-13 w-full !bg-[var(--green)] !px-5 !text-charcoal shadow-[0_16px_36px_-20px_rgba(95,143,34,.75)] hover:!bg-[var(--key-blue)] hover:!text-white disabled:cursor-wait disabled:opacity-70"><span data-gate-submit-label>Reveal My Report</span> <ArrowRight class="h-4 w-4" /></button>
                  <p id="report-gate-error" class="mt-4 hidden rounded-2xl bg-red-50 p-3 text-sm leading-relaxed text-red-700"></p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="scan-results" class="hidden bg-[linear-gradient(180deg,var(--off-white)_0%,#fff_100%)] py-12 md:py-24">
      <div class="container-page">
        <div class="mx-auto max-w-6xl">
          <div class="mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end">
            <div>
              <p class="eyebrow text-[var(--key-blue)]">Your AI visibility snapshot</p>
              <h2 class="display-3 mt-3 text-charcoal"><span data-result-shop>Your shop</span></h2>
            </div>
            <div class="inline-flex w-fit items-center gap-3 rounded-[18px] bg-[var(--navy)] py-2 pl-2 pr-4 text-white shadow-[0_18px_40px_-24px_rgba(35,46,102,.8)] ring-1 ring-white/10">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--green)] text-[var(--navy-deep)] shadow-sm"><CircleCheckBig class="h-5 w-5" /></span>
              <span class="text-left"><span class="block text-[9px] font-semibold uppercase tracking-[.18em] text-white/50">Status</span><span class="mt-0.5 block text-sm font-semibold leading-none">Scan complete</span></span>
            </div>
          </div>

          <article class="overflow-hidden rounded-[36px] border border-[var(--hairline)] bg-white shadow-[0_38px_100px_-64px_rgba(20,22,28,.42)]">
            <div class="grid lg:grid-cols-[340px_1fr]">
              <div class="relative overflow-hidden bg-[linear-gradient(155deg,var(--navy)_0%,var(--navy-deep)_100%)] p-8 text-white md:p-10">
                <span class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-[var(--key-blue)]/25 blur-3xl"></span>
                <div class="relative">
                  <div class="flex items-center gap-2 text-sm font-medium text-white/60"><Gauge class="h-4 w-4" /> AI visibility</div>
                  <div data-score-ring class="score-ring mt-8" style="--score:0">
                    <div class="score-ring-inner"><span data-result-score class="font-display text-6xl font-semibold tracking-[-.07em]">—</span><span class="mt-1 text-xs text-white/45">out of 100</span></div>
                  </div>
                  <div class="mt-8 border-t border-white/15 pt-5">
                    <p class="text-[10px] uppercase tracking-[.16em] text-white/45">Current signal</p>
                    <p data-result-status class="mt-2 font-display text-2xl font-semibold">Scan complete</p>
                  </div>
                  <p class="mt-5 text-xs leading-relaxed text-white/45">Directional snapshot—not an official ranking.</p>
                </div>
              </div>

              <div class="flex flex-col justify-center p-8 md:p-12 lg:p-14">
                <p class="eyebrow text-[var(--key-blue)]">Your verdict</p>
                <h3 data-result-verdict class="mt-5 max-w-[22ch] font-display text-[clamp(2rem,4vw,3.7rem)] font-semibold leading-[1.03] tracking-[-.045em] text-charcoal">Your result will appear here.</h3>
                <div class="mt-8 flex flex-wrap gap-2">
                  <span class="rounded-full bg-[var(--key-blue-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--navy)]">AI search</span>
                  <span class="rounded-full bg-[var(--off-white)] px-3 py-1.5 text-xs font-semibold text-charcoal/60">Local visibility</span>
                  <span class="rounded-full bg-[#eaf3dc] px-3 py-1.5 text-xs font-semibold text-charcoal/65">Auto repair</span>
                </div>
              </div>
            </div>

            <div class="border-t border-[var(--hairline)] p-6 md:p-10">
              <div class="grid gap-8 lg:grid-cols-[1.1fr_.9fr] lg:gap-12">
                <section>
                  <div class="flex items-center gap-3"><span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-[#eaf3dc] text-[#5f8f22]"><CircleCheckBig class="h-5 w-5" /></span><div><p class="eyebrow text-[#6d9b2f]">Signals AI picked up</p><h4 class="mt-1 font-display text-xl font-semibold text-charcoal">What is already clear</h4></div></div>
                  <ul data-result-understood class="mt-6 divide-y divide-[var(--hairline)]"></ul>
                </section>

                <section class="relative overflow-hidden rounded-[28px] border border-white/10 bg-[linear-gradient(145deg,var(--navy)_0%,var(--navy-deep)_100%)] p-6 text-white shadow-[0_24px_55px_-38px_rgba(35,46,102,.85)] md:p-7">
                  <span class="pointer-events-none absolute -right-16 -top-20 h-48 w-48 rounded-full bg-[var(--key-blue)]/25 blur-3xl" aria-hidden="true"></span>
                  <div class="relative flex items-center gap-3"><span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white/10 text-[var(--green)] ring-1 ring-white/10"><TriangleAlert class="h-5 w-5" /></span><div><p class="eyebrow text-[#9ed8f0]">Priority signal</p><h4 class="mt-1 font-display text-xl font-semibold text-white">Biggest visibility gap</h4></div></div>
                  <p data-result-gap class="relative mt-6 text-lg font-medium leading-relaxed text-white/80"></p>
                </section>
              </div>
            </div>

            <div class="border-t border-[var(--hairline)] bg-[var(--cream)] p-6 md:p-10">
              <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
                <div class="flex items-center gap-4"><span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-[var(--navy)] shadow-sm"><Trophy class="h-6 w-6" /></span><div><p class="eyebrow text-charcoal/45">Competitive position</p><h4 class="mt-1 font-display text-2xl font-semibold text-charcoal">Where your shop appeared</h4></div></div>
                <span class="w-fit rounded-full border border-[var(--navy)] bg-[var(--navy)] px-3.5 py-1.5 text-[10px] font-semibold uppercase tracking-[.14em] text-white shadow-[0_8px_20px_-12px_rgba(30,45,102,0.9)]">Based on this scan</span>
              </div>

              <div class="mt-7 grid gap-7 md:grid-cols-[220px_1fr] md:items-center">
                <div class="rounded-[24px] bg-white p-5 shadow-[0_20px_50px_-38px_rgba(20,22,28,.4)]">
                  <p class="text-xs font-semibold uppercase tracking-[.14em] text-charcoal/40">Estimated rank</p>
                  <p class="mt-3 font-display text-6xl font-semibold leading-none tracking-[-.06em] text-[var(--navy)]">#<span data-rank-position>—</span></p>
                  <p class="mt-2 text-sm text-charcoal/50">of <span data-rank-total>—</span> shops checked</p>
                  <div class="mt-4 border-t border-[var(--hairline)] pt-4 text-sm font-semibold text-charcoal"><span data-shops-ahead>—</span> recommended before you</div>
                </div>

                <div>
                  <div data-rank-track class="rank-track" aria-label="Competitive recommendation order"></div>
                  <p data-result-competitor class="mt-6 max-w-2xl text-base leading-relaxed text-charcoal/60"></p>
                </div>
              </div>
            </div>
          </article>

          <div class="relative mt-8 overflow-hidden rounded-[32px] bg-[linear-gradient(135deg,var(--key-blue),var(--navy))] p-7 text-white shadow-[0_28px_70px_-48px_rgba(35,46,102,.8)] md:flex md:items-center md:justify-between md:gap-10 md:p-10">
            <span class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-white/10 blur-3xl"></span>
            <div class="relative max-w-2xl"><h3 class="font-display text-3xl font-semibold tracking-tight">Make your shop the easier recommendation.</h3><p data-result-cta class="mt-3 leading-relaxed text-white/70"></p></div>
            <a href={CONSULTATION_URL} class="report-cta-pulse relative mt-6 inline-flex shrink-0 items-center gap-2 rounded-full bg-[var(--green)] px-6 py-3.5 font-semibold text-charcoal shadow-[0_16px_38px_-20px_rgba(0,0,0,.4)] transition hover:-translate-y-0.5 hover:bg-white md:mt-0" data-track-event="consultation_cta_click" data-track-placement="ai_visibility_results_bottom">Schedule A Consultation <ArrowRight class="h-4 w-4" /></a>
          </div>
        </div>
      </div>
    </section>

    <section id="schedule" class="hidden scroll-mt-24 bg-white py-14 md:py-20"><div class="container-page"><div class="mx-auto max-w-5xl text-center"><p class="eyebrow text-[var(--key-blue)]">Go deeper with Turnkey</p><h2 class="display-2 mt-4 text-charcoal">Let’s review what AI found.</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-charcoal/65">We’ll connect the snapshot to your website, reviews, positioning, local search presence, and broader marketing strategy.</p><div class="mt-9 overflow-hidden rounded-[30px] bg-[var(--off-white)] text-left shadow-[0_28px_70px_-48px_rgba(20,22,28,.35)] ring-1 ring-black/5"><iframe src={APPOINTMENTCORE_BOOKING_URL} title="Schedule an AI visibility review with Turnkey Marketing" width="100%" height="800" class="block min-h-[800px] w-full border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></div><script is:inline src="https://go.appointmentcore.com/frontend/js/app/booking-link-embed-helper.js?v=1786635857"></script></section>
  </main>

  <script is:inline>
    const form = document.querySelector("#scan-form");
    const submit = document.querySelector("#scan-submit");
    const submitLabel = document.querySelector("[data-scan-submit-label]");
    const error = document.querySelector("#scan-error");
    const progress = document.querySelector("#scan-progress");
    const gate = document.querySelector("#report-gate");
    const gateForm = document.querySelector("#report-gate-form");
    const gateSubmit = document.querySelector("#report-gate-submit");
    const gateSubmitLabel = document.querySelector("[data-gate-submit-label]");
    const gateError = document.querySelector("#report-gate-error");
    const results = document.querySelector("#scan-results");
    const schedule = document.querySelector("#schedule");
    const stageTitle = document.querySelector("#scan-stage-title");
    const stageDetail = document.querySelector("#scan-stage-detail");
    const stageHeroIcon = document.querySelector("#scan-stage-hero-icon .scan-icon");
    const progressBar = document.querySelector("#scan-progress-bar");
    const progressTrack = document.querySelector("[role='progressbar']");
    const stageMessages = [
      ["Finding your shop", "Checking the public information AI can find about your business."],
      ["Reading your service signals", "Looking at how your location, services, and specialty are described online."],
      ["Comparing nearby recommendations", "Checking which local alternatives are easier for AI to understand."],
      ["Building your snapshot", "Turning the findings into a clear score, gap, and next step."],
    ];
    const stageIcons = ["location", "search", "pages", "ai"];
    const stageProgress = [25, 50, 75, 96];
    let stageTimer;
    let stageIndex = 0;
    let pendingReportToken = "";
    const setText = (selector, value) => document.querySelector(selector)?.replaceChildren(document.createTextNode(value ?? ""));
    const cleanResultText = (value) => String(value || "")
      .replace(/\[([^\]]+)\]\(https?:\/\/[^)]+\)/gi, "$1")
      .replace(/https?:\/\/\S+/gi, "")
      .replace(/\s*\([^)]*\b(?:\.com|\.net|\.org|\.co|\.io)\b[^)]*\)/gi, "")
      .replace(/【[^】]+】/g, "")
      .replace(/\s+/g, " ")
      .replace(/\s+([,.;:!?])/g, "$1")
      .trim();
    const shortText = (value, max = 260) => {
      const text = cleanResultText(value);
      return text.length > max ? `${text.slice(0, max - 1).trim()}…` : text;
    };
    const showList = (items) => {
      const list = document.querySelector("[data-result-understood]");
      if (!list) return;
      list.replaceChildren(...(items || []).slice(0, 3).map((item, index) => {
        const li = document.createElement("li");
        li.className = "grid grid-cols-[38px_1fr] gap-3 py-5 first:pt-0 last:pb-0";
        const number = document.createElement("span");
        number.className = "inline-flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--off-white)] text-xs font-bold text-[#6d9b2f]";
        number.textContent = String(index + 1).padStart(2, "0");
        const copy = document.createElement("p");
        copy.className = "text-[15px] leading-relaxed text-charcoal/65";
        copy.textContent = shortText(item, 125);
        li.append(number, copy);
        return li;
      }));
    };
    const scoreStatus = (score) => score < 40 ? "Needs attention" : score < 60 ? "Incomplete signal" : score < 80 ? "Solid foundation" : "Strong visibility";
    const showRank = (aheadValue, comparedValue) => {
      const shopsAhead = Math.max(0, Number(aheadValue) || 0);
      const total = Math.max(shopsAhead + 1, Number(comparedValue) || 0);
      const position = shopsAhead + 1;
      setText("[data-rank-position]", String(position));
      setText("[data-rank-total]", String(total));
      setText("[data-shops-ahead]", String(shopsAhead));
      const track = document.querySelector("[data-rank-track]");
      if (!track) return;
      const nodes = [];
      const visibleAhead = Math.min(shopsAhead, 5);
      for (let index = 1; index <= visibleAhead; index += 1) {
        const node = document.createElement("div");
        node.className = "rank-node rank-node-ahead";
        node.innerHTML = `<span>#${index}</span><small>Shop</small>`;
        nodes.push(node);
      }
      if (shopsAhead > visibleAhead) {
        const more = document.createElement("div");
        more.className = "rank-node-more";
        more.textContent = `+${shopsAhead - visibleAhead}`;
        nodes.push(more);
      }
      const current = document.createElement("div");
      current.className = "rank-node rank-node-current";
      current.innerHTML = `<span>#${position}</span><small>Your shop</small>`;
      nodes.push(current);
      const shopsAfter = Math.max(0, total - position);
      if (shopsAfter > 0) {
        const after = document.createElement("div");
        after.className = "rank-node-after";
        after.textContent = `+${shopsAfter} after`;
        nodes.push(after);
      }
      track.replaceChildren(...nodes);
      track.setAttribute("aria-label", `Your shop appeared number ${position} of ${total}; ${shopsAhead} shops were recommended before it.`);
    };
    const renderReport = (payload) => {
      const score = Math.max(0, Math.min(100, Number(payload.score) || 0));
      setText("[data-result-shop]", shortText(payload.shopName, 90));
      setText("[data-result-score]", String(score));
      setText("[data-result-status]", scoreStatus(score));
      setText("[data-result-verdict]", shortText(payload.verdict, 125));
      setText("[data-result-gap]", shortText(payload.gap, 190));
      setText("[data-result-competitor]", shortText(payload.competitor, 170));
      setText("[data-result-cta]", shortText(payload.cta, 170));
      document.querySelector("[data-score-ring]")?.setAttribute("style", `--score:${score}`);
      showList(payload.understood);
      showRank(payload.shopsAhead ?? payload.competitors, payload.shopsCompared);
    };
    const updateStage = () => {
      const [title, detail] = stageMessages[stageIndex];
      const percent = stageProgress[stageIndex];
      if (stageTitle) stageTitle.textContent = title;
      if (stageDetail) stageDetail.textContent = detail;
      if (stageHeroIcon) stageHeroIcon.className = `scan-icon scan-icon-${stageIcons[stageIndex]}`;
      if (progressBar) progressBar.style.setProperty("--scan-progress", `${percent}%`);
      progressTrack?.setAttribute("aria-valuenow", String(percent));
      document.querySelectorAll("[data-scan-stage]").forEach((item, index) => {
        item.classList.toggle("scan-stage-active", index === stageIndex);
        item.classList.toggle("scan-stage-complete", index < stageIndex);
      });
    };
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      pendingReportToken = "";
      error.classList.add("hidden");
      gateError?.classList.add("hidden");
      gate?.classList.add("hidden");
      results.classList.add("hidden");
      schedule.classList.add("hidden");
      submit.disabled = true;
      if (submitLabel) submitLabel.textContent = "Running scan…";
      progress.classList.remove("hidden");
      progress.scrollIntoView({ behavior: "smooth", block: "center" });
      stageIndex = 0;
      updateStage();
      stageTimer = window.setInterval(() => {
        stageIndex = Math.min(stageIndex + 1, stageMessages.length - 1);
        updateStage();
      }, 2200);

      try {
        const response = await fetch("/api/visibility-scan", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const payload = await response.json();
        if (!response.ok || !payload.reportToken) {
          throw new Error(payload.error || "We could not complete the scan.");
        }

        window.clearInterval(stageTimer);
        pendingReportToken = payload.reportToken;
        setText("[data-gate-shop]", shortText(payload.shopName, 90));
        progress.classList.add("hidden");
        gate?.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run Another Scan";
        gate?.scrollIntoView({ behavior: "smooth", block: "start" });
        window.setTimeout(() => document.querySelector("#report-email")?.focus({ preventScroll: true }), 650);
      } catch (scanError) {
        window.clearInterval(stageTimer);
        progress.classList.add("hidden");
        error.textContent = scanError.message || "Something went wrong. Please try again.";
        error.classList.remove("hidden");
        submit.disabled = false;
        if (submitLabel) submitLabel.textContent = "Run My Free Scan";
      }
    });

    gateForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      gateError?.classList.add("hidden");
      gateSubmit.disabled = true;
      if (gateSubmitLabel) gateSubmitLabel.textContent = "Unlocking report…";

      try {
        const email = new FormData(gateForm).get("email");
        const response = await fetch("/api/visibility-scan-unlock", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, reportToken: pendingReportToken }),
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || "We couldn't unlock your report yet.");

        renderReport(payload);
        gate?.classList.add("hidden");
        results.classList.remove("hidden");
        schedule.classList.remove("hidden");
        pendingReportToken = "";
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Report Unlocked";
        results.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (unlockError) {
        gateError.textContent = unlockError.message || "We couldn't unlock your report yet. Please try again.";
        gateError.classList.remove("hidden");
        gateSubmit.disabled = false;
        if (gateSubmitLabel) gateSubmitLabel.textContent = "Reveal My Report";
      }
    });
  </script>

  <style is:global>
    .scan-icon {
      display: block;
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      background: currentColor;
      mask-position: center;
      mask-repeat: no-repeat;
      mask-size: contain;
    }

    .scan-icon-location {
      mask-image: url("/images/icons/ai-scan/location.svg");
    }

    .scan-icon-search {
      mask-image: url("/images/icons/ai-scan/search.svg");
    }

    .scan-icon-pages {
      mask-image: url("/images/icons/ai-scan/pages.svg");
    }

    .scan-icon-ai {
      mask-image: url("/images/icons/ai-scan/ai.svg");
    }

    .scan-icon-clock {
      mask-image: url("/images/icons/ai-scan/clock.svg");
    }

    .scan-stage-hero-icon {
      position: relative;
      display: inline-grid;
      width: 5rem;
      height: 4.5rem;
      place-items: center;
      color: var(--green);
    }

    .scan-stage-hero-icon > .scan-icon {
      position: relative;
      z-index: 2;
      width: 1.9rem;
      height: 1.9rem;
      filter: drop-shadow(0 9px 12px rgba(95, 143, 34, 0.2));
    }

    .scan-stage-pulse {
      position: absolute;
      top: 50%;
      width: 2rem;
      height: 3.25rem;
      border: 3px solid rgba(63, 140, 203, 0.15);
      border-top-color: transparent;
      border-bottom-color: transparent;
      animation: scan-signal-pulse 1.7s ease-in-out infinite;
    }

    .scan-stage-pulse-left {
      left: 0.25rem;
      border-right: 0;
      border-radius: 3rem 0 0 3rem;
      transform: translateY(-50%);
    }

    .scan-stage-pulse-right {
      right: 0.25rem;
      border-left: 0;
      border-radius: 0 3rem 3rem 0;
      transform: translateY(-50%);
      animation-delay: 0.18s;
    }

    @keyframes scan-signal-pulse {
      0%,
      100% {
        opacity: 0.45;
        scale: 0.84;
      }

      50% {
        opacity: 1;
        scale: 1;
      }
    }

    .scan-progress-track {
      height: 0.55rem;
      overflow: hidden;
      border-radius: 999px;
      background: #e8edf6;
      box-shadow: inset 0 1px 2px rgba(35, 46, 102, 0.08);
    }

    .scan-progress-bar {
      display: block;
      width: var(--scan-progress);
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--green), #80d91f);
      box-shadow: 0 0 18px rgba(147, 200, 69, 0.28);
      transition: width 600ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .scan-stage-grid {
      display: grid;
      border-top: 1px solid rgba(35, 46, 102, 0.11);
      border-bottom: 1px solid rgba(35, 46, 102, 0.11);
    }

    .scan-stage-item {
      position: relative;
      display: grid;
      grid-template-columns: 2.8rem 1fr;
      gap: 0.9rem;
      align-items: center;
      padding: 0.95rem 0;
      border-bottom: 1px solid rgba(35, 46, 102, 0.09);
      color: rgba(35, 46, 102, 0.36);
      transition: color 260ms ease;
    }

    .scan-stage-item:last-child {
      border-bottom: 0;
    }

    .scan-stage-marker {
      position: relative;
      z-index: 1;
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border: 1.5px solid rgba(35, 46, 102, 0.2);
      border-radius: 999px;
      background: #fff;
      color: rgba(35, 46, 102, 0.42);
      transition: border-color 260ms ease, background 260ms ease, color 260ms ease, transform 260ms ease;
    }

    .scan-stage-marker .scan-icon {
      width: 1.05rem;
      height: 1.05rem;
    }

    .scan-stage-label {
      max-width: 13rem;
      font-size: 0.78rem;
      font-weight: 650;
      line-height: 1.35;
    }

    .scan-stage-complete {
      color: rgba(35, 46, 102, 0.68);
    }

    .scan-stage-complete .scan-stage-marker {
      border-color: var(--navy);
      background: var(--navy);
      color: #fff;
    }

    .scan-stage-active {
      color: var(--navy-deep);
    }

    .scan-stage-active .scan-stage-marker {
      border-color: var(--green);
      background: var(--green);
      color: #fff;
      transform: scale(1.08);
      box-shadow: 0 12px 25px -15px rgba(95, 143, 34, 0.8);
    }

    .scan-progress-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
    }

    .scan-progress-note .scan-icon {
      width: 0.85rem;
      height: 0.85rem;
      color: var(--green);
    }

    .report-cta-pulse::after {
      position: absolute;
      inset: 0;
      border: 2px solid var(--green);
      border-radius: inherit;
      content: "";
      pointer-events: none;
      animation: report-cta-pulse 2.8s ease-out infinite;
    }

    @keyframes report-cta-pulse {
      0%,
      58% {
        opacity: 0;
        transform: scale(1);
      }

      66% {
        opacity: 0.62;
      }

      100% {
        opacity: 0;
        transform: scale(1.16, 1.45);
      }
    }

    @media (min-width: 768px) {
      .scan-stage-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border: 0;
      }

      .scan-stage-item {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 0.7rem;
        padding: 0;
        border: 0;
        text-align: center;
      }

      .scan-stage-item:not(:last-child)::after {
        position: absolute;
        z-index: 0;
        top: 1.35rem;
        left: calc(50% + 1.75rem);
        width: calc(100% - 3.5rem);
        height: 1px;
        background: rgba(35, 46, 102, 0.16);
        content: "";
      }

      .scan-stage-label {
        max-width: 11.5rem;
      }
    }

    .score-ring {
      display: grid;
      width: 11.5rem;
      aspect-ratio: 1;
      place-items: center;
      border-radius: 999px;
      background: conic-gradient(var(--green) calc(var(--score) * 1%), rgba(255, 255, 255, 0.12) 0);
      box-shadow: 0 28px 60px -34px rgba(0, 0, 0, 0.65);
      position: relative;
    }

    .score-ring::after {
      content: "";
      position: absolute;
      inset: 0.6rem;
      border-radius: inherit;
      background: var(--navy-deep);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }

    .score-ring-inner {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      flex-direction: column;
      justify-content: center;
    }

    .rank-track {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      max-width: 100%;
      overflow-x: auto;
      padding: 0.2rem 0 0.55rem;
      scrollbar-width: thin;
    }

    .rank-node {
      display: flex;
      min-width: 4.25rem;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      position: relative;
    }

    .rank-node:not(:last-child)::after {
      content: "";
      position: absolute;
      left: calc(50% + 1.55rem);
      top: 1.45rem;
      width: 1.7rem;
      height: 1px;
      background: var(--hairline);
    }

    .rank-node span {
      display: inline-flex;
      width: 3rem;
      height: 3rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      font-family: var(--font-display);
      font-weight: 600;
    }

    .rank-node small {
      color: rgba(20, 22, 28, 0.42);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .rank-node-ahead span {
      background: #fff;
      box-shadow: inset 0 0 0 1px var(--hairline);
      color: rgba(20, 22, 28, 0.5);
    }

    .rank-node-current span {
      background: var(--green);
      color: var(--charcoal);
      box-shadow: 0 12px 28px -16px rgba(95, 143, 34, 0.75);
    }

    .rank-node-current small {
      color: var(--navy);
    }

    .rank-node-more,
    .rank-node-after {
      flex: 0 0 auto;
      border-radius: 999px;
      background: rgba(35, 46, 102, 0.06);
      padding: 0.55rem 0.75rem;
      color: rgba(20, 22, 28, 0.46);
      font-size: 0.7rem;
      font-weight: 700;
      white-space: nowrap;
    }

    @media (max-width: 1023px) {
      .score-ring {
        width: 10.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .scan-stage-pulse {
        animation: none;
        opacity: 0.75;
      }

      .scan-progress-bar {
        transition: none;
      }

      .report-cta-pulse::after {
        animation: none;
        display: none;
      }
    }
  </style>
</BaseLayout>
