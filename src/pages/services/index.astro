---
import { ArrowRight, ArrowUpRight, Check } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/site/PageHero.astro";
import MarketingIcon, { type IconName } from "@/components/site/MarketingIcon.astro";
import { CONSULTATION_URL, services } from "@/lib/services";
import { getServiceDetail } from "@/lib/service-details";
import { siteMedia } from "@/lib/site-media";
import { audiences } from "@/lib/audiences";

const vip = services.find((service) => service.featured) ?? services[0];
const rest = services.filter((service) => !service.featured);
const vipDetail = getServiceDetail(vip.slug);
const serviceMarketingIcons: Record<string, IconName> = {
  "vip-marketing-manager": "team-support",
  "directtrack-marketing": "call-tracking",
  "marketing-consulting": "strategy",
  "direct-mail": "direct-mail",
  "social-media-marketing": "social-media",
  "retention-marketing": "customer-retention",
  "digital-marketing": "local-seo",
  "boost-days": "campaign-launch",
};
const serviceNeeds = [
  {
    title: "You need a clearer plan before spending more.",
    copy: "Review what is running, decide what to keep or change, and leave with a practical next move.",
    slug: "marketing-consulting",
    label: "Explore Marketing Consulting",
  },
  {
    title: "You need a coordinated marketing department.",
    copy: "Put strategy, creative, vendor coordination, reporting, and weekly execution under one accountable team.",
    slug: "vip-marketing-manager",
    label: "Explore VIP Marketing Manager",
  },
  {
    title: "You need more local customers in the door.",
    copy: "Build a planned postcard campaign around the right list, offer, timing, and reporting.",
    slug: "direct-mail",
    label: "Explore Direct Mail",
  },
  {
    title: "You need nearby drivers to find and trust you.",
    copy: "Strengthen reviews, your Google Business Profile, website oversight, and the vendors connected to them.",
    slug: "digital-marketing",
    label: "Explore Digital Marketing",
  },
];

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Auto Repair Marketing Services",
  description:
    "Turnkey Marketing services for independent auto repair shops, including consulting, direct mail, social media, retention, digital marketing, and an outsourced marketing department.",
  url: "https://www.turnkeyautomarketing.com/services",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: services.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.name,
      url: `https://www.turnkeyautomarketing.com/services/${service.slug}`,
    })),
  },
};
---

<BaseLayout
  title="Auto Repair Marketing Services | Turnkey Marketing"
  description="Explore auto repair marketing services from Turnkey: strategy, direct mail, retention, social media, local SEO, and coordinated vendor support."
  path="/services"
  ogTitle="Services — Turnkey Marketing"
  ogImage={siteMedia.about.team.src}
  schema={servicesSchema}
>
  <PageHero
    eyebrow="Services"
    title="Auto repair marketing services built around the whole shop."
    description="You do not need more disconnected vendors. You need an auto repair marketing agency that sees the whole board, knows the repair-shop world, and moves the plan forward every week."
    image={siteMedia.services.overviewHero}
    ctaHref={CONSULTATION_URL}
    ctaLabel="Book a Strategy Call"
    secondaryHref="#service-list"
    secondaryLabel="See the services"
  >
    <div slot="badge" class="card-float floaty absolute -left-3 bottom-8 px-5 py-4 md:left-4">
      <div class="flex items-center gap-2">
        <MarketingIcon name="reviews" class="h-7 w-7" />
        <p class="text-xs font-medium text-charcoal/60">300+ shops</p>
      </div>
      <p class="mt-1 font-display text-lg font-semibold tracking-normal text-charcoal">
        One coordinated plan
      </p>
    </div>
  </PageHero>

  <section class="bg-white py-14 md:py-20">
    <div class="container-page grid gap-7 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <p class="eyebrow">Built for independent shops</p>
        <h2 class="mt-5 max-w-[13ch] text-balance text-[clamp(2.2rem,4.2vw,3.9rem)] font-semibold leading-[1.02] tracking-[-0.045em] text-charcoal">
          The right work, connected to one plan.
        </h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-muted-foreground lg:col-span-6 lg:col-start-7 lg:pt-8">
        <p>
          Turnkey helps auto shop owners connect strategy, direct mail, customer retention,
          social media, digital campaigns, and reporting. Some shops need a complete outside
          marketing department; others need one focused service. Either way, the work starts
          with what the shop is trying to change, not with a channel someone wants to sell.
        </p>
        <p>
          For local visibility, that includes the practical SEO work already inside our Digital
          Marketing service: Google review management, Google Business Profile optimization,
          semi-annual website audits, and coordination with website and Google Ads vendors.
          Turnkey keeps those pieces working toward the same goal while the shop owner stays
          focused on the bays, the team, and the customers.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:items-start lg:gap-14">
      <div class="lg:col-span-5">
        <p class="eyebrow text-[var(--key-blue)]">Who we help</p>
        <h2 class="display-3 mt-5 max-w-[13ch] text-balance text-charcoal">Match the service plan to the shop.</h2>
      </div>
      <div class="grid gap-4 lg:col-span-7">
        {audiences.map((audience) => (
          <a href={`/who-we-help/${audience.slug}`} class="group rounded-[26px] border border-[var(--hairline)] bg-white p-6 transition hover:-translate-y-1 hover:border-[var(--key-blue)]/35 hover:shadow-[0_24px_65px_-50px_rgba(20,22,28,0.5)] md:p-8">
            <h3 class="font-display text-2xl font-semibold leading-tight text-charcoal">{audience.name}</h3>
            <p class="mt-3 leading-relaxed text-charcoal/65">{audience.heroCopy}</p>
            <span class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--navy)]">
              Explore this shop type
              <ArrowRight className="motion-arrow h-4 w-4" aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--navy)] py-14 md:py-20">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow text-[var(--green)]">Choose by what your shop needs</p>
        <h2 class="mt-5 text-balance text-[clamp(2.2rem,4.2vw,3.9rem)] font-semibold leading-[1.02] tracking-[-0.045em] text-white">
          Start with the problem in front of you.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-white/72">
          You can start with one service. Choose the service that fits the
          decision your shop needs to make now.
        </p>
      </div>

      <div class="mt-9 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-5">
        {serviceNeeds.map((need) => (
          <a
            href={`/services/${need.slug}`}
            class="group flex min-h-[230px] flex-col rounded-[28px] border border-black/[0.06] bg-white p-6 shadow-[0_22px_60px_-50px_rgba(20,22,28,0.5)] transition hover:-translate-y-1 hover:border-[var(--key-blue)]/30 hover:shadow-[0_28px_70px_-46px_rgba(20,22,28,0.52)] md:p-8"
            data-track-event="service_cta_click"
            data-track-slug={need.slug}
            data-track-placement="services_need_pathways"
          >
            <h3 class="max-w-[20ch] font-display text-2xl font-semibold leading-tight tracking-normal text-charcoal md:text-[1.75rem]">
              {need.title}
            </h3>
            <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">{need.copy}</p>
            <span class="mt-auto inline-flex min-h-11 items-end gap-2 pt-7 font-semibold text-[var(--navy)]">
              {need.label}
              <ArrowRight className="motion-arrow h-4 w-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-16 md:py-24">
    <div class="container-page">
      <a
        href={`/services/${vip.slug}`}
        class="group grid gap-10 overflow-hidden rounded-[32px] bg-white p-7 shadow-[0_30px_90px_-60px_rgba(20,22,28,0.34)] md:p-10 lg:grid-cols-12 lg:items-center"
        data-track-event="service_cta_click"
        data-track-slug={vip.slug}
        data-track-placement="services_hero"
      >
        <div class="lg:col-span-5">
          <div class="flex items-center gap-2">
            <MarketingIcon name="reviews" class="h-7 w-7" />
            <p class="text-xs uppercase tracking-[0.18em] text-charcoal/60">
              Flagship service
            </p>
          </div>
          <h2 class="display-2 mt-5 max-w-[10ch] text-balance text-charcoal">
            {vip.name}
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-charcoal/65">
            {vip.tagline}
          </p>
          <span class="mt-8 inline-flex items-center gap-2 font-medium text-charcoal">
            Explore VIP Marketing Manager
            <ArrowUpRight className="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </span>
        </div>

        <div class="lg:col-span-4">
          <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-1">
            {vipDetail.included.map((item) => (
              <li class="flex items-center gap-3 text-[0.95rem] font-medium text-charcoal">
                <span class="inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-[var(--key-blue-soft)]">
                  <Check className="h-3.5 w-3.5 text-[var(--navy)]" />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="relative lg:col-span-3">
          <div class="aspect-[4/3] overflow-hidden rounded-[24px] bg-[var(--off-white)]">
            <img
              src={vipDetail.image.src}
              alt={vipDetail.image.alt}
              width="900"
              height="675"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              style={`object-position: ${vipDetail.image.position};`}
            />
          </div>
        </div>
      </a>
    </div>
  </section>

  <section id="service-list" class="container-page py-16 md:py-24">
    <div class="flex items-center gap-5">
      <p class="text-sm font-semibold text-charcoal/70">Services</p>
      <div class="h-px flex-1 bg-charcoal/10"></div>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {rest.map((service) => {
        const detail = getServiceDetail(service.slug);
        return (
          <a
            href={`/services/${service.slug}`}
            class:list={[
              "group grid min-h-[280px] gap-7 rounded-[28px] bg-white p-7 transition hover:-translate-y-1 hover:shadow-[0_28px_70px_-48px_rgba(20,22,28,0.35)] md:grid-cols-[1fr_180px]",
              service.isNew && "ring-1 ring-[var(--green)]/45",
            ]}
            data-track-event="service_cta_click"
            data-track-slug={service.slug}
          >
            <div>
              <MarketingIcon
                name={serviceMarketingIcons[service.slug] ?? "strategy"}
                class="mb-5 h-10 w-10 transition-transform duration-300 group-hover:scale-110"
              />
              {service.isNew && (
                <span
                  class="inline-flex rounded px-1.5 py-0.5 text-[0.6rem] uppercase tracking-widest"
                  style="background: var(--green); color: var(--charcoal);"
                >
                  New
                </span>
              )}
              <h2 class:list={[
                "font-display text-3xl font-semibold leading-tight tracking-normal text-charcoal",
                service.isNew && "mt-4",
              ]}>
                {service.name}
              </h2>
              <p class="mt-4 max-w-md text-muted-foreground">
                {service.tagline}
              </p>
              <span class="mt-8 inline-flex items-center gap-2 font-medium text-charcoal">
                View service
                <ArrowRight className="h-4 w-4 transition group-hover:translate-x-1" />
              </span>
            </div>
            <div class="aspect-[4/3] overflow-hidden rounded-[24px] bg-[var(--off-white)] md:aspect-auto">
              <img
                src={detail.image.src}
                alt={detail.image.alt}
                width="1200"
                height={service.slug === "direct-mail" ? 673 : 675}
                loading="lazy"
                decoding="async"
                class:list={[
                  "h-full w-full transition duration-500 group-hover:scale-[1.04]",
                  detail.imageFit === "contain" ? "object-contain p-6" : "object-cover",
                ]}
                style={`object-position: ${detail.image.position};`}
              />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container-page pb-24 md:pb-32">
    <a
      href={CONSULTATION_URL}
      class="flex flex-col gap-8 rounded-[32px] bg-[var(--charcoal)] p-8 text-white transition hover:bg-[var(--navy)] md:flex-row md:items-center md:justify-between md:p-12"
      data-track-event="consultation_cta_click"
      data-track-placement="services_index"
    >
      <span class="font-display text-3xl font-semibold leading-tight tracking-normal md:text-4xl">
        Want us to help sort what your shop actually needs?
      </span>
      <span class="inline-flex items-center gap-2 font-medium">
        Book a Strategy Call
        <ArrowRight className="h-4 w-4" />
      </span>
    </a>
  </section>
</BaseLayout>
