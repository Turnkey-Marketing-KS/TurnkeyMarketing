---
import V6Layout from "@/components/v6/V6Layout.astro";
import V6PageHero from "@/components/v6/V6PageHero.astro";
import SolidPhoneIcon from "@/components/site/SolidPhoneIcon.astro";
import { CONSULTATION_URL, services } from "@/lib/services";
import { getServiceDetail } from "@/lib/service-details";
import { siteMedia } from "@/lib/site-media";
import { audiences } from "@/lib/audiences";
import { arrow, arrowUp, iconSrc, phoneHref, phoneLabel, serviceIcons, split } from "@/lib/v6";

const vip = services.find((service) => service.featured) ?? services[0];
const rest = services.filter((service) => !service.featured);
const included = rest.filter((service) => !service.isNew);
const spotlight = rest.filter((service) => service.isNew);
const vipDetail = getServiceDetail(vip.slug);
const dtSteps = [
  { icon: "location", title: "Choose the <br />right households" },
  { icon: "email", title: "Run one <br />coordinated campaign" },
  { icon: "report", title: "Measure, review, <br />and improve" },
];
const serviceNeeds = [
  {
    title: "You need a clearer plan before spending more.",
    copy: "Review what is running, decide what to keep or change, and leave with a practical next move.",
    slug: "marketing-consulting",
    label: "Explore Marketing Consulting",
  },
  {
    title: "You need a coordinated marketing department.",
    copy: "Put strategy, creative, vendor coordination, reporting, and weekly execution under one accountable team.",
    slug: "vip-marketing-manager",
    label: "Explore VIP Marketing Manager",
  },
  {
    title: "You need more local customers in the door.",
    copy: "Build a planned postcard campaign around the right list, offer, timing, and reporting.",
    slug: "direct-mail",
    label: "Explore Direct Mail",
  },
  {
    title: "You need nearby drivers to find and trust you.",
    copy: "Strengthen reviews, your Google Business Profile, website oversight, and the vendors connected to them.",
    slug: "digital-marketing",
    label: "Explore Digital Marketing",
  },
];

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Auto Repair Marketing Services",
  description:
    "Turnkey Marketing services for independent auto repair shops, including consulting, direct mail, social media, retention, digital marketing, and an outsourced marketing department.",
  url: "https://www.turnkeyautomarketing.com/services",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: services.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.name,
      url: `https://www.turnkeyautomarketing.com/services/${service.slug}`,
    })),
  },
};
const heroImage = siteMedia.services.overviewHero;
---

<V6Layout
  title="Auto Repair Marketing Services | Turnkey Marketing"
  description="Explore auto repair marketing services from Turnkey: strategy, direct mail, retention, social media, local SEO, and coordinated vendor support."
  path="/services"
  ogTitle="Services — Turnkey Marketing"
  ogImage={siteMedia.about.team.src}
  schema={servicesSchema}
  class="tk-svc"
>
  <V6PageHero
    title="Auto repair marketing services"
    accent="built around the whole shop."
    lead="You do not need more disconnected vendors. You need an auto repair marketing agency that sees the whole board, knows the repair-shop world, and moves the plan forward every week."
    image={{ ...heroImage, width: 950, height: 664 }}
    class="tk-svc__hero"
  >
    <a href={CONSULTATION_URL} class="v6-btn v6-btn--navy v6-btn--lg"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
    <a href="#service-list" class="v6-link">See the services <i set:html={arrow} /></a>
    <p slot="aside" class="tk-svc__badge"><span class="v6-stars" aria-hidden="true">★★★★★</span><span>300+ shops</span><strong>One coordinated plan</strong></p>
  </V6PageHero>

  <!-- Intro: sticky title beside the two paragraphs -->
  <section class="v6-sec tk-svc__intro">
    <div class="v6-wrap tk-svc__introGrid">
      <h2 class="v6-h2 tk-svc__introTitle" data-words set:html={split([{ t: "The right work," }, { t: "connected to one plan.", accent: true }])} />
      <div class="tk-svc__introCopy" data-rise>
        <p>
          Turnkey helps auto shop owners connect strategy, direct mail, customer retention,
          social media, digital campaigns, and reporting. Some shops need a complete outside
          marketing department; others need one focused service. Either way, the work starts
          with what the shop is trying to change, not with a channel someone wants to sell.
        </p>
        <p>
          For local visibility, that includes the practical SEO work already inside our Digital
          Marketing service: Google review management, Google Business Profile optimization,
          semi-annual website audits, and coordination with website and Google Ads vendors.
          Turnkey keeps those pieces working toward the same goal while the shop owner stays
          focused on the bays, the team, and the customers.
        </p>
      </div>
    </div>
  </section>

  <!-- The suite: VIP as the umbrella, the rest included -->
  <section id="service-list" class="v6-sec v6-sec--tint tk-svc__suiteSec">
    <div class="v6-wrap">
      <div class="v6-suite tk-svc__suite" data-rise>
        <a
          href={`/services/${vip.slug}`}
          class="v6-suite__lead tk-svc__lead"
          data-track-event="service_cta_click"
          data-track-slug={vip.slug}
          data-track-placement="services_hero"
        >
          <div class="v6-suite__content tk-svc__leadContent">
            <span class="tk-svc__flag"><span class="tk-svc__flagIcon"><span class="v6-icon" style={`--icon:url(${iconSrc("vip")})`}></span></span>Flagship service</span>
            <h2 class="v6-suite__name">{vip.name}</h2>
            <p class="v6-suite__copy">{vip.tagline}</p>
            <ul class="tk-svc__vipList">
              {vipDetail.included.map((item) => (
                <li><span class="v6-mark v6-mark--check" aria-hidden="true"></span>{item}</li>
              ))}
            </ul>
            <span class="v6-btn v6-btn--green tk-svc__leadBtn"><span>Explore VIP Marketing Manager</span><i set:html={arrow} /></span>
          </div>
        </a>
        <div class="v6-suite__list">
          <p class="v6-suite__label">All included with our VIP plan. Also available on their own.</p>
          <ul>
            {included.map((service) => (
              <li>
                <a href={`/services/${service.slug}`} class="v6-svc tk-svc__item" data-track-event="service_cta_click" data-track-slug={service.slug}>
                  <span class="v6-svc__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(serviceIcons[service.slug])})`}></span></span>
                  <span class="v6-svc__text">
                    <h2 class="v6-svc__name tk-svc__itemName">{service.name}</h2>
                    <span class="v6-svc__tagline">{service.tagline}</span>
                    <span class="tk-svc__view">View service <i set:html={arrow} /></span>
                  </span>
                  <span class="v6-svc__go" set:html={arrowUp} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {spotlight.map((service) => (
        <a href={`/services/${service.slug}`} class="v6-dt tk-svc__dt" data-track-event="service_cta_click" data-track-slug={service.slug} data-rise>
          <div class="v6-dt__intro">
            <span class="v6-dt__new">New</span>
            <h2 class="v6-dt__name">{service.name}</h2>
            <p class="v6-dt__copy">{service.tagline}</p>
            <span class="v6-link v6-link--light">View service <i set:html={arrow} /></span>
          </div>
          <ol class="v6-dt__flow" aria-hidden="true">
            {dtSteps.map((step, index) => (
              <li>
                <span class="v6-dt__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(step.icon)})`}></span></span>
                <span class="v6-dt__row"><span class="v6-dt__num">{index + 1}</span><span class="v6-dt__title" set:html={step.title} /></span>
              </li>
            ))}
          </ol>
        </a>
      ))}
    </div>
  </section>

  <!-- Choose by need -->
  <section class="v6-sec v6-sec--navy tk-svc__needs">
    <div class="v6-wrap">
      <div class="v6-head">
        <h2 class="v6-h2" data-words set:html={split([{ t: "Start with the problem" }, { t: "in front of you.", accent: true }])} />
        <p class="v6-lead" data-rise>
          You can start with one service. Choose the service that fits the
          decision your shop needs to make now.
        </p>
      </div>
      <div class="v6-swipe tk-svc__needGrid" style="--cols:2">
        {serviceNeeds.map((need, index) => (
          <a
            href={`/services/${need.slug}`}
            class="tk-svc__need"
            data-track-event="service_cta_click"
            data-track-slug={need.slug}
            data-track-placement="services_need_pathways"
            data-rise
          >
            <span class="tk-svc__needIcon"><span class="v6-icon" style={`--icon:url(${iconSrc(serviceIcons[need.slug])})`}></span></span>
            <h3 class="tk-svc__needTitle">{need.title}</h3>
            <p class="tk-svc__needCopy">{need.copy}</p>
            <span class="v6-link tk-svc__needGo">{need.label} <i set:html={arrow} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we help -->
  <section class="v6-sec tk-svc__who">
    <div class="v6-wrap tk-svc__whoGrid">
      <h2 class="v6-h2 tk-svc__whoTitle" data-words set:html={split([{ t: "Match the service plan" }, { t: "to the shop.", accent: true }])} />
      <ul class="tk-svc__whoList">
        {audiences.map((audience) => (
          <li data-rise>
            <a href={`/who-we-help/${audience.slug}`} class="tk-svc__whoRow">
              <h3 class="tk-svc__whoName">{audience.name}</h3>
              <p class="tk-svc__whoCopy">{audience.heroCopy}</p>
              <span class="v6-link tk-svc__whoGo">Explore this shop type <i set:html={arrow} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="v6-cta tk-svc__cta">
    <div class="v6-wrap">
      <div class="v6-cta__panel" data-rise>
        <p class="v6-cta__title tk-svc__ctaTitle" data-words set:html={split([{ t: "Want us to help sort what" }, { t: "your shop actually needs?", accent: true }])} />
        <div class="v6-cta__actions">
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--navy v6-btn--lg"
            data-track-event="consultation_cta_click"
            data-track-placement="services_index"
          ><span>Book a Strategy Call</span><i set:html={arrow} /></a>
          <a href={phoneHref} class="v6-btn v6-btn--ghost v6-btn--lg" data-track-event="phone_click" data-track-placement="services_index"><SolidPhoneIcon class="h-6 w-6" /><span>{phoneLabel}</span></a>
        </div>
      </div>
    </div>
  </section>
</V6Layout>

<style>
  /* Hero */
  .tk-svc__badge { display: grid; gap: 0.15rem; justify-self: start; padding: 1rem 1.25rem; border-radius: 22px; background: var(--off-white); font-size: 0.85rem; color: var(--muted); }
  .tk-svc__badge strong { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.02em; color: var(--charcoal); }
  .tk-svc__badge .v6-stars { font-size: 0.8rem; }
  :global(.tk-svc__hero .v6-ph__title) { max-width: 15ch; }
  :global(.tk-svc__hero .v6-ph__actions .v6-link) { min-height: 2.75rem; }

  /* Intro */
  .tk-svc__introGrid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .tk-svc__introTitle { position: sticky; top: 8rem; max-width: 12ch; }
  .tk-svc__introCopy { display: grid; gap: 1.4rem; padding-top: 0.75rem; font-size: clamp(1.1rem, 1.35vw, 1.3rem); line-height: 1.65; color: #3a3f4b; }
  .tk-svc__introCopy p:first-child { font-size: clamp(1.25rem, 1.7vw, 1.55rem); line-height: 1.5; letter-spacing: -0.015em; color: var(--charcoal); }

  /* Suite */
  .tk-svc__suite { margin-top: 0; }
  .tk-svc__lead { min-height: 38rem; }
  .tk-svc__leadContent { justify-content: flex-start; width: 100%; }
  .tk-svc__flag { display: inline-flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; font-weight: 600; color: rgba(255, 255, 255, 0.85); }
  .tk-svc__flagIcon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: var(--green); color: var(--navy); }
  .tk-svc__flagIcon .v6-icon { width: 1.4rem; height: 1.4rem; }
  .tk-svc__lead .v6-suite__name { margin-top: auto; padding-top: 2rem; }
  .tk-svc__vipList { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.25rem; width: 100%; margin-block: 0.5rem 0.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.16); font-size: 0.92rem; line-height: 1.4; color: rgba(255, 255, 255, 0.9); }
  .tk-svc__vipList li { display: flex; align-items: flex-start; gap: 0.6rem; }
  .tk-svc__vipList .v6-mark { width: 1.3rem; height: 1.3rem; }
  .tk-svc__leadBtn { transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .tk-svc__lead:hover .tk-svc__leadBtn { transform: translateY(-2px); box-shadow: 0 16px 36px -18px rgba(147, 200, 69, 0.9); }
  .tk-svc__lead:hover .tk-svc__leadBtn i { transform: translateX(3px); }
  .tk-svc__itemName { font-weight: 600; font-size: 1.15rem; letter-spacing: -0.025em; line-height: 1.2; }
  .tk-svc__view { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--navy); transition: color 0.35s; }
  .tk-svc__item:hover .tk-svc__view { color: #fff; }
  .tk-svc__item .v6-svc__go { display: none; }
  .tk-svc__dt { transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .tk-svc__dt:hover { transform: translateY(-3px); box-shadow: 0 30px 70px -40px rgba(35, 46, 102, 0.9); }
  .tk-svc__dt:hover .v6-link { background-size: 100% 1.5px; }

  /* Needs */
  .tk-svc__need { display: flex; flex-direction: column; gap: 0.9rem; min-height: 17rem; padding: clamp(1.75rem, 3vw, 2.5rem); border-radius: 30px; background: #fff; color: var(--charcoal); box-shadow: 0 30px 60px -44px rgba(0, 0, 0, 0.55); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .tk-svc__need:hover { transform: translateY(-4px); box-shadow: 0 36px 70px -40px rgba(0, 0, 0, 0.6); }
  .tk-svc__needIcon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: var(--green); color: var(--navy); transition: background-color 0.4s, color 0.4s; }
  .tk-svc__needIcon .v6-icon { width: 1.5rem; height: 1.5rem; }
  .tk-svc__need:hover .tk-svc__needIcon { background: var(--navy); color: var(--green); }
  .tk-svc__needTitle { margin-top: 0.5rem; max-width: 20ch; font-size: clamp(1.4rem, 2.1vw, 1.9rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; text-wrap: balance; }
  .tk-svc__needCopy { max-width: 34rem; line-height: 1.6; color: var(--muted); }
  .tk-svc__needGo { margin-top: auto; align-self: flex-start; }
  .tk-svc__need:hover .tk-svc__needGo { background-size: 100% 1.5px; }
  .tk-svc__need:hover .tk-svc__needGo :global(i) { transform: translateX(3px); }

  /* Who we help */
  .tk-svc__whoGrid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .tk-svc__whoTitle { position: sticky; top: 8rem; max-width: 11ch; }
  .tk-svc__whoList { border-top: 1px solid var(--hairline); }
  .tk-svc__whoList li { border-bottom: 1px solid var(--hairline); }
  .tk-svc__whoRow { display: grid; gap: 0.75rem; padding-block: clamp(1.75rem, 3vw, 2.5rem); transition: padding 0.5s var(--ease); }
  .tk-svc__whoName { font-size: clamp(1.5rem, 2.4vw, 2.2rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.08; transition: color 0.3s; }
  .tk-svc__whoCopy { max-width: 40rem; line-height: 1.65; color: var(--muted); }
  .tk-svc__whoGo { justify-self: start; margin-top: 0.25rem; }
  .tk-svc__whoRow:hover .tk-svc__whoName { color: var(--key-blue); }
  .tk-svc__whoRow:hover .tk-svc__whoGo { background-size: 100% 1.5px; }
  .tk-svc__whoRow:hover .tk-svc__whoGo :global(i) { transform: translateX(3px); }

  .tk-svc__ctaTitle { max-width: 16ch; font-size: clamp(2.5rem, 5.4vw, 5.25rem); }

  @media (max-width: 1100px) {
    .tk-svc__lead { min-height: 0; }
    .tk-svc__lead .v6-suite__name { padding-top: 3rem; }
  }
  @media (max-width: 900px) {
    .tk-svc__badge { display: none; }
    :global(.tk-svc__hero .v6-ph__media) { aspect-ratio: 4 / 3; }
    .tk-svc__introGrid, .tk-svc__whoGrid { grid-template-columns: 1fr; gap: 1.75rem; }
    .tk-svc__introTitle, .tk-svc__whoTitle { position: static; }
    .tk-svc__introCopy { padding-top: 0; font-size: 1.05rem; }
    .tk-svc__introCopy p:first-child { font-size: 1.2rem; }
    .tk-svc__suite { margin-inline: calc(var(--gutter) * -0.5); }
    .tk-svc__leadContent { padding: 1.75rem 1.4rem; gap: 1rem; }
    .tk-svc__lead .v6-suite__name { padding-top: 2.25rem; font-size: 2.6rem; }
    .tk-svc__vipList { grid-template-columns: 1fr; gap: 0.55rem; }
    .tk-svc__leadBtn { align-self: stretch; justify-content: center; padding-inline: 1rem; gap: 0.5rem; white-space: nowrap; font-size: 0.92rem; }
    .tk-svc__suite .v6-suite__list { padding: 1.5rem 0.4rem 0.75rem; }
    .tk-svc__suite .v6-suite__label { padding-inline: 1rem; }
    .tk-svc__item { padding: 1rem; }
    .tk-svc__dt { margin-inline: calc(var(--gutter) * -0.5); border-radius: 32px; padding: 2rem 1.5rem; }
    .tk-svc__need { min-height: 19rem; border-radius: 26px; }
    .tk-svc__whoRow { padding-block: 1.5rem; }
    .tk-svc__whoName { font-size: 1.5rem; }
    .tk-svc__ctaTitle { font-size: clamp(2.2rem, 10vw, 3rem); }
  }
</style>
