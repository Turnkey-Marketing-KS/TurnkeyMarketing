---
import V6Layout from "@/components/v6/V6Layout.astro";
import V6PageHero from "@/components/v6/V6PageHero.astro";
import SolidPhoneIcon from "@/components/site/SolidPhoneIcon.astro";
import { arrow, iconSrc, phoneHref, phoneLabel, serviceIcons, split } from "@/lib/v6";
import { CONSULTATION_URL, services, type Service } from "@/lib/services";
import { getServiceDetail } from "@/lib/service-details";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const detail = getServiceDetail(service.slug);
const servicePath = `/services/${service.slug}`;
const hero = detail.hero;
const hasHeroSubhead = hero.subhead.trim().length > 0;
const showHeroEyebrow = service.slug !== "directtrack-marketing";
const shortName = service.shortName ?? service.name;
const sectionHeadings = detail.sectionHeadings ?? {};
// Sends commercial service pages to the matching educational resource so the two
// pages support each other instead of competing for the same query.
const supportingResources: Record<string, { href: string; label: string; lead: string }> = {
  "marketing-consulting": {
    href: "/resources/auto-repair-marketing-plan",
    label: "seven-step auto repair marketing plan guide",
    lead: "Planning before the call? Use our",
  },
  "direct-mail": {
    href: "/resources/direct-mail-for-repair-shops",
    label: "direct mail campaign guide for repair shops",
    lead: "Want the thinking behind the campaign? Read our",
  },
  "directtrack-marketing": {
    href: "/resources/auto-repair-advertising",
    label: "auto repair advertising strategy guide",
    lead: "Want to see how every channel fits together? Read our",
  },
};
const supportingResource = supportingResources[service.slug];
const relatedProof = detail.relatedProof ?? [];

const relatedServices = detail.pairsWith
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is Service => Boolean(s));

const trustStats = [
  { value: "300+", label: "Auto repair shops served across the U.S." },
  { value: "13+", label: "Years marketing exclusively for shop owners" },
  { value: "5.0★", label: "Google rating from shop owners and clients" },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  url: `https://www.turnkeyautomarketing.com${servicePath}`,
  description: service.seoDescription,
  provider: {
    "@type": "Organization",
    "@id": "https://www.turnkeyautomarketing.com/#organization",
    name: "Turnkey Marketing",
    url: "https://www.turnkeyautomarketing.com",
  },
  areaServed: "United States",
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Independent auto repair shop owners",
  },
  serviceType: service.schemaType,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Services",
      item: "https://www.turnkeyautomarketing.com/services",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: service.name,
      item: `https://www.turnkeyautomarketing.com${servicePath}`,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: detail.faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const isFlagship = Boolean(service.featured);
// Real shop and team photos for each service (the old 3D renders stay only as the social share image).
const heroPhotos: Record<string, { src: string; alt: string; width: number; height: number; position?: string }> = {
  "vip-marketing-manager": { src: "/site-media/team-turnkey-2025.webp", alt: "The Turnkey Marketing team", width: 1400, height: 933, position: "50% 40%" },
  "directtrack-marketing": { src: "/site-media/hero-shop-keys.webp", alt: "Auto repair technician handing car keys back to a smiling customer outside the shop", width: 1999, height: 1333, position: "62% 50%" },
  "marketing-consulting": { src: "/site-media/mikes-auto-works.webp", alt: "Mike's Auto Works team member helping a customer at the counter", width: 1200, height: 900, position: "50% 45%" },
  "direct-mail": { src: "/site-media/tommys-hi-tech-building.webp", alt: "Tommy's Hi-Tech Auto Repair shop exterior", width: 1400, height: 685, position: "50% 50%" },
  "social-media-marketing": { src: "/site-media/thunderbird-team.webp", alt: "Thunderbird Automotive Specialists team members in the shop", width: 1200, height: 800, position: "50% 40%" },
  "retention-marketing": { src: "/site-media/hero-thunderbird-shop.webp", alt: "Shop owner helping a customer at the Thunderbird service counter", width: 1200, height: 800, position: "58% 50%" },
  "digital-marketing": { src: "/site-media/mm-shop.webp", alt: "Technician running a wheel alignment in the shop", width: 1200, height: 834, position: "66% 50%" },
  "boost-days": { src: "/site-media/hero-shop-pearson.webp", alt: "Technician smiling while working under the hood at Pearson Auto Repair", width: 2000, height: 1333, position: "58% 40%" },
};
const heroPhoto = heroPhotos[service.slug];
// Section headings: the last few words render in key blue. Text is unchanged.
const accentTail = (text: string) => {
  const words = text.split(" ");
  let cut = Math.max(1, Math.round(words.length * 0.55));
  // Keep a dash with the words before it so the blue part never starts with one
  if (/^[—–-]$/.test(words[cut] ?? "")) cut += 1;
  return split([{ t: words.slice(0, cut).join(" ") }, { t: words.slice(cut).join(" "), accent: true }]);
};
const heroKicker = showHeroEyebrow ? (hero.badge ? `${service.name} · ${hero.badge}` : service.name) : undefined;
---

<V6Layout
  title={service.seoTitle}
  description={service.seoDescription}
  path={servicePath}
  ogTitle={service.seoTitle}
  ogType="website"
  ogImage={heroPhoto.src}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
  class={isFlagship ? "tk-sd tk-sd--flag" : "tk-sd"}
>
  <V6PageHero
    title={hero.headline}
    accent={hero.headlineAccent}
    lead={hasHeroSubhead ? hero.subhead : undefined}
    crumbs={[{ label: "Services", href: "/services" }, { label: service.name }]}
    image={heroPhoto}
    class="tk-sd__hero"
  >
    <a
      href={CONSULTATION_URL}
      class="v6-btn v6-btn--navy v6-btn--lg"
      data-track-event="consultation_cta_click"
      data-track-slug={service.slug}
      data-track-placement="service_hero"
    ><span>Book a Strategy Call</span><i set:html={arrow} /></a>
    <a href="#service-includes" class="v6-link">See what's included <i set:html={arrow} /></a>
  </V6PageHero>

  <!-- Hero stats: the flagship gets the gradient border -->
  <div class="v6-wrap tk-sd__statsWrap">
    <div class:list={["tk-sd__statsFrame", isFlagship && "v6-glow"]} data-rise>
      <ul class:list={["tk-sd__stats", isFlagship && "v6-glow__inner"]}>
        {hero.stats.map((stat) => (
          <li class="tk-sd__stat">
            <p class="tk-sd__statValue">{stat.value.endsWith("★") ? <>{stat.value.slice(0, -1)}<span class="v6-star">★</span></> : stat.value}</p>
            <p class="tk-sd__statLabel">{stat.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Problems -->
  <section class="v6-sec v6-sec--tint tk-sd__pains">
    <div class="v6-wrap tk-sd__side">
      <div class="tk-sd__sideHead">
        <h2 class="v6-h2 tk-sd__h2" data-words set:html={accentTail(sectionHeadings.problems ?? "You didn't open a shop to spend your nights doing marketing.")} />
        <p class="v6-lead tk-sd__sub" data-rise>
          These are the problems shop owners bring us right before they hand this work over.
        </p>
      </div>
      <div class="tk-sd__painBody">
        <ul class="tk-sd__painList">
          {detail.pains.map((pain) => (
            <li data-rise><span class="v6-mark v6-mark--x" aria-hidden="true"></span><p>{pain}</p></li>
          ))}
        </ul>
        <div class="tk-sd__fit" data-rise>
          <span class="v6-mark v6-mark--check" aria-hidden="true"></span>
          <div>
            <p class="tk-sd__fitTitle">Where {shortName} fits</p>
            <p class="tk-sd__fitText">{detail.bestFor}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section id="service-includes" class="v6-sec tk-sd__inc">
    <div class="v6-wrap tk-sd__incGrid">
      <div class="tk-sd__incSide">
        <div class="tk-sd__incHead">
          <h2 class="v6-h2 tk-sd__h2" data-words set:html={accentTail(sectionHeadings.included ?? "Everything it takes to make this work. Handled.")} />
          <p class="v6-lead tk-sd__sub" data-rise>{service.summary}</p>
        </div>
        <div class="tk-sd__incAside" data-rise>
          {supportingResource && (
            <p class="tk-sd__resource">
              {supportingResource.lead}
              <a href={supportingResource.href}>{supportingResource.label}</a>.
            </p>
          )}
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--navy"
            data-track-event="consultation_cta_click"
            data-track-slug={service.slug}
            data-track-placement="service_includes"
          ><span>Book a Strategy Call</span><i set:html={arrow} /></a>
        </div>
      </div>

      <div class="tk-sd__incMain">
        <div class="v6-swipe tk-sd__deliv" style="--cols:2">
          {detail.deliverables.map((item) => (
            <div class="v6-tile tk-sd__tile" data-rise>
              <h3 class="v6-tile__title">{item.title}</h3>
              <p class="v6-tile__text">{item.description}</p>
            </div>
          ))}
        </div>
        {detail.scope && (
          <div class:list={["tk-sd__scopeFrame", isFlagship && "v6-glow"]} data-rise>
            <aside class:list={["tk-sd__scope", isFlagship && "v6-glow__inner"]} aria-label={`${shortName} scope`}>
              <span class="tk-sd__scopeIcon"><span class="v6-icon" style={`--icon:url(${iconSrc(serviceIcons[service.slug] ?? "target")})`}></span></span>
              <div>
                <p class="tk-sd__scopeTitle">{detail.scope.title}</p>
                <p class="tk-sd__scopeText">{detail.scope.description}</p>
              </div>
            </aside>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="v6-sec v6-sec--navy tk-sd__proc">
    <div class="v6-wrap">
      <h2 class="v6-h2 tk-sd__procTitle" data-words set:html={accentTail(sectionHeadings.process ?? "Simple on purpose. You run the shop — we run the plan.")} />
      <ol class="tk-sd__steps">
        {detail.process.map((step) => (
          <li class="tk-sd__step" data-rise>
            <span class="tk-sd__stepNum" aria-hidden="true"></span>
            <p class="tk-sd__stepTitle">{step.title}</p>
            <p class="tk-sd__stepText">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Proof -->
  <section class="v6-sec tk-sd__proof">
    <div class="v6-wrap tk-sd__proofGrid">
      <figure class="tk-sd__quote" data-rise>
        <span class="v6-stars tk-sd__stars" aria-hidden="true">★★★★★</span>
        <blockquote>“{detail.testimonial.quote}”</blockquote>
        <figcaption>
          <strong>{detail.testimonial.name}</strong>
          {detail.testimonial.detail !== detail.testimonial.name && <span>{detail.testimonial.detail}</span>}
        </figcaption>
      </figure>

      <div class="tk-sd__trust" data-rise>
        <ul class="tk-sd__trustStats">
          {trustStats.map((stat) => (
            <li>
              <p class="tk-sd__trustNum">{stat.value.endsWith("★") ? <>{stat.value.slice(0, -1)}<span class="v6-star">★</span></> : stat.value}</p>
              <p class="tk-sd__trustLabel">{stat.label}</p>
            </li>
          ))}
        </ul>
        <a href="/results" class="v6-link tk-sd__trustLink">See all shop results <i set:html={arrow} /></a>
        {relatedProof.length > 0 && (
          <div class="tk-sd__related">
            <ul>
              {relatedProof.map((proof) => (
                <li><a href={proof.href} class="tk-sd__relatedLink"><span>{proof.label}</span><i set:html={arrow} /></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- FAQ: answers stay in the HTML, only visually collapsed -->
  <section class="v6-faq tk-sd__faq">
    <div class="v6-wrap v6-faq__grid">
      <div class="tk-sd__faqSide">
        <h2 class="v6-h2 tk-sd__faqTitle" data-words set:html={split([{ t: "What shop owners ask about" }, { t: `${shortName}.`, accent: true }])} />
        <p class="v6-lead tk-sd__faqNote" data-rise>
          If your question isn't here, bring it to the call — that's what it's for.
        </p>
        <a
          href={CONSULTATION_URL}
          class="v6-btn v6-btn--navy tk-sd__faqBtn"
          data-track-event="consultation_cta_click"
          data-track-slug={service.slug}
          data-track-placement="service_faq"
        ><span>Book a Strategy Call</span><i set:html={arrow} /></a>
      </div>
      <ul class="v6-acc tk-sd__acc">
        {detail.faqs.map((item, index) => (
          <li class:list={["v6-acc__item", index === 0 && "is-open"]} data-acc-item>
            <button type="button" class="v6-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head><span>{item.q}</span><span class="v6-acc__icon" aria-hidden="true"></span></button>
            <div class="v6-acc__panel"><div><p>{item.a}</p></div></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Related services -->
  <section class="v6-sec tk-sd__pairs">
    <div class="v6-wrap">
      <div class="v6-row-head tk-sd__pairsHead">
        <div>
          <h2 class="v6-h2 tk-sd__h2" data-words set:html={accentTail(detail.relatedServicesHeading?.title ?? "Shops rarely run just one piece.")} />
          {detail.relatedServicesHeading && <p class="v6-lead tk-sd__sub" data-rise>{detail.relatedServicesHeading.description}</p>}
        </div>
        <a href="/services" class="v6-link">All services <i set:html={arrow} /></a>
      </div>
      <div class="v6-swipe tk-sd__pairGrid" style="--cols:3">
        {relatedServices.map((related) => (
          <a href={`/services/${related.slug}`} class="v6-tile tk-sd__pair" data-rise>
            <span class="tk-sd__pairTop">
              <span class="v6-tile__icon"><span class="v6-icon" style={`--icon:url(${iconSrc(serviceIcons[related.slug] ?? "target")})`}></span></span>
            </span>
            <h3 class="v6-tile__title tk-sd__pairName">{related.shortName ?? related.name}</h3>
            <p class="v6-tile__text">{related.tagline}</p>
            <span class="v6-link v6-tile__go tk-sd__pairGo">Explore service <i set:html={arrow} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Next step -->
  <section class="v6-cta tk-sd__cta">
    <div class="v6-wrap">
      <div class="v6-cta__panel" data-rise>
        <h2 class="v6-cta__title tk-sd__ctaTitle" data-words set:html={split([{ t: `See how ${shortName}` }, { t: "would fit your shop.", accent: true }])} />
        <p class="v6-cta__text">
          Book a Strategy Call — we'll look at your market, your current marketing, and whether
          this is the right move for your shop.
        </p>
        <div class="v6-cta__actions">
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--navy v6-btn--lg"
            data-track-event="consultation_cta_click"
            data-track-slug={service.slug}
            data-track-placement="service_bottom"
          ><span>Book a Strategy Call</span><i set:html={arrow} /></a>
          <a href={phoneHref} class="v6-btn v6-btn--ghost v6-btn--lg" data-track-event="phone_click" data-track-placement="service_bottom"><SolidPhoneIcon class="h-6 w-6" /><span>{phoneLabel}</span></a>
        </div>
        <a href="/results" class="v6-link tk-sd__ctaResults">See client results <i set:html={arrow} /></a>
      </div>
    </div>
  </section>
</V6Layout>

<style>
  /* Hero */
  :global(.tk-sd__hero .v6-ph__title) { max-width: 15ch; }
  :global(.tk-sd__hero .v6-kicker) { display: inline-flex; align-items: center; gap: 0.6rem; }
  :global(.tk-sd__hero .v6-kicker)::before { content: ""; width: 1.75rem; height: 2px; border-radius: 2px; background: var(--grad); }

  /* Stats */
  .tk-sd__statsWrap { margin-top: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: clamp(3.5rem, 7vw, 6.5rem); }
  .tk-sd__inc .v6-link, .tk-sd__proof .v6-link, .tk-sd__pairs .v6-link, .tk-sd__cta .v6-link, :global(.tk-sd__hero .v6-ph__actions .v6-link) { min-height: 2.75rem; }
  :global(.tk-sd__hero .v6-crumbs a) { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .tk-sd__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 4rem); padding-block: clamp(1.75rem, 3vw, 2.5rem); border-bottom: 1px solid var(--hairline); }
  .tk-sd__stat { display: grid; gap: 0.5rem; align-content: start; }
  .tk-sd__statValue { font-size: clamp(1.5rem, 2.4vw, 2.2rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.05; color: var(--navy); }
  .tk-sd__stat:first-child .tk-sd__statValue { color: var(--key-blue); }
  .tk-sd__statLabel { max-width: 30ch; font-size: 0.95rem; line-height: 1.55; color: var(--muted); }
  :global(.tk-sd--flag) .tk-sd__stats { border-bottom: 0; padding: clamp(1.75rem, 3.5vw, 2.75rem); }
  :global(.tk-sd--flag) .tk-sd__stat + .tk-sd__stat { padding-left: clamp(1.5rem, 4vw, 4rem); border-left: 1px solid var(--hairline); }
  :global(.tk-sd--flag) .tk-sd__stats { gap: 0; }
  :global(.tk-sd--flag) .tk-sd__stat { padding-right: 1rem; }

  /* Shared split: sticky title beside content */
  .tk-sd__h2 { font-size: clamp(2.1rem, 3.8vw, 3.75rem); max-width: 16ch; }
  .tk-sd__sub { margin-top: 1.25rem; }
  .tk-sd__side, .tk-sd__incGrid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 6vw, 6.5rem); align-items: start; }
  .tk-sd__sideHead, .tk-sd__incSide { position: sticky; top: 7.5rem; }

  /* Problems */
  .tk-sd__painList { border-top: 1px solid rgba(20, 22, 28, 0.12); }
  .tk-sd__painList li { display: flex; gap: 1.1rem; align-items: flex-start; padding-block: clamp(1.4rem, 2.6vw, 2rem); border-bottom: 1px solid rgba(20, 22, 28, 0.12); }
  .tk-sd__painList p { font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.45; letter-spacing: -0.015em; color: var(--charcoal); }
  .tk-sd__painList .v6-mark { margin-top: 0.1rem; }
  .tk-sd__painList .v6-mark--x { background: #ffe6e1; }
  .tk-sd__fit { display: flex; gap: 1.1rem; align-items: flex-start; margin-top: clamp(1.5rem, 3vw, 2.25rem); padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: 30px; background: var(--navy); color: #fff; }
  .tk-sd__fit .v6-mark { margin-top: 0.15rem; }
  .tk-sd__fitTitle { font-size: clamp(1.25rem, 1.8vw, 1.55rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; }
  .tk-sd__fitText { margin-top: 0.5rem; line-height: 1.6; color: rgba(255, 255, 255, 0.76); }

  /* Included */
  .tk-sd__incAside { display: grid; justify-items: start; gap: 1.25rem; margin-top: 1.75rem; }
  .tk-sd__resource { max-width: 30rem; font-size: 0.95rem; line-height: 1.6; color: var(--muted); }
  .tk-sd__resource a { margin-left: 0.25rem; font-weight: 600; color: var(--navy); text-decoration: underline; text-decoration-color: rgba(63, 140, 203, 0.45); text-decoration-thickness: 1.5px; text-underline-offset: 4px; transition: text-decoration-color 0.3s; }
  .tk-sd__resource a:hover { text-decoration-color: var(--key-blue); }
  .tk-sd__deliv { counter-reset: tk-deliv; }
  .tk-sd__tile { counter-increment: tk-deliv; min-height: 14rem; }
  .tk-sd__tileNum::before { content: counter(tk-deliv, decimal-leading-zero); font-size: 0.9rem; font-weight: 700; color: var(--key-blue); font-variant-numeric: tabular-nums; }
  .tk-sd__tileNum { display: block; margin-bottom: auto; padding-bottom: 1.5rem; }
  :global(.tk-sd--flag) .tk-sd__tileNum::before { color: var(--green); }
  /* Odd counts: the first tile spans the row so the grid never leaves an orphan */
  .tk-sd__tile:first-child:nth-last-child(odd) { grid-column: 1 / -1; min-height: 0; background: var(--navy); color: #fff; }
  .tk-sd__tile:first-child:nth-last-child(odd) .v6-tile__text { color: rgba(255, 255, 255, 0.74); max-width: 40rem; }
  .tk-sd__tile:first-child:nth-last-child(odd) .tk-sd__tileNum::before { color: var(--green); }
  .tk-sd__scopeFrame { margin-top: clamp(0.75rem, 1.5vw, 1.25rem); }
  .tk-sd__scope { display: flex; gap: 1.25rem; align-items: flex-start; padding: clamp(1.5rem, 2.6vw, 2.25rem); border-radius: 30px; background: var(--key-blue-soft); }
  .tk-sd__scopeIcon { flex: none; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: #fff; color: var(--navy); }
  .tk-sd__scopeIcon .v6-icon { width: 1.5rem; height: 1.5rem; }
  :global(.tk-sd--flag) .tk-sd__scopeIcon { background: var(--navy); color: var(--green); }
  .tk-sd__scopeTitle { font-size: clamp(1.25rem, 1.8vw, 1.55rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.15; color: var(--navy); }
  .tk-sd__scopeText { margin-top: 0.6rem; max-width: 42rem; line-height: 1.65; color: #3a3f4b; }

  /* Process */
  .tk-sd__procTitle { max-width: 20ch; }
  .tk-sd__procTitle :global(.v6-accent) { color: #8cc3ec; }
