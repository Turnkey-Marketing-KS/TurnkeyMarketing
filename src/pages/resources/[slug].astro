---
import { ArrowLeft, ArrowRight } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarketingIdeasArticle from "@/components/resources/MarketingIdeasArticle.astro";
import { getResourcePost, resourcePosts } from "@/lib/resource-posts";
import { CONSULTATION_URL } from "@/lib/services";

export function getStaticPaths() {
  return resourcePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const currentPost = post ?? getResourcePost(Astro.params.slug ?? "");

if (!currentPost) {
  return Astro.redirect("/404");
}

const siteUrl = Astro.site ?? new URL("https://www.turnkeyautomarketing.com");
const articleUrl = new URL(currentPost.href, siteUrl).toString();
const articleImageUrl = new URL(currentPost.image.src, siteUrl).toString();
const relatedPosts = (currentPost.relatedSlugs ?? [])
  .map((slug) => getResourcePost(slug))
  .filter((relatedPost) => relatedPost !== undefined);
const isClientProof = currentPost.layout === "client-proof" && currentPost.client;
const isMarketingIdeas = currentPost.layout === "marketing-ideas";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: currentPost.title,
  description: currentPost.seoDescription ?? currentPost.description,
  image: {
    "@type": "ImageObject",
    url: articleImageUrl,
    width: currentPost.imageWidth ?? 1200,
    height: currentPost.imageHeight ?? 800,
  },
  mainEntityOfPage: articleUrl,
  ...(currentPost.originalDate ? { datePublished: currentPost.originalDate } : {}),
  ...(currentPost.updatedDate ? { dateModified: currentPost.updatedDate } : {}),
  author: {
    "@type": "Organization",
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl.toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Resources",
      item: new URL("/resources", siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: currentPost.title,
      item: articleUrl,
    },
  ],
};
---

<BaseLayout
  title={currentPost.seoTitle ?? `${currentPost.title} — Turnkey Marketing`}
  description={currentPost.seoDescription ?? currentPost.description}
  path={currentPost.href}
  ogTitle={currentPost.seoTitle ?? `${currentPost.title} — Turnkey Marketing`}
  ogType="article"
  ogImage={currentPost.image.src}
  schema={[articleSchema, breadcrumbSchema]}
>
  {isMarketingIdeas ? (
    <MarketingIdeasArticle post={currentPost} />
  ) : isClientProof ? (
    <>
      <section class="overflow-hidden bg-[var(--off-white)] py-8 md:py-12 lg:py-16">
        <div class="container-page">
          <a href="/resources" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-charcoal/65 transition hover:text-charcoal">
            <ArrowLeft className="h-4 w-4" />
            All resources
          </a>

          <header class="mt-7 grid gap-7 lg:grid-cols-12 lg:items-end lg:gap-10">
            <div class="lg:col-span-8">
              <p class="eyebrow text-[var(--key-blue)]">
                Client story · <time datetime={currentPost.updatedDate ?? currentPost.originalDate}>{currentPost.date}</time>
              </p>
              <h1 class="page-title mt-5 max-w-[14ch] text-balance text-charcoal">
                {currentPost.title}
              </h1>
            </div>
            <p class="max-w-xl text-lg leading-relaxed text-charcoal/65 lg:col-span-4 lg:pb-1">
              {currentPost.dek}
            </p>
          </header>

          <figure class="mt-10 grid overflow-hidden rounded-[30px] bg-white shadow-[0_34px_90px_-58px_rgba(20,22,28,0.55)] md:rounded-[38px] lg:grid-cols-[0.82fr_1.18fr]">
            <div class="aspect-[4/3] overflow-hidden bg-[var(--navy)] lg:aspect-auto lg:min-h-[580px]">
              <img
                src={currentPost.client.portrait.src}
                alt={currentPost.client.portrait.alt}
                width="1200"
                height="1600"
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover"
                style={`object-position: ${currentPost.client.portrait.position};`}
              />
            </div>

            <figcaption class="relative flex flex-col justify-center overflow-hidden bg-[var(--navy)] px-6 py-10 text-white md:px-12 md:py-14 lg:px-16">
              <span class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-[var(--key-blue)]/20 blur-3xl" aria-hidden="true"></span>
              <span class="font-display text-7xl font-semibold leading-none text-[var(--green)]" aria-hidden="true">“</span>
              <blockquote class="relative -mt-3 max-w-[25ch] font-display text-[clamp(1.65rem,3vw,3rem)] font-semibold leading-[1.12] tracking-[-0.035em]">
                {currentPost.client.quote}
              </blockquote>
              <div class="relative mt-9 border-t border-white/15 pt-6">
                <p class="font-semibold text-white">{currentPost.client.name}</p>
                <p class="mt-1 text-sm text-white/64">
                  {currentPost.client.company} · {currentPost.client.location}
                </p>
              </div>
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="bg-white py-14 md:py-20">
        <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
          <aside class="lg:col-span-4">
            <div class="sticky top-28">
              <p class="eyebrow text-[var(--key-blue)]">Why this matters</p>
              <h2 class="mt-4 max-w-[12ch] font-display text-3xl font-semibold leading-tight text-charcoal md:text-4xl">
                A plan turns marketing into a system.
              </h2>
              <ul class="mt-7 grid gap-4 border-t border-[var(--hairline)] pt-6 text-sm leading-relaxed text-charcoal/70">
                {currentPost.takeaways.map((takeaway) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 flex-none rounded-full bg-[var(--green)]"></span>
                    <span>{takeaway}</span>
                  </li>
                ))}
              </ul>
            </div>
          </aside>

          <article class="lg:col-span-8">
            <div class="max-w-3xl">
              {currentPost.sections.map((section, index) => (
                <section class={index === 0 ? "" : "mt-12 border-t border-[var(--hairline)] pt-12"}>
                  <p class="text-sm font-semibold tabular-nums text-[var(--key-blue)]">0{index + 1}</p>
                  <h2 class="mt-3 font-display text-3xl font-semibold leading-tight text-charcoal md:text-[2.65rem]">
                    {section.heading}
                  </h2>
                  <p class="mt-5 text-lg leading-relaxed text-charcoal/65">
                    {section.body}
                  </p>
                </section>
              ))}

              {currentPost.serviceLink && (
                <p class="mt-12 border-t border-[var(--hairline)] pt-8 text-base leading-relaxed text-charcoal/65">
                  Ready to turn the idea into a coordinated plan?
                  <a href={currentPost.serviceLink.href} class="ml-1 font-semibold text-[var(--navy)] underline decoration-[var(--key-blue)]/35 underline-offset-4 transition hover:decoration-[var(--key-blue)]">
                    {currentPost.serviceLink.label}
                  </a>.
                </p>
              )}
            </div>
          </article>
        </div>
      </section>

      <section class="bg-[var(--off-white)] py-14 md:py-20">
        <div class="container-page">
          <div class="relative overflow-hidden rounded-[30px] bg-[var(--navy)] px-6 py-10 text-white md:rounded-[36px] md:px-12 md:py-14 lg:px-16">
            <span class="pointer-events-none absolute -right-16 -top-24 h-80 w-80 rounded-full bg-[var(--key-blue)]/25 blur-3xl" aria-hidden="true"></span>
            <div class="relative grid gap-7 lg:grid-cols-[1fr_auto] lg:items-end">
              <div>
                <p class="eyebrow !text-[var(--green)]">Your plan, your shop</p>
                <h2 class="mt-4 max-w-[16ch] font-display text-3xl font-semibold leading-tight md:text-5xl">
                  Stop starting your marketing over every month.
                </h2>
                <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/70 md:text-lg">
                  Bring us your goals, capacity, and current marketing. We’ll help you see what to keep, fix, stop, and run next.
                </p>
              </div>
              <a href={CONSULTATION_URL} class="inline-flex min-h-12 w-fit items-center gap-2 rounded-full bg-[var(--green)] px-6 py-3.5 font-semibold text-charcoal transition hover:-translate-y-0.5 hover:brightness-105">
                Build My Plan
                <ArrowRight className="h-4 w-4" />
              </a>
            </div>
          </div>

          {relatedPosts.length > 0 && (
            <section class="mt-14" aria-labelledby="related-client-resources-heading">
              <div class="flex items-end justify-between gap-4 border-b border-charcoal/10 pb-4">
                <div>
                  <p class="eyebrow text-[var(--key-blue)]">Keep going</p>
                  <h2 id="related-client-resources-heading" class="mt-2 font-display text-2xl font-semibold text-charcoal">
                    Put the plan into practice
                  </h2>
                </div>
                <a href="/resources" class="text-sm font-semibold text-[var(--navy)]">View all</a>
              </div>
              <div class="mt-6 grid gap-5 sm:grid-cols-2">
                {relatedPosts.map((relatedPost) => (
                  <a href={relatedPost.href} class="group rounded-[24px] border border-black/[0.06] bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-black/10 hover:shadow-[0_24px_60px_-48px_rgba(20,22,28,0.55)]">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--key-blue)]">{relatedPost.tag}</p>
                    <h3 class="mt-3 font-display text-xl font-semibold leading-tight text-charcoal">{relatedPost.title}</h3>
                    <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--navy)]">
                      Read article <span class="motion-arrow" aria-hidden="true">→</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>
      </section>
    </>
  ) : (
    <>
  <section class="container-page py-14 md:py-20">
    <a href="/resources" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-charcoal/65 transition hover:text-charcoal">
      <ArrowLeft className="h-4 w-4" />
      All resources
    </a>

    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <p class="eyebrow text-[var(--key-blue)]">
          {currentPost.tag} · <time datetime={currentPost.updatedDate ?? currentPost.originalDate}>{currentPost.date}</time>
        </p>
        <h1 class="page-title mt-5 max-w-[12ch] text-balance text-charcoal">
          {currentPost.title}
        </h1>
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-charcoal/65">
          {currentPost.dek}
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-[30px] bg-white p-4 shadow-[0_30px_90px_-60px_rgba(20,22,28,0.45)]">
          <div class="aspect-[4/3] overflow-hidden rounded-[22px] bg-[var(--off-white)]">
            <img
              src={currentPost.image.src}
              alt={currentPost.image.alt}
              width={currentPost.imageWidth ?? 1000}
              height={currentPost.imageHeight ?? 750}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover"
              style={`object-position: ${currentPost.image.position};`}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="sticky top-28 rounded-[28px] bg-white p-7">
          <p class="text-sm font-semibold text-charcoal">What to take from this</p>
          <ul class="mt-5 grid gap-3 text-sm leading-relaxed text-charcoal/70">
            {currentPost.takeaways.map((takeaway) => (
              <li class="flex gap-3">
                <span class="mt-2 h-2 w-2 flex-none rounded-full bg-[var(--key-blue)]"></span>
                <span>{takeaway}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <article class="lg:col-span-8">
        <div class="rounded-[32px] bg-white p-7 md:p-10">
          {currentPost.sections.map((section, index) => (
            <section class={index === 0 ? "" : "mt-10 border-t hairline pt-10"}>
              <h2 class="font-display text-3xl font-semibold leading-tight text-charcoal">
                {section.heading}
              </h2>
              <p class="mt-4 max-w-3xl text-lg leading-relaxed text-charcoal/65">
                {section.body}
              </p>
              {section.bullets && (
                <ul class="mt-5 grid max-w-3xl gap-3 text-base leading-relaxed text-charcoal/65">
                  {section.bullets.map((bullet) => (
                    <li class="flex gap-3">
                      <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-[var(--key-blue)]" aria-hidden="true"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
          {currentPost.serviceLink && (
            <p class="mt-10 border-t hairline pt-8 text-base leading-relaxed text-charcoal/65">
              Ready to turn the idea into a coordinated plan?
              <a href={currentPost.serviceLink.href} class="ml-1 font-semibold text-[var(--navy)] underline decoration-[var(--key-blue)]/35 underline-offset-4 transition hover:decoration-[var(--key-blue)]">
                {currentPost.serviceLink.label}
              </a>.
            </p>
          )}
        </div>

        <div class="mt-8 rounded-[28px] bg-[var(--navy)] p-7 text-white md:p-9">
          <h2 class="font-display text-3xl font-semibold leading-tight">
            Want help applying this to your shop?
          </h2>
          <p class="mt-4 max-w-2xl text-white/70">
            Bring the question to a strategy call. We will talk through what is
            working, what is leaking, and what may make sense next.
          </p>
          <a href={CONSULTATION_URL} class="mt-7 inline-flex items-center gap-2 rounded-full bg-[var(--green)] px-6 py-3.5 font-medium text-charcoal transition hover:brightness-105">
            Book a Call
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>

        {relatedPosts.length > 0 && (
          <section class="mt-10" aria-labelledby="related-resources-heading">
            <div class="flex items-end justify-between gap-4 border-b border-charcoal/10 pb-4">
              <div>
                <p class="eyebrow text-[var(--key-blue)]">Keep going</p>
                <h2 id="related-resources-heading" class="mt-2 font-display text-2xl font-semibold text-charcoal">
                  Related resources
                </h2>
              </div>
              <a href="/resources" class="text-sm font-semibold text-[var(--navy)]">
                View all
              </a>
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              {relatedPosts.map((relatedPost) => (
                <a
                  href={relatedPost.href}
                  class="group rounded-[24px] border border-black/[0.06] bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-black/10 hover:shadow-[0_24px_60px_-48px_rgba(20,22,28,0.55)]"
                >
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--key-blue)]">
                    {relatedPost.tag}
                  </p>
                  <h3 class="mt-3 font-display text-xl font-semibold leading-tight text-charcoal">
                    {relatedPost.title}
                  </h3>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--navy)]">
                    Read article
                    <span class="motion-arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </section>
    </>
  )}
</BaseLayout>
