---
import V6Layout from "@/components/v6/V6Layout.astro";
import MarketingIdeasArticle from "@/components/resources/MarketingIdeasArticle.astro";
import AIReviewsArticle from "@/components/resources/AIReviewsArticle.astro";
import ReputationGuide from "@/components/resources/ReputationGuide.astro";
import AISearchArticle from "@/components/resources/AISearchArticle.astro";
import AdvertisingGuide from "@/components/resources/AdvertisingGuide.astro";
import ExternalSources from "@/components/resources/ExternalSources.astro";
import { getResourcePost, resourcePosts } from "@/lib/resource-posts";
import { CONSULTATION_URL } from "@/lib/services";
import { arrow, split } from "@/lib/v6";

export function getStaticPaths() {
  return resourcePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const currentPost = post ?? getResourcePost(Astro.params.slug ?? "");

if (!currentPost) {
  return Astro.redirect("/404");
}

const siteUrl = Astro.site ?? new URL("https://www.turnkeyautomarketing.com");
const articleUrl = new URL(currentPost.href, siteUrl).toString();
const articleImageUrl = new URL(currentPost.image.src, siteUrl).toString();
const relatedPosts = (currentPost.relatedSlugs ?? [])
  .map((slug) => getResourcePost(slug))
  .filter((relatedPost) => relatedPost !== undefined);
const isClientProof = currentPost.layout === "client-proof" && currentPost.client;
const isMarketingIdeas = currentPost.layout === "marketing-ideas";
const isAIReviews = currentPost.layout === "ai-reviews";
const isReputationGuide = currentPost.layout === "reputation-guide";
const isAISearch = currentPost.layout === "ai-search";
const isAdvertisingGuide = currentPost.layout === "advertising-guide";
const isTemplateLayout = !isReputationGuide && !isAIReviews && !isAISearch && !isMarketingIdeas && !isAdvertisingGuide;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: currentPost.title,
  description: currentPost.seoDescription ?? currentPost.description,
  image: {
    "@type": "ImageObject",
    url: articleImageUrl,
    width: currentPost.imageWidth ?? 1200,
    height: currentPost.imageHeight ?? 800,
  },
  mainEntityOfPage: articleUrl,
  ...(currentPost.originalDate ? { datePublished: currentPost.originalDate } : {}),
  ...(currentPost.updatedDate ? { dateModified: currentPost.updatedDate } : {}),
  author: {
    "@type": "Organization",
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "Turnkey Marketing",
    url: siteUrl.toString(),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl.toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Resources",
      item: new URL("/resources", siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: currentPost.title,
      item: articleUrl,
    },
  ],
};

const schemaFaqs = currentPost.faq?.map((item) => ({
  question: item.question,
  answer: item.answer,
})) ?? currentPost.faqs?.map((item) => ({
  question: item.q,
  answer: item.a,
}));

const faqSchema = schemaFaqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: schemaFaqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : undefined;

const pageSchemas = faqSchema
  ? [articleSchema, breadcrumbSchema, faqSchema]
  : [articleSchema, breadcrumbSchema];

const relatedCols = Math.max(2, Math.min(4, relatedPosts.length));

// Section anchors for the table of contents. The heading text itself is never changed.
const tocLabel = (heading: string) => heading.replace(/^\s*\d+[.)]\s*/, "").replace(/\.$/, "");
const usedIds = new Set<string>();
const sectionId = (heading: string) => {
  const base = tocLabel(heading).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 64) || "section";
  let id = base;
  for (let n = 2; usedIds.has(id); n++) id = `${base}-${n}`;
  usedIds.add(id);
  return id;
};
const templateSections = isTemplateLayout && !isClientProof
  ? currentPost.sections.map((section) => ({ ...section, id: sectionId(section.heading) }))
  : [];
const showToc = templateSections.length >= 3;
---

<V6Layout
  title={currentPost.seoTitle ?? `${currentPost.title} — Turnkey Marketing`}
  description={currentPost.seoDescription ?? currentPost.description}
  path={currentPost.href}
  ogTitle={currentPost.seoTitle ?? `${currentPost.title} — Turnkey Marketing`}
  ogType="article"
  ogImage={currentPost.image.src}
  schema={pageSchemas}
  class="tk-art"
>
  <div class="tk-art__progress" aria-hidden="true"><span data-art-progress></span></div>

  {isReputationGuide ? (
    <ReputationGuide post={currentPost} />
  ) : isAIReviews ? (
    <AIReviewsArticle post={currentPost} />
  ) : isAISearch ? (
    <AISearchArticle post={currentPost} />
  ) : isMarketingIdeas ? (
    <MarketingIdeasArticle post={currentPost} />
  ) : isAdvertisingGuide ? (
    <AdvertisingGuide post={currentPost} />
  ) : isClientProof ? (
    <article data-art-body>
      <header class="tk-art__hero">
        <div class="v6-wrap">
          <a href="/resources" class="tk-art__back"><i set:html={arrow} /> All resources</a>
          <div class="tk-art__head tk-art__head--solo">
            <p class="tk-art__meta" data-fade>
              Client story · <time datetime={currentPost.updatedDate ?? currentPost.originalDate}>{currentPost.date}</time>
            </p>
            <h1 class="tk-art__title" data-words set:html={split([{ t: currentPost.title }])} />
            <p class="tk-art__dek" data-fade style="--d:2">
              {currentPost.dek}
            </p>
          </div>
        </div>
      </header>

      <div class="v6-wrap">
        <figure class="tk-proof" data-fade style="--d:3">
          <div class="tk-proof__photo">
            <img
              src={currentPost.client.portrait.src}
              alt={currentPost.client.portrait.alt}
              width="1200"
              height="1600"
              loading="eager"
              decoding="async"
              style={`object-position: ${currentPost.client.portrait.position};`}
            />
          </div>
          <figcaption class="tk-proof__quote">
            <span class="tk-proof__mark" aria-hidden="true">“</span>
            <blockquote>
              {currentPost.client.quote}
            </blockquote>
            <div class="tk-proof__who">
              <p class="tk-proof__name">{currentPost.client.name}</p>
              <p>
                {currentPost.client.company} · {currentPost.client.location}
              </p>
            </div>
          </figcaption>
        </figure>
      </div>

      <section class="v6-sec tk-art__read">
        <div class="v6-wrap tk-art__layout">
          <aside class="tk-art__aside">
            <div class="tk-art__sticky">
              <h2 class="tk-art__aside-h2">
                A plan turns marketing into a system.
              </h2>
              <ul class="tk-art__takeaways">
                {currentPost.takeaways.map((takeaway) => (
                  <li><span>{takeaway}</span></li>
                ))}
              </ul>
            </div>
          </aside>

          <div class="tk-art__main">
            <div class="tk-proof__sections">
              {currentPost.sections.map((section) => (
                <section class="tk-proof__section" data-rise>
                  <h2 class="tk-proof__h2">
                    {section.heading}
                  </h2>
                  <p class="tk-proof__body">
                    {section.body}
                  </p>
                </section>
              ))}
            </div>

            {currentPost.serviceLinks && currentPost.serviceLinks.length > 0 && (
              <section class="tk-art__services" aria-labelledby="related-services-heading">
                <h2 id="related-services-heading" class="tk-art__services-h2">
                  Related marketing services
                </h2>
                <ul class="tk-art__svc">
                  {currentPost.serviceLinks.map((serviceLink) => (
                    <li>
                      <a
                        href={serviceLink.href}
                        class="tk-art__svc-row"
                        data-track-event="service_cta_click"
                        data-track-slug={serviceLink.href.replace("/services/", "")}
                        data-track-placement="resource_related_services"
                      >
                        <span class="tk-art__svc-text">
                          <h3 class="tk-art__svc-title">
                            {serviceLink.label}
                          </h3>
                          <p class="tk-art__svc-desc">
                            {serviceLink.description}
                          </p>
                        </span>
                        <span class="tk-art__svc-go" aria-hidden="true" set:html={arrow} />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      </section>
    </article>
  ) : (
    <article data-art-body>
      <header class="tk-art__hero">
        <div class="v6-wrap">
          <a href="/resources" class="tk-art__back"><i set:html={arrow} /> All resources</a>
          <div class="tk-art__head">
            <div class="tk-art__head-text">
              <p class="tk-art__meta" data-fade>
                <span class="tk-art__tag">{currentPost.tag}</span> · <time datetime={currentPost.updatedDate ?? currentPost.originalDate}>{currentPost.date}</time>
              </p>
              <h1 class="tk-art__title" data-words set:html={split([{ t: currentPost.title }])} />
              <p class="tk-art__dek" data-fade style="--d:2">
                {currentPost.dek}
              </p>
            </div>
            <figure class="tk-art__media" data-fade style="--d:3">
              <img
                src={currentPost.image.src}
                alt={currentPost.image.alt}
                width={currentPost.imageWidth ?? 1000}
                height={currentPost.imageHeight ?? 750}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                style={`object-position: ${currentPost.image.position};`}
              />
            </figure>
          </div>
        </div>
      </header>

      <section class="v6-sec tk-art__read">
        <div class="v6-wrap tk-art__layout">
          {showToc && (
            <aside class="tk-art__aside">
              <nav class="tk-toc" aria-label="In this article" data-toc>
                <details class="tk-toc__box" data-toc-details open>
                  <summary>In this article <span class="tk-toc__plus" aria-hidden="true"></span></summary>
                  <ul class="tk-toc__list">
                    {templateSections.map((section) => (
                      <li><a href={`#${section.id}`}>{tocLabel(section.heading)}</a></li>
                    ))}
                  </ul>
                </details>
              </nav>
            </aside>
          )}

          <div class:list={["tk-art__main", !showToc && "tk-art__main--solo"]}>
            <ul class="tk-art__keys">
              {currentPost.takeaways.map((takeaway) => (
                <li>{takeaway}</li>
              ))}
            </ul>

            <div class="v6-prose tk-art__prose">
              {templateSections.map((section) => (
                <section class="tk-art__section" id={section.id}>
                  <h2>
                    {section.heading}
                  </h2>
                  {section.body.split("\n\n").map((paragraph) => (
                    <p>
                      {paragraph}
                    </p>
                  ))}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {section.link && (
                    <a href={section.link.href} class="tk-art__inline-link">
                      {section.link.label.split(" ").slice(0, -1).join(" ")}{" "}<span class="tk-art__nowrap">{section.link.label.split(" ").slice(-1)[0]}<i set:html={arrow} /></span>
                    </a>
                  )}
                </section>
              ))}
            </div>

            {currentPost.serviceLinks && currentPost.serviceLinks.length > 0 && (
              <section class="tk-art__services" aria-labelledby="related-services-heading">
                <h2 id="related-services-heading" class="tk-art__services-h2">
                  Related marketing services
                </h2>
                <ul class="tk-art__svc">
                  {currentPost.serviceLinks.map((serviceLink) => (
                    <li>
                      <a
                        href={serviceLink.href}
                        class="tk-art__svc-row"
                        data-track-event="service_cta_click"
                        data-track-slug={serviceLink.href.replace("/services/", "")}
                        data-track-placement="resource_related_services"
                      >
                        <span class="tk-art__svc-text">
                          <h3 class="tk-art__svc-title">
                            {serviceLink.label}
                          </h3>
                          <p class="tk-art__svc-desc">
                            {serviceLink.description}
                          </p>
                        </span>
                        <span class="tk-art__svc-go" aria-hidden="true" set:html={arrow} />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {currentPost.slug === "auto-repair-shop-photography-guide" && (
              <aside class="tk-art__shotlist">
                <h2 class="tk-art__services-h2">A ready-to-use photo shot list</h2>
                <p>
                  Turn the guidance into a production checklist covering the exterior, team, service bays, equipment, details, and customer experience.
                </p>
                <a href="/photos" class="v6-link">
                  Open the auto repair photo shot list
                  <i set:html={arrow} />
                </a>
              </aside>
            )}
          </div>
        </div>
      </section>
    </article>
  )}

  {isTemplateLayout && currentPost.faq && currentPost.faq.length > 0 && (
    <section
      id="faq"
      class="v6-faq tk-art__faq"
      aria-labelledby="resource-faq-heading"
    >
      <div class="v6-wrap v6-faq__grid">
        <div class="v6-faq__title">
          <h2 id="resource-faq-heading" class="v6-h2" data-words set:html={split([{ t: "Frequently asked" }, { t: "questions", accent: true }])} />
        </div>

        <ul class="v6-acc">
          {currentPost.faq.map((item, index) => (
            <li class:list={["v6-acc__item", index === 0 && "is-open"]} data-acc-item>
              <h3 class="tk-acc__q">
                <button type="button" class="v6-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head><span>{item.question}</span><span class="v6-acc__icon" aria-hidden="true"></span></button>
              </h3>
              <div class="v6-acc__panel"><div><p>{item.answer}</p></div></div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {isTemplateLayout && currentPost.externalSources && currentPost.externalSources.length > 0 && (
    <ExternalSources sources={currentPost.externalSources} />
  )}

  {isTemplateLayout && (
    <section class="tk-art__cta">
      <div class="v6-wrap">
        <div class="tk-art__cta-panel" data-rise>
          <div class="tk-art__cta-copy">
          {isClientProof ? (
            <>
              <h2 class="tk-art__cta-title">
                Stop starting your marketing over every month.
              </h2>
              <p class="tk-art__cta-text">
                Bring us your goals, capacity, and current marketing. We’ll help you see what to keep, fix, stop, and run next.
              </p>
            </>
          ) : (
            <>
              <h2 class="tk-art__cta-title">
                Want help applying this to your shop?
              </h2>
              <p class="tk-art__cta-text">
                Bring the question to a strategy call. We will talk through what is
                working, what is leaking, and what may make sense next.
              </p>
            </>
          )}
          </div>
          <div class="tk-art__cta-actions">
            <a href={CONSULTATION_URL} class="v6-btn v6-btn--green v6-btn--lg">
              <span>Book a Strategy Call</span>
              <i set:html={arrow} />
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  {isTemplateLayout && relatedPosts.length > 0 && (
    <section class="tk-art__related" aria-labelledby={isClientProof ? "related-client-resources-heading" : "related-resources-heading"}>
      <div class="v6-wrap">
        <div class="v6-row-head">
          <h2 id={isClientProof ? "related-client-resources-heading" : "related-resources-heading"} class="v6-h2 tk-art__related-h2">
            {isClientProof ? "Put the plan into practice" : "Related resources"}
          </h2>
          <a href="/resources" class="v6-link">View all <i set:html={arrow} /></a>
        </div>
        <div class="v6-swipe tk-art__cards" style={`--cols:${relatedCols}`}>
          {relatedPosts.map((relatedPost) => (
            <a href={relatedPost.href} class="v6-post tk-art__card">
              <div class="v6-post__media tk-art__card-media">
                <img src={relatedPost.image.src} alt={relatedPost.image.alt} width={relatedPost.imageWidth ?? 1200} height={relatedPost.imageHeight ?? 800} loading="lazy" decoding="async" style={`object-position:${relatedPost.image.position};`} />
              </div>
              <h3 class="v6-post__title tk-art__card-title">
                {relatedPost.title}
              </h3>
              <span class="v6-link">
                Read article
                <i set:html={arrow} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</V6Layout>

<script>
  // Reading progress and table-of-contents highlighting, shared by every article layout.
  const bar = document.querySelector<HTMLElement>("[data-art-progress]");
  const body = document.querySelector<HTMLElement>("[data-art-body]") ?? document.querySelector<HTMLElement>(".tk-art article");
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a[href^='#']")];
  const targets = tocLinks
    .map((link) => ({ link, el: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
    .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => entry.el instanceof HTMLElement);
  const details = [...document.querySelectorAll<HTMLDetailsElement>("[data-toc-details]")];
  const desktop = window.matchMedia("(min-width: 1101px)");
  const syncDetails = () => details.forEach((d) => { d.open = desktop.matches; });
  syncDetails();
  desktop.addEventListener("change", syncDetails);
  details.forEach((d) => {
    d.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => { if (!desktop.matches) d.open = false; }));
  });

  let ticking = false;
  const update = () => {
    ticking = false;
    if (bar && body) {
      const rect = body.getBoundingClientRect();
      const distance = Math.max(1, rect.height - window.innerHeight * 0.6);
      const p = Math.min(1, Math.max(0, -rect.top / distance));
      bar.style.transform = `scaleX(${p})`;
    }
    if (targets.length) {
      const line = window.innerHeight * 0.3;
      let active = -1;
      targets.forEach((entry, index) => { if (entry.el.getBoundingClientRect().top <= line) active = index; });
      targets.forEach((entry, index) => {
        const on = index === active;
        entry.link.classList.toggle("is-active", on);
        if (on) entry.link.setAttribute("aria-current", "location");
        else entry.link.removeAttribute("aria-current");
      });
    }
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  update();
</script>

<style is:global>
  /* ------------------------------------------------------------------ */
  /* Article system: shared by the template and every long-form layout   */
  /* Reading palette: dark body copy, solid surfaces, visible links.     */
  /* ------------------------------------------------------------------ */
  .tk-art {
    --art-toc: 15.5rem;
    --art-ink: #2b303b;
    --art-soft: #3d4350;
    --art-meta: #5b6070;
    --art-rule: #dcd9d1;
    --art-measure: 45.5rem;
  }
  .tk-art__progress { position: fixed; z-index: 49; left: 0; right: 0; top: calc(var(--header-h) + env(safe-area-inset-top, 0px)); height: 3px; pointer-events: none; }
  .tk-art__progress span { display: block; height: 100%; background: var(--grad); transform: scaleX(0); transform-origin: left; }

  /* Hero */
  .tk-art__hero { padding-top: clamp(1.5rem, 3.5vw, 3rem); }
  .tk-art__back { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 2.75rem; font-size: 0.92rem; font-weight: 600; color: var(--navy); transition: color 0.3s; }
  .tk-art__back:hover { color: var(--key-blue); }
  .tk-art__back i { display: inline-grid; transform: rotate(180deg); transition: transform 0.5s var(--ease); }
  .tk-art__back:hover i { transform: rotate(180deg) translateX(3px); }
  .tk-art__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: center; margin-top: clamp(1rem, 2.5vw, 2rem); }
  .tk-art__head--solo { display: block; max-width: 64rem; }
  .tk-art__head-text { min-width: 0; }
  .tk-art__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; font-size: 0.92rem; font-weight: 500; color: var(--art-meta); line-height: 1.5; }
  .tk-art__tag { color: var(--navy); font-weight: 600; }
  .tk-art__title { margin-top: 1rem; font-size: clamp(2.6rem, 4.6vw, 4.75rem); line-height: 1.02; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; max-width: 17ch; color: var(--charcoal); }
  .tk-art__title--xl { font-size: clamp(2.8rem, 5.6vw, 5.75rem); max-width: 14ch; }
  .tk-art__dek { margin-top: 1.5rem; font-size: clamp(1.12rem, 1.35vw, 1.3rem); line-height: 1.55; color: var(--art-soft); max-width: 36rem; }
  .tk-art__byline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; margin-top: 1.5rem; font-size: 0.9rem; color: var(--art-meta); }
  .tk-art__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; }
  .tk-art__media { position: relative; overflow: hidden; margin: 0; border-radius: 28px; aspect-ratio: 4 / 3; background: var(--off-white); }
  .tk-art__media img { width: 100%; height: 100%; object-fit: cover; }
  .tk-art__media--contain img { object-fit: contain; }
  .tk-art__media-note { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.7rem 1rem; border-radius: 999px; background: #fff; color: var(--navy); font-size: 0.85rem; font-weight: 600; text-align: center; }
  .tk-art__media-note .v6-icon { width: 1rem; height: 1rem; flex: none; }

  /* Reading layout: sticky contents rail + measured column */
  .tk-art__read { padding-block: clamp(3.5rem, 6.5vw, 6rem); }
  .tk-art__layout { display: grid; grid-template-columns: var(--art-toc) minmax(0, 1fr); gap: clamp(3rem, 6vw, 7rem); align-items: start; }
  .tk-art__layout:has(> .tk-art__main--solo) { grid-template-columns: minmax(0, 1fr); }
  .tk-art__main { min-width: 0; max-width: var(--art-measure); }
  .tk-art__main--solo { max-width: 46rem; }
  .tk-art__aside { min-width: 0; align-self: stretch; }
  .tk-art__sticky { position: sticky; top: calc(var(--header-h) + 2.5rem); }
  .tk-art__sticky--card { padding: 1.75rem; border-radius: 24px; background: var(--off-white); }
  .tk-art__aside-title { font-size: 0.95rem; font-weight: 600; color: var(--charcoal); }
