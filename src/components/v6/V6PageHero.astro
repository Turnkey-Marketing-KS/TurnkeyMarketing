---
// v6 page hero. Desktop: editorial title with the lead and actions beside it, then an optional
// photo that grows as you scroll. Phones: stacked, full-width buttons, taller photo crop.
// The H1 text is `title` followed by `accent` (accent renders in key blue).
import { split } from "@/lib/v6";

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  accent?: string;
  lead?: string;
  crumbs?: Crumb[];
  kicker?: string;
  align?: "split" | "center";
  image?: { src: string; alt: string; width: number; height: number; position?: string };
  caption?: string;
  class?: string;
}
const { title, accent, lead, crumbs, kicker, align = "split", image, caption, class: className } = Astro.props;
const segs = [{ t: title }, ...(accent ? [{ t: accent, accent: true }] : [])];
const hasActions = Astro.slots.has("default");
---

<section class:list={["v6-ph", align === "center" && "v6-ph--center", className]}>
  <div class="v6-wrap">
    <div class="v6-ph__grid">
      <div>
        {crumbs && crumbs.length > 0 && (
          <nav class="v6-crumbs" aria-label="Breadcrumb">
            <ol>
              {crumbs.map((crumb) => (
                <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )}
        {kicker && <p class="v6-kicker" style={crumbs ? "margin-top:1.25rem" : undefined}>{kicker}</p>}
        <h1 class="v6-ph__title" data-words set:html={split(segs)} />
      </div>
      {(lead || hasActions || Astro.slots.has("aside")) && (
        <div class="v6-ph__aside" data-fade style="--d:2">
          {lead && <p class="v6-ph__lead">{lead}</p>}
          {hasActions && <div class="v6-ph__actions"><slot /></div>}
          <slot name="aside" />
        </div>
      )}
    </div>
    {image && (
      <figure class="v6-ph__media" data-ph-media data-fade style="--d:3">
        <img src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" style={image.position ? `object-position:${image.position}` : undefined} />
        {caption && <figcaption class="v6-ph__caption">{caption}</figcaption>}
      </figure>
    )}
  </div>
</section>
