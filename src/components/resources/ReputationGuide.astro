---
import { Content } from "@/articles/auto-repair-reputation-management.md";
import { getResourcePost, type ResourcePost } from "@/lib/resource-posts";
import { CONSULTATION_URL } from "@/lib/services";
import { arrow, split } from "@/lib/v6";

interface Props { post: ResourcePost }
const { post } = Astro.props;
const nav = [
  ["check-what-customers-can-find", "Check your presence"],
  ["choose-a-strength-you-can-deliver", "Choose your strength"],
  ["invite-honest-reviews-consistently", "Invite honest reviews"],
  ["give-responses-a-clear-owner", "Respond and follow through"],
  ["turn-feedback-into-one-improvement", "Improve the experience"],
  ["put-real-strengths-into-your-marketing", "Build your message"],
  ["buy-tools-for-a-defined-problem", "Tools and costs"],
  ["measure-follow-through-and-demand", "Measure progress"],
  ["your-first-month", "Your first month"],
];
const related = (post.relatedSlugs ?? []).map(getResourcePost).filter(Boolean);
---

<article class="tk-md" data-art-body>
  <header class="tk-art__hero">
    <div class="v6-wrap">
      <a href="/resources" class="tk-art__back"><i set:html={arrow} /> All resources</a>
      <div class="tk-art__head">
        <div class="tk-art__head-text">
          <h1 class="tk-art__title" data-words set:html={split([{ t: post.title }])} />
          <p class="tk-art__dek" data-fade style="--d:2">{post.dek}</p>
          <p class="tk-art__byline" data-fade style="--d:2">By Turnkey Marketing <span aria-hidden="true">·</span> <time datetime={post.originalDate}>September 22, 2026</time> <span aria-hidden="true">·</span> 8 min read</p>
          <div class="tk-art__actions" data-fade style="--d:3">
            <a class="v6-btn v6-btn--navy v6-btn--lg" href="#your-first-month"><span>Build your first-month plan</span> <i set:html={arrow} /></a>
          </div>
        </div>
        <figure class="tk-art__media" data-fade style="--d:3">
          <img src={post.image.src} alt={post.image.alt} width={1200} height={900} loading="eager" decoding="async" />
        </figure>
      </div>
    </div>
  </header>

  <div class="v6-wrap tk-art__layout tk-art__read">
    <aside class="tk-art__aside">
      <nav class="tk-toc" aria-label="In this article" data-toc>
        <details class="tk-toc__box" data-toc-details open>
          <summary>In this article <span class="tk-toc__plus" aria-hidden="true"></span></summary>
          <ul class="tk-toc__list">{nav.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </details>
      </nav>
    </aside>
    <div class="tk-art__main"><div class="v6-prose tk-md__prose"><Content /></div></div>
  </div>

  <section class="v6-cta">
    <div class="v6-wrap">
      <div class="v6-cta__panel" data-rise>
        <p class="v6-cta__title" data-words set:html={split([{ t: "Stop carrying" }, { t: "the marketing burden.", accent: true }])} />
        <div class="v6-cta__actions">
          <a href={CONSULTATION_URL} class="v6-btn v6-btn--navy v6-btn--lg" data-track-event="consultation_cta_click" data-track-placement="resource_reputation_guide_cta"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec v6-sec--tint tk-art__related" aria-labelledby="review-related-title">
    <div class="v6-wrap">
      <h2 id="review-related-title" class="v6-h2 tk-art__related-h2">Keep building customer trust.</h2>
      <div class="v6-swipe tk-art__cards" style={`--cols:${Math.max(2, related.length)}`}>{related.map(item => item && <a href={item.href} class="v6-post"><div class="v6-post__media"><img src={item.image.src} alt={item.image.alt} width={item.imageWidth ?? 1200} height={item.imageHeight ?? 800} loading="lazy" decoding="async" style={`object-position:${item.image.position};`} /></div><span class="v6-post__tag">{item.tag}</span><h3 class="v6-post__title">{item.title}</h3><p class="v6-link">Read the guide <i set:html={arrow} /></p></a>)}</div>
    </div>
  </section>
</article>

<style>
  .tk-md { --md-body: #2b303b; }
  .tk-md .tk-art__dek { color: var(--md-body); }
  .tk-md__prose { color: var(--md-body); }
  .tk-md__prose :global(a) { color: var(--navy); text-decoration-color: var(--key-blue); text-decoration-thickness: 2px; }
  .tk-md__prose :global(> p:first-child) { font-size: 1.28em; line-height: 1.6; color: var(--navy); font-weight: 500; letter-spacing: -0.01em; }
  .tk-md__prose :global(h2) { scroll-margin-top: calc(var(--header-h) + 2rem); }
  .tk-md__prose :global(h3) { color: var(--navy); }
  .tk-md__prose :global(.month-plan) { padding: clamp(1.4rem, 3vw, 2rem); border-radius: 26px; background: var(--key-blue-soft); border-left: 4px solid var(--key-blue); color: var(--md-body); }
  .tk-md__prose :global(.month-plan strong) { color: var(--navy); }
  .tk-md__prose :global(.month-plan > * + *) { margin-top: 1em; }
  .tk-md__prose :global(.month-plan p:last-child) { margin-bottom: 0; }
</style>
