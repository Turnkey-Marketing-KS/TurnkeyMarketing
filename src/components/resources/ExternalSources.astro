---
import type { ResourcePost } from "@/lib/resource-posts";
import { arrowUp } from "@/lib/v6";

interface Props {
  sources: NonNullable<ResourcePost["externalSources"]>;
}

const { sources } = Astro.props;
---

<section class="tk-src" aria-labelledby="authoritative-sources-heading">
  <div class="v6-wrap tk-src__grid">
    <div class="tk-src__head">
      <h2 id="authoritative-sources-heading" class="tk-src__title">
        Keep researching the topic.
      </h2>
      <p class="tk-src__lead">
        These independent resources add official guidance, practical tools, or important policy context.
      </p>
    </div>

    <ul class="tk-src__list">
      {sources.map((source) => (
        <li>
          <a
            href={source.href}
            target="_blank"
            rel="noopener noreferrer"
            class="tk-src__row"
            data-track-event="external_source_click"
            data-track-publisher={source.publisher}
          >
            <span class="tk-src__text">
              <span class="tk-src__pub">{source.publisher}</span>
              <span class="tk-src__label">
                {source.label}
              </span>
              <span class="tk-src__desc">{source.description}</span>
            </span>
            <span class="tk-src__go" aria-hidden="true" set:html={arrowUp} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tk-src { padding-block: clamp(4rem, 8vw, 7rem); }
  .tk-src__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .tk-src__head { position: sticky; top: calc(var(--header-h) + 2.5rem); }
  .tk-src__title { font-size: clamp(2rem, 3.4vw, 3.2rem); line-height: 1.04; letter-spacing: -0.05em; font-weight: 600; text-wrap: balance; max-width: 13ch; color: var(--charcoal); }
  .tk-src__lead { margin-top: 1.1rem; max-width: 26rem; font-size: 1.05rem; line-height: 1.6; color: #3d4350; }
  .tk-src__list { border-top: 2px solid var(--charcoal); }
  .tk-src__list li { border-bottom: 1px solid #dcd9d1; }
  .tk-src__row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; padding-block: 1.5rem; }
  .tk-src__text { display: grid; gap: 0.35rem; min-width: 0; }
  .tk-src__pub { font-size: 0.88rem; font-weight: 600; color: #3d4350; }
  .tk-src__label { font-size: clamp(1.12rem, 1.5vw, 1.3rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.25; color: var(--navy); text-decoration: underline; text-decoration-color: var(--key-blue); text-decoration-thickness: 2px; text-underline-offset: 4px; transition: color 0.3s; }
  .tk-src__desc { max-width: 40rem; font-size: 1rem; line-height: 1.6; color: #2b303b; }
  .tk-src__go { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 999px; background: var(--key-blue-soft); color: var(--navy); transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease); }
  .tk-src__row:hover .tk-src__label { color: var(--key-blue); }
  .tk-src__row:hover .tk-src__go { background: var(--navy); color: #fff; transform: translate(2px, -2px); }
  @media (max-width: 1100px) {
    .tk-src__grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .tk-src__head { position: static; }
  }
  @media (max-width: 900px) {
    .tk-src { padding-block: 3.5rem; }
    .tk-src__title { font-size: clamp(1.85rem, 8vw, 2.4rem); max-width: none; }
    .tk-src__lead { font-size: 1rem; }
    .tk-src__row { gap: 1rem; padding-block: 1.25rem; }
    .tk-src__go { width: 2.5rem; height: 2.5rem; }
  }
</style>
