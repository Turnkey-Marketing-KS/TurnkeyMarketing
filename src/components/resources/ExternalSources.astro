---
import { ExternalLink } from "lucide-react";
import type { ResourcePost } from "@/lib/resource-posts";

interface Props {
  sources: NonNullable<ResourcePost["externalSources"]>;
}

const { sources } = Astro.props;
---

<section class="bg-white py-14 md:py-20" aria-labelledby="authoritative-sources-heading">
  <div class="container-page">
    <div class="grid gap-8 border-t border-[var(--hairline)] pt-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <p class="eyebrow text-[var(--key-blue)]">Authoritative sources</p>
        <h2 id="authoritative-sources-heading" class="mt-3 max-w-[13ch] font-display text-3xl font-semibold leading-tight text-charcoal md:text-4xl">
          Keep researching the topic.
        </h2>
        <p class="mt-4 max-w-[38ch] text-sm leading-relaxed text-charcoal/62">
          These independent resources add official guidance, practical tools, or important policy context.
        </p>
      </div>

      <ul class="grid gap-4 lg:col-span-8">
        {sources.map((source) => (
          <li>
            <a
              href={source.href}
              target="_blank"
              rel="noopener noreferrer"
              class="motion-card group flex min-h-28 items-start justify-between gap-5 rounded-[22px] border border-black/[0.08] bg-[var(--off-white)] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-black/15 hover:bg-white hover:shadow-[0_20px_45px_-38px_rgba(20,22,28,0.45)] md:p-6"
              data-track-event="external_source_click"
              data-track-publisher={source.publisher}
            >
              <span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--key-blue)]">{source.publisher}</span>
                <span class="mt-2 block font-display text-xl font-semibold leading-snug text-charcoal transition group-hover:text-[var(--navy)]">
                  {source.label}
                </span>
                <span class="mt-2 block max-w-[62ch] text-sm leading-relaxed text-charcoal/62">{source.description}</span>
              </span>
              <ExternalLink className="mt-1 h-4 w-4 shrink-0 text-charcoal/40 transition group-hover:text-[var(--key-blue)]" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
