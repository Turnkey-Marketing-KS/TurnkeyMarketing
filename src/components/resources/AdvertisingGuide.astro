---
import {
  ArrowRight,
  BarChart3,
  Building2,
  Check,
  ChevronRight,
  CircleDollarSign,
  ClipboardCheck,
  Compass,
  Gauge,
  Layers3,
  Mail,
  MapPin,
  Megaphone,
  MonitorPlay,
  PhoneCall,
  Search,
  Target,
  Users,
} from "lucide-react";
import { CONSULTATION_URL } from "@/lib/services";
import type { ResourcePost } from "@/lib/resource-posts";

interface Props {
  post: ResourcePost;
}

const { post } = Astro.props;

const problems = [
  {
    number: "01",
    title: "Every vendor sees one channel.",
    body: "The paid-search vendor reports clicks. The website company reports traffic. The mail company reports pieces delivered. The owner is left deciding whether any of it helped the schedule.",
  },
  {
    number: "02",
    title: "The handoffs are nobody's job.",
    body: "A promising ad still fails when the offer is unclear, the landing page changes the message, the phone is answered poorly, or the shop cannot accept the work being promoted.",
  },
  {
    number: "03",
    title: "Reports stop before the repair order.",
    body: "Impressions, reach, clicks, and leads explain delivery. They do not tell you whether the right person called, booked, showed, approved work, or came back.",
  },
];

const ownership = [
  {
    label: "Turnkey directs",
    title: "The whole advertising plan",
    body: "Business goal, audience, work mix, offer, budget roles, calendar, vendor briefs, shop handoffs, reporting questions, and the next decision.",
    accent: "green",
  },
  {
    label: "Turnkey delivers",
    title: "The services we manage",
    body: "DirectTrack, direct mail, social media, retention, Boost Days, creative, consulting, and the coordinated execution included in the service you choose.",
    accent: "blue",
  },
  {
    label: "Turnkey coordinates",
    title: "Specialists already on your team",
    body: "Google Ads, Local Services Ads, website, media, and other vendors can receive clearer direction and accountability through the right Consulting or VIP relationship.",
    accent: "white",
  },
  {
    label: "Your shop owns",
    title: "The customer experience",
    body: "Capacity, approvals, accurate service information, call handling, scheduling, the in-shop experience, and the follow-up that turns a first visit into a relationship.",
    accent: "white",
  },
];

const channels = [
  {
    icon: Search,
    name: "Paid search",
    job: "Capture existing demand",
    best: "Drivers are actively searching for a nearby shop or a specific service.",
    watch: "Cost rises quickly when geography, service intent, landing pages, and call quality are loose.",
    owner: "Often an outside specialist; Turnkey can direct and coordinate the role.",
  },
  {
    icon: MapPin,
    name: "Local Services Ads",
    job: "Generate eligible local leads",
    best: "The shop is eligible, ready to manage lead quality, and disciplined about response and disputes.",
    watch: "Lead volume is not booked work. Eligibility, geography, response, and dispute handling matter.",
    owner: "Often an outside specialist or shop account; Turnkey can oversee the plan around it.",
  },
  {
    icon: Target,
    name: "DirectTrack",
    job: "Create targeted local demand",
    best: "The shop needs better-fit new-customer acquisition beyond people already searching today.",
    watch: "Targeting, creative, frequency, landing experience, and shop capacity must agree.",
    owner: "Planned, managed, measured, and reviewed directly by Turnkey.",
  },
  {
    icon: Mail,
    name: "Direct mail",
    job: "Reach selected households repeatedly",
    best: "You can choose a mailing list, offer, schedule, and follow-up plan that fit the shop's market.",
    watch: "The wrong list or a one-off drop can make good creative look ineffective.",
    owner: "Available as a managed Turnkey campaign.",
  },
  {
    icon: Megaphone,
    name: "Paid social",
    job: "Build awareness and support a campaign",
    best: "The shop has strong real-world creative, a defined local audience, and a useful next action.",
    watch: "Engagement is not demand. Make the path from the ad to the shop measurable.",
    owner: "Turnkey scope depends on the selected service and campaign.",
  },
  {
    icon: Users,
    name: "Retention",
    job: "Earn the next visit",
    best: "The shop wants to bring existing customers back with regular follow-up.",
    watch: "Poor data, irrelevant messages, and constant offers can train customers to ignore the shop.",
    owner: "Available through Turnkey Retention Marketing.",
  },
];

const process = [
  {
    title: "Name the shop problem.",
    body: "Is the real need more new customers, a stronger work mix, help with a slow period, better retention, or accountability for money already being spent?",
  },
  {
    title: "Define the customer and offer.",
    body: "Choose the household, vehicle, service need, geography, reason to trust the shop, and next action before anyone builds an ad.",
  },
  {
    title: "Give every channel one job.",
    body: "Decide what captures demand, what creates it, what supports trust, and what earns the next visit. Remove channels that have no clear role.",
  },
  {
    title: "Direct the vendors and handoffs.",
    body: "Align the message, landing experience, tracking, phone greeting, schedule, advisor explanation, and reporting before the campaign goes live.",
  },
  {
    title: "Measure, decide, and adjust.",
    body: "Review the full path to completed work. Keep, fix, stop, or expand based on useful evidence—not the loudest vendor report.",
  },
];

const measurement = [
  ["Delivery", "Impressions, reach, frequency, mail delivery, or audience match", "Did the intended market have a fair chance to see the message?"],
  ["Response", "Clicks, calls, forms, messages, or offer responses", "Did the campaign create a meaningful action?"],
  ["Qualification", "Qualified-call rate and requested work", "Did it attract customers and services the shop wants?"],
  ["Booking", "Booked appointment, show rate, and capacity fit", "Did the shop convert the response into a real visit?"],
  ["Repair order", "Completed work, new-customer quality, and attributable revenue", "Did the visit become useful work?"],
  ["Relationship", "Next visit, retention, referrals, and longer-term value", "Did the first result create a customer worth keeping?"],
];

const vendorQuestions = [
  "What exact shop problem is this campaign responsible for solving?",
  "Who is the intended customer—and who are we deliberately not targeting?",
  "Which services and work mix can the shop accept right now?",
  "How will the message, landing experience, phone handoff, and advisor explanation stay aligned?",
  "Which account, data, creative, and tracking assets will the shop own?",
  "What will be reported beyond impressions, clicks, or leads?",
  "What evidence would make us keep, fix, stop, or expand the campaign?",
];
---

<article>
  <section class="relative overflow-hidden bg-[var(--off-white)] py-8 md:py-12 lg:py-16">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <span class="absolute -right-28 -top-24 h-80 w-80 rounded-full bg-[var(--key-blue)]/10 blur-3xl"></span>
      <span class="absolute -bottom-40 left-[18%] h-80 w-80 rounded-full bg-[var(--green)]/10 blur-3xl"></span>
    </div>

    <div class="container-page relative">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-charcoal/58">
        <a href="/resources" class="inline-flex min-h-11 items-center transition hover:text-charcoal">Resources</a>
        <ChevronRight className="h-3.5 w-3.5" />
        <span class="font-medium text-charcoal">Advertising guide</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="lg:col-span-7">
          <p class="eyebrow text-[var(--key-blue)]">Auto repair advertising guide</p>
          <h1 class="display-1 mt-5 max-w-[12ch] text-balance text-charcoal">
            Auto repair advertising that works as
            <span class="text-[var(--key-blue)]">one plan.</span>
          </h1>
          <p class="mt-6 max-w-[59ch] text-lg leading-relaxed text-charcoal/68 md:text-xl">
            You should not have to become the marketing manager for every vendor. Turnkey helps
            direct your auto shop advertising—setting the strategy, doing the work that belongs in
            our service scope, and coordinating outside partners so the whole plan serves the shop.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/services/directtrack-marketing"
              class="btn-primary w-full sm:w-auto"
              data-track-event="service_cta_click"
              data-track-slug="directtrack-marketing"
              data-track-placement="advertising_guide_hero"
            >
              Explore DirectTrack
              <ArrowRight className="h-4 w-4" />
            </a>
            <a href="#build-the-plan" class="btn-ghost w-full justify-center sm:w-auto">
              See how the plan works
            </a>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-charcoal/10 pt-6 text-sm text-charcoal/55">
            <span>For independent auto shop owners</span>
            <span aria-hidden="true">•</span>
            <time datetime={post.updatedDate ?? post.originalDate}>{post.date}</time>
            <span aria-hidden="true">•</span>
            <a href="/about" class="font-semibold text-[var(--navy)] underline decoration-[var(--green)] decoration-2 underline-offset-4">
              From Turnkey's auto-repair marketing team
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="card-float relative overflow-hidden rounded-[30px] bg-[var(--navy)] p-3 shadow-[0_34px_90px_-54px_rgba(20,22,28,0.68)] md:rounded-[36px] md:p-4">
            <div class="aspect-[16/11] overflow-hidden rounded-[24px] bg-[var(--navy-deep)] md:rounded-[29px]">
              <img
                src={post.image.src}
                alt={post.image.alt}
                width={post.imageWidth ?? 1200}
                height={post.imageHeight ?? 675}
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover"
                style={`object-position: ${post.image.position};`}
              />
            </div>
            <div class="grid gap-3 px-3 pb-3 pt-5 text-white sm:grid-cols-3 md:px-4 md:pb-4">
              <div>
                <p class="text-2xl font-semibold">One</p>
                <p class="mt-1 text-xs leading-relaxed text-white/60">accountable plan</p>
              </div>
              <div>
                <p class="text-2xl font-semibold">Clear</p>
                <p class="mt-1 text-xs leading-relaxed text-white/60">channel ownership</p>
              </div>
              <div>
                <p class="text-2xl font-semibold">Useful</p>
                <p class="mt-1 text-xs leading-relaxed text-white/60">shop-level reporting</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <p class="eyebrow text-[var(--key-blue)]">The owner problem</p>
          <h2 class="display-2 mt-4 max-w-[12ch] text-balance text-charcoal">
            The problem is rarely a missing ad.
          </h2>
        </div>
        <div class="lg:col-span-7 lg:pt-9">
          <p class="max-w-[60ch] text-lg leading-relaxed text-charcoal/68 md:text-xl">
            Most automotive shop advertising breaks down between channels. Each vendor can show
            activity inside its platform, while nobody owns the offer, the customer path, the shop
            handoff, or the decision about what happens next.
          </p>
          <p class="mt-5 max-w-[60ch] leading-relaxed text-charcoal/62">
            Turnkey's role is to see the entire system. We help decide what the advertising needs to
            accomplish, direct the people doing the work, connect the campaign to the front counter,
            and read the results in the language of the shop.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-5 md:mt-14 md:grid-cols-3">
        {problems.map((problem) => (
          <section class="motion-card rounded-[24px] border border-black/[0.07] bg-[var(--off-white)] p-6 md:rounded-[28px] md:p-7">
            <p class="text-sm font-semibold tabular-nums text-[var(--key-blue)]">{problem.number}</p>
            <h3 class="mt-5 font-display text-2xl font-semibold leading-tight text-charcoal">{problem.title}</h3>
            <p class="mt-4 leading-relaxed text-charcoal/62">{problem.body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="build-the-plan" class="relative overflow-hidden bg-[var(--navy)] py-14 text-white md:py-20 lg:py-24">
    <span class="pointer-events-none absolute -right-32 top-8 h-96 w-96 rounded-full bg-[var(--key-blue)]/20 blur-3xl" aria-hidden="true"></span>
    <div class="container-page relative">
      <div class="max-w-4xl">
        <p class="eyebrow !text-[var(--green)]">How oversight works</p>
        <h2 class="display-2 mt-4 max-w-[15ch] text-balance text-white">
          One direction. Clear owners. No vendor free-for-all.
        </h2>
        <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-white/68">
          Oversight does not mean pretending Turnkey personally operates every platform. It means
          the owner knows who is responsible for each part, why the channel is in the plan, and how
          the pieces are supposed to work together.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {ownership.map((item, index) => (
          <section class="rounded-[26px] border border-white/12 bg-white/[0.065] p-6 backdrop-blur-sm md:p-8">
            <div class="flex items-center justify-between gap-4">
              <p class:list={["text-xs font-semibold uppercase tracking-[0.16em]", item.accent === "green" ? "text-[var(--green)]" : item.accent === "blue" ? "text-[#8fc8f4]" : "text-white/58"]}>
                {item.label}
              </p>
              <span class:list={["h-2.5 w-2.5 rounded-full", index === 0 ? "bg-[var(--green)]" : index === 1 ? "bg-[var(--key-blue)]" : "bg-white/35"]}></span>
            </div>
            <h3 class="mt-5 font-display text-2xl font-semibold text-white">{item.title}</h3>
            <p class="mt-4 leading-relaxed text-white/64">{item.body}</p>
          </section>
        ))}
      </div>

      <div class="mt-9 flex flex-col gap-4 rounded-[24px] border border-[var(--green)]/35 bg-[var(--green)]/10 p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
        <div>
          <p class="font-display text-2xl font-semibold">Need strategic direction without changing every vendor?</p>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-white/65">
            Marketing Consulting helps you evaluate the plan, spend, campaigns, vendors, and next decisions.
          </p>
        </div>
        <a
          href="/services/marketing-consulting"
          class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-full bg-white px-6 font-semibold text-[var(--navy)] transition hover:-translate-y-0.5"
          data-track-event="service_cta_click"
          data-track-slug="marketing-consulting"
          data-track-placement="advertising_guide_oversight"
        >
          Explore consulting <ArrowRight className="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-14">
        <div class="lg:col-span-7">
          <p class="eyebrow text-[var(--key-blue)]">Channel roles</p>
          <h2 class="display-2 mt-4 max-w-[14ch] text-balance text-charcoal">
            A practical auto shop advertising mix gives every channel one job.
          </h2>
        </div>
        <p class="max-w-[50ch] text-lg leading-relaxed text-charcoal/64 lg:col-span-5">
          The mix should change with the shop's market, capacity, customer, and timeframe. Use this
          as a decision framework—not a shopping list.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:mt-14 lg:grid-cols-2">
        {channels.map((channel) => {
          const Icon = channel.icon;
          return (
            <section class="motion-card rounded-[26px] border border-black/[0.07] bg-white p-6 shadow-[0_18px_50px_-44px_rgba(20,22,28,0.48)] md:p-8">
              <div class="flex items-start gap-4">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[var(--key-blue-soft)] text-[var(--navy)]">
                  <Icon className="h-5 w-5" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--key-blue)]">{channel.job}</p>
                  <h3 class="mt-2 font-display text-2xl font-semibold text-charcoal">{channel.name}</h3>
                </div>
              </div>
              <dl class="mt-6 grid gap-4 border-t border-[var(--hairline)] pt-5 text-sm leading-relaxed">
                <div>
                  <dt class="font-semibold text-charcoal">Best when</dt>
                  <dd class="mt-1 text-charcoal/62">{channel.best}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-charcoal">Watch closely</dt>
                  <dd class="mt-1 text-charcoal/62">{channel.watch}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-charcoal">Ownership</dt>
                  <dd class="mt-1 text-charcoal/62">{channel.owner}</dd>
                </div>
              </dl>
            </section>
          );
        })}
      </div>

      <p class="mt-8 max-w-3xl text-sm leading-relaxed text-charcoal/58">
        Local SEO and your Google Business Profile are not paid advertising, but they support almost
        every advertising channel by helping a prospect verify the shop. See how Turnkey approaches
        <a href="/services/digital-marketing" class="font-semibold text-[var(--navy)] underline decoration-[var(--key-blue)]/40 underline-offset-4">
          digital marketing and local visibility for auto repair shops
        </a>.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20 lg:py-24">
    <div class="container-page">
      <div class="overflow-hidden rounded-[30px] bg-[var(--navy-deep)] text-white shadow-[0_34px_90px_-54px_rgba(20,22,28,0.72)] md:rounded-[36px]">
        <div class="grid lg:grid-cols-12">
          <div class="relative overflow-hidden p-7 md:p-11 lg:col-span-7 lg:p-14">
            <span class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[var(--key-blue)]/25 blur-3xl" aria-hidden="true"></span>
            <div class="relative">
              <p class="eyebrow !text-[var(--green)]">DirectTrack Marketing</p>
              <h2 class="display-2 mt-4 max-w-[13ch] text-balance text-white">
                The advertising campaigns Turnkey manages.
              </h2>
              <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-white/68">
                DirectTrack combines targeted email, streaming TV commercials, and geofenced display
                advertising around the same local audience. Turnkey plans the targeting, coordinates
                the creative and campaign, tracks response, and reviews the results with you each month.
              </p>
              <p class="mt-5 max-w-[58ch] leading-relaxed text-white/58">
                It does not need to replace Google Ads, LSA, direct mail, or local SEO. It gives the
                broader automotive shop advertising plan a coordinated local campaign with one
                accountable owner.
              </p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a
                  href="/services/directtrack-marketing"
                  class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[var(--green)] px-6 font-semibold text-charcoal transition hover:-translate-y-0.5 hover:brightness-105"
                  data-track-event="service_cta_click"
                  data-track-slug="directtrack-marketing"
                  data-track-placement="advertising_guide_directtrack"
                >
                  See how DirectTrack works <ArrowRight className="h-4 w-4" />
                </a>
                <a href="/results#pro-automotive" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/25 px-6 font-semibold text-white transition hover:border-white/55 hover:bg-white/5">
                  Review documented results
                </a>
              </div>
            </div>
          </div>

          <div class="bg-white/[0.055] p-7 md:p-10 lg:col-span-5 lg:p-12">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/50">Included in DirectTrack</p>
            <ul class="mt-6 grid gap-5">
              {[
                [Mail, "Super-targeted email", "Reach selected local households with a coordinated message."],
                [MonitorPlay, "Streaming TV commercials", "Build recognition on streaming services your market watches."],
                [MapPin, "Geofenced display", "Serve display creative around relevant real-world geography."],
                [BarChart3, "Transparent reporting", "Connect campaign response to real shop activity when the data supports it."],
                [Users, "Monthly review", "Decide what moved, what did not, and what the next cycle needs."],
              ].map(([Icon, title, body]) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center text-[var(--green)]">
                    <Icon className="h-[18px] w-[18px]" />
                  </span>
                  <div>
                    <p class="font-semibold text-white">{title}</p>
                    <p class="mt-1 text-sm leading-relaxed text-white/56">{body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--off-white)] py-14 md:py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <p class="eyebrow text-[var(--key-blue)]">How to review your campaigns</p>
            <h2 class="display-2 mt-4 max-w-[11ch] text-balance text-charcoal">
              From scattered ads to a directed plan.
            </h2>
            <p class="mt-5 max-w-[38ch] leading-relaxed text-charcoal/62">
              The process stays grounded in what the shop can accept, what the right customer needs,
              and what the data can honestly show.
            </p>
          </div>
        </div>
        <div class="lg:col-span-8">
          <ul class="grid gap-4">
            {process.map((item) => (
              <li class="rounded-[24px] border border-black/[0.07] bg-white p-6 md:p-8">
                <h3 class="font-display text-2xl font-semibold text-charcoal">{item.title}</h3>
                <p class="mt-3 max-w-[58ch] leading-relaxed text-charcoal/62">{item.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20 lg:py-24">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-14">
        <div class="lg:col-span-8">
          <p class="eyebrow text-[var(--key-blue)]">Measurement that reaches the shop</p>
          <h2 class="display-2 mt-4 max-w-[22ch] text-balance text-charcoal">
            <span class="block">A click is a clue.</span>
            <span class="block"><span class="md:whitespace-nowrap">A completed <span class="whitespace-nowrap">repair order</span></span> is a result.</span>
          </h2>
        </div>
        <p class="max-w-[50ch] text-lg leading-relaxed text-charcoal/64 lg:col-span-4">
          Good reporting does not erase attribution limits. It makes each step visible enough to ask
          a better question and decide what to change next.
        </p>
      </div>

      <div class="mt-10 overflow-hidden rounded-[26px] border border-black/[0.07] md:mt-14 md:rounded-[30px]">
        <div class="hidden grid-cols-[0.72fr_1.25fr_1.45fr] bg-[var(--navy)] px-7 py-4 text-xs font-semibold uppercase tracking-[0.14em] text-white/70 md:grid">
          <span>Stage</span><span>Useful evidence</span><span>Question it should answer</span>
        </div>
        <div class="divide-y divide-[var(--hairline)] bg-white">
          {measurement.map(([stage, evidence, question], index) => (
            <div class="grid gap-4 px-6 py-6 md:grid-cols-[0.72fr_1.25fr_1.45fr] md:items-start md:px-7">
              <div class="flex items-center gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--key-blue-soft)] text-xs font-bold text-[var(--navy)]">{index + 1}</span>
                <p class="font-semibold text-charcoal">{stage}</p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-charcoal/40 md:hidden">Useful evidence</p>
