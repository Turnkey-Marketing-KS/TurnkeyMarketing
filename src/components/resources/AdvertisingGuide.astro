---
import { CONSULTATION_URL } from "@/lib/services";
import type { ResourcePost } from "@/lib/resource-posts";
import ExternalSources from "@/components/resources/ExternalSources.astro";
import { arrow, iconSrc, split } from "@/lib/v6";

interface Props {
  post: ResourcePost;
}

const { post } = Astro.props;

const problems = [
  {
    title: "Every vendor sees one channel.",
    body: "The paid-search vendor reports clicks. The website company reports traffic. The mail house reports pieces delivered. And you're the one left guessing whether any of it actually filled the schedule.",
  },
  {
    title: "The handoffs are nobody's job.",
    body: "A good ad still fails when the offer is unclear, the landing page changes the message, the phone gets answered poorly, or the shop can't take the work being promoted.",
  },
  {
    title: "Reports stop before the repair order.",
    body: "Impressions, reach, clicks, and leads prove the ads ran. They don't tell you whether the right person called, booked, showed up, approved work, or came back.",
  },
];

const ownership = [
  {
    label: "Turnkey directs",
    title: "The whole advertising plan",
    body: "Business goal, audience, work mix, offer, budget roles, calendar, vendor briefs, shop handoffs, reporting questions, and the next decision.",
    accent: "green",
  },
  {
    label: "Turnkey delivers",
    title: "The services we manage",
    body: "DirectTrack, direct mail, social media, retention, Boost Days, creative, consulting, and the coordinated execution included in the service you choose.",
    accent: "blue",
  },
  {
    label: "Turnkey coordinates",
    title: "Specialists already on your team",
    body: "Your Google Ads, Local Services Ads, website, media, and other vendors get clearer direction and real accountability through the right Consulting or VIP relationship.",
    accent: "white",
  },
  {
    label: "Your shop owns",
    title: "The customer experience",
    body: "Capacity, approvals, accurate service information, call handling, scheduling, the in-shop experience, and the follow-up that turns a first visit into a relationship.",
    accent: "white",
  },
];

const channels = [
  {
    icon: "internet",
    name: "Paid search",
    job: "Capture existing demand",
    best: "Drivers are already searching for a nearby shop or a specific service.",
    watch: "Costs climb fast when geography, service intent, landing pages, and call quality are loose.",
    owner: "Often an outside specialist. Turnkey can direct and coordinate the role.",
  },
  {
    icon: "location",
    name: "Local Services Ads",
    job: "Generate eligible local leads",
    best: "The shop is eligible, ready to manage lead quality, and disciplined about response time and disputes.",
    watch: "Lead volume isn't booked work. Eligibility, geography, response, and dispute handling all matter.",
    owner: "Often an outside specialist or the shop's own account. Turnkey can oversee the plan around it.",
  },
  {
    icon: "target",
    name: "DirectTrack",
    job: "Create targeted local demand",
    best: "You need better-fit new customers beyond the people who are already searching today.",
    watch: "Targeting, creative, frequency, the landing experience, and shop capacity all have to agree.",
    owner: "Planned, managed, measured, and reviewed directly by Turnkey.",
  },
  {
    icon: "direct-mail",
    name: "Direct mail",
    job: "Reach selected households repeatedly",
    best: "You can choose a mailing list, offer, schedule, and follow-up plan that fit your market.",
    watch: "The wrong list or a one-time drop can make good creative look like it failed.",
    owner: "Available as a managed Turnkey campaign.",
  },
  {
    icon: "social-media-marketing",
    name: "Paid social",
    job: "Build awareness and support a campaign",
    best: "You have strong real-world creative, a defined local audience, and a useful next step for the people who see it.",
    watch: "Engagement isn't demand. Make the path from the ad to the shop measurable.",
    owner: "Turnkey scope depends on the selected service and campaign.",
  },
  {
    icon: "retention",
    name: "Retention",
    job: "Earn the next visit",
    best: "You want existing customers coming back through regular, relevant follow-up.",
    watch: "Poor data, irrelevant messages, and nonstop offers can train customers to ignore you.",
    owner: "Available through Turnkey Retention Marketing.",
  },
];

const process = [
  {
    title: "Name the shop problem.",
    body: "What do you really need? More new customers, a stronger work mix, help through a slow period, better retention, or accountability for money you're already spending?",
  },
  {
    title: "Define the customer and offer.",
    body: "Before anyone builds an ad, choose the household, vehicle, service need, geography, reason to trust the shop, and next step.",
  },
  {
    title: "Give every channel one job.",
    body: "Decide what captures demand, what creates it, what builds trust, and what earns the next visit. Cut any channel that has no clear role.",
  },
  {
    title: "Direct the vendors and handoffs.",
    body: "Before the campaign goes live, line up the message, landing experience, tracking, phone greeting, schedule, advisor explanation, and reporting.",
  },
  {
    title: "Measure, decide, and adjust.",
    body: "Review the whole path to completed work. Then keep, fix, stop, or expand based on real evidence, not whichever vendor report is loudest.",
  },
];

const measurement = [
  ["Delivery", "Impressions, reach, frequency, mail delivery, or audience match", "Did the intended market have a fair chance to see the message?"],
  ["Response", "Clicks, calls, forms, messages, or offer responses", "Did the campaign create a meaningful action?"],
  ["Qualification", "Qualified-call rate and requested work", "Did it attract customers and services the shop wants?"],
  ["Booking", "Booked appointment, show rate, and capacity fit", "Did the shop convert the response into a real visit?"],
  ["Repair order", "Completed work, new-customer quality, and attributable revenue", "Did the visit become useful work?"],
  ["Relationship", "Next visit, retention, referrals, and longer-term value", "Did the first result create a customer worth keeping?"],
];

const vendorQuestions = [
  "What exact shop problem is this campaign responsible for solving?",
  "Who is the intended customer, and who are we deliberately not targeting?",
  "Which services and work mix can the shop accept right now?",
  "How will the message, landing experience, phone handoff, and advisor explanation stay aligned?",
  "Which account, data, creative, and tracking assets will the shop own?",
  "What will be reported beyond impressions, clicks, or leads?",
  "What evidence would make us keep, fix, stop, or expand the campaign?",
];
---

<article class="tk-ad" data-art-body>
  <section class="tk-art__hero">
    <div class="v6-wrap">
      <nav aria-label="Breadcrumb" class="v6-crumbs tk-ad__crumbs">
        <a href="/resources" class="tk-ad__crumb">Resources</a>
        <span class="tk-ad__crumb-sep" aria-hidden="true"></span>
        <span class="tk-ad__crumb-here">Advertising guide</span>
      </nav>

      <div class="tk-art__head">
        <div class="tk-art__head-text">
          <h1 class="tk-art__title tk-art__title--xl" data-words set:html={split([{ t: "Auto repair advertising that works as" }, { t: "one plan.", accent: true }])} />
          <p class="tk-art__dek" data-fade style="--d:2">
            You shouldn't have to become the marketing manager for every vendor you hire. Turnkey
            helps direct your auto shop advertising. We set the strategy, do the work inside our
            service scope, and coordinate your outside partners so the whole plan serves the shop.
          </p>
          <div class="tk-art__actions" data-fade style="--d:3">
            <a
              href="/services/directtrack-marketing"
              class="v6-btn v6-btn--navy v6-btn--lg"
              data-track-event="service_cta_click"
              data-track-slug="directtrack-marketing"
              data-track-placement="advertising_guide_hero"
            >
              <span>Explore DirectTrack</span>
              <i set:html={arrow} />
            </a>
            <a href="#build-the-plan" class="v6-link">
              See how the plan works
            </a>
          </div>
          <div class="tk-art__byline tk-ad__byline" data-fade style="--d:3">
            <span>For independent auto shop owners</span>
            <span aria-hidden="true">•</span>
            <time datetime={post.updatedDate ?? post.originalDate}>{post.date}</time>
            <span aria-hidden="true">•</span>
            <a href="/about" class="tk-art__text-link">
              From Turnkey's auto-repair marketing team
            </a>
          </div>
        </div>

        <div class="tk-ad__visual" data-fade style="--d:3">
          <figure class="tk-art__media tk-ad__media">
            <img
              src={post.image.src}
              alt={post.image.alt}
              width={post.imageWidth ?? 1200}
              height={post.imageHeight ?? 675}
              loading="eager"
              decoding="async"
              style={`object-position: ${post.image.position};`}
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec tk-ad__first">
    <div class="v6-wrap">
      <div class="tk-ad__split">
        <div>
          <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "The problem is rarely a" }, { t: "missing ad.", accent: true }])} />
        </div>
        <div class="tk-ad__copy">
          <p class="tk-ad__big">
            Most automotive shop advertising breaks down between channels, not inside them. Each
            vendor can show you activity on its own platform. Meanwhile nobody owns the offer, the
            customer's path to your door, the handoff to the shop, or the decision about what
            happens next.
          </p>
          <p>
            Turnkey's job is to see the whole system. We help decide what the advertising needs to
            accomplish, direct the people doing the work, connect each campaign to your front
            counter, and read the results in shop terms: calls, cars, and repair orders.
          </p>
        </div>
      </div>

      <div class="v6-swipe tk-ad__problems" style="--cols:3">
        {problems.map((problem) => (
          <section class="v6-tile" data-rise>
            <h3 class="v6-tile__title">{problem.title}</h3>
            <p class="v6-tile__text">{problem.body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="build-the-plan" class="v6-sec v6-sec--navy tk-ad__plan">
    <div class="v6-wrap">
      <div class="tk-ad__plan-head">
        <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "One direction. Clear owners." }, { t: "No vendor free-for-all.", accent: true }])} />
        <p class="v6-lead">
          Oversight doesn't mean pretending Turnkey personally runs every platform. It means you
          know who is responsible for each piece, why each channel is in the plan, and how the
          pieces are supposed to work together.
        </p>
      </div>

      <div class="tk-ad__owners">
        {ownership.map((item, index) => (
          <section class:list={["tk-ad__owner", index === 0 && "tk-ad__owner--green"]} data-rise>
            <h3 class="tk-ad__owner-h3">{item.title}</h3>
            <p class="tk-ad__owner-text"><strong>{item.label}:</strong> {item.body}</p>
          </section>
        ))}
      </div>

      <div class="tk-ad__consult">
        <div>
          <p class="tk-ad__consult-title">Need strategic direction without changing every vendor?</p>
          <p class="tk-ad__consult-text">
            Marketing Consulting helps you evaluate the plan, the spend, the campaigns, the vendors, and what to decide next.
          </p>
        </div>
        <a
          href="/services/marketing-consulting"
          class="v6-btn v6-btn--navy"
          data-track-event="service_cta_click"
          data-track-slug="marketing-consulting"
          data-track-placement="advertising_guide_oversight"
        >
          <span>Explore consulting</span> <i set:html={arrow} />
        </a>
      </div>
    </div>
  </section>

  <section class="v6-sec v6-sec--tint">
    <div class="v6-wrap">
      <div class="v6-head">
        <div>
          <h2 class="v6-h2 tk-ad__h2 tk-ad__h2--wide" data-words set:html={split([{ t: "A practical auto shop advertising mix gives" }, { t: "every channel one job.", accent: true }])} />
        </div>
        <p class="v6-lead">
          The right mix changes with your market, your capacity, your customers, and your
          timeframe. Use this to make decisions, not as a shopping list.
        </p>
      </div>

      <div class="tk-ad__channels">
        {channels.map((channel) => (
          <section class="v6-tile tk-ad__channel" data-rise>
            <div class="tk-ad__channel-head">
              <span class="v6-tile__icon" aria-hidden="true">
                <span class="v6-icon" style={`--icon:url(${iconSrc(channel.icon)})`}></span>
              </span>
              <h3 class="v6-tile__title">{channel.name}</h3>
            </div>
            <p class="tk-ad__job">Its job: {channel.job.toLowerCase()}.</p>
            <dl class="tk-ad__dl">
              <div>
                <dt>Best when</dt>
                <dd>{channel.best}</dd>
              </div>
              <div>
                <dt>Watch closely</dt>
                <dd>{channel.watch}</dd>
              </div>
              <div>
                <dt>Ownership</dt>
                <dd>{channel.owner}</dd>
              </div>
            </dl>
          </section>
        ))}
      </div>

      <p class="tk-ad__footnote">
        Local SEO and your Google Business Profile aren't paid advertising, but they support almost
        every ad channel. They're where a prospect goes to check out the shop before calling. See
        how Turnkey approaches
        <a href="/services/digital-marketing" class="tk-art__text-link">
          digital marketing and local visibility for auto repair shops
        </a>.
      </p>
    </div>
  </section>

  <section class="v6-sec">
    <div class="v6-wrap">
      <div class="v6-glow tk-ad__dt" data-rise>
        <div class="v6-glow__inner tk-ad__dt-inner">
          <div class="tk-ad__dt-main">
            <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "The advertising campaigns" }, { t: "Turnkey manages.", accent: true }])} />
            <p class="tk-ad__big">
              DirectTrack combines targeted email, streaming TV commercials, and geofenced display
              advertising, all aimed at the same local audience. Turnkey plans the targeting,
              coordinates the creative and the campaign, tracks response, and reviews the results
              with you every month.
            </p>
            <p class="tk-ad__muted">
              It doesn't have to replace Google Ads, LSA, direct mail, or local SEO. It gives your
              broader automotive shop advertising plan one coordinated local campaign with one
              accountable owner.
            </p>
            <div class="tk-ad__dt-actions">
              <a
                href="/services/directtrack-marketing"
                class="v6-btn v6-btn--navy v6-btn--lg"
                data-track-event="service_cta_click"
                data-track-slug="directtrack-marketing"
                data-track-placement="advertising_guide_directtrack"
              >
                <span>See how DirectTrack works</span> <i set:html={arrow} />
              </a>
              <a href="/results#pro-automotive" class="v6-link">
                Review documented results
              </a>
            </div>
          </div>

          <div class="tk-ad__dt-side">
            <ul class="tk-ad__dt-list">
              {[
                ["email", "Super-targeted email", "Reach selected local households with one coordinated message."],
                ["internet", "Streaming TV commercials", "Build recognition on the streaming services your market watches."],
                ["location", "Geofenced display", "Show display ads around the real-world places that matter to your market."],
                ["report", "Transparent reporting", "Connect campaign response to real shop activity wherever the data supports it."],
                ["weekly-planner", "Monthly review", "Decide what moved, what didn't, and what the next cycle needs."],
              ].map(([icon, title, body]) => (
                <li>
                  <span class="tk-ad__dt-icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc(icon)})`}></span></span>
                  <div>
                    <p class="tk-ad__dt-title">{title}</p>
                    <p class="tk-ad__dt-body">{body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec v6-sec--tint">
    <div class="v6-wrap tk-ad__split tk-ad__split--sticky">
      <div class="tk-ad__sticky">
        <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "From scattered ads to a" }, { t: "directed plan.", accent: true }])} />
        <p class="v6-lead tk-ad__lead">
          Every step stays grounded in three things: what the shop can take on, what the right
          customer needs, and what the data can honestly show.
        </p>
      </div>
      <ul class="tk-ad__process">
        {process.map((item) => (
          <li data-rise>
            <h3 class="tk-ad__process-h3">{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v6-sec">
    <div class="v6-wrap">
      <div class="v6-head">
        <div>
          <h2 class="v6-h2 tk-ad__h2 tk-ad__h2--wide">
            <span class="block">A click is a clue.</span>
            <span class="block tk-ad__accent"><span class="tk-ad__nowrap">A completed <span class="whitespace-nowrap">repair order</span></span> is a result.</span>
          </h2>
        </div>
        <p class="v6-lead">
          Good reporting won't erase the limits of knowing exactly what produced each call. It
          makes every step visible enough to ask a better question and decide what to change next.
        </p>
      </div>

      <div class="tk-ad__table">
        <div class="tk-ad__thead">
          <span>Stage</span><span>Useful evidence</span><span>Question it should answer</span>
        </div>
        <div class="tk-ad__tbody">
          {measurement.map(([stage, evidence, question]) => (
            <div class="tk-ad__tr">
              <div class="tk-ad__stage">
                <p>{stage}</p>
              </div>
              <div>
                <p class="tk-ad__cell-label">Useful evidence</p>
                <p class="tk-ad__cell">{evidence}</p>
              </div>
              <div>
                <p class="tk-ad__cell-label">Question</p>
                <p class="tk-ad__cell tk-ad__cell--q">{question}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="v6-swipe tk-ad__rules" style="--cols:3">
        {[
          ["boost", "Capacity before volume", "A campaign that overfills the wrong week, or promotes work the shop can't take, is not a win."],
          ["phone", "Call quality before lead count", "Listen for fit, intent, booking friction, and the promise the customer heard in the ad."],
          ["report", "Compare costs with results", "Use revenue you can reliably tie to the campaign, then weigh repair-order quality and repeat visits."],
        ].map(([icon, title, body]) => (
          <section class="v6-tile tk-ad__rule">
            <span class="v6-tile__icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc(icon)})`}></span></span>
            <h3 class="v6-tile__title">{title}</h3>
            <p class="v6-tile__text">{body}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="v6-sec v6-sec--tint">
    <div class="v6-wrap tk-ad__split tk-ad__split--sticky">
      <div class="tk-ad__sticky">
        <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "Seven questions every shop owner" }, { t: "deserves answered.", accent: true }])} />
        <p class="v6-lead tk-ad__lead">
          You don't need to know every ad platform. You do need a plan that makes everyone you hire
          answer the same business questions.
        </p>
      </div>
      <ul class="tk-ad__questions">
        {vendorQuestions.map((question) => (
          <li>
            <p>{question}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="v6-faq tk-ad__faq">
    <div class="v6-wrap v6-faq__grid">
      <div class="v6-faq__title">
        <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "Auto repair advertising" }, { t: "FAQ", accent: true }])} />
      </div>

      <ul class="v6-acc">
        {(post.faqs ?? []).map((item, index) => (
          <li class:list={["v6-acc__item", index === 0 && "is-open"]} data-acc-item>
            <button type="button" class="v6-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head>
              <span>{item.q}</span>
              <span class="v6-acc__icon" aria-hidden="true"></span>
            </button>
            <div class="v6-acc__panel"><div><p>{item.a}</p></div></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {post.externalSources && post.externalSources.length > 0 && (
    <ExternalSources sources={post.externalSources} />
  )}

  <section class="v6-sec v6-sec--navy tk-ad__final">
    <div class="v6-wrap">
      <div class="tk-ad__final-grid">
        <div>
          <h2 class="v6-h2 tk-ad__h2" data-words set:html={split([{ t: "Stop being the person who has to" }, { t: "manage every marketer.", accent: true }])} />
          <p class="v6-lead">
            Bring us your goals, capacity, current spend, vendors, and reports. We'll help sort out
            what Turnkey should run, what another specialist should own, and how the whole plan
            gets directed around your shop.
          </p>
        </div>
        <div class="tk-ad__final-actions">
          <a
            href={CONSULTATION_URL}
            class="v6-btn v6-btn--green v6-btn--lg"
            data-track-event="consultation_cta_click"
            data-track-placement="advertising_guide_final"
          >
            <span>Book a Strategy Call</span> <i set:html={arrow} />
          </a>
          <a
            href="/services/vip-marketing-manager"
            class="v6-btn v6-btn--ghost v6-btn--lg"
            data-track-event="service_cta_click"
            data-track-slug="vip-marketing-manager"
            data-track-placement="advertising_guide_final"
          >
            <span>See full-plan ownership</span>
          </a>
        </div>
      </div>

      <div class="tk-ad__principles">
        {[
          ["target", "Strategy before channels"],
          ["direct", "Direct work plus vendor coordination"],
          ["report", "Decisions tied to shop outcomes"],
        ].map(([icon, label]) => (
          <div>
            <span class="tk-ad__pr-icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc(icon)})`}></span></span>
            <span>{label}</span>
          </div>
        ))}
      </div>

      <nav aria-label="Related advertising resources" class="tk-ad__related">
        <div class="tk-ad__related-grid">
          {[
            ["/resources/auto-repair-marketing-plan", "Build the full auto repair marketing plan"],
            ["/resources/auto-repair-marketing-ideas", "Choose ideas for the shop problem in front of you"],
            ["/resources/direct-mail-for-repair-shops", "Plan a managed direct mail campaign"],
          ].map(([href, label]) => (
            <a href={href}>
              <span>{label}</span>
              <i set:html={arrow} />
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>
</article>

<style>
  /* Readable ink for body copy; muted gray is reserved for tiny meta */
  .tk-ad { --ink: #2b303b; }
  .tk-ad .tk-art__dek, .tk-ad .v6-lead, .tk-ad .v6-tile__text { color: var(--ink); }
  .tk-ad .v6-sec--navy .v6-lead { color: #e4e8f2; }

  .tk-ad__crumbs { gap: 0.5rem; }
  .tk-ad__crumb { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--navy); font-weight: 600; }
  .tk-ad__crumb-sep::before { content: "/"; color: #8a8f9c; }
  .tk-ad__crumb-here { color: var(--charcoal); font-weight: 500; }
  .tk-ad__byline a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .tk-ad__byline { padding-top: 1.25rem; border-top: 1px solid #dcd9d2; margin-top: 2rem; }
  .tk-ad__visual { display: grid; }
  .tk-ad__media { aspect-ratio: 16 / 11; }

  .tk-ad__first { padding-top: clamp(5.5rem, 10vw, 9rem); }
  .tk-ad__h2 { max-width: 15ch; }
  .tk-ad__h2--wide { max-width: 20ch; }
  .tk-ad__split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .tk-ad__copy { display: grid; gap: 1.25rem; padding-top: 0.5rem; font-size: 1.075rem; line-height: 1.7; color: var(--ink); max-width: 40rem; }
  .tk-ad__big { font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.6; color: var(--charcoal); }
