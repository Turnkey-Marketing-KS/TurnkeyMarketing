---
import { Content } from "@/articles/ai-google-reviews.md";
import { getResourcePost, type ResourcePost } from "@/lib/resource-posts";
import { CONSULTATION_URL } from "@/lib/services";
import { arrow, split } from "@/lib/v6";

interface Props { post: ResourcePost }
const { post } = Astro.props;
const nav = [
  ["look-beyond-the-star-rating", "Beyond the stars"],
  ["give-ai-a-useful-set-of-reviews", "Prepare your reviews"],
  ["ask-for-evidence-then-recommendations", "Copy the AI prompt"],
  ["turn-complaints-into-a-specific-fix", "Make an operational fix"],
  ["turn-compliments-into-stronger-marketing", "Build your message"],
  ["check-whether-the-change-helped", "Measure the change"],
  ["frequently-asked-questions", "Common questions"],
];
const related = (post.relatedSlugs ?? []).map(getResourcePost).filter(Boolean);
---

<article class="tk-md" data-art-body>
  <header class="tk-art__hero">
    <div class="v6-wrap">
      <a href="/resources" class="tk-art__back"><i set:html={arrow} /> All resources</a>
      <div class="tk-art__head">
        <div class="tk-art__head-text">
          <h1 class="tk-art__title" data-words set:html={split([{ t: post.title }])} />
          <p class="tk-art__dek" data-fade style="--d:2">Your reviews already tell you what customers value and what gets in their way. Here is how to use AI to find both, then act on what you learn.</p>
          <p class="tk-art__byline" data-fade style="--d:2">By Turnkey Marketing <span aria-hidden="true">·</span> <time datetime={post.originalDate}>September 15, 2026</time> <span aria-hidden="true">·</span> 7 min read</p>
          <div class="tk-art__actions" data-fade style="--d:3">
            <a class="v6-btn v6-btn--navy v6-btn--lg" href="#ask-for-evidence-then-recommendations"><span>Get the AI prompt</span> <i set:html={arrow} /></a>
          </div>
        </div>
        <figure class="tk-art__media tk-md__media" data-fade style="--d:3">
          <img src={post.image.src} alt={post.image.alt} width={1200} height={900} loading="eager" decoding="async" />
        </figure>
      </div>
    </div>
  </header>

  <div class="v6-wrap tk-art__layout tk-art__read">
    <aside class="tk-art__aside">
      <nav class="tk-toc" aria-label="In this article" data-toc>
        <details class="tk-toc__box" data-toc-details open>
          <summary>In this article <span class="tk-toc__plus" aria-hidden="true"></span></summary>
          <ul class="tk-toc__list">{nav.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </details>
      </nav>
    </aside>
    <div class="tk-art__main"><div class="v6-prose tk-md__prose"><Content /></div></div>
  </div>

  <section class="v6-cta">
    <div class="v6-wrap">
      <div class="v6-cta__panel" data-rise>
        <p class="v6-cta__title" data-words set:html={split([{ t: "Stop carrying" }, { t: "the marketing burden.", accent: true }])} />
        <div class="v6-cta__actions">
          <a href={CONSULTATION_URL} class="v6-btn v6-btn--navy v6-btn--lg" data-track-event="consultation_cta_click" data-track-placement="resource_ai_reviews_cta"><span>Book a Strategy Call</span><i set:html={arrow} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec v6-sec--tint tk-art__related" aria-labelledby="review-related-title">
    <div class="v6-wrap">
      <h2 id="review-related-title" class="v6-h2 tk-art__related-h2">Put the insights to work.</h2>
      <div class="v6-swipe tk-art__cards" style={`--cols:${Math.max(2, related.length)}`}>{related.map(item => item && <a href={item.href} class="v6-post"><div class="v6-post__media"><img src={item.image.src} alt={item.image.alt} width={item.imageWidth ?? 1200} height={item.imageHeight ?? 800} loading="lazy" decoding="async" style={`object-position:${item.image.position};`} /></div><h3 class="v6-post__title">{item.title}</h3><p class="v6-link">Read the guide <i set:html={arrow} /></p></a>)}</div>
    </div>
  </section>
</article>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-review-prompt]");
  const prompt = document.querySelector<HTMLElement>(".review-prompt blockquote");
  const status = document.querySelector<HTMLElement>(".copy-status");
  if (button && prompt && status) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(prompt.innerText.trim());
        button.textContent = "Copied!";
        status.textContent = "Prompt copied. Paste it into your AI assistant with your prepared reviews.";
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(prompt);
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = "Select and copy the highlighted prompt, then paste it into your AI assistant.";
      }
    });
  }
</script>

<style>
  .tk-md__media { background: var(--navy); }
  .tk-md { --md-body: #2b303b; --md-on-navy: #e4e8f3; }
  .tk-md .tk-art__dek { color: var(--md-body); }
  .tk-md__prose { color: var(--md-body); }
  .tk-md__prose :global(> p:first-child) { font-size: 1.28em; line-height: 1.6; color: var(--navy); font-weight: 500; letter-spacing: -0.01em; }
  .tk-md__prose :global(a) { color: var(--navy); text-decoration-color: var(--key-blue); text-decoration-thickness: 2px; }
  .tk-md__prose :global(h2) { scroll-margin-top: calc(var(--header-h) + 2rem); }
  .tk-md__prose :global(.review-prompt) { position: relative; padding: clamp(1.4rem, 3vw, 2.25rem); border-radius: 30px; background: var(--navy); color: #fff; }
  .tk-md__prose :global(.prompt-toolbar) { display: flex; gap: 1rem; justify-content: flex-end; align-items: center; padding-bottom: 1.1rem; border-bottom: 1px solid #3b4785; }
  .tk-md__prose :global(.prompt-toolbar button) { flex: none; min-height: 2.75rem; padding: 0 1.2rem; border-radius: 999px; background: #fff; color: var(--navy); font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: background-color 0.3s; }
  .tk-md__prose :global(.prompt-toolbar button:hover) { background: var(--green); }
  .tk-md__prose :global(.prompt-toolbar button[hidden]) { display: none; }
  .tk-md__prose :global(.review-prompt blockquote) { margin-top: 1.25rem; padding: 0; border: 0; font-size: 0.98rem; font-weight: 400; letter-spacing: 0; line-height: 1.75; color: var(--md-on-navy); }
  .tk-md__prose :global(.review-prompt blockquote > * + *) { margin-top: 1em; }
  .tk-md__prose :global(.copy-status) { margin-top: 1rem; font-size: 0.85rem; color: #fff; line-height: 1.5; }
  .tk-md__prose :global(.copy-status:empty) { display: none; }
  @media (max-width: 900px) {
        }
  /* Review examples: each card reads problem, then what to look into, then the change to try */
  .tk-md__prose :global(.review-examples) { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .tk-md__prose :global(.example-card) { overflow: hidden; border-radius: 26px; background: #fff; box-shadow: 0 0 0 1px var(--hairline), 0 24px 50px -40px rgba(35, 46, 102, 0.55); }
  .tk-md__prose :global(.example-card h3) { margin: 0; padding: 1.35rem 1.6rem; background: var(--navy); color: #fff; font-size: clamp(1.15rem, 1.6vw, 1.3rem); letter-spacing: -0.025em; line-height: 1.25; }
  .tk-md__prose :global(.example-card dl) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin: 0; }
  .tk-md__prose :global(.example-card dt) { grid-row: 1; padding: 1.25rem 1.6rem 0; font-size: 0.85rem; font-weight: 700; color: var(--key-blue); }
  .tk-md__prose :global(.example-card dt:nth-of-type(2)) { background: var(--key-blue-soft); color: var(--navy); }
  .tk-md__prose :global(.example-card dd) { grid-row: 2; margin: 0; padding: 0.35rem 1.6rem 1.4rem; font-size: 1.0625rem; font-weight: 500; line-height: 1.5; color: var(--charcoal); }
  .tk-md__prose :global(.example-card dd:nth-of-type(2)) { background: var(--key-blue-soft); }
  @media (max-width: 900px) {
    .tk-md__prose :global(.example-card) { border-radius: 22px; }
    .tk-md__prose :global(.example-card h3) { padding: 1.1rem 1.2rem; }
    .tk-md__prose :global(.example-card dl) { grid-template-columns: 1fr; }
    .tk-md__prose :global(.example-card dt), .tk-md__prose :global(.example-card dd) { grid-row: auto; padding-inline: 1.2rem; }
    .tk-md__prose :global(.example-card dd) { padding-bottom: 1.1rem; font-size: 1rem; }
  }
</style>
