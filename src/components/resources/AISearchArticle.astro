---
import {
  ArrowLeft,
  ArrowRight,
  Bot,
  Check,
  CheckCircle2,
  ChevronRight,
  CircleDot,
  FileSearch,
  PhoneCall,
  Search,
  ShieldCheck,
  Wrench,
} from "lucide-react";
import { getResourcePost, type ResourcePost } from "@/lib/resource-posts";

interface Props {
  post: ResourcePost;
}

const { post } = Astro.props;
const relatedPosts = (post.relatedSlugs ?? [])
  .map((slug) => getResourcePost(slug))
  .filter((relatedPost) => relatedPost !== undefined);

const navLinks = [
  { href: "#what-changed", label: "What changed" },
  { href: "#three-gates", label: "What AI looks for" },
  { href: "#technical-foundation", label: "Technical basics" },
  { href: "#ai-calls", label: "AI calls" },
  { href: "#action-plan", label: "30-day plan" },
  { href: "#how-turnkey-helps", label: "How Turnkey helps" },
  { href: "#faq", label: "FAQ" },
  { href: "#sources", label: "Sources" },
];

const evidence = [
  {
    value: "Multiple shops",
    label: "Google can contact several nearby shops while the driver waits for one answer.",
    href: "https://support.google.com/websearch/answer/16421135",
    source: "Google Search Help",
  },
  {
    value: "3× longer",
    label: "People give AI the whole story, not just “brake shop near me.”",
    href: "https://blog.google/products-and-platforms/products/search/ai-mode-us-insights/",
    source: "Google, 2025",
  },
  {
    value: "8% vs. 15%",
    label: "When an AI summary appeared, fewer searchers bothered clicking a traditional result.",
    href: "https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/",
    source: "Pew Research Center, 2025",
  },
  {
    value: "45% / 88%",
    label: "Customers may ask AI who to call, but most still read the reviews before handing over the keys.",
    href: "https://www.brightlocal.com/research/lcrs-ai-trust/",
    source: "BrightLocal, 2026",
  },
];

const gates = [
  {
    title: "Understand",
    question: "Can AI tell what your shop is best at?",
    body: "If I asked what your shop is known for, I doubt you would say, “Everything for everyone.” Your website should be just as clear about the vehicles, repairs, and problems your team handles best.",
    checks: [
      "Clear services and vehicle specialties",
      "Correct location, hours, and phone number",
      "Straight answers to common questions",
    ],
    icon: Search,
    customIcon: null,
    dark: false,
    greenAccent: false,
  },
  {
    title: "Verify",
    question: "Does the rest of the internet back you up?",
    body: "AI can compare your website with your Google Business Profile, reviews, directories, and photos. If one says you close at 5 and another says 7, nobody is going to solve the mystery. Make every source tell the same story.",
    checks: [
      "Matching shop information everywhere",
      "Recent reviews that mention real repairs",
      "Real photos, people, and credentials",
    ],
    icon: ShieldCheck,
    customIcon: null,
    dark: true,
    greenAccent: true,
  },
  {
    title: "Act",
    question: "Is it easy to call or book the next step?",
    body: "Getting recommended is nice. Getting the appointment is better. Your phone, scheduling process, and explanation of what happens next should make it easy for a worried driver to say yes.",
    checks: [
      "A phone that is answered consistently",
      "Clear availability and scheduling",
      "A confident handoff to inspection",
    ],
    icon: PhoneCall,
    customIcon: "/images/icons/phone-call.svg",
    dark: false,
    greenAccent: true,
  },
];

const callJourney = [
  {
    title: "Driver asks",
    body: "“Who can look at this warning light before Friday?”",
    icon: Search,
  },
  {
    title: "Google checks shops",
    body: "Nearby shops are compared using what is already online",
    icon: Bot,
  },
  {
    title: "Your advisor answers",
    body: "Your team explains timing, price, and what must be inspected",
    icon: PhoneCall,
  },
  {
    title: "Driver chooses",
    body: "The clearest, most trustworthy next step has the edge",
    icon: CheckCircle2,
  },
];

const actionSteps = [
  {
    label: "Target",
    title: "Choose the work you want more of.",
    body: "Start with profitable jobs and the customers you are genuinely equipped to help, rather than a giant keyword list someone exported from a marketing tool. Name the vehicles, repairs, and diagnostic work your team wants in the bays.",
  },
  {
    label: "Identity",
    title: "Make your shop information match everywhere.",
    body: "Use the same business name, address, phone number, hours, and appointment link everywhere. If your website says one thing and Google says another, the customer will not investigate. They will call someone else.",
  },
  {
    label: "Service pages",
    title: "Answer the questions customers ask before they call.",
    body: "Explain the symptoms you handle, which vehicles you service, what your team checks, and what happens next. Seven thin pages that repeat “brake repair” with seven city names do not make you seven times more convincing.",
  },
  {
    label: "Reviews",
    title: "Build a steady flow of specific reviews.",
    body: "Ask soon after a good experience, while the repair and your communication are still fresh. “Great shop!” is nice. A review that mentions the misfire, the clear updates, and the fix is far more useful.",
  },
  {
    label: "Proof",
    title: "Show the real people and work behind the shop.",
    body: "Show your actual team, bays, inspections, credentials, and community work. Stock photos of suspiciously spotless mechanics fool no one. Real proof gives customers and AI something credible to work with.",
  },
  {
    label: "Phone readiness",
    title: "Give service advisors a clear response plan.",
    body: "Agree on what can be quoted, what needs an inspection, how diagnostic fees are explained, and which questions move the call forward. Confidence at the counter should not depend on which advisor happens to answer.",
  },
  {
    label: "Measurement",
    title: "Track calls and booked work, not just traffic.",
    body: "Watch qualified calls, appointment requests, and the work that actually reaches the schedule. A flashy traffic chart cannot pay a technician. The right repair orders can.",
  },
];

const sources = [
  {
    title: "How to check pricing for local businesses with AI in Google Search",
    publisher: "Google Search Help · current product documentation",
    href: "https://support.google.com/websearch/answer/16421135",
  },
  {
    title: "Optimizing your website for generative AI features on Google Search",
    publisher: "Google Search Central · official 2026 guidance",
    href: "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide",
  },
  {
    title: "Local business structured data",
    publisher: "Google Search Central · official technical documentation",
    href: "https://developers.google.com/search/docs/appearance/structured-data/local-business",
  },
  {
    title: "Tips to improve your local ranking on Google",
    publisher: "Google Business Profile Help · official guidance",
    href: "https://support.google.com/business/answer/7091",
  },
  {
    title: "Publishers and developers FAQ",
    publisher: "OpenAI Help Center · crawler and referral guidance",
    href: "https://help.openai.com/en/articles/12627856",
  },
  {
    title: "Google users are less likely to click when an AI summary appears",
    publisher: "Pew Research Center · 68,879 searches observed in March 2025",
    href: "https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/",
  },
  {
    title: "Local Consumer Review Survey: AI and trust",
    publisher: "BrightLocal · vendor survey; 1,002 US adults, AI-user subgroup 455",
    href: "https://www.brightlocal.com/research/lcrs-ai-trust/",
  },
];
---

<article class="bg-white">
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <section class="relative overflow-hidden bg-[linear-gradient(135deg,#fff_0%,#f6faff_58%,#edf4fc_100%)] py-10 md:py-14 lg:py-20">
    <span class="pointer-events-none absolute -right-28 -top-24 h-[30rem] w-[30rem] rounded-full bg-[var(--key-blue-soft)]/65 blur-3xl" aria-hidden="true"></span>
    <span class="pointer-events-none absolute -bottom-44 left-1/3 h-80 w-80 rounded-full bg-[var(--green)]/8 blur-3xl" aria-hidden="true"></span>
    <div class="container-page relative">
      <a href="/resources" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-charcoal/65 transition hover:text-charcoal">
        <ArrowLeft className="h-4 w-4" /> All resources
      </a>

      <div class="mt-9 grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-14 xl:gap-20">
        <header class="lg:col-span-7">
          <p class="eyebrow text-[var(--key-blue)]">AI Search · Field Guide · <time datetime={post.updatedDate ?? post.originalDate}>{post.date}</time></p>
          <h1 class="mt-6 max-w-[11ch] text-balance font-display text-[clamp(3rem,6.1vw,6.35rem)] font-semibold leading-[.91] tracking-[-.065em] text-charcoal">
            Will AI <span class="text-[var(--key-blue)]">Recommend Your Auto Repair Shop?</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-charcoal/68 md:text-xl">{post.dek}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="/ai-visibility-scan" class="btn-primary w-full justify-center sm:w-auto" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_hero_scan">
              Scan your shop’s AI visibility <ArrowRight className="h-4 w-4" />
            </a>
            <a href="#what-changed" class="btn-ghost w-full justify-center sm:w-auto">Read the field guide</a>
          </div>
        </header>

        <figure class="lg:col-span-5">
          <div class="rounded-[30px] border border-[rgba(35,46,102,.1)] bg-white p-2.5 shadow-[0_38px_90px_-46px_rgba(35,46,102,.5)] md:rounded-[38px] md:p-3">
            <div class="aspect-[4/3] overflow-hidden rounded-[22px] bg-[var(--navy)] md:rounded-[29px]">
              <img
                src={post.image.src}
                alt={post.image.alt}
                width={post.imageWidth ?? 2400}
                height={post.imageHeight ?? 1600}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover"
                style={`object-position: ${post.image.position};`}
              />
            </div>
          </div>
        </figure>
      </div>

    </div>
  </section>

  <section class="border-y border-[var(--hairline)] bg-white py-10 md:py-12" aria-labelledby="short-answer-heading">
    <div class="container-page grid gap-5 md:grid-cols-[180px_1fr] md:gap-10 lg:max-w-6xl">
      <p class="eyebrow pt-1 text-[var(--key-blue)]">The short answer</p>
      <div>
        <h2 id="short-answer-heading" class="article-summary-heading text-charcoal">
          AI is more likely to recommend a shop it can clearly understand and trust.
        </h2>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-charcoal/65">Yes, if AI can quickly understand what you do and find enough evidence to trust it. The good news is that the fundamentals still win: clear services, accurate information, strong reviews, real proof, and an easy next step. No secret handshake required.</p>
      </div>
    </div>
  </section>

  <div class="bg-white">
    <div class="container-page py-14 md:py-20 lg:grid lg:grid-cols-[210px_minmax(0,1fr)] lg:gap-14">
      <aside class="hidden lg:block">
        <nav class="sticky top-28" aria-label="Article sections">
          <p class="eyebrow text-charcoal/40">In this guide</p>
          <div class="mt-5 border-l border-[var(--hairline)]">
            {navLinks.map((link) => (
              <a href={link.href} class="article-nav-link block border-l-2 border-transparent py-2.5 pl-4 text-sm text-charcoal/55 transition hover:text-charcoal" data-article-nav>{link.label}</a>
            ))}
          </div>
          <a href="/ai-visibility-scan" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--navy)]" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_sticky_scan">Run the scan <ArrowRight className="h-4 w-4" /></a>
        </nav>
      </aside>

      <div class="min-w-0">
        <nav class="article-mobile-nav -mx-4 mb-12 snap-x snap-proximity overflow-x-auto px-4 lg:hidden" aria-label="Article sections">
          <div class="flex w-max gap-2 pb-2">
            {navLinks.map((link) => <a href={link.href} class="article-mobile-nav-link inline-flex min-h-11 snap-start items-center rounded-full border border-[rgba(35,46,102,.22)] bg-white px-4 py-2 text-sm font-medium text-[var(--navy)] shadow-[0_8px_20px_-18px_rgba(35,46,102,.7)] transition hover:border-[var(--navy)] hover:bg-[var(--navy)] hover:text-white" data-article-nav>{link.label}</a>)}
          </div>
        </nav>

        <section id="what-changed" class="scroll-mt-28" aria-labelledby="what-changed-heading">
          <p class="eyebrow text-[var(--key-blue)]">The shift</p>
          <h2 id="what-changed-heading" class="article-section-heading mt-4 text-charcoal">
            Customers can compare shops <span class="block">without visiting them.</span>
          </h2>
          <div class="mt-6 max-w-[66ch] space-y-5 text-lg leading-[1.75] text-charcoal/68">
            <p>Picture a driver in the parking lot at work. The check-engine light is on, the car has started doing “that weird thing again,” and they need help before Friday. They are not in the mood to study six shop websites. They want a trustworthy answer.</p>
            <p>So instead of searching “auto repair near me,” they ask AI: “Which shop nearby is good with European electrical problems, has strong reviews, and can see me this week?” AI can check several sources and hand back a shortlist. Just like that, part of the buying decision happens before the driver knows your shop by name.</p>
            <p>Google can even contact multiple nearby shops about price and availability. That means your marketing is no longer just what appears on a page. It is also whether your information makes sense and whether your team gives a clear, helpful answer when the phone rings.</p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-2">
            <article class="relative overflow-hidden rounded-[30px] border border-[rgba(35,46,102,.16)] bg-[linear-gradient(145deg,#fff_0%,#f4faff_100%)] p-6 shadow-[0_28px_70px_-52px_rgba(35,46,102,.58)] md:p-8">
              <span class="absolute inset-y-0 left-0 w-1.5 bg-[var(--key-blue)]" aria-hidden="true"></span>

              <div class="flex items-start gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--key-blue)] text-white shadow-sm" aria-hidden="true"><Search className="h-5 w-5" /></span>
                <div>
                  <p class="eyebrow text-[var(--key-blue)]">Traditional search</p>
                  <h3 class="mt-3 font-display text-[1.75rem] font-semibold leading-[1.05] tracking-[-.035em] text-[var(--navy)]">
                    The customer visited first
                  </h3>
                </div>
              </div>

              <p class="mt-4 max-w-sm text-[0.96rem] leading-relaxed text-charcoal/75">
                Your website got to make the introduction before the customer decided.
              </p>

              <ol class="mt-7 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-1.5" aria-label="Website-led customer journey">
                {["Search", "Click", "Compare", "Call"].map((label) => (
                  <li class="rounded-[14px] border border-[rgba(35,46,102,.11)] bg-white px-2 py-3.5 text-center shadow-[0_10px_24px_-22px_rgba(35,46,102,.8)]">
                    <span class="mx-auto block h-1 w-6 rounded-full bg-[var(--key-blue)]" aria-hidden="true"></span>
                    <span class="mt-2 block text-xs font-semibold text-charcoal sm:text-sm">{label}</span>
                  </li>
                ))}
              </ol>

              <div class="mt-7 border-t border-[rgba(35,46,102,.12)] pt-5">
                <p class="text-[0.67rem] font-semibold uppercase tracking-[.18em] text-[var(--navy)]/55">Where trust was built</p>
                <p class="mt-2 font-display text-lg font-semibold leading-snug text-charcoal">
                  On your website, after the customer arrived.
                </p>
              </div>
            </article>

            <article class="relative overflow-hidden rounded-[30px] bg-[linear-gradient(145deg,var(--navy)_0%,var(--navy-deep)_100%)] p-6 text-white shadow-[0_30px_75px_-48px_rgba(25,37,94,.92)] md:p-8">
              <span class="absolute inset-y-0 left-0 w-1.5 bg-[var(--green)]" aria-hidden="true"></span>
              <span class="pointer-events-none absolute -right-16 -top-20 h-48 w-48 rounded-full bg-[var(--key-blue)]/20 blur-3xl" aria-hidden="true"></span>

              <div class="relative flex items-start gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-[var(--green)] text-[var(--navy)]" aria-hidden="true"><Bot className="h-5 w-5" /></span>
                <div>
                  <p class="eyebrow text-[#9ed8f0]">AI-assisted search</p>
                  <h3 class="mt-3 font-display text-[1.75rem] font-semibold leading-[1.05] tracking-[-.035em] text-white">
                    The comparison happens first
                  </h3>
                </div>
              </div>

              <p class="relative mt-4 max-w-sm text-[0.96rem] leading-relaxed text-white/78">
                AI may form the shortlist before the customer ever sees your homepage.
              </p>

              <ol class="relative mt-7 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-1.5" aria-label="AI-assisted customer journey">
                {["Ask", "Check", "Compare", "Contact"].map((label) => (
                  <li class="rounded-[14px] border border-[#45538d] bg-[#303d79] px-2 py-3.5 text-center">
                    <span class="mx-auto block h-1 w-6 rounded-full bg-[var(--green)]" aria-hidden="true"></span>
                    <span class="mt-2 block text-xs font-semibold text-white lg:text-sm">{label}</span>
                  </li>
                ))}
              </ol>

              <div class="relative mt-7 border-t border-white/15 pt-5">
                <p class="text-[0.67rem] font-semibold uppercase tracking-[.18em] text-[#9ed8f0]">Where trust is built</p>
                <p class="mt-2 font-display text-lg font-semibold leading-snug text-white">
                  In the information already online, before the customer clicks.
                </p>
              </div>
            </article>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4" aria-label="AI search evidence">
            {evidence.map((item) => (
              <a href={item.href} target="_blank" rel="noreferrer" class="motion-card group rounded-[24px] border border-black/[0.07] bg-white p-5 shadow-[0_22px_50px_-44px_rgba(20,22,28,.55)]">
                <p class="font-display text-3xl font-semibold tracking-[-.04em] text-[var(--navy)]">{item.value}</p>
                <p class="mt-3 text-sm leading-relaxed text-charcoal/65">{item.label}</p>
                <p class="mt-5 text-[11px] font-semibold uppercase tracking-[.12em] text-charcoal/38">{item.source} ↗</p>
              </a>
            ))}
          </div>
        </section>

        <section class="-mx-4 mt-16 overflow-hidden bg-[var(--navy)] px-4 py-12 text-white sm:rounded-[32px] sm:px-8 md:mt-20 md:px-12 md:py-14" aria-labelledby="automotive-stakes-heading">
          <p class="eyebrow text-[#9ed8f0]">Why auto repair is different</p>
          <h2 id="automotive-stakes-heading" class="article-section-heading mt-4 text-white">
            AI can recommend a shop. <span class="block">It cannot diagnose the car.</span>
          </h2>
          <div class="mt-6 max-w-[65ch] space-y-5 text-lg leading-[1.72] text-white/68">
            <p>AI can find nearby options and ask about basic pricing. It cannot hear the noise, smell the smell, put the car on a lift, or confirm what caused a trouble code. And despite what a very confident customer may tell you, a screenshot from an AI chat is not a completed inspection.</p>
            <p>I see that as an advantage for a well-run shop. Explain what you service, how diagnosis works, what can be estimated over the phone, and what requires the vehicle. A useful, honest answer earns more trust than a fast guess dressed up as certainty.</p>
          </div>
          <div class="mt-9 grid gap-3 sm:grid-cols-2">
            {["Customers need help quickly", "Diagnosis still requires the vehicle", "Most drivers choose nearby shops", "Trust matters before price"].map((label) => (
              <div class="flex items-center gap-3 rounded-2xl border border-[#39467f] bg-[var(--navy-deep)] px-4 py-3.5"><CheckCircle2 className="h-5 w-5 flex-none text-[var(--green)]" /><span class="font-medium text-white/85">{label}</span></div>
            ))}
          </div>
        </section>

        <section id="three-gates" class="mt-16 scroll-mt-28 md:mt-20" aria-labelledby="three-gates-heading">
          <p class="eyebrow text-[var(--key-blue)]">A practical model</p>
          <h2 id="three-gates-heading" class="article-section-heading mt-4 text-charcoal">
            Three things make a shop <span class="block">easier to recommend.</span>
          </h2>
          <p class="mt-6 max-w-[65ch] text-lg leading-[1.72] text-charcoal/65">Let me save you from the rabbit hole: there is no magic “rank me in AI” button. Make your shop clear, consistent, and easy to contact. Those improvements help real customers and <a href="/services/digital-marketing" class="font-semibold text-[var(--navy)] underline decoration-[rgba(64,145,209,.45)] decoration-2 underline-offset-4 transition hover:decoration-[var(--key-blue)]">traditional local search</a>, too.</p>

          <div class="mt-10 grid gap-5">
            {gates.map((gate) => {
              const Icon = gate.icon;
              return (
                <section
                  class:list={[
                    "relative overflow-hidden rounded-[28px] p-6 md:grid md:grid-cols-[82px_1fr] md:gap-7 md:p-8",
                    gate.dark
                      ? "bg-[linear-gradient(135deg,var(--navy)_0%,var(--navy-deep)_100%)] text-white shadow-[0_34px_80px_-54px_rgba(25,37,94,.95)]"
                      : "border border-[rgba(35,46,102,.13)] bg-white shadow-[0_26px_64px_-52px_rgba(35,46,102,.58)]",
                  ]}
                >
                  <span
                    class:list={[
                      "absolute inset-y-0 left-0 w-1.5",
                      gate.title === "Act"
                        ? "bg-[var(--navy)]"
                        : gate.greenAccent
                          ? "bg-[var(--green)]"
                          : "bg-[var(--key-blue)]",
                    ]}
                    aria-hidden="true"
                  ></span>
                  {gate.dark && <span class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-[var(--key-blue)]/20 blur-3xl" aria-hidden="true"></span>}
                  <div class="md:block">
                    <span
                      class="relative inline-flex h-13 w-13 items-center justify-center rounded-2xl border border-white bg-white text-[var(--navy)] shadow-[0_10px_24px_-14px_rgba(18,31,82,.5)]"
                    >
                      {gate.customIcon ? (
                        <img src={gate.customIcon} alt="" role="presentation" width="1200" height="1200" loading="lazy" decoding="async" class="h-6 w-6" aria-hidden="true" />
                      ) : (
                        <Icon className="h-6 w-6" />
                      )}
                    </span>
                  </div>
                  <div class="relative mt-5 md:mt-0">
                    <h3 class:list={["font-display text-2xl font-semibold leading-tight md:text-3xl", gate.dark ? "text-white" : "text-charcoal"]}>{gate.question}</h3>
                    <p class:list={["mt-4 max-w-[62ch] leading-relaxed", gate.dark ? "text-white/72" : "text-charcoal/68"]}>{gate.body}</p>
                    <ul class="mt-5 grid gap-2.5 sm:grid-cols-3">
                      {gate.checks.map((check) => (
                        <li class:list={["flex gap-2 text-sm leading-relaxed", gate.dark ? "text-white/78" : "text-charcoal/68"]}>
                          <Check className="mt-0.5 h-4 w-4 flex-none text-[var(--green)]" />{check}
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>
              );
            })}
          </div>

