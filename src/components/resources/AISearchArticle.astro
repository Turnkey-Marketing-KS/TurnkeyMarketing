<script>
  const progress = document.querySelector<HTMLElement>("[data-reading-progress]");
  const sections = [...document.querySelectorAll<HTMLElement>("main section[id]")];
  const navItems = [...document.querySelectorAll<HTMLAnchorElement>("[data-article-nav]")];

  const updateArticleState = () => {
    const article = document.querySelector<HTMLElement>("main article");
    if (progress && article) {
      const start = article.offsetTop;
      const distance = Math.max(1, article.offsetHeight - window.innerHeight);
      const percentage = Math.min(100, Math.max(0, ((window.scrollY - start) / distance) * 100));
      progress.style.width = `${percentage}%`;
    }

    const marker = window.scrollY + 180;
    let activeId = "";
    for (const section of sections) {
      if (section.offsetTop <= marker) activeId = section.id;
    }
    navItems.forEach((item) => item.classList.toggle("is-active", item.hash === `#${activeId}`));
  };

  window.addEventListener("scroll", updateArticleState, { passive: true });
  window.addEventListener("resize", updateArticleState);
  updateArticleState();
</script>

