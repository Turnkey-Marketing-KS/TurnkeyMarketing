---
import { getResourcePost, type ResourcePost } from "@/lib/resource-posts";
import ExternalSources from "@/components/resources/ExternalSources.astro";
import { arrow, arrowUp, iconSrc, split } from "@/lib/v6";

interface Props {
  post: ResourcePost;
}

const { post } = Astro.props;
const relatedPosts = (post.relatedSlugs ?? [])
  .map((slug) => getResourcePost(slug))
  .filter((relatedPost) => relatedPost !== undefined);

const navLinks = [
  { href: "#what-changed", label: "What changed" },
  { href: "#three-gates", label: "What AI looks for" },
  { href: "#technical-foundation", label: "Technical basics" },
  { href: "#ai-calls", label: "AI calls" },
  { href: "#action-plan", label: "30-day plan" },
  { href: "#how-turnkey-helps", label: "How Turnkey helps" },
  { href: "#faq", label: "FAQ" },
  { href: "#sources", label: "Sources" },
];

const evidence = [
  {
    value: "Multiple shops",
    label: "Google can contact several nearby shops on a driver’s behalf while that driver waits for one answer.",
    href: "https://support.google.com/websearch/answer/16421135",
    source: "Google Search Help",
  },
  {
    value: "3× longer",
    label: "Drivers give AI the whole story now, not just “brake shop near me.”",
    href: "https://blog.google/products-and-platforms/products/search/ai-mode-us-insights/",
    source: "Google, 2025",
  },
  {
    value: "8% vs. 15%",
    label: "With an AI summary on the page, 8% of searchers clicked a traditional result. Without one, 15% did.",
    href: "https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/",
    source: "Pew Research Center, 2025",
  },
  {
    value: "45% / 88%",
    label: "Customers may ask AI who to call. Most still read the reviews before they hand over the keys.",
    href: "https://www.brightlocal.com/research/lcrs-ai-trust/",
    source: "BrightLocal, 2026",
  },
];

const gates = [
  {
    title: "Understand",
    question: "Can AI tell what your shop is best at?",
    body: "Ask a customer what your shop is known for. The answer should not be “everything for everyone.” Your website needs to be just as specific about the vehicles, repairs, and problems your team handles best.",
    checks: [
      "Clear services and vehicle specialties",
      "Correct location, hours, and phone number",
      "Straight answers to common questions",
    ],
    icon: "internet",
    customIcon: null,
    dark: false,
    greenAccent: false,
  },
  {
    title: "Verify",
    question: "Does the rest of the internet back you up?",
    body: "AI can compare your website with your Google Business Profile, reviews, directories, and photos. If one says you close at 5 and another says 7, nobody calls to settle it. They move on. Make every source tell the same story.",
    checks: [
      "Matching shop information everywhere",
      "Recent reviews that mention real repairs",
      "Real photos, people, and credentials",
    ],
    icon: "report",
    customIcon: null,
    dark: true,
    greenAccent: true,
  },
  {
    title: "Act",
    question: "Is it easy to call or book the next step?",
    body: "Getting recommended is nice. Getting the appointment is the point. Your phone, your scheduling, and how you explain what happens next should make it easy for a worried driver to say yes.",
    checks: [
      "A phone that is answered consistently",
      "Clear availability and scheduling",
      "A confident handoff to inspection",
    ],
    icon: "phone",
    customIcon: "/images/icons/phone-call.svg",
    dark: false,
    greenAccent: true,
  },
];

const callJourney = [
  {
    title: "Driver asks",
    body: "“Who can look at this warning light before Friday?”",
    icon: "internet",
  },
  {
    title: "Google checks shops",
    body: "Nearby shops get compared on what is already online",
    icon: "target",
  },
  {
    title: "Your advisor answers",
    body: "Your team explains timing, price, and what has to be inspected",
    icon: "phone",
  },
  {
    title: "Driver chooses",
    body: "The shop with the clearest, most trustworthy next step has the edge",
    icon: "report",
  },
];

const actionSteps = [
  {
    title: "Choose the work you want more of.",
    body: "Start with the profitable jobs and the customers your team is genuinely equipped to help. Skip the giant keyword list someone exported from a marketing tool. Name the vehicles, repairs, and diagnostic work you want in your bays.",
  },
  {
    title: "Make your shop information match everywhere.",
    body: "Use the same business name, address, phone number, hours, and appointment link everywhere. If your website says one thing and Google says another, the customer will not investigate. They will call the next shop.",
  },
  {
    title: "Answer the questions customers ask before they call.",
    body: "Explain the symptoms you handle, the vehicles you service, what your team checks, and what happens next. Seven thin pages that repeat “brake repair” with seven city names do not make you seven times more convincing.",
  },
  {
    title: "Build a steady flow of specific reviews.",
    body: "Ask soon after a good experience, while the repair and your communication are still fresh. “Great shop!” is nice. A review that mentions the misfire, the clear updates, and the fix tells the next customer, and AI, far more.",
  },
  {
    title: "Show the real people and work behind the shop.",
    body: "Show your actual team, bays, inspections, credentials, and community work. Stock photos of suspiciously spotless mechanics fool no one. Real proof gives customers and AI something credible to go on.",
  },
  {
    title: "Give service advisors a clear response plan.",
    body: "Agree on what can be quoted, what needs an inspection, how diagnostic fees get explained, and which questions move the call toward an appointment. Confidence at the counter should not depend on which advisor happens to pick up.",
  },
  {
    title: "Track calls and booked work, not just traffic.",
    body: "Watch qualified calls, appointment requests, and the work that actually lands on the schedule. A traffic chart cannot pay a technician. The right repair orders can.",
  },
];

const sources = [
  {
    title: "How to check pricing for local businesses with AI in Google Search",
    publisher: "Google Search Help · current product documentation",
    href: "https://support.google.com/websearch/answer/16421135",
  },
  {
    title: "Optimizing your website for generative AI features on Google Search",
    publisher: "Google Search Central · official 2026 guidance",
    href: "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide",
  },
  {
    title: "Local business structured data",
    publisher: "Google Search Central · official technical documentation",
    href: "https://developers.google.com/search/docs/appearance/structured-data/local-business",
  },
  {
    title: "Tips to improve your local ranking on Google",
    publisher: "Google Business Profile Help · official guidance",
    href: "https://support.google.com/business/answer/7091",
  },
  {
    title: "Publishers and developers FAQ",
    publisher: "OpenAI Help Center · crawler and referral guidance",
    href: "https://help.openai.com/en/articles/12627856",
  },
  {
    title: "Google users are less likely to click when an AI summary appears",
    publisher: "Pew Research Center · 68,879 searches observed in March 2025",
    href: "https://www.pewresearch.org/short-reads/2025/07/22/google-users-are-less-likely-to-click-on-links-when-an-ai-summary-appears-in-the-results/",
  },
  {
    title: "Local Consumer Review Survey: AI and trust",
    publisher: "BrightLocal · vendor survey; 1,002 US adults, AI-user subgroup 455",
    href: "https://www.brightlocal.com/research/lcrs-ai-trust/",
  },
];
---

<article class="tk-ais" data-art-body>
  <section class="tk-art__hero">
    <div class="v6-wrap">
      <a href="/resources" class="tk-art__back">
        <i set:html={arrow} /> All resources
      </a>

      <div class="tk-art__head">
        <header class="tk-art__head-text">
          <p class="tk-art__meta" data-fade><span class="tk-art__tag">AI Search</span> · <time datetime={post.updatedDate ?? post.originalDate}>{post.date}</time></p>
          <h1 class="tk-art__title tk-art__title--xl" data-words set:html={split([{ t: "Will AI" }, { t: "Recommend Your Auto Repair Shop?", accent: true }])} />
          <p class="tk-art__dek" data-fade style="--d:2">{post.dek}</p>
          <div class="tk-art__actions" data-fade style="--d:3">
            <a href="/ai-visibility-scan" class="v6-btn v6-btn--navy v6-btn--lg" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_hero_scan">
              <span>Scan your shop’s AI visibility</span> <i set:html={arrow} />
            </a>
            <a href="#what-changed" class="v6-link">Read the guide</a>
          </div>
        </header>

        <figure class="tk-art__media tk-ais__hero-media" data-fade style="--d:3">
          <img
            src={post.image.src}
            alt={post.image.alt}
            width={post.imageWidth ?? 2400}
            height={post.imageHeight ?? 1600}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={`object-position: ${post.image.position};`}
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="tk-ais__short" aria-labelledby="short-answer-heading">
    <div class="v6-wrap tk-ais__short-grid">
      <div>
        <h2 id="short-answer-heading" class="tk-ais__short-h2" data-rise>
          AI is more likely to recommend a shop it can clearly understand and trust.
        </h2>
        <p class="tk-ais__short-text">Yes, if AI can quickly tell what you do and find enough evidence to trust it. The good news: the fundamentals still win. Clear services, accurate information, strong reviews, real proof, and an easy next step. There is no secret handshake.</p>
      </div>
    </div>
  </section>

  <aside class="v6-wrap tk-ais__note">
    <p>
      Your reviews can guide decisions inside the shop, too. Learn <a href="/resources/analyze-google-reviews-with-ai" class="tk-art__text-link">how to use AI to find review patterns</a>, fix what frustrates customers, and build your message around what is already working.
    </p>
  </aside>

  <div class="v6-wrap tk-art__layout tk-art__read">
    <aside class="tk-art__aside">
      <nav class="tk-toc" aria-label="Article sections" data-toc>
        <details class="tk-toc__box" data-toc-details open>
          <summary>In this guide <span class="tk-toc__plus" aria-hidden="true"></span></summary>
          <div class="tk-toc__list">
            {navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </details>
        <div class="tk-toc__extra">
          <a href="/ai-visibility-scan" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_sticky_scan">Run the scan <i set:html={arrow} /></a>
        </div>
      </nav>
    </aside>

    <div class="tk-art__main">
      <section id="what-changed" class="tk-ais__sec" aria-labelledby="what-changed-heading">
        <h2 id="what-changed-heading" class="tk-art__h2">
          Customers can compare shops <span class="block">without visiting them.</span>
        </h2>
        <div class="tk-art__lede">
          <p>Picture a driver in the parking lot at work. The check-engine light is on, the car is doing “that weird thing again,” and they need help before Friday. They are not going to study six shop websites. They want one answer they can trust.</p>
          <p>So instead of typing “auto repair near me,” they ask AI: “Which shop nearby is good with European electrical problems, has strong reviews, and can see me this week?” AI can check several sources and hand back a shortlist. Part of the buying decision now happens before that driver knows your shop by name.</p>
          <p>Google can even contact several nearby shops to ask about price and availability. So your marketing is no longer only what shows up on a page. It is also whether your information adds up, and whether your team gives a clear, helpful answer when the phone rings.</p>
        </div>

        <div class="tk-ais__compare">
          <article class="tk-ais__mode" data-rise>
            <div class="tk-ais__mode-head">
              <span class="tk-ais__icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("internet")})`}></span></span>
              <div>
                <h3 class="tk-ais__mode-h3">
                  The customer visited first
                </h3>
              </div>
            </div>

            <p class="tk-ais__mode-text">
              With traditional search, your website made the introduction before the customer decided.
            </p>

            <ol class="tk-ais__chips" aria-label="Website-led customer journey">
              {["Search", "Click", "Compare", "Call"].map((label) => (
                <li><span>{label}</span></li>
              ))}
            </ol>

            <div class="tk-ais__mode-foot">
              <p class="tk-ais__mode-where">
                Trust got built on your website, after the customer arrived.
              </p>
            </div>
          </article>

          <article class="tk-ais__mode tk-ais__mode--navy" data-rise>
            <div class="tk-ais__mode-head">
              <span class="tk-ais__icon" aria-hidden="true"><span class="v6-icon" style={`--icon:url(${iconSrc("target")})`}></span></span>
              <div>
                <h3 class="tk-ais__mode-h3">
                  The comparison happens first
                </h3>
              </div>
            </div>

            <p class="tk-ais__mode-text">
              With AI-assisted search, the shortlist may be set before the customer ever sees your homepage.
            </p>

            <ol class="tk-ais__chips" aria-label="AI-assisted customer journey">
              {["Ask", "Check", "Compare", "Contact"].map((label) => (
                <li><span>{label}</span></li>
              ))}
            </ol>

            <div class="tk-ais__mode-foot">
              <p class="tk-ais__mode-where">
                Trust gets built from what is already online, before anyone clicks.
              </p>
            </div>
          </article>
        </div>

        <div class="tk-ais__evidence" aria-label="AI search evidence">
          {evidence.map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer" class="tk-ais__stat">
              <p class="tk-ais__stat-num">{item.value}</p>
              <p class="tk-ais__stat-label">{item.label}</p>
              <p class="tk-ais__stat-src">{item.source} ↗</p>
            </a>
          ))}
        </div>
      </section>

      <section class="tk-ais__navy" aria-labelledby="automotive-stakes-heading" data-rise>
        <h2 id="automotive-stakes-heading" class="tk-art__h2">
          AI can recommend a shop. <span class="block">It cannot diagnose the car.</span>
        </h2>
        <div class="tk-art__lede">
          <p>AI can find nearby options and ask about basic pricing. It cannot hear the noise, smell the smell, put the car on a lift, or confirm what caused a trouble code. And no matter how confident the customer sounds, a screenshot from an AI chat is not a completed inspection.</p>
          <p>For a well-run shop, that is an advantage. Explain what you service, how diagnosis works, what can be estimated over the phone, and what needs the vehicle in the bay. A useful, honest answer earns more trust than a fast guess dressed up as certainty.</p>
        </div>
        <div class="tk-ais__facts">
          {["Customers need help quickly", "Diagnosis still requires the vehicle", "Most drivers choose nearby shops", "Trust matters before price"].map((label) => (
            <div><span class="v6-mark v6-mark--check" aria-hidden="true"></span><span>{label}</span></div>
          ))}
        </div>
      </section>

      <section id="three-gates" class="tk-ais__sec" aria-labelledby="three-gates-heading">
        <h2 id="three-gates-heading" class="tk-art__h2">
          Three things make a shop <span class="block">easier to recommend.</span>
        </h2>
        <p class="tk-art__lede">Save yourself the rabbit hole: there is no magic “rank me in AI” button. Make your shop clear, consistent, and easy to contact. The same work helps real customers and <a href="/services/digital-marketing">traditional local search</a>, too.</p>

        <div class="tk-ais__gates">
          {gates.map((gate) => (
            <section class:list={["tk-ais__gate", gate.dark && "tk-ais__gate--navy"]} data-rise>
              <div class="tk-ais__gate-side">
                                <span class="tk-ais__icon">
                  {gate.customIcon ? (
                    <img src={gate.customIcon} alt="" role="presentation" width="1200" height="1200" loading="lazy" decoding="async" aria-hidden="true" />
                  ) : (
                    <span class="v6-icon" aria-hidden="true" style={`--icon:url(${iconSrc(gate.icon)})`}></span>
                  )}
                </span>
              </div>
              <div>
                <h3 class="tk-ais__gate-h3">{gate.question}</h3>
                <p class="tk-ais__gate-text">{gate.body}</p>
                <ul class="tk-ais__checks">
                  {gate.checks.map((check) => (
                    <li>
                      <span class="v6-mark v6-mark--check" aria-hidden="true"></span>{check}
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))}
        </div>

        <p class="tk-ais__small">If your shop is hard to describe, start with an <a href="/resources/ideal-customer-profile-auto-repair-shop" class="tk-art__text-link">ideal customer profile for your repair shop</a>. If the story is clear but the proof is thin, use our <a href="/resources/auto-repair-shop-photography-guide" class="tk-art__text-link">shop photography guide</a> to show the real team and work behind it.</p>
      </section>

      <section id="technical-foundation" class="tk-ais__sec" aria-labelledby="technical-foundation-heading">
        <h2 id="technical-foundation-heading" class="tk-art__h2">
          The technical part, <span class="block">without the tech headache.</span>
        </h2>
        <div class="tk-art__lede">
          <p>Your shop does not need to become a software company. It does need a <a href="/services/digital-marketing">digital marketing foundation</a> that search systems can open, read, and understand without a scavenger hunt.</p>
          <p>This is where crawlability and structured data come in. They sound technical because they are. The business goal is simple: label the facts your customers care about, and make sure those same facts appear in ordinary page text.</p>
        </div>

        <div class="tk-ais__rows">
          <div class="tk-ais__row">
            <h3 class="tk-ais__row-h3">Readable pages</h3>
            <p>Services, locations, credentials, warranties, and answers should appear as real text on fast, mobile-friendly pages. If important information lives only inside an image, a video, a social post, or a widget, a search system may never see it.</p>
          </div>
          <div class="tk-ais__row">
            <h3 class="tk-ais__row-h3">Structured facts</h3>
            <p>LocalBusiness, AutoRepair, Service, and opening-hours markup can label key business details for search engines. The code does not buy a recommendation or guarantee a ranking. It removes guesswork, which is exactly what good marketing should do.</p>
          </div>
          <div class="tk-ais__row">
            <h3 class="tk-ais__row-h3">A clear source of truth</h3>
            <p>Your website, Google Business Profile, directories, and review platforms should agree on the basics. When they do, customers have less reason to hesitate, and AI has more reason to trust what it finds.</p>
          </div>
        </div>
      </section>

      <section class="v6-glow tk-ais__scan" aria-labelledby="scan-cta-heading" data-rise>
        <div class="v6-glow__inner tk-ais__scan-inner">
          <div>
            <h2 id="scan-cta-heading" class="tk-ais__scan-h2">
              Would AI know when your shop is the right fit?
            </h2>
            <p class="tk-ais__scan-text">See the version of your shop AI can piece together from public information, then find where a little cleanup would make a real difference.</p>
          </div>
          <a href="/ai-visibility-scan" class="v6-btn v6-btn--navy v6-btn--lg" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_inline_scan"><span>Run my free scan</span> <i set:html={arrow} /></a>
        </div>
      </section>

      <section id="ai-calls" class="tk-ais__sec" aria-labelledby="ai-calls-heading">
        <h2 id="ai-calls-heading" class="tk-art__h2">
          Google may call your shop <span class="block">for the customer.</span>
        </h2>
        <div class="tk-art__lede">
          <p>Picture the front counter on a busy Tuesday morning. Two customers are waiting, a technician needs an answer, and now an automated caller wants price and availability. That is not the moment to make up the shop’s answer from scratch.</p>
          <p>Google says its automated caller identifies itself, explains that it is calling for a user, and may record the call. The takeaway: how your phone gets answered is now part of how visible your shop is. Give advisors a clear way to explain diagnostic charges, appointment windows, and what they need to know before promising anything.</p>
        </div>

        <ol class="tk-ais__journey" data-allow-overflow aria-label="AI-assisted local service journey">
          {callJourney.map((item, index) => (
            <li>
              <div class="tk-ais__journey-top">
                <span class="tk-ais__icon tk-ais__icon--navy"><span class="v6-icon" aria-hidden="true" style={`--icon:url(${iconSrc(item.icon)})`}></span></span>
                {index < callJourney.length - 1 && <i class="tk-ais__journey-go" aria-hidden="true" set:html={arrow} />}
              </div>
              <h3 class="tk-ais__journey-h3">{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ol>

        <div class="tk-ais__advisor" data-rise>
          <span class="tk-ais__icon tk-ais__icon--green"><span class="v6-icon" aria-hidden="true" style={`--icon:url(${iconSrc("car-count")})`}></span></span>
          <div>
            <h3 class="tk-ais__advisor-h3">Treat the AI answer as a clue, not a diagnosis.</h3>
            <p class="tk-ais__advisor-text">You do not need to argue with the customer or roll your eyes at the robot. Acknowledge what they found, explain what still has to be inspected, and walk them through how your team will confirm the cause before recommending a repair.</p>
          </div>
        </div>
      </section>

      <section id="action-plan" class="tk-ais__sec" aria-labelledby="action-plan-heading">
        <h2 id="action-plan-heading" class="tk-art__h2">
          Seven practical moves <span class="block">for the next 30 days.</span>
        </h2>
        <p class="tk-art__lede">You do not need to rebuild your whole <a href="/resources/auto-repair-marketing-plan">auto repair marketing plan</a> by next Tuesday. Start with these seven moves. Each one makes it easier for the right customer to find you, trust you, and book.</p>
        <ul class="tk-ais__steps">
          {actionSteps.map((step) => (
            <li>
              <h3 class="tk-ais__step-h3">{step.title}</h3>
              <p class="tk-ais__step-text">{step.body}</p>
            </li>
          ))}
        </ul>
        <div class="tk-ais__warn"><p><strong>Skip the breathless AI hacks.</strong> You do not need to sprinkle magic files across your website. Clear pages, correct shop information, useful content, strong reviews, and real proof will do far more for your car count.</p></div>
      </section>

      <section id="how-turnkey-helps" class="tk-ais__tint" aria-labelledby="turnkey-heading">
        <h2 id="turnkey-heading" class="tk-art__h2">
          Turnkey keeps the whole <span class="block">marketing system working together.</span>
        </h2>
        <p class="tk-art__lede">You already have enough moving parts inside the shop. You should not also have to referee a website company, an SEO vendor, review tools, content, and reporting. We pull those pieces together around the repairs you want more of and the customers your shop serves best.</p>
        <div class="tk-ais__helps">
          <a href="/services/digital-marketing" class="v6-tile">
            <span class="v6-tile__icon"><span class="v6-icon" aria-hidden="true" style={`--icon:url(${iconSrc("internet")})`}></span></span>
            <h3 class="v6-tile__title">Make your shop easier to find and trust</h3>
            <p class="v6-tile__text">Keep your website, Google Business Profile, reviews, and content accurate, useful, and pointed at the work you want.</p>
            <span class="v6-tile__go v6-link">Explore digital marketing <i set:html={arrow} /></span>
          </a>
          <a href="/services/vip-marketing-manager" class="v6-tile v6-tile--navy">
            <span class="v6-tile__icon"><span class="v6-icon" aria-hidden="true" style={`--icon:url(${iconSrc("vip")})`}></span></span>
            <h3 class="v6-tile__title">Put one experienced team in charge</h3>
            <p class="v6-tile__text">Bring strategy, vendors, campaigns, reporting, and follow-through under one practical plan built for your shop.</p>
            <span class="v6-tile__go v6-link v6-link--light">Meet the VIP marketing manager <i set:html={arrow} /></span>
          </a>
        </div>
      </section>

      {post.faq && post.faq.length > 0 && (
        <section id="faq" class="tk-ais__sec" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="tk-art__h2">
            AI search questions, <span class="block">answered without the hype.</span>
          </h2>
          <p class="tk-art__lede">These come from Google’s People Also Ask results and the questions that keep showing up across the top-ranking guides as the market changes.</p>
          <ul class="v6-acc tk-ais__acc">
            {post.faq.map((item, index) => (
              <li class:list={["v6-acc__item", index === 0 && "is-open"]} data-acc-item>
                <h3 class="tk-acc__q"><button type="button" class="v6-acc__head" aria-expanded={index === 0 ? "true" : "false"} data-acc-head><span>{item.question}</span><span class="v6-acc__icon" aria-hidden="true"></span></button></h3>
                <div class="v6-acc__panel"><div><p>{item.answer}</p></div></div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section id="sources" class="tk-ais__sec" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="tk-art__h2">What this guide is based on</h2>
        <p class="tk-art__lede">AI search changes quickly. We checked current Google and OpenAI documentation and used outside research only where it added useful context. Claims were reviewed on August 26, 2026.</p>
        <ul class="tk-ais__sources">
          {sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noreferrer"><span><span class="tk-ais__source-title">{source.title}</span><span class="tk-ais__source-pub">{source.publisher}</span></span><i aria-hidden="true" set:html={arrowUp} /></a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>

  {post.externalSources && post.externalSources.length > 0 && (
    <ExternalSources sources={post.externalSources} />
  )}

  <section class="v6-sec v6-sec--navy tk-ais__final">
    <div class="v6-wrap tk-ais__final-inner" data-rise>
      <img src="/images/icons/ai-search-spark-white.svg" alt="" role="presentation" width="1200" height="1200" loading="lazy" decoding="async" class="ai-spark-icon" aria-hidden="true" />
      <h2 class="tk-ais__final-h2">
        Would AI put your shop <span class="block">on the shortlist?</span>
      </h2>
      <p class="tk-ais__final-text">Find out what AI can see, what it may be missing, and which fix deserves your attention first.</p>
      <div class="v6-cta__actions">
        <a href="/ai-visibility-scan" class="v6-btn v6-btn--green v6-btn--lg" data-track-event="ai_visibility_scan_click" data-track-placement="resource_ai_search_final_scan"><span>Run my free AI Visibility Scan</span> <i set:html={arrow} /></a>
        <a href="/services/digital-marketing" class="v6-btn v6-btn--ghost v6-btn--lg"><span>Explore digital marketing</span></a>
      </div>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="v6-sec v6-sec--tint tk-art__related" aria-labelledby="related-reading-heading">
      <div class="v6-wrap">
        <div class="v6-row-head">
          <div><h2 id="related-reading-heading" class="v6-h2 tk-art__related-h2">Related field guides</h2></div>
          <a href="/resources" class="v6-link">All resources <i set:html={arrow} /></a>
        </div>
        <div class="v6-swipe tk-art__cards" style={`--cols:${Math.max(2, Math.min(4, relatedPosts.length))}`}>
          {relatedPosts.map((relatedPost) => (
            <a href={relatedPost.href} class="v6-post">
              <div class="v6-post__media"><img src={relatedPost.image.src} alt={relatedPost.image.alt} width={relatedPost.imageWidth ?? 1200} height={relatedPost.imageHeight ?? 800} loading="lazy" decoding="async" style={`object-position:${relatedPost.image.position};`} /></div>
              <p class="v6-post__tag">{relatedPost.tag}</p><h3 class="v6-post__title">{relatedPost.title}</h3><span class="v6-link">Read guide <i set:html={arrow} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</article>

