---
import { getResourcePost, type ResourcePost } from "@/lib/resource-posts";
import ExternalSources from "@/components/resources/ExternalSources.astro";
import { arrow, iconSrc, split } from "@/lib/v6";

interface Props {
  post: ResourcePost;
}

const { post } = Astro.props;
const relatedPosts = (post.relatedSlugs ?? [])
  .map((slug) => getResourcePost(slug))
  .filter((relatedPost) => relatedPost !== undefined);

const groupLinks = [
  { href: "#new-customers", label: "New customers" },
  { href: "#slow-bays", label: "Slow bays" },
  { href: "#retention", label: "Retention" },
  { href: "#trust", label: "Trust" },
  { href: "#better-work", label: "Better work" },
];

const situations = [
  {
    icon: "target",
    need: "Attract better-fit new customers",
    startingPoint: "Local visibility, real proof, targeted mail, and referrals",
    measure: "Qualified first appointments",
    href: "#new-customers",
    linkLabel: "See the new-customer ideas",
  },
  {
    icon: "weekly-planner",
    need: "Fill a known schedule gap",
    startingPoint: "Capacity campaigns, reactivation, and declined work",
    measure: "Appointments booked inside the target window",
    href: "#slow-bays",
    linkLabel: "See the slow-bay ideas",
  },
  {
    icon: "retention",
    need: "Earn the second and third visit",
    startingPoint: "Next-step scheduling, welcome follow-up, and reminders",
    measure: "Return rate and time to the next visit",
    href: "#retention",
    linkLabel: "See the retention ideas",
  },
  {
    icon: "vip",
    need: "Build trust before the call",
    startingPoint: "Real photos, honest reviews, a clear process, and useful answers",
    measure: "Profile actions and call-to-book rate",
    href: "#trust",
    linkLabel: "See the trust ideas",
  },
  {
    icon: "car-count",
    need: "Improve customer and repair-order fit",
    startingPoint: "A focused audience, a clear service promise, and an advisor script",
    measure: "Target-service mix and repair-order quality",
    href: "#better-work",
    linkLabel: "See the work-mix ideas",
  },
];

const ideaGroups = [
  {
    id: "new-customers",
    title: "Attract better-fit new customers.",
    intro:
      "More cars only help when the shop can serve them well and the work fits the business. So start with the customers, vehicles, and services you want more of. Then show up where those drivers are already deciding which shop to call.",
    ideas: [
      {
        title: "Make your Google Business Profile answer the obvious questions.",
        bestWhen: "Drivers have a hard time finding the shop, or the profile leaves them guessing.",
        body: "Fill in and maintain the primary category, services, hours, phone number, appointment link, service area, and shop description. Add recent photos of the exterior, the entrance, the front counter, the team, and the work environment. Google says local results are based mainly on relevance, distance, and prominence. Complete, accurate information gives Google a clearer picture of when your shop is the relevant answer, and it answers the questions a driver has before picking up the phone.",
        measure: "Profile calls, website visits, direction requests, and qualified appointments.",
        watch: "Don't stuff keywords into the business name, create duplicate locations, or trust anyone who promises a ranking position.",
        link: {
          href: "https://support.google.com/business/answer/7091",
          label: "Read Google's local-ranking guidance",
          external: true,
        },
      },
      {
        title: "Strengthen the pages for work you genuinely want more of.",
        bestWhen: "Drivers search for a specialty and land on a generic service list.",
        body: "Build or improve a page around a service, vehicle type, or customer situation your shop is truly equipped to handle. Explain the symptoms, what your team checks, what the customer can expect, and why your technicians are qualified. Use original photos and real proof. A good page helps a driver make a decision. It doesn't repeat a city name twenty times.",
        measure: "Qualified calls and booked repair orders tied to the work you targeted.",
        watch: "Skip thin pages for services the shop can't support or locations it doesn't serve.",
      },
      {
        title: "Use direct mail as a campaign, not a print order.",
        bestWhen: "You need to be known inside a defined drive-time area.",
        body: "Before anyone designs a postcard, decide on a tight household list, a clear customer problem, an offer the shop can serve, a landing path, and a repeatable drop schedule. New movers, nearby best-fit households, and lapsed customers can each support their own campaign. The mailer is one piece of the system. How the phone gets answered and how the shop follows up decide whether it turns into good work.",
        measure: "Tracked calls, booked appointments, show rate, and repair-order quality for each drop.",
        watch: "One broad mailing usually teaches you less than repeated drops to a qualified list.",
        link: {
          href: "/resources/direct-mail-for-repair-shops",
          label: "Use the direct-mail campaign guide",
        },
      },
      {
        title: "Build a referral moment into the customer experience.",
        bestWhen: "Happy customers already recommend the shop, but it happens by accident.",
        body: "Pick a natural moment right after the customer gets a clear win: the vehicle is ready, they understand what was wrong, and the shop kept its promise. Give your advisors a short, comfortable way to ask for an introduction, and make the next step easy. The best referral ask describes who the shop helps best. It doesn't ask customers to send everyone they know.",
        measure: "Referred calls, booked first visits, and the share that turns into a second visit.",
        watch: "Don't turn a warm relationship into a complicated rewards program your team can't keep up with.",
      },
    ],
  },
  {
    id: "slow-bays",
    title: "Fill a predictable schedule gap.",
    intro:
      "A soft calendar is usually a timing problem before it's a branding problem. Work backward from the open dates. Reach people who already have a reason to come in, and brief the front counter before the first message goes out.",
    ideas: [
      {
        title: "Trigger a campaign from real appointment capacity.",
        bestWhen: "You can see a soft window two to four weeks out.",
        body: "Get specific. Which days are open, which services fit them, how much technician time is available, and how many appointments can the shop accept? Then choose an audience and a message that can act inside that window. A modest email, text, direct-mail, or targeted digital campaign built around a real schedule gap gives you a specific audience, offer, and booking window. That beats waiting for empty bays and reaching for a broad discount.",
        measure: "Booked and completed appointments inside the target dates.",
        watch: "Marketing can't rescue a gap when the creative, approvals, lists, or staff prep start too late.",
        link: {
          href: "/services/directtrack-marketing",
          label: "Explore targeted campaigns with DirectTrack",
        },
      },
      {
        title: "Reactivate customers whose normal return window has passed.",
        bestWhen: "Your database holds good customers who have quietly stopped coming back.",
        body: "Define inactive by your shop's actual visit cycle, such as customers who haven't returned in 12, 18, or 24 months. Then separate useful segments by vehicle, prior work, location, or customer value. Acknowledge the gap without scolding anyone, give a practical reason to reconnect, and make booking simple in the channels each customer has agreed to hear from you.",
        measure: "Reactivated appointments, completed repair orders, and return rate after the campaign.",
        watch: "One generic blast to the whole database hides which customers and messages actually worked.",
        link: {
          href: "/services/retention-marketing",
          label: "See how retention marketing brings customers back",
        },
      },
      {
        title: "Follow up on previously declined work with context.",
        bestWhen: "Customers left with documented work that still needs attention.",
        body: "Use the advisor's notes and the inspection record to remind the customer what was found, why it matters, and how to take the next step. Be honest about what is safety, what is reliability, and what is routine maintenance. Agree on who sends the message and when, so it feels like the service conversation picking back up. It should never read like an alarming note from a campaign nobody at the shop recognizes.",
        measure: "Responses, booked follow-up work, approvals, and completed repair orders.",
        watch: "Respect each customer's communication preferences and the messaging rules that apply, and never exaggerate urgency.",
      },
    ],
  },
  {
    id: "retention",
    title: "Turn a first appointment into a relationship.",
    intro:
      "You already paid to earn this customer's attention and trust. Retention marketing protects that investment. Make the next helpful step clear, send it at the right time, and keep it consistent with the visit the customer just had.",
    ideas: [
      {
        title: "Set the next expectation before the keys change hands.",
        bestWhen: "Customers leave happy with no clear reason or date to come back.",
        body: "At pickup, explain the next likely maintenance milestone, note it in the system, and tell the customer how the shop will follow up. When it makes sense, offer to reserve the next visit right there. Then the email or text months later reinforces a conversation the customer remembers, instead of arriving as a mystery recommendation.",
        measure: "Future appointments set, reminder response, and return rate.",
        watch: "Don't schedule a next step the advisor hasn't explained or the shop can't honor.",
      },
      {
        title: "Create a useful new-customer welcome sequence.",
        bestWhen: "The first visit goes well, then the customer hears nothing until the next promotion.",
        body: "Send a short thank-you. Explain how to reach the shop, remind the customer where to find inspections or records, and introduce the next service touchpoint that fits their vehicle. A simple 30-, 60-, and 90-day sequence builds familiarity without sending three sales offers in a row. Give each message one job and one obvious next step.",
        measure: "Message engagement, second-visit rate, and time to the next appointment.",
        watch: "Automation should sound like your shop, and it should stop once a message no longer applies.",
        link: {
          href: "/services/retention-marketing",
          label: "See how Turnkey supports customer retention",
        },
      },
      {
        title: "Segment seasonal reminders around real vehicle needs.",
        bestWhen: "Every customer gets the same holiday promotion.",
        body: "Start with local weather, mileage, vehicle age, service history, and the work your team can take on. A cooling-system reminder, pre-trip inspection, tire check, or maintenance message only helps when the audience and the timing fit. For a good customer, a clear explanation of why the service matters now is usually a better reason to book than a novelty holiday coupon.",
        measure: "Appointments and completed work from the customer segment you intended to reach.",
        watch: "Don't let the marketing calendar create demand the technician schedule can't absorb.",
      },
    ],
  },
  {
    id: "trust",
    title: "Build trust before the customer calls.",
    intro:
      "A driver can't judge your diagnosis before choosing your shop. So they look for other signals: people they recognize, a professional place, clear communication, recent customer experiences, and a process that makes sense.",
    ideas: [
      {
        title: "Show the real people, place, and process.",
        bestWhen: "Your website could belong to almost any repair shop.",
        body: "Photograph the exterior and entrance, your advisors and technicians, the inspection process, the equipment, the waiting area, and the moment the keys go back to the customer. Use those images on the website, Business Profile, social content, email, recruiting, and campaigns. Current, original photos let a customer recognize your shop before arriving. They also give every channel the same look, so everything feels like one shop.",
        measure: "Engagement with profile and website pages, calls, and customer feedback.",
        watch: "Old team photos and generic stock images can create more doubt than confidence.",
        link: {
          href: "/resources/auto-repair-shop-photography-guide",
          label: "Plan the shop photo library",
        },
      },
      {
        title: "Ask every eligible customer for an honest review.",
        bestWhen: "Review requests are hit or miss, or depend on one advisor remembering.",
        body: "Pick a repeatable point after the visit is complete, send a direct link, and ask for honest feedback in neutral words. Give the team a way to recover when a customer raises a concern. Reviews can build customer confidence and may contribute to local prominence. The goal is still a truthful record of the experience, not a manufactured five-star score.",
        measure: "Request volume, completed reviews, recency, rating themes, and issues recovered.",
        watch: "The FTC prohibits fake reviews and incentives conditioned on whether a review is positive or negative.",
        link: {
          href: "https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers",
          label: "Review the FTC's business guidance",
          external: true,
        },
      },
      {
        title: "Respond to reviews like a future customer is reading.",
        bestWhen: "Reviews get canned replies, defensive replies, or no reply at all.",
        body: "Thank the customer, mention a specific part of the visit when it fits, and let your shop's way of communicating come through. With a negative review, stay calm, keep private repair details out of it, and offer a direct way to continue the conversation. The reply isn't only for the reviewer. Future customers read it to see how you handle praise and how you handle problems.",
        measure: "Response coverage, response time, recurring themes, and recovered relationships.",
        watch: "Don't argue, reveal customer information, or paste the same promotional paragraph under every review.",
        link: {
          href: "/services/digital-marketing",
          label: "See how Turnkey supports reviews and local visibility",
        },
      },
      {
        title: "Turn advisor questions into useful content.",
        bestWhen: "Your front counter answers the same important questions every week.",
        body: "Keep a running list of what customers ask before booking, during the inspection, and before approving work. Turn the best ones into short website answers, emails, quick videos, social posts, or call-handling notes. Plain explanations of diagnostics, estimates, warranties, timelines, and maintenance take the uncertainty out before a customer ever reaches an advisor.",
        measure: "Relevant page visits, calls and bookings the content helped produce, call quality, and how often the same question still comes up.",
        watch: "Useful content answers a real decision question. It doesn't need to chase every trend or keyword.",
      },
    ],
  },
  {
    id: "better-work",
    title: "Get more of the work the shop wants.",
    intro:
      "Maybe the calendar is full and the business still feels strained. Then more volume probably isn't the goal. Marketing can shape your vehicle mix, your service mix, what customers expect when they call, and the quality of work that reaches the bays.",
    ideas: [
      {
        title: "Choose one customer or service priority for the quarter.",
        bestWhen: "Every campaign is trying to reach every driver for every service.",
        body: "Use your shop data and your team's experience to pick a focus: a vehicle specialty, a maintenance relationship, a service category, nearby households, or another customer situation you serve especially well. Write down why that work fits the business and what proof the customer needs to see. One focused quarter gives you a cleaner test than a permanent promise to be everything to everyone.",
        measure: "Qualified inquiries, targeted service mix, repair-order quality, and repeat visits.",
        watch: "Base the focus on real capability and real economics, not an invented demographic stereotype.",
        link: {
          href: "/resources/ideal-customer-profile-auto-repair-shop",
          label: "Build an evidence-based customer profile",
        },
      },
      {
        title: "Carry one promise from the ad to the advisor.",
        bestWhen: "The campaign gets responses, but too few become good appointments.",
        body: "Line up the audience, offer, landing page, phone greeting, advisor explanation, and follow-up around the same customer need. Give the team the exact campaign details before launch, then listen to a sample of real calls. When the front counter knows who the message is for and why it matters, the promise in the ad has a better chance of becoming the right repair order.",
        measure: "Qualified-call rate, booking rate, show rate, and completed targeted work.",
        watch: "More traffic won't fix a confusing offer, a weak handoff, or a schedule that can't take the work.",
        link: {
          href: "/services/directtrack-marketing",
          label: "See how DirectTrack connects targeting and measurement",
        },
      },
    ],
  },
];

const measurementSteps = [
  { label: "Response", detail: "Calls, forms, and messages" },
  { label: "Qualified", detail: "The right customer and work" },
  { label: "Booked", detail: "Appointment accepted" },
  { label: "Completed", detail: "Repair order closed" },
  { label: "Returned", detail: "Next visit earned" },
];

const testSteps = [
  "Write down the business problem and where the numbers stand today.",
  "Pick one audience, one campaign, and one person who owns it.",
  "Get the landing page, phone handling, scheduling, and follow-up ready.",
  "Choose the one business number you'll judge it by, and set a review date.",
  "Run it long enough to learn something, without changing everything at once.",
  "Decide whether to keep it, fix it, stop it, or expand it.",
];

const avoidItems = [
  {
    title: "A campaign without a shop problem",
    body: "If nobody can say what needs to change, there's no fair way to judge the channel.",
  },
  {
    title: "A discount for everyone",
    body: "A broad price offer can create activity while attracting work and expectations the shop doesn't want.",
  },
  {
    title: "A channel nobody owns",
    body: "Every campaign needs one person responsible for the list, the message, the launch, the phone handoff, and the review.",
  },
  {
    title: "A report that stops at leads",
    body: "A lead count can't tell you whether the right customers booked, showed up, approved work, or came back.",
  },
];

const ideaCount = ideaGroups.reduce((total, group) => total + group.ideas.length, 0);

const wordSource = [
  post.dek,
  ...situations.flatMap((situation) => [situation.need, situation.startingPoint, situation.measure]),
  ...ideaGroups.flatMap((group) => [
    group.intro,
    ...group.ideas.flatMap((idea) => [idea.title, idea.bestWhen, idea.body, idea.measure, idea.watch]),
  ]),
  ...measurementSteps.map((step) => step.detail),
  ...testSteps,
  ...avoidItems.map((item) => item.body),
].join(" ");
const readMinutes = Math.max(1, Math.round(wordSource.split(/\s+/).length / 225));
---

<article class="tk-mi" data-art-body>
  <section class="tk-art__hero">
    <div class="v6-wrap">
      <a href="/resources" class="tk-art__back">
        <i set:html={arrow} />
        All resources
      </a>

      <div class="tk-art__head">
        <header class="tk-art__head-text">
          <p class="tk-art__meta" data-fade>
            <span class="tk-art__tag">{post.tag} guide</span> · <time datetime={post.updatedDate ?? post.originalDate}>{post.date}</time> · {readMinutes} min read
          </p>
          <h1 class="tk-art__title" data-words set:html={split([{ t: post.title }])} />
          <p class="tk-art__dek tk-mi__dek" data-fade style="--d:2">
            {post.dek}
          </p>
          <div class="tk-art__actions" data-fade style="--d:3">
            <a href="#start-here" class="v6-btn v6-btn--navy v6-btn--lg">
              <span>Find Your Starting Point</span>
              <i set:html={arrow} />
            </a>
          </div>
        </header>

        <div class="tk-mi__visual" data-fade style="--d:3">
          <figure class="tk-art__media">
            <img
              src={post.image.src}
              alt={post.image.alt}
              width={post.imageWidth ?? 1200}
              height={post.imageHeight ?? 800}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={`object-position: ${post.image.position ?? "50% 50%"};`}
            />
          </figure>

          <div class="tk-mi__inside">
            <dl>
              <div>
                <dt>{ideaCount}</dt>
                <dd>ideas you can run</dd>
              </div>
              <div>
                <dt>{situations.length}</dt>
                <dd>shop situations to start from</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec tk-mi__short" aria-labelledby="short-answer-heading">
    <div class="v6-wrap tk-mi__split">
      <div>
        <h2 id="short-answer-heading" class="tk-art__h2 tk-mi__short-h2" data-rise>
          Choose the idea by the job it needs to do.
        </h2>
      </div>
      <div>
        <p class="tk-mi__short-text">
          Start with the problem in front of your shop, not the channel everyone is talking about this month. Most auto repair marketing has one of five jobs: attract a better-fit new customer, fill a known capacity gap, earn another visit, reduce uncertainty, or improve the work mix. Which one matters most right now? Answer that first, then choose the channel. For the bigger picture,
          <a href="/" class="tk-art__text-link">
            see how Turnkey approaches auto repair marketing for independent shops
          </a>.
        </p>
        <ul class="tk-mi__takeaways">
          {post.takeaways.map((takeaway) => (
            <li>{takeaway}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="start-here" class="v6-sec v6-sec--tint tk-mi__start" aria-labelledby="start-heading">
    <div class="v6-wrap">
      <div class="tk-mi__start-head">
        <h2 id="start-heading" class="v6-h2" data-words set:html={split([{ t: "What does the shop need" }, { t: "marketing to change?", accent: true }])} />
        <p class="v6-lead">
          Pick the situation that sounds most like your shop right now. Each one takes you to the ideas most likely to help, instead of the tactics getting the most attention online.
        </p>
      </div>

      <div class="v6-swipe tk-mi__routes" style="--cols:5">
        {situations.map((situation) => (
          <a href={situation.href} class="v6-tile tk-mi__route">
            <span class="v6-tile__icon" aria-hidden="true">
              <span class="v6-icon" style={`--icon:url(${iconSrc(situation.icon)})`}></span>
            </span>
            <h3 class="v6-tile__title">{situation.need}</h3>
            <p class="v6-tile__text">Start with: {situation.startingPoint}.</p>
            <div class="tk-mi__route-measure">
              <span>Measure:</span> {situation.measure}
            </div>
            <span class="v6-link tk-mi__route-go">
              {situation.linkLabel} <i set:html={arrow} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="v6-wrap tk-art__layout tk-art__read">
    <aside class="tk-art__aside">
      <nav class="tk-toc" aria-label="Article sections" data-toc>
        <details class="tk-toc__box" data-toc-details open>
          <summary>In this guide <span class="tk-toc__plus" aria-hidden="true"></span></summary>
          <ul class="tk-toc__list">
            {ideaGroups.map((group, index) => (
              <li>
                <a href={`#${group.id}`}>
                  {groupLinks[index].label}
                </a>
              </li>
            ))}
          </ul>
        </details>
        <div class="tk-toc__extra">
          <a href="#start-here">
            <i class="tk-mi__up" set:html={arrow} />
            Start here
          </a>
          <a href="#measurement">
            <i class="tk-mi__down" set:html={arrow} />
            The scoreboard
          </a>
        </div>
      </nav>
    </aside>

    <div class="tk-art__main">
      {ideaGroups.map((group) => (
        <section id={group.id} class="tk-mi__group">
          <div class="tk-mi__group-head">
            <h2 class="tk-art__h2" data-rise>{group.title}</h2>
            <p class="tk-art__lede tk-mi__lede">{group.intro}</p>
          </div>

          <ul class="tk-mi__ideas">
            {group.ideas.map((idea) => (
              <li class="tk-mi__idea">
                <h3 class="tk-mi__idea-h3">{idea.title}</h3>
                <p class="tk-mi__best">
                  <span>Best when:</span>
                  {idea.bestWhen}
                </p>
                <p class="tk-mi__idea-text">{idea.body}</p>
                <dl class="tk-mi__dl">
                  <div class="tk-mi__dl-measure">
                    <dt>Measure</dt>
                    <dd>{idea.measure}</dd>
                  </div>
                  <div class="tk-mi__dl-watch">
                    <dt>Watch out for</dt>
                    <dd>{idea.watch}</dd>
                  </div>
                </dl>
                {idea.link && (
                  <a
                    href={idea.link.href}
                    class="v6-link tk-mi__idea-link"
                    target={idea.link.external ? "_blank" : undefined}
                    rel={idea.link.external ? "noreferrer" : undefined}
                    data-track-event={idea.link.href.startsWith("/services/") ? "service_cta_click" : undefined}
                    data-track-slug={idea.link.href.startsWith("/services/") ? idea.link.href.replace("/services/", "") : undefined}
                    data-track-placement={idea.link.href.startsWith("/services/") ? "resource_marketing_ideas_inline" : undefined}
                  >
                    {idea.link.label}
                    <i set:html={arrow} />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="tk-mi__back">
        <a href="#start-here" class="v6-link">
          <i class="tk-mi__up" set:html={arrow} />
          Back to the starting point
        </a>
      </div>
    </div>
  </div>

  <section class="v6-sec v6-sec--navy" aria-labelledby="current-context-heading">
    <div class="v6-wrap tk-mi__split">
      <div>
        <h2 id="current-context-heading" class="v6-h2 tk-mi__navy-h2" data-rise>
          Local discovery is becoming more conversational.
        </h2>
      </div>
      <div class="tk-mi__navy-text">
        <p>
          Google compiles local business information from claimed profiles, public web content, licensed data, user contributions, and its own interactions with places. Google now also says eligible US users can ask its AI to call multiple nearby auto repair providers to check availability and prices. Availability can vary, and a call like that still can't replace a proper vehicle inspection or an exact diagnosis.
        </p>
        <p>
          So don't answer the change by swapping your strategy for AI-written content. Keep your shop facts accurate. Make your services and your proof easy to understand. Answer the phone well, and publish information that helps a real customer choose. Those basics make your shop easier to understand for people and for search systems alike.
        </p>
        <div class="tk-mi__navy-links">
          <a href="https://support.google.com/business/answer/2721884" target="_blank" rel="noreferrer" class="v6-link v6-link--light">
            How Google sources local information <i set:html={arrow} />
          </a>
          <a href="https://blog.google/products-and-platforms/products/search/search-io-2026/?pubDate=20260519" target="_blank" rel="noreferrer" class="v6-link v6-link--light">
            Google Search's 2026 update <i set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="measurement" class="v6-sec v6-sec--tint tk-mi__measure" aria-labelledby="measurement-heading">
    <div class="v6-wrap tk-mi__split">
      <div class="tk-mi__sticky">
        <h2 id="measurement-heading" class="v6-h2" data-words set:html={split([{ t: "Measure the path to the" }, { t: "repair order.", accent: true }])} />
        <p class="v6-lead tk-mi__measure-lead">
          Impressions and clicks can tell you whether anything is happening. They can't tell you whether the right driver booked, showed up, approved the work, or trusted the shop enough to come back.
        </p>
      </div>

      <div>
        <ol class="rail">
          {measurementSteps.map((step) => (
            <li class="rail-step">
              <span class="rail-dot" aria-hidden="true"></span>
              <h3 class="rail-h3">{step.label}</h3>
              <p class="rail-text">{step.detail}</p>
            </li>
          ))}
        </ol>

        <div class="tk-mi__test">
          <h3 class="tk-mi__test-h3">A useful 90-day test</h3>
          <ol class="tk-mi__test-list">
            {testSteps.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="v6-sec tk-mi__avoid" aria-labelledby="avoid-heading">
    <div class="v6-wrap">
      <div class="v6-head">
        <div>
          <h2 id="avoid-heading" class="v6-h2" data-words set:html={split([{ t: "What not to" }, { t: "run next.", accent: true }])} />
