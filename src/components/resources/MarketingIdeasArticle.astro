            data-track-placement="resource_marketing_ideas_bottom"
          >
            <span>See VIP Marketing Manager</span>
            <i set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </section>

  {relatedPosts.length > 0 && (
